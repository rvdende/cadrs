// P3.3 / PS4.1, PS4.10, PS4.11: the Surface and Thin tabs. Sketch 1 on Top: a 60 × 40
// rectangle; Sketch 2: a Ø30 circle beside it.
// 01 Thin: the rectangle's region, Thickness 1 = 3 mm inside: a hollow box wall, its corners
//    mitred (Flip wall and Mid plane below, and Thickness 2).
// 02 Mid plane: the wall straddles the sketch line (1.5 mm each side).
// 03 Surface: Sketch 2 (the whole sketch, from the list), 30 mm: a sheet around the circle (no caps); the dialog has no
//    boolean tabs.
// 04 accepted: the Parts list has a "Surfaces (1)" group with "Surface 1" under the parts. A
//    surface shows its back side darker (the inside of the open tube) and its free edges wider.
// 05 Surface of an open chain (Sketch 3: three lines, no region), 25 mm: a folded sheet.
// 06 accepted: "Surfaces (2)".
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 60 40"),
        Key("Shift+7"),
        Key("F"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(30, 20, 0)),
        Click(ui("extrude-body-type-2")),
        Click(ui("extrude-thickness1-field")),
        Key("Ctrl+A"),
        Type("3"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-thin-3-inside"),
        Click(ui("extrude-mid-plane-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-thin-mid-plane"),
        Key("Enter"),
        Custom("sketch top circle 100 20 15"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("extrude-body-type-1")),
        Click(ui("feature-sketch-2")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-surface-of-a-circle"),
        Key("Enter"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-surfaces-group"),
        // An open chain (Sketch 3, three lines) extruded as a surface: a folded sheet.
        Custom("sketch top chain 0 -25 30 -35 50 -20 80 -35"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("extrude-body-type-1")),
        Click(ui("feature-sketch-3")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("25"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-surface-of-an-open-chain"),
        Key("Enter"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-two-surfaces"),
    ],
)
