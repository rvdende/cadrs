// P3B.4 / A18.1–A18.5, A1.5, X8: folders in the Instances and Mate Features lists, and the list
// filter, on the Ex2 end state (`fixtures/pneumatic_cylinder_ex2.cadrs`).
// 01 (A18.2) the header's New folder with nothing selected: the Folder name popup; 02 accepted:
//    an empty folder at the end of the list.
// 03 (A18.3, ex3-step3) the four Structural Rods selected → right-click → Add selection to
//    folder…; 04 the popup beside the first selected row, named "Rods"; 05 accepted: "Rods (4)"
//    where the first rod was.
// 06 (A18.2) the Piston & Rod dragged onto the folder's row: it joins (5 items).
// 07 (A18.2) the folder dragged to the top of the list (its rows move with it).
// 08 (A18.4) the folder's eye: everything in it hidden; 09 its menu: Rename, Show, Suppress,
//    Unpack folder, Delete; 10 Suppress: its instances greyed and struck through (then
//    Unsuppress, Show).
// 11 (A18.4) renamed in place to "Tie rods"; 12 Unpack folder: the rows stay, the folder goes
//    (undone); 13 Delete: the folder and its instances (and their mates) go (undone).
// 14 (A18.5) a mate folder: right-click Fastened 5 → Add selection to folder… → "Rod mates";
//    15 Fastened 6 dragged onto it.
// 16 (A1.5) the filter "rod": the matching rows and their folders, in both lists; 17 ":folder
//    rod mates".
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture pneumatic_cylinder_ex2"),
        Click(ui("tab-cylinder-assembly")),
        Key("F"),
        // A18.2: New folder, nothing selected.
        Click(ui("instance-new-folder")),
        WaitFor("folder-name-popup"),
        Screenshot("01-a18.2-new-folder-popup"),
        Type("Spare"),
        Key("Enter"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("02-a18.2-empty-folder-last"),
        // A18.3: Add selection to folder….
        Click(ui("instance-row-10")),
        Click(ui("instance-row-11")),
        Click(ui("instance-row-12")),
        Click(ui("instance-row-13")),
        RightClick(ui("instance-row-12")),
        WaitFor("asm-folder"),
        Hover(ui("asm-folder")),
        Wait(3),
        Screenshot("03-a18.3-add-selection-to-folder"),
        Click(ui("asm-folder")),
        WaitFor("folder-name-popup"),
        Type("Rods"),
        Screenshot("04-a18.3-folder-name-popup"),
        Click(ui("folder-name-popup-accept")),
        Click(at(1350, 650)),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("05-a18.3-rods-folder"),
        // A18.2: drag the Piston & Rod onto the folder.
        Press(ui("instance-row-14")),
        Wait(2),
        Hover(ui_at("instance-row-13", 0.5, 0.5)),
        Wait(2),
        Hover(ui("instance-folder-rods")),
        Wait(5),
        Release,
        Wait(10),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("06-a18.2-dragged-into-folder"),
        // A18.2: reorder the folder, to the top.
        Press(ui("instance-folder-rods")),
        Wait(2),
        Hover(ui_at("instance-row-1", 0.5, 0.9)),
        Wait(2),
        Hover(ui_at("instance-row-1", 0.5, 0.1)),
        Wait(5),
        Screenshot("07a-a18.2-dragging-folder"),
        Release,
        Wait(10),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("07-a18.2-folder-moved-to-top"),
        // A18.4: the folder's eye, its menu.
        Hover(ui("instance-folder-rods")),
        Wait(3),
        Click(ui("instance-folder-rods-eye")),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("08-a18.4-folder-eye-hid-contents"),
        RightClick(ui("instance-folder-rods")),
        WaitFor("asm-folder-suppress"),
        Hover(ui("asm-folder-suppress")),
        Wait(3),
        Screenshot("09-a18.4-folder-menu"),
        Click(ui("asm-folder-suppress")),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("10-a18.4-folder-suppressed"),
        RightClick(ui("instance-folder-rods")),
        WaitFor("asm-folder-unsuppress"),
        Click(ui("asm-folder-unsuppress")),
        RightClick(ui("instance-folder-rods")),
        WaitFor("asm-folder-show"),
        Click(ui("asm-folder-show")),
        Wait(5),
        // A18.4: Rename (double-click).
        DoubleClick(ui("instance-folder-rods")),
        Key("Ctrl+A"),
        Type("Tie rods"),
        Key("Enter"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("11-a18.4-renamed"),
        // A18.4: Unpack (undone), Delete (undone).
        RightClick(ui("instance-folder-tie-rods")),
        WaitFor("asm-folder-unpack"),
        Click(ui("asm-folder-unpack")),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("12-a18.4-unpacked"),
        Key("Ctrl+Z"),
        RightClick(ui("instance-folder-tie-rods")),
        WaitFor("asm-folder-delete"),
        Click(ui("asm-folder-delete")),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("13-a18.4-deleted-with-contents"),
        Key("Ctrl+Z"),
        // A18.5: a mate folder.
        RightClick(ui("mate-row-7")),
        WaitFor("mate-folder"),
        Click(ui("mate-folder")),
        WaitFor("folder-name-popup"),
        Type("Rod mates"),
        Key("Enter"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("14-a18.5-mate-folder"),
        Press(ui("mate-row-8")),
        Wait(2),
        Hover(ui_at("mate-row-7", 0.5, 0.5)),
        Wait(2),
        Hover(ui("mate-folder-rod-mates")),
        Wait(5),
        Release,
        Wait(10),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("15-a18.5-mate-dragged-into-folder"),
        // A1.5: the filter.
        Click(ui("instance-filter")),
        Type("rod"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("16-a1.5-filter-rod"),
        Click(ui("instance-filter")),
        Key("Ctrl+A"),
        Type(":folder rod mates"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("17-a1.5-filter-folder"),
    ],
)
