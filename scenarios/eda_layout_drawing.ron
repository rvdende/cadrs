// Drawing on the board, on the course's finished board (GS18): 01 the top silkscreen picked as
// the drawing layer in the layers panel; 02 text, a rectangle, a circle and a run of lines on
// it; 03 a keep-out in the top-right corner (no copper pour, tracks or vias, both sides); 04 the
// ground zone refilled round it; 05 DRC still clean; 06 the VCC net highlighted (`) and the
// track width stepped (W); 07 the ruler (Ctrl+Shift+M) corner to corner.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("eda-example gs18"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        Custom("eda-zoom -5 -5 60 55"),
        Click(ui("eda-layers-toggle")),
        WaitFor("eda-layer-top-silkscreen"),
        Click(ui("eda-layer-top-silkscreen")),
        MoveTo(1100, 900),
        Screenshot("01-drawing-layer"),
        Click(ui("eda-layers-toggle")),
        // Text, a rectangle, a circle, lines.
        Click(ui("pcb-text")),
        WaitFor("eda-btext-dialog"),
        Click(ui("eda-btext-text-field")),
        Type("cadrs"),
        Click(ui("eda-btext-ok")),
        Click(flat(22.0, 46.0)),
        Click(ui("pcb-draw-rect")),
        Click(flat(2.0, 2.0)),
        Click(flat(12.0, 8.0)),
        Click(ui("pcb-draw-circle")),
        Click(flat(40.0, 44.0)),
        Click(flat(42.0, 44.0)),
        Click(ui("pcb-draw-line")),
        Click(flat(2.0, 40.0)),
        Click(flat(10.0, 40.0)),
        Click(flat(10.0, 46.0)),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1100, 900),
        Screenshot("02-drawings"),
        // A keep-out, top right.
        Click(ui("pcb-keepout")),
        WaitFor("eda-keepout-dialog"),
        Click(ui("eda-keepout-ok")),
        Click(flat(30.0, 38.0)),
        Click(flat(45.0, 38.0)),
        Click(flat(45.0, 50.0)),
        DoubleClick(flat(30.0, 50.0)),
        MoveTo(1100, 900),
        Screenshot("03-keepout"),
        Key("B"),
        MoveTo(1100, 900),
        Screenshot("04-refilled"),
        Click(ui("pcb-drc")),
        WaitFor("eda-drc-dialog"),
        Click(ui("eda-drc-run")),
        ExpectText("eda-drc-summary", "Violations (0): 0 errors, 0 warnings. Unconnected items: 0"),
        Screenshot("05-drc"),
        Click(ui("eda-drc-close")),
        // The VCC net highlighted (`), the track width stepped up (W), the ruler across the board.
        Hover(flat(37.12, 26.0)),
        Key("`"),
        Key("W"),
        MoveTo(1100, 900),
        Screenshot("06-net-and-width"),
        Key("Ctrl+Shift+M"),
        Click(flat(0.0, 0.0)),
        Click(flat(45.0, 50.0)),
        MoveTo(1100, 900),
        Screenshot("07-measure"),
        Key("Escape"),
        Key("Escape"),
    ],
)
