// Extrude → Remove through active sheet metal (P3I.5, SM1.6, SM12.1): a plate bent down at x = 80, a
// circle and a rectangle sketched on the Right plane cut through all: the holes go through the bent
// wall perpendicular to it and are part of the definition, so the flat pattern has them too.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 100 60"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(50, 30, 0)),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Custom("sketch top chain 80 -15 80 75"),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Wait(10),
        Click(xyz(80, 70, 0)),
        Wait(30),
        Click(ui("sm-bend-alignment")),
        Wait(5),
        Click(ui("sm-bend-alignment-option-3")),
        Wait(20),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Wait(30),
        Custom("sketch right circle 30 -10 5 rect 15 -18 25 -12"),
        Wait(20),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(ui("feature-sketch-3")),
        Wait(3),
        Click(ui("extrude-operation-2")),
        Wait(5),
        Click(ui("extrude-end-type")),
        Wait(5),
        Click(ui("extrude-end-type-option-5")),
        Wait(20),
        Custom("view 60 15 80 30 -10 0.08"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-cut-through-the-wall"),
        Click(ui("extrude-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-accepted"),
    ],
)
