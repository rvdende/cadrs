// M8: keyboard shortcut parity (reference/onshape/shortcuts.md). Shift+/ opens the keyboard
// shortcuts dialog (reference/onshape/shortcuts/keyboard-shortcut-dialog-03.png): tabs General |
// Part Studio | 3D view | Sketch with right-aligned keycaps, and a search box; Esc closes it.
// View keys: arrows rotate 15° (Shift 90°), Z zooms out, F zooms to fit, P hides and shows the
// planes, Shift+7 is isometric. In a sketch: G draws a rectangle, Ctrl+A selects all, Delete
// removes it and Ctrl+Z brings it back; Shift+Enter accepts and starts the next sketch.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        MoveTo(1300, 850),
        Key("Shift+/"),
        WaitFor("shortcuts-dialog"),
        Wait(3),
        Screenshot("01-shortcuts-dialog-general"),
        Click(ui("shortcuts-tab-4")),
        Wait(3),
        Screenshot("02-sketch-tab"),
        Click(ui("shortcuts-search")),
        Type("zoom"),
        Wait(3),
        Screenshot("03-search-zoom"),
        Key("Escape"),
        Wait(3),
        MoveTo(1300, 850),
        Key("ArrowRight"),
        Wait(30),
        Screenshot("04-arrow-right-rotates-15"),
        Key("Shift+ArrowUp"),
        Wait(30),
        Screenshot("05-shift-arrow-up-rotates-90"),
        Key("Shift+7"),
        Wait(30),
        Key("Z"),
        Wait(30),
        Screenshot("06-z-zooms-out"),
        Key("F"),
        Wait(30),
        Screenshot("07-f-zooms-to-fit"),
        Key("P"),
        Wait(3),
        Screenshot("08-p-hides-planes"),
        Key("P"),
        Wait(3),
        Key("Shift+S"),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        ClickWorld(-30, -20),
        ClickWorld(30, 20),
        Wait(3),
        Key("Escape"),
        Key("Escape"),
        Wait(2),
        MoveTo(1300, 850),
        Key("Ctrl+A"),
        Wait(3),
        Screenshot("09-ctrl-a-selects-all"),
        Key("Delete"),
        Wait(3),
        Screenshot("10-delete"),
        Key("Ctrl+Z"),
        Wait(3),
        Screenshot("11-ctrl-z-restores"),
        Key("Shift+Enter"),
        Wait(5),
        WaitFor("sketch-dialog"),
        Wait(3),
        Screenshot("12-shift-enter-accepts-and-starts-sketch-2"),
        Key("Escape"),
        Wait(3),
        Screenshot("13-escape-cancels-empty-sketch"),
    ],
)
