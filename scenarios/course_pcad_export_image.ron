// P3F.6 (`intro-to-parametric-cad.md` P3.7; `intro-to-parametric-cad-gaps.md`): model data
// reused as images for instructions and manuals. Export image… from a 3D tab's menu and from an
// exploded view; the files go to `target/exports/course_pcad_export_image/` (emptied first).
// 01 the Part Studio's tab menu: Export image… hovered (the Control Arm in the view).
// 02 the Export image dialog: File name, Format PNG, Size 1920 × 1080, Transparent background,
//    Folder.
// 03 Export at 1280 × 720 PNG: the toast names "Control Arm view.png (1280 × 720)".
// 04 JPEG at a custom 800 × 600: the width and height fields.
// 04b (P3F.6 judge) Transparent background disabled for JPEG, why on hover.
// 05 its toast: "Control Arm view.jpg (800 × 600)".
// 06 a transparent PNG at the viewport's size: its toast.
// 07 the Cylinder assembly (the Ex2 stand-in) with Exploded view 1 (two steps) at 100 %, the
//    Exploded views panel's Export image… hovered.
// 08 its dialog: "Cylinder assembly - Exploded view 1".
// 09 exported at 1920 × 1080: the toast.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("clear-dir target/exports/course_pcad_export_image"),
        Custom("control-arm"),
        Wait(120),
        Custom("view 25 32"),
        Wait(40),
        RightClick(ui("tab-part-studio-1")),
        WaitFor("tab-export-image"),
        Hover(ui("tab-export-image")),
        Wait(8),
        Screenshot("01-tab-menu-export-image"),
        Click(ui("tab-export-image")),
        WaitFor("export-image-dialog"),
        Wait(5),
        Click(ui("export-image-name")),
        Key("Ctrl+A"),
        Type("Control Arm view"),
        Click(ui("export-image-folder")),
        Wait(2),
        Key("Ctrl+A"),
        Type("target/exports/course_pcad_export_image"),
        Wait(3),
        Screenshot("02-export-image-dialog"),
        Click(ui("export-image-size")),
        Wait(5),
        Click(ui("export-image-size-option-1")),
        Wait(3),
        Click(ui("export-image-ok")),
        WaitFor("export-image-toast"),
        Wait(5),
        MoveTo(1420, 900),
        Screenshot("03-exported-png-1280x720"),
        RightClick(ui("tab-part-studio-1")),
        WaitFor("tab-export-image"),
        Click(ui("tab-export-image")),
        WaitFor("export-image-dialog"),
        Wait(5),
        Click(ui("export-image-name")),
        Key("Ctrl+A"),
        Type("Control Arm view"),
        Click(ui("export-image-format")),
        Wait(5),
        Click(ui("export-image-format-option-1")),
        Wait(3),
        Click(ui("export-image-size")),
        Wait(5),
        Click(ui("export-image-size-option-4")),
        Wait(3),
        Click(ui("export-image-width")),
        Key("Ctrl+A"),
        Type("800"),
        Click(ui("export-image-height")),
        Key("Ctrl+A"),
        Type("600"),
        Click(ui("export-image-folder")),
        Wait(2),
        Key("Ctrl+A"),
        Type("target/exports/course_pcad_export_image"),
        Wait(3),
        Screenshot("04-jpeg-custom-size"),
        Hover(ui("export-image-transparent")),
        Wait(40),
        Screenshot("04b-jpeg-no-transparency-why"),
        Click(ui("export-image-ok")),
        WaitFor("export-image-toast"),
        Wait(5),
        MoveTo(1420, 900),
        Screenshot("05-exported-jpeg-800x600"),
        RightClick(ui("tab-part-studio-1")),
        WaitFor("tab-export-image"),
        Click(ui("tab-export-image")),
        WaitFor("export-image-dialog"),
        Wait(5),
        Click(ui("export-image-name")),
        Key("Ctrl+A"),
        Type("Control Arm transparent"),
        Click(ui("export-image-size")),
        Wait(5),
        Click(ui("export-image-size-option-0")),
        Wait(3),
        Click(ui("export-image-transparent")),
        Click(ui("export-image-folder")),
        Wait(2),
        Key("Ctrl+A"),
        Type("target/exports/course_pcad_export_image"),
        Wait(3),
        Click(ui("export-image-ok")),
        WaitFor("export-image-toast"),
        Wait(5),
        MoveTo(1420, 900),
        Screenshot("06-exported-transparent-viewport-size"),
        // The exploded view.
        Custom("fixture pneumatic_cylinder_ex2"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        Custom("view 30 20 0 0 110 0.6"),
        Wait(20),
        Click(ui("panel-exploded-views")),
        WaitFor("exploded-views-panel"),
        Wait(5),
        Click(ui("exploded-view-add")),
