// Helix (`reference/onshape/surfacing.md` HX1–HX6) and a sweep along it: a Ø40 × 40 cylinder;
// Thicken ▾ → Helix; its face picked: Turns, 4 revolutions over the face's height, starting on
// the sketch's x axis at the sketch end, clockwise; Counterclockwise; accepted, the helix is a
// curve in the view. A Ø3 circle on Front at the helix's start is swept along it (the helix
// picked in the feature list): a coil round the cylinder (its volume against π r² × length is
// asserted in `cadrs_core/tests/surfacing.rs`, `a_helix_is_a_sweep_path`).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top circle 0 0 20"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(0, 0, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("40"),
        Key("Enter"),
        Wait(10),
        Key("F"),
        Wait(40),
        Click(ui("thicken")),
        Wait(5),
        Click(ui("surfacing-menu-helix")),
        WaitFor("helix-dialog"),
        Wait(5),
        Click(xyz(20, 0, 20)),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-helix-on-the-face-4-turns"),
        Click(ui("helix-revolutions-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("6"),
        Key("Tab"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-six-turns"),
        Click(ui("helix-dialog-accept")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted-a-curve"),
        Custom("sketch front circle 20 0 1.5"),
        Wait(10),
        Click(ui("sweep")),
        WaitFor("sweep-dialog"),
        Wait(3),
        Click(ui("feature-sketch-2")),
        Wait(3),
        Click(ui("sweep-path-field")),
        Wait(2),
        Click(ui("feature-helix-1")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-sweep-along-the-helix"),
        Click(ui("sweep-dialog-accept")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-coil"),
    ],
)
