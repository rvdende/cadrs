// Sheet metal model, Extrude (P3I.2, SM2.3): an open sketch on Front (a 40 line, a quarter arc
// of radius 10, a 30 line) picked in *Sketch curves to extrude*, 30 mm Blind, 2 mm thick: the
// lines become walls and the arc a rolled wall joined by tangent joints (the rolled K factor,
// no bend); the depth arrow drags the depth; the opposite direction arrow of Thickness puts the
// material on the other side of the curves; then the arc picked in *Arcs to extrude as bends*
// becomes a bend (its inner radius 10 − 2 from the sketch) between the two walls, as Onshape's
// `sheetmetal-extrude-02.png` dialog lays it out. Accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch front chain 0 0 40 0 arc 40 10 40 0 50 10 chain 50 10 50 40"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-1")),
        Click(xyz(20, 0, 0)),
        Click(xyz(47.0711, 0, 2.9289)),
        Click(xyz(50, 0, 25)),
        Click(ui("sm-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Custom("view 30 25 25 -15 20 0.07"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-rolled-arc"),
        Click(ui("sm-thickness-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-thickness-other-side"),
        Click(ui("sm-thickness-flip")),
        Click(ui("sm-arcs-field")),
        Click(xyz(47.0711, 0, 2.9289)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-arc-as-bend"),
        Click(ui("sheet-metal-model-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-accepted"),
    ],
)
