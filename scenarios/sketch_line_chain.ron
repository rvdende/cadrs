// M4: the Line tool (compare reference/onshape/screens/18a, 19, 19a and NOTES.md "Line tool and
// inference"). L; click–click–click chains segments, each starting where the last ended, with a
// light-blue rubber band and its live length (5 decimals) next to it; Esc ends the chain. Then a
// press–drag–release draws a single segment; a new chain is started and Esc, Esc ends it and
// leaves the tool.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("L"),
        Wait(2),
        ClickWorld(-60, 7.5),
        MoveWorld(-52.5, 45),
        Wait(2),
        Screenshot("01-first-segment-rubber-band"),
        ClickWorld(-52.5, 45),
        MoveWorld(-7.5, 63),
        Wait(2),
        Screenshot("02-chained-second-segment-angled"),
        ClickWorld(-7.5, 63),
        MoveWorld(15, 30),
        Wait(2),
        Screenshot("03-third-segment"),
        ClickWorld(15, 30),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveWorld(60, 67.5),
        Wait(2),
        Screenshot("04-esc-ends-chain-tool-stays"),
        Press(world(-60, -22.5)),
        Hover(world(-30, -30)),
        Hover(world(0, -45)),
        Wait(2),
        Screenshot("05-drag-single-segment"),
        Release,
        Wait(2),
        MoveWorld(30, -22.5),
        Wait(2),
        Screenshot("06-drag-committed-no-chain"),
        ClickWorld(0, -45),
        MoveWorld(37.5, -60),
        Wait(2),
        Screenshot("07-new-chain-from-endpoint"),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("08-esc-esc-leaves-tool"),
    ],
)
