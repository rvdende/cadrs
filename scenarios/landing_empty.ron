// M1: the documents page with a fresh, empty data dir; hover and open the Create menu.
// P3E.1: Create ▸ Import files… opens the file picker (STEP and STL files) (06).
Scenario(
    start: Some("landing"),
    steps: [
        Screenshot("01-empty"),
        Hover(ui("create")),
        Wait(2),
        Screenshot("02-create-hover"),
        Click(ui("create")),
        WaitFor("create-menu"),
        Hover(ui("new-document")),
        Wait(2),
        Screenshot("03-create-menu"),
        Key("Escape"),
        Hover(ui("filter-trash")),
        Wait(2),
        Screenshot("04-filter-hover"),
        Click(ui("filter-trash")),
        Wait(2),
        Screenshot("05-trash-empty"),
        Click(ui("create")),
        WaitFor("import-files"),
        // P3F.2: Import files… opens the file picker (STEP and IGES); a stable folder is typed.
        Click(ui("import-files")),
        WaitFor("import-picker"),
        Wait(3),
        Click(ui("import-picker-folder")),
        Wait(2),
        Key("Ctrl+A"),
        Type("crates"),
        Key("Enter"),
        WaitFor("import-picker-row-cadrs_core"),
        Wait(3),
        Screenshot("06-import-picker"),
    ],
)
