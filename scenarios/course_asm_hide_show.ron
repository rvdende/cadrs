// P3B.1 / A4.1–A4.6, X10 (Y, Shift+Y), X11, X15: hiding and showing instances, on three
// instances of the Ex1 stand-in (`fixtures/motor_mount_standin.cadrs`): <1> at its studio
// position, <2> right, <3> left.
// 01 the eye shows on the hovered row; 02 clicked: <2> hidden (row greyed, crossed eye).
// 03 right-click <1> → Hide other instances (04: only <1> left).
// 05 right-click empty space: Show all, Show all instances, Paste, Create Drawing, Check
//    interference, Zoom to fit, Isometric; 06 Show all instances.
// 07 right-click <3> → Isolate…: only <3>, "Exit isolate"; 08 (after Exit isolate) Make
//    transparent… on <1>.
// 09 Y with the pointer over <2> hides it; 10 Y over <3> too; 11 Shift+Y shows every hidden
//    instance.
// 12 <3> hidden with its eye and added to the selection in the list (<1> stays selected from
//    08: "2 items") → right-click → Show (13).
// 14 right-click <2> → Switch to Motor Mount: the Part Studio, its part highlighted (15).
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture motor_mount_standin"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Key("Shift+7"),
        Wait(10),
        Scroll(at(900, 520), -3),
        Wait(20),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(3),
        Click(ui("insert-part-dc-motor-mount-stand-in")),
        Wait(2),
        Click(ui("insert-part-dc-motor-mount-stand-in")),
        Wait(2),
        Click(world(160, 40)),
        Wait(2),
        Click(world(-150, 20)),
        Wait(2),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        Key("F"),
        Wait(30),
        // A4.1: the eye.
        Hover(ui("instance-row-2")),
        Wait(3),
        Screenshot("01-eye-on-hover"),
        Click(ui("instance-row-2-eye")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("02-eye-hid-2"),
        // A4.2: Hide other instances.
        RightClick(ui("instance-row-1")),
        WaitFor("asm-hide-others"),
        Hover(ui("asm-hide-others")),
        Wait(3),
        Screenshot("03-menu-hide-other"),
        Click(ui("asm-hide-others")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("04-hid-others"),
        // A4.3: empty space → Show all instances.
        RightClick(at(1350, 250)),
        WaitFor("asm-show-all-instances"),
        Hover(ui("asm-show-all-instances")),
        Wait(3),
        Screenshot("05-empty-space-menu"),
        Click(ui("asm-show-all-instances")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("06-all-shown"),
        // A4.2: Isolate, then Make transparent.
        RightClick(ui("instance-row-3")),
        WaitFor("asm-isolate"),
        Click(ui("asm-isolate")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("07-isolated-3"),
        Click(ui("exit-isolate")),
        Wait(5),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-transparent"),
        Click(ui("asm-transparent")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("08-transparent-1"),
        // A4.5: Y hides the instance under the pointer, Shift+Y shows.
        Hover(xyz(160, 20, 12.7)),
        Wait(10),
        Key("Y"),
        Wait(5),
        Screenshot("09-y-hid-2"),
        Hover(xyz(-150, 0, 12.7)),
        Wait(10),
        Key("Y"),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("10-y-hid-3"),
        Key("Shift+Y"),
        Wait(5),
        Screenshot("11-shift-y-shows-all"),
        // A4.4: select a hidden row → Show.
        Hover(ui("instance-row-3")),
        Wait(3),
        Click(ui("instance-row-3-eye")),
        Wait(3),
        Click(ui("instance-row-3")),
        Wait(3),
        RightClick(ui("instance-row-3")),
        WaitFor("asm-show"),
        Hover(ui("asm-show")),
        Wait(3),
        Screenshot("12-hidden-row-show"),
        Click(ui("asm-show")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("13-shown"),
        // A4.6: Switch to the Part Studio.
        RightClick(ui("instance-row-2")),
        WaitFor("asm-switch-to"),
        Hover(ui("asm-switch-to")),
        Wait(3),
        Screenshot("14-switch-to-menu"),
        Click(ui("asm-switch-to")),
        Wait(10),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("15-switched-part-highlighted"),
    ],
)
