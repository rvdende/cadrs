// P3G.5 ex-dv2 (derived-and-linking.md ex-dv2, DV1.3, DV1.4, DV3.4): edit the source A; B stays
// unchanged and shows the update indicator; Update brings the new volume. Continues ex-dv1 on
// the same stand-ins (`linked-ex dv1` makes ex-dv1's Derived 1 in B: A's V1 at the origin and at
// Mate connector 1).
// 01 B: Derived 1, two copies, 75 000 mm³.
// 02 A "Block source" opened (the documents page's Open, `move-doc open`): Extrude 1 edited,
//    depth 25 → 40.
// 03 ✓: the block 40 high in A's workspace.
// 04 the top bar's Create version: "Create version from Main", name V2.
// 05 back in B: Derived 1 and the tab show the blue update badge; the geometry and the mass are
//    unchanged (75 000 mm³).
// 06 the badge's tooltip "V2 is available. Click to update."
// 07 the badge clicked: the Reference manager, Block source "V1 ⇒ V2", Update all.
// 08 Update all: per copy 50·30·40 = 60 000: 120 000 mm³, 2 × 9 400 = 18 800 mm², centroid
//    (25, 15, 70) (the copies at z 20 and 120); the badge gone.
// 09 Ctrl+Z: 75 000 mm³ again (V1), the badge back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(20),
        Custom("linked-fixture store linked_block_standin folder"),
        Wait(5),
        Custom("linked-fixture open linked_block_host_standin"),
        WaitFor("document-shell"),
        Wait(40),
        Custom("linked-ex dv1"),
        Wait(90),
        Key("F"),
        Wait(30),
        Click(ui("part-row-part-1")),
        Wait(3),
        Click(ui("part-row-part-1--2")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(10),
        ExpectText("mass-dialog", "75000.000"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("01-b-two-copies-75000"),
        Click(ui("mass-dialog-cancel")),
        Wait(5),
        Key("Space"),
        Wait(3),
        Custom("move-doc open Block source"),
        WaitFor("document-shell"),
        Wait(60),
        Key("F"),
        Wait(30),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog-title"),
        Wait(10),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("40"),
        Key("Tab"),
        Wait(30),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-a-extrude-depth-40"),
        Click(ui("extrude-dialog-accept")),
        Wait(40),
        Key("F"),
        Wait(30),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("03-a-edited"),
        Click(ui("document-create-version")),
        WaitFor("create-version-dialog"),
        Wait(10),
        Screenshot("04-create-version-v2"),
        Click(ui("create-version-create")),
        Wait(30),
        Custom("move-doc open Block derived"),
        WaitFor("document-shell"),
        Wait(90),
        Key("F"),
        Wait(30),
        Click(ui("part-row-part-1")),
        Wait(3),
        Click(ui("part-row-part-1--2")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(10),
        ExpectText("mass-dialog", "75000.000"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("05-b-badge-unchanged"),
        Click(ui("mass-dialog-cancel")),
        Wait(5),
        Key("Space"),
        Wait(3),
        Hover(ui("feature-derived-1-linked")),
        Wait(50),
        Screenshot("06-badge-tooltip"),
        Click(ui("feature-derived-1-linked")),
        WaitFor("reference-manager"),
        Wait(15),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("07-reference-manager"),
        Click(ui("refman-update")),
        Wait(90),
        Key("F"),
        Wait(30),
        Click(ui("part-row-part-1")),
        Wait(3),
        Click(ui("part-row-part-1--2")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(10),
        ExpectText("mass-dialog", "120000.000"),
        ExpectText("mass-dialog", "18800.000"),
        ExpectText("mass-dialog", "70.000"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("08-updated-120000"),
        Click(ui("mass-dialog-cancel")),
        Wait(5),
        Key("Space"),
        Wait(3),
        Key("Ctrl+Z"),
        Wait(90),
        Click(ui("part-row-part-1")),
        Wait(3),
        Click(ui("part-row-part-1--2")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(10),
        ExpectText("mass-dialog", "75000.000"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("09-undo-75000"),
    ],
)
