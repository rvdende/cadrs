// Wire colours and a capacitor's footprint (points are sheet millimetres, Y up): 01 a capacitor
// with an L of wire, double-clicked: the wire dialog (the run's 2 wires); 02 orange: both legs
// change together; 03 the capacitor double-clicked, Choose… beside Footprint: the footprint
// browser narrowed to its C_* filters, 0805 picked; 04 back in the dialog with the footprint
// filled in; 05 OK: the field set (shown in the BOM-relevant Footprint field).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-add-board")),
        WaitFor("pcb-name-edit"),
        Key("Ctrl+A"),
        Type("Colours"),
        Key("Enter"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        Custom("eda-zoom 88.9 93.98 124.46 119.38"),
        MoveTo(900, 500),
        Key("A"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("capacitor"),
        WaitFor("eda-chooser-device-c"),
        Click(ui("eda-chooser-device-c")),
        Click(ui("eda-chooser-ok")),
        Click(flat(101.6, 101.6)),
        Key("W"),
        Click(flat(101.6, 105.41)),
        Click(flat(101.6, 110.49)),
        Click(flat(111.76, 110.49)),
        DoubleClick(flat(111.76, 110.49)),
        Key("Escape"),
        DoubleClick(flat(106.68, 110.49)),
        WaitFor("eda-wire-dialog"),
        Screenshot("01-wire-dialog"),
        Click(ui("eda-wire-swatch-5")),
        Click(ui("eda-wire-ok")),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("02-run-coloured"),
        DoubleClick(flat(101.6, 101.6)),
        WaitFor("eda-props-dialog"),
        Click(ui("eda-props-footprint-choose")),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("0805"),
        Wait(2),
        WaitFor("eda-chooser-capacitor-smd-c-0805-2012metric"),
        Click(ui("eda-chooser-capacitor-smd-c-0805-2012metric")),
        Wait(2),
        Screenshot("03-footprint-browser"),
        Click(ui("eda-chooser-ok")),
        Wait(1),
        Screenshot("04-footprint-filled"),
        Click(ui("eda-props-ok")),
        Key("E"),
        Wait(1),
        Key("Escape"),
        MoveTo(1100, 900),
        Screenshot("05-done"),
    ],
)
