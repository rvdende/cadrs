// Corner break (P3I.5, SM11): the plate's back right corner edge (through the thickness) picked;
// Fillet, Radius 10 (Distance control); then the Chamfer tab, Equal distance 8; accepted. The corner
// break is in the definition, so the flat shows it, and the model's joints lock in the table.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 100 60"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(50, 30, 0)),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-corner-break")),
        WaitFor("sheet-metal-corner-break-dialog"),
        Wait(10),
        Click(xyz(100, 60, 1)),
        Wait(20),
        Click(ui("sm-corner-break-size-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        Wait(30),
        Custom("view 30 30 90 55 0 0.05"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-fillet-r10"),
        Click(ui("sm-corner-break-type-1")),
        Wait(30),
        Click(ui("sm-corner-break-distance-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-chamfer-8"),
        Click(ui("sheet-metal-corner-break-dialog-accept")),
        Wait(30),
        Custom("view 30 30 50 30 0 0.11"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
    ],
)
