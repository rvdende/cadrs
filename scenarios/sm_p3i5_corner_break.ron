// Corner break (P3I.5, SM11): the plate's back right corner edge (through the thickness) picked;
// Fillet, Radius 10 (Distance control); Asymmetric 10 / 4 (01b); Allow edge overflow with radius 70
// (01c, past the 60 edge); then the Chamfer tab, Equal distance 8; accepted. The corner
// break is in the definition, so the flat shows it, and the model's joints lock in the table.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(xyz(50, 30, 0)),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-corner-break")),
        WaitFor("sheet-metal-corner-break-dialog"),
        Click(xyz(100, 60, 1)),
        Click(ui("sm-corner-break-size-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        Custom("view 30 30 90 55 0 0.05"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-fillet-r10"),
        // Asymmetric: second radius 4 (a quarter ellipse, 10 along the right edge, 4 along the top).
        Click(ui("smt-asymmetric-checkbox")),
        Click(ui("sm-corner-break-size2-field")),
        Key("Ctrl+A"),
        Type("4"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01b-asymmetric-10-4"),
        // Allow edge overflow with a radius of 70 (longer than the 60 edge): the round runs on
        // past the corner at (100, 0).
        Click(ui("smt-asymmetric-checkbox")),
        Click(ui("smt-allow-overflow-checkbox")),
        Click(ui("sm-corner-break-size-field")),
        Key("Ctrl+A"),
        Type("70"),
        Key("Tab"),
        Custom("view 30 60 60 30 0 0.11"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01c-overflow-r70"),
        Custom("view 30 30 90 55 0 0.05"),
        Click(ui("sm-corner-break-type-1")),
        Click(ui("sm-corner-break-distance-field")),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-chamfer-8"),
        Click(ui("sheet-metal-corner-break-dialog-accept")),
        Custom("view 30 30 50 30 0 0.11"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
    ],
)
