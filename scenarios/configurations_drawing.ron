// Configurations in drawings (`drawing::view_config`, the Insert view card's Configuration), on
// the 60 × 40 plate with a Ø16 hole of `with-hole`: Extrude 1's depth configured, Default 10 mm
// and Thick 20 mm; the Part Studio shows Default.
// 01 Create Drawing → ANSI_A_INCH; the part picked in Insert view: under the reference, the
//    Configuration (Default, the studio's).
// 02 Thick picked: the view following the cursor is 20 mm thick.
// 03 placed (Esc ends Projected view): the sheet's Thick view; the Part Studio still shows Default.
// 04 the view's menu ▸ Configuration ▸ Configuration: Default and Thick (✓).
// 05 Default picked: the view is 10 mm thick.
// 06 Ctrl+Z: Thick again.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("with-hole"),
        RightClick(ui("feature-extrude-1")),
        WaitFor("feature-context-menu"),
        Hover(ui("feature-configure")),
        Wait(10),
        Click(ui("feature-configure-0")),
        WaitFor("configuration-panel"),
        Click(ui("configuration-input-1-add-row")),
        WaitFor("configuration-name"),
        Key("Ctrl+A"),
        Type("Thick"),
        Key("Enter"),
        Click(ui("configuration-input-1-row-2-cell-1")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Wait(3),
        Click(ui("insert-tab")),
        Click(ui("create-drawing")),
        WaitFor("create-drawing-dialog"),
        Click(ui("template-filter-1")),
        Click(ui("template-row-ANSI_A_INCH.dwt")),
        Click(ui("create-drawing-ok")),
        WaitFor("insert-view-dialog"),
        Click(ui("browser-part-1-1")),
        WaitFor("insert-view-configuration"),
        MoveTo(900, 600),
        Wait(5),
        Screenshot("01-insert-view-configuration"),
        Click(ui("insert-view-config-0")),
        Click(ui("insert-view-config-0-option-1")),
        MoveTo(620, 552),
        Wait(20),
        MoveTo(623, 552),
        Wait(10),
        Screenshot("02-thick-following-cursor"),
        Click(at(623, 552)),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(10),
        Screenshot("03-thick-placed"),
        RightClick(at(623, 552)),
        WaitFor("view-context-menu"),
        Hover(ui("view-config")),
        Wait(10),
        Hover(ui("view-config-0")),
        Wait(10),
        Screenshot("04-view-configuration-menu"),
        Click(ui("view-config-0-0")),
        MoveTo(1500, 960),
        Wait(10),
        Screenshot("05-default"),
        Key("Ctrl+Z"),
        Wait(10),
        Screenshot("06-undone-thick"),
    ],
)
