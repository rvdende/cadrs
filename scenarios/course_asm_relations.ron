        Key("Ctrl+A"),
        Type("2"),
        Key("Enter"),
        Wait(5),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("03-a1.4-gear-dialog"),
        AssertEnabled("relation-dialog-accept"),
        Click(ui("relation-dialog-accept")),
        Wait(8),
        Hover(ui("mate-row-8")),
        Wait(40),
