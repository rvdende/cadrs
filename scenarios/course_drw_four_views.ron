// P3C.2 / X2, D1.3, D1.5, D4.5, D4.7: the "Four views" template option on a part.
// 01 The bracket's Part Studio tab menu → "Create Drawing of Part Studio 1…": the dialog with
//    ISO_A3_MM.dwt (first angle) picked and the Four views option chosen (available because the
//    drawing references the studio).
// 02 OK: the drawing opens with four views placed above the title block at the largest common
//    scale that fits (1:1 here): Front top left, Top below it and Left to its right (first angle:
//    each view on the side opposite where it is seen from, P6.2), and a shaded Isometric view in
//    the free corner; the title block shows the scale and the first-angle symbol. Insert view
//    does not start (the views are there).
// 03 Ctrl+S: Sheet1 → Part Studio 1 → Front → Top, Left, Isometric.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("drawing-bracket"),
        RightClick(ui("tab-part-studio-1")),
        Click(ui("tab-create-drawing")),
        WaitFor("create-drawing-dialog"),
        Click(ui("template-filter-2")),
        Click(ui("template-row-ISO_A3_MM.dwt")),
        Click(ui("template-option-four-views")),
        MoveTo(1400, 950),
        Wait(3),
        Screenshot("01-create-drawing-four-views"),
        Click(ui("create-drawing-ok")),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("02-four-views-first-angle"),
        Key("Ctrl+S"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("03-sheets-flyout"),
    ],
)
