// P3B.6 / A20.6, A20.7, A20.11, TD9: BOM templates, Copy table, Export to CSV, Generate missing
// part numbers and the Properties dialog (intro-to-assemblies.md A20, test-drive.md TD9), on the
// Ex3 end state (`fixtures/pneumatic_cylinder_ex3.cadrs`).
// 01 (A20.6) a layout: Vendor added, Material removed.
// 02 (A20.7) overflow → Save as template…: the name popup ("Purchasing"); 03 saved.
// 04 the layout changed again (Vendor removed, Material back); 05 Apply template: the saved
//    template; 06 applied: Vendor back, Material gone.
// 07 (A20.7) overflow → Copy table (tab-separated, on the clipboard); 08 Export to CSV: the file
//    written (`exports/Cylinder assembly BOM.csv` next to the screenshots).
// 09 (A20.11) the Part number header's menu → Generate missing part numbers; 10 PRT-000001 … in
//    BOM order, the fasteners keep their library numbers.
// 11 (TD9.5) the Barrel's Properties: its generated Part number; Add property "Cost" (Number);
//    12 the new field filled; 13 Add column → Cost: 42.50 in the BOM.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture pneumatic_cylinder_ex3"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        Click(ui("panel-bom")),
        Wait(10),
        Key("F"),
        Wait(30),
        // A20.6: Vendor added, Material removed.
        Click(ui("bom-add-column")),
        Wait(5),
        Click(ui("bom-add-col-7")),
        Wait(8),
        // The panel widened (drag its left edge) so the new column is in view.
        Drag(ui("bom-panel-resize"), at(640, 400)),
        Wait(5),
        RightClick(ui("bom-header-col-5")),
        Wait(5),
        Click(ui("bom-remove-column")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("01-a20.6-layout-vendor"),
        // A20.7: Save as template.
        Click(ui("bom-overflow")),
        Wait(5),
        Click(ui("bom-save-template")),
        WaitFor("bom-template-name"),
        Wait(3),
        Type("Purchasing"),
        Wait(3),
        Screenshot("02-a20.7-save-as-template"),
        Key("Enter"),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("03-a20.7-template-saved"),
        // The layout changed: Vendor removed, Material back.
        RightClick(ui("bom-header-col-5")),
        Wait(5),
        Click(ui("bom-remove-column")),
        Wait(8),
        Click(ui("bom-add-column")),
        Wait(5),
        Click(ui("bom-add-col-5")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("04-layout-changed"),
        // Apply template.
        Click(ui("bom-apply-template")),
        Wait(5),
        Screenshot("05-a20.7-apply-template-menu"),
        Click(ui("bom-template-0")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("06-a20.7-template-applied"),
        // Copy table, Export to CSV.
        Click(ui("bom-overflow")),
        Wait(5),
        Click(ui("bom-copy")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("07-a20.7-copy-table"),
        Click(ui("bom-overflow")),
        Wait(5),
        Click(ui("bom-export-csv")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("08-a20.7-export-csv"),
        // A20.11: Generate missing part numbers.
        RightClick(ui("bom-header-col-2")),
        Wait(5),
        Screenshot("09-a20.11-part-number-menu"),
        Click(ui("bom-generate-numbers")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("10-a20.11-part-numbers-generated"),
        // TD9.5: the Barrel's Properties; a custom property.
        RightClick(ui("instance-row-2")),
        WaitFor("asm-properties"),
        Click(ui("asm-properties")),
        WaitFor("properties-dialog"),
        Wait(5),
        Click(ui("props-new-name")),
        Wait(3),
        Type("Cost"),
        Click(ui("props-new-kind")),
        Wait(3),
        Click(ui("props-new-kind-option-1")),
        Wait(3),
        Screenshot("11-td9.5-properties-add-cost"),
        Click(ui("props-new-add")),
        Wait(8),
        Click(ui("props-custom-1")),
        Wait(3),
        Type("42.50"),
        Wait(3),
        Screenshot("12-td9.5-cost-filled"),
        Click(ui("props-save")),
        Wait(8),
        Click(ui("bom-add-column")),
        Wait(5),
        Click(ui("bom-add-col-12")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("13-cost-column"),
    ],
)
