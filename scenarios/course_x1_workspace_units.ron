// T2 / X1: "A Workspace units setting (the exercises require mm)." A 50 × 30 rectangle in a new
// document (millimetres, the default). Document menu (☰) → Workspace units…: Length units
// Millimeter → Inch, OK. Editing the sketch shows its dimensions in inches (1.969, 1.181); the
// width's edit box opens with "1.9685 in", and a bare 2 is read as 2 in (50.8 mm). The region's
// area reads in square inches. The units are saved with the document and the change is one
// undo step: Ctrl+Z (after the sketch edit's) brings millimetres back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0.3, 0.3),
        ClickWorld(47, 28),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-millimetres-by-default"),
        Key("Enter"),
        Wait(5),
        Click(ui("document-menu")),
        WaitFor("document-menu-popup"),
        Wait(3),
        Hover(ui("document-menu-units")),
        Wait(3),
        Screenshot("02-document-menu-workspace-units"),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        Wait(10),
        Screenshot("03-units-dialog-millimeter"),
        Click(ui("units-length")),
        WaitFor("units-length-menu"),
        Wait(3),
        Hover(ui("units-length-option-3")),
        Wait(3),
        Screenshot("04-length-units-menu"),
        Click(ui("units-length-option-3")),
        Wait(3),
        Screenshot("05-inch-chosen"),
        Click(ui("units-ok")),
        Wait(5),
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Wait(5),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-dimensions-in-inches"),
        DoubleClick(world(25, -8.1)),
        WaitFor("dimension-edit"),
        Wait(3),
        Screenshot("07-edit-box-in-inches"),
        Type("2"),
        Key("Enter"),
        Wait(5),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("08-bare-2-is-2-inches"),
        Click(world(20, 15)),
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("09-area-in-square-inches"),
        Key("Enter"),
        Wait(5),
        Key("Ctrl+Z"),
        Wait(3),
        Key("Ctrl+Z"),
        Wait(3),
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Wait(5),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("10-undo-back-to-millimetres"),
    ],
)
