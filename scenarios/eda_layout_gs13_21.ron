// The Getting Started course's board (docs/PLAN.md GS13–GS21) laid out in cadrs, from the
// finished schematic (`eda-example gs11`). Points are board millimetres (`flat(x, y)`).
// 01 Board setup (Default class tracks 0.4 mm); 02 Update PCB from schematic: the change log;
// 03 the footprints with the ratsnest; 04 the 45 × 50 mm outline; 05 BT1 flipped to the back,
// D1 and R1 placed; 06 routed (led on the front, GND on the back, VCC through a via);
// 07 the GND zone on the back, filled; 08 DRC clean; 09 the Plot dialog after plotting and
// generating the drill files; 10 the board in 3D.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("eda-example gs11"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        Custom("eda-zoom -5 -5 60 55"),
        // GS13.
        Click(ui("pcb-board-setup")),
        WaitFor("eda-setup-dialog"),
        Click(ui("eda-setup-track-field")),
        Key("Ctrl+A"),
        Type("0.4"),
        Screenshot("01-board-setup"),
        Click(ui("eda-setup-ok")),
        // GS14.
        MoveTo(1100, 860),
        Key("F8"),
        WaitFor("eda-update-dialog"),
        Click(ui("eda-update-run")),
        Wait(2),
        Screenshot("02-update-pcb"),
        Click(ui("eda-update-close")),
        Custom("eda-zoom -5 -5 95 55"),
        MoveTo(1100, 860),
        Screenshot("03-footprints-and-ratsnest"),
        // GS15.
        Click(ui("pcb-outline")),
        Click(flat(0.0, 0.0)),
        Click(flat(45.0, 50.0)),
        Custom("eda-zoom -5 -5 60 55"),
        MoveTo(1100, 860),
        Screenshot("04-outline"),
        // GS16: BT1 to the back, D1 and R1 below it.
        Hover(flat(44.77, 25.0)),
        Key("M"),
        Click(flat(22.5, 32.0)),
        Key("F"),
        Hover(flat(67.04, 25.0)),
        Key("M"),
        Click(flat(8.0, 14.0)),
        Key("R"),
        Key("R"),
        Key("R"),
        Hover(flat(79.44, 25.0)),
        Key("M"),
        Click(flat(37.0, 11.5)),
        Key("R"),
        Key("R"),
        Key("Escape"),
        MoveTo(1100, 860),
        Screenshot("05-placed"),
        // GS17.
        Hover(flat(8.0, 11.46)),
        Key("X"),
        Click(flat(24.3, 11.5)),
        Hover(flat(7.77, 32.0)),
        Key("X"),
        Click(flat(8.0, 14.0)),
        Hover(flat(37.23, 32.0)),
        Key("X"),
        Click(flat(37.0, 20.0)),
        Key("V"),
        Click(flat(37.0, 11.5)),
        MoveTo(1100, 860),
        Screenshot("06-routed"),
        // GS18.
        Key("PageDown"),
        Click(ui("pcb-zone")),
        WaitFor("eda-zone-dialog"),
        Click(ui("eda-zone-ok")),
        Click(flat(0.0, 0.0)),
        Click(flat(45.0, 0.0)),
        Click(flat(45.0, 50.0)),
        DoubleClick(flat(0.0, 50.0)),
        Key("B"),
        MoveTo(1100, 860),
        Screenshot("07-zone-filled"),
        // GS19.
        Click(ui("pcb-drc")),
        WaitFor("eda-drc-dialog"),
        Click(ui("eda-drc-run")),
        ExpectText("eda-drc-summary", "Violations (0): 0 errors, 0 warnings. Unconnected items: 0"),
        Screenshot("08-drc-clean"),
        Click(ui("eda-drc-close")),
        // GS21.
        Click(ui("pcb-plot")),
        WaitFor("eda-plot-dialog"),
        Click(ui("eda-plot-dir-field")),
        Key("Ctrl+A"),
        Type("target/scenarios/eda_layout_gs13_21/fab/"),
        Click(ui("eda-plot-run")),
        Click(ui("eda-plot-drill")),
        Screenshot("09-plotted"),
        Click(ui("eda-plot-close")),
        // GS20.
        Click(ui("eda-mode-3d")),
        Key("F"),
        MoveTo(1100, 860),
        Screenshot("10-3d"),
    ],
)
