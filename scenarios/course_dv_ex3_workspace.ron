// P3G.5 ex-dv3 (derived-and-linking.md ex-dv3, DV1.1, DV1.11, DV3.4): in the same document,
// derive at the workspace; a source edit shows up at once. Stand-in: A "Block source"
// (`fixtures/linked_block_standin.cadrs`: Sketch 1 fully defined with the 50 length and 30
// width dimensions).
// 01 A's Block: the 50 × 30 × 25 block.
// 02 + → Create Part Studio: "Part Studio 1"; the icon rail's Insert: Derived 1's dialog on
//    Current document: this document ("Main") and its Part Studio "Block" (follows the tab).
// 03 Block picked: the source card "Block · Block source · Main"; the block copied in place.
// 04 ✓: Derived 1 with no link icon (a workspace reference has no version to update); mass
//    37 500 mm³.
// 05 Block tab, Sketch 1 edited: the length dimension 50 → 60.
// 06 ✓: A's block 60 long, in the view it opened with (01).
// 07 Part Studio 1 again: Derived 1 follows at once, 60·30·25 = 45 000 mm³ (the self-check),
//    with no badge and nothing to update.
// 08 Ctrl+Z (the sketch edit undone; undo shows the Block tab it changed), then Part Studio 1:
//    Derived 1's part back at 37 500 mm³.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("linked-fixture open linked_block_standin"),
        WaitFor("document-shell"),
        Key("F"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("01-a-block"),
        Click(ui("insert-tab")),
        Click(ui("create-part-studio")),
        Click(ui("rail-insert")),
        WaitFor("derived-dialog"),
        Hover(ui("derived-studio-block")),
        Wait(10),
        MoveTo(255, 191),
        Wait(3),
        Screenshot("02-current-document"),
        Click(ui("derived-studio-block")),
        Key("F"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("03-block-picked"),
        Click(ui("derived-dialog-accept")),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "37500.000"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("04-derived-workspace"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        Click(ui("tab-block")),
        Wait(40),
        DoubleClick(ui("feature-sketch-1")),
        Key("N"),
        Wait(30),
        DoubleClick(ui("dim-label-50")),
        Type("60"),
        Key("Enter"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("05-length-60"),
        Click(ui("sketch-dialog-accept")),
        Custom("view 30 30"),
        Key("F"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("06-a-edited"),
        Click(ui("tab-part-studio-1")),
        Key("F"),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "45000.000"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("07-follows-45000"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        Key("Ctrl+Z"),
        Click(ui("tab-part-studio-1")),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "37500.000"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("08-undo-37500"),
    ],
)
