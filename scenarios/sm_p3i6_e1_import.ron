// P3I.6 (exercise E1, `ex1-importing-dxf-bend/step-02.png` … `step-05.png`): Sketch on Top, the
// sketch toolbar's Insert DXF or DWG opens "Insert a DXF or DWG file" (the import folder's DXF and
// DWG files with their thumbnails, Units Millimeter, Use file origin position); a click on
// flat_pattern_e1.dxf (the stand-in tray's flat pattern, our own export) inserts its outline, cut-outs
// and bend lines into Sketch 1, closing 7 sheet regions. Accepted, then Sheet metal model ›
// Thicken of the 7 regions, 1 mm, with step 5's Minimal gap 0.025, Corner relief Closed and Bend
// relief Tear: a flat sheet with the cut-outs (step 5).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch-dxf-dir fixtures/sheetmetal"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(5),
        Click(ui("sketch-dxf")),
        WaitFor("sketch-dxf-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-insert-dxf-dialog"),
        Click(ui("sketch-dxf-file-flat_pattern_e1.dxf")),
        Wait(30),
        Key("F"),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-imported"),
        Click(ui("sketch-dialog-accept")),
        Wait(20),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(40, 60, 0)),
        Wait(3),
        Click(xyz(20, -23, 0)),
        Wait(3),
        Click(xyz(100, -53, 0)),
        Wait(3),
        Click(xyz(20, 145, 0)),
        Wait(3),
        Click(xyz(100, 173, 0)),
        Wait(3),
        Click(xyz(206, 60, 0)),
        Wait(3),
        Click(xyz(-6, 60, 0)),
        Wait(40),
        // Step 5's relief: Minimal gap 0.025 mm, Corner relief Closed, Bend relief Tear.
        Click(ui("sm-minimal-gap-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("0.025"),
        Key("Tab"),
        Wait(10),
        Click(ui("sm-corner-relief-type")),
        Wait(5),
        Click(ui("sm-corner-relief-type-option-4")),
        Wait(20),
        Click(ui("sm-bend-relief-type")),
        Wait(5),
        Click(ui("sm-bend-relief-type-option-2")),
        Wait(30),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-thicken-seven-regions"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-accepted"),
    ],
)
