// T4 / S17.1: "Trim: click an entity to cut it back to the nearest intersections. If there is
// no intersection, the entity is deleted. Ctrl+Z undoes." (M, Trim ▾;
// `reference/onshape/edit_tools/trim-points-03.png`). A horizontal line crossed by two
// verticals, a circle crossed by both verticals, and a lone line. With Trim (M), hovering the
// horizontal line between the verticals shows that piece in the hover tan with dots at the
// crossings; clicking removes it (the two outer pieces stay, their new ends on the verticals).
// Clicking the lone line deletes it. Hovering the circle's bottom shows the arc between the
// crossings; clicking leaves the top arc (a circle trimmed between two crossings becomes an
// arc). Ctrl+Z brings the circle back. A lone sketch point (Shift+S) trims away too: hovering
// it shows it in the hover tan, clicking deletes it (`edit_tools/trim-points-02.png`).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(-60, 0),
        ClickWorld(60, 0),
        Key("Escape"),
        ClickWorld(-20, -30),
        ClickWorld(-20, 40),
        Key("Escape"),
        ClickWorld(20, -30),
        ClickWorld(20, 40),
        Key("Escape"),
        ClickWorld(30, -45),
        ClickWorld(60, -45),
        Key("Escape"),
        Key("Escape"),
        Key("C"),
        ClickWorld(0, 40),
        ClickWorld(0, 65),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-geometry"),
        Key("M"),
        MoveWorld(4, 0),
        Wait(3),
        Screenshot("02-hover-shows-piece-to-remove"),
        ClickWorld(4, 0),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-trimmed-between-crossings"),
        ClickWorld(45, -45),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-lone-line-deleted"),
        MoveWorld(0, 15),
        Wait(3),
        Screenshot("05-hover-circle-bottom"),
        ClickWorld(0, 15),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-circle-became-arc"),
        Key("Ctrl+Z"),
        Screenshot("07-undo-restores-circle"),
        Key("Shift+S"),
        ClickWorld(-52, -58),
        Key("M"),
        MoveWorld(-51, -58),
        Wait(3),
        Screenshot("08-hover-lone-point"),
        ClickWorld(-51, -58),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("09-lone-point-trimmed"),
    ],
)
