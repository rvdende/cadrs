// Hem (P3I.4, SM4; `help/feature-tools/shmetal-hem-dialog.png`, `hem-*.png`): on a 60 × 40 × 2
// plate (Thicken, bend radius 1): the empty dialog as Onshape's (Straight, Flattened, Total
// length 12.5 mm, Outer, Simple); the east edge picked: a flattened straight hem lying the
// minimal gap over the plate; Rolled (inner radius 1, 270 deg); Tear drop (minimal gap); In
// place; Straight with an inner radius; the dialog's flip arrow, then the arrow in the view
// flipping it back; accepted. A second hem changed and cancelled isn't remembered: the next one
// starts from the accepted hem's values (SM4.5), not flipped.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 60 40"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(30, 20, 0)),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(10),
        Click(ui("sheet-metal-menu-hem")),
        WaitFor("sheet-metal-hem-dialog"),
        Wait(10),
        Custom("view 20 10 55 20 4 0.05"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-hem-dialog"),
        Click(xyz(60, 20, 2)),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-straight-flattened"),
        Click(ui("smf-hem-type")),
        Wait(5),
        Click(ui("smf-hem-type-option-1")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-rolled"),
        Click(ui("smf-hem-type")),
        Wait(5),
        Click(ui("smf-hem-type-option-2")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-tear-drop"),
        Click(ui("smf-hem-alignment")),
        Wait(5),
        Click(ui("smf-hem-alignment-option-1")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-tear-drop-in-place"),
        Click(ui("smf-hem-type")),
        Wait(5),
        Click(ui("smf-hem-type-option-0")),
        Wait(10),
        Click(ui("smf-flattened-checkbox")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-straight-inner-radius"),
        Click(ui("smf-hem-type-flip")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-flipped"),
        // The arrow in the view flips it back (one command, like the dialog's arrow).
        Click(ui("smf-hem-flip-arrow")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07b-flipped-back-by-the-view-arrow"),
        Click(ui("sheet-metal-hem-dialog-accept")),
        Wait(30),
        // A second hem started and changed (Tear drop, flipped) but cancelled: not remembered.
        Click(ui("sheet-metal-model-caret")),
        Wait(10),
        Click(ui("sheet-metal-menu-hem")),
        WaitFor("sheet-metal-hem-dialog"),
        Wait(10),
        Click(ui("smf-hem-type")),
        Wait(5),
        Click(ui("smf-hem-type-option-2")),
        Wait(10),
        Click(ui("smf-hem-type-flip")),
        Wait(10),
        Key("Escape"),
        Wait(20),
        // The next hem starts from the accepted one's values (Straight, inner radius), not flipped.
        Click(ui("sheet-metal-model-caret")),
        Wait(10),
        Click(ui("sheet-metal-menu-hem")),
        WaitFor("sheet-metal-hem-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-next-hem-remembers"),
        Key("Escape"),
        Wait(10),
    ],
)
