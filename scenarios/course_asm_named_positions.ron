// P3B.8 / A1.8, A16.2, X16 Named positions on the hinged step stool
// (`fixtures/step_stool_hinged.cadrs`: the Ex4 end state, Revolute 1 limited -42.5 ... 0 deg, closed).
// 01 (A1.8) the right strip's Named positions button: the empty panel.
// 02 Revolute 1 -> Apply limit position (-42.5 deg), then Add position: a new row in the table,
//    its name in edit mode ("Open" typed).
// 03 "Open" captured: its Revolute 1 column reads -42.5° (the check: the assembly is in it).
// 04 Revolute 1 -> Reset; "Closed" captured: two positions, "Closed" current.
// 05 Apply "Open": the stool opens (the mates solved to its values); mass properties:
//    CoM (0, -2.422, 12.755) in, as the gap list's Ex4 check.
// 06 A row's menu: Apply, Update to current position, Rename, Delete.
// 07 Rename "Closed" -> "Folded" (in place); 07b its Revolute 1 value typed, -10° (then
//    undone); 08 Delete "Folded" (then undone, and applied: closed).
// 09 (A16.2) a new assembly with the stool as a subassembly; its menu's Lock / follow position
//    to: Current position (locked, as its tab: closed) or a named position.
// 10 following "Open": the subassembly shows open in the parent (the row's named position
//    icon); its own tab stays closed.
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture step_stool_hinged"),
        Click(ui("tab-step-stool-assembly")),
        Custom("view 70 15 0 -150 300 1.6"),
        Click(ui("panel-named-positions")),
        WaitFor("named-positions-panel"),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("01-a1.8-named-positions-panel"),
        // Open the stool: Apply limit position (-42.5 deg).
        RightClick(ui("mate-row-2")),
        WaitFor("mate-apply-limit"),
        Hover(ui("mate-apply-limit")),
        Wait(5),
        Click(ui("mate-limit-angle-min")),
        Click(ui("named-position-add")),
        WaitFor("named-position-name"),
        Key("Ctrl+A"),
        Type("Open"),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("02-x16-add-position-open"),
        Key("Enter"),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("03-x16-open-captured"),
        // Closed: Reset, then Add position.
        RightClick(ui("mate-row-2")),
        WaitFor("mate-reset"),
        Click(ui("mate-reset")),
        Click(ui("named-position-add")),
        WaitFor("named-position-name"),
        Key("Ctrl+A"),
        Type("Closed"),
        Key("Enter"),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("04-x16-closed-captured"),
        // Apply "Open": the gap list's CoM.
        Click(ui("named-position-row-1-apply")),
        Click(ui("instance-root")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        MoveTo(1100, 250),
        Wait(2),
        Screenshot("05-x16-apply-open-mass"),
        Click(ui("mass-dialog-cancel")),
        // The row menu.
        RightClick(ui("named-position-row-2")),
        WaitFor("named-position-rename"),
        Hover(ui("named-position-rename")),
        Wait(3),
        Screenshot("06-x16-position-menu"),
        Click(ui("named-position-rename")),
        WaitFor("named-position-name"),
        Key("Ctrl+A"),
        Type("Folded"),
        Key("Enter"),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("07-x16-renamed-folded"),
        // A stored value typed in the table (one undo step), then undone.
        Click(ui("named-position-row-2-value-1-field")),
        Key("Ctrl+A"),
        Type("-10 deg"),
        Key("Enter"),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("07b-x16-value-edited"),
        Key("Ctrl+Z"),
        RightClick(ui("named-position-row-2")),
        WaitFor("named-position-delete"),
        Click(ui("named-position-delete")),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("08-x16-deleted"),
        Key("Ctrl+Z"),
        // Back to "Folded" (closed) in the stool's own tab.
        Click(ui("named-position-row-2-apply")),
        // A16.2: a parent assembly following "Open".
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-kind-1")),
        Click(ui("insert-assembly-step-stool-assembly")),
        Click(ui("insert-dialog-accept")),
        Custom("view 70 15 0 -150 300 1.6"),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-follow"),
        Hover(ui("asm-follow")),
        Wait(5),
        Screenshot("09-a16.2-lock-follow-position-menu"),
        Click(ui("asm-follow-0")),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("10-a16.2-following-open"),
    ],
)
