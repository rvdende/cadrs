// P3E.5 (test-drive.md "Exercises", steps 1–7 and 9; TD4.1, TD7.3, TD8.5–TD8.9, TD9.4, TD10.2,
// TD10.4–TD10.7, TD12.3–TD12.7): the test drive walkthrough on its stand-in, "Drill"
// (`cadrs_core::samples::drill`, `fixtures/drill_standin.cadrs`): Part Studio CARBURETOR
// (MANIFOLD, CARBURETOR_BODY), Assembly CARBURETOR, Part Studio DRILL BODY, Assembly FUEL AND
// POWER TRAIN. Everything is clicked through the UI (no scenario shortcut). Sheet points are
// `world(x, y)` in sheet mm on the ANSI B sheet.
// Step 1: 01 Explore cadrs → Samples: "Drill" (Test Drive) selected, its details; 02 Open a
//    copy: "Copy of Drill", the CARBURETOR Part Studio.
// Step 2: 03 Shift+E, the MANIFOLD's mounting face picked ("Face of Extrude 1"): Add is picked
//    by itself, MANIFOLD in Merge scope; 04 New, 2 mm: Part 3; 05 renamed CARBURETOR_GASKET,
//    given Nylon 6/6, Mass properties: 1676.648 mm³ (2 × (1200 − 115.125π)), its mass, centre of
//    mass and inertia.
// Step 3: 06 the CARBURETOR assembly: the gasket inserted beside it; 07 Fastened: the gasket's
//    face locked with Shift (its points), the glyph on its bolt hole's centre; 08 the
//    manifold's face locked, its bolt hole's centre; 09 Flip, ✓: the gasket on the manifold.
// Step 4: 10 FUEL AND POWER TRAIN: Insert → Assemblies: CARBURETOR; 11 clicked in beside the
//    drill body; 11b zoomed in to pick; 12 Fastened: the gasket's face locked, its bore's
//    centre; 12b the drill body's top locked, its port's centre; 13 the carburetor upside down
//    in the drill body; 14 Flip: on top; 15 Solve, ✓.
// Step 5: 16 from the top, the manifold's two bolt hole edges selected (Diameter 5.5); 17 Insert
//    → Standard content: ISO, Socket head cap screw, M5, 25; 18 Insert: one screw on each hole
//    (Fastened 2, 3), seen from the front and above; K (no explicit connectors to hide here).
// Step 6: 19 the BOM (the panel widened), CARBURETOR expanded (2.1–2.3); 20 the gasket's row menu: Generate next
//    part number; 21 its menu again: Switch to CARBURETOR (TD9.4); 22 the CARBURETOR Part
//    Studio, the gasket selected; 23 its Properties: Part number PRT-000006, a Description
//    typed; 24 back in FUEL AND POWER TRAIN: the BOM shows the Description.
// Step 7: 25 "+" → Create Drawing… → ANSI_B_MM.dwt; 26 Insert view: FUEL AND POWER TRAIN, Front,
//    1:2; 27 Front and the projected Right view placed; the title block shows the model's Name
//    (FUEL AND POWER TRAIN, its Description) and Part number (PRT-000005); the tab then renamed
//    "FUEL AND POWER TRAIN Drawing"; 28 Insert BOM: Structured – Top level, fixed corner bottom
//    right, snapped to the title block's left edge (TD10.5), its columns fitted to the frame
//    (the cells wrap); 28b placed;
//    29 the height (148.00, Front) and depth (80.00, Right) dimensions; 30 Callout (Item No.):
//    1 the drill body, 2 the carburetor, 3 a screw; 31 the finished drawing.
// Step 9: 32 History → Create version "FUEL AND POWER TRAIN COMPLETE"; 33 its menu → Branch to
//    create workspace: "Alternate Gasket Thickness" (the version in the body, not the title); 34 in the branch, Extrude 3 at 1 mm:
//    838.324 mm³; 35 the header's workspace menu (under the header bar); 36 Main: still
//    1676.648; 37 Merge into current workspace: CARBURETOR changed, Replace (the list opens
//    upwards); 38 merged: Main's gasket 838.324, the rail's "Merge from …" row; 39 the version's menu → Restore (the entry
//    before the merge); 40 restored: 1676.648 again.
Scenario(
    start: Some("landing"),
    seed_documents: 4,
    steps: [
        WaitFor("doc-row-0"),
        // Step 1: Explore cadrs → the Drill sample → Open a copy.
        Click(ui("filter-explore")),
        WaitFor("sample-row-6"),
        Click(ui("sample-name-6")),
        WaitFor("details-open-copy"),
        Screenshot("01-sample-drill"),
        Click(ui("details-open-copy")),
        WaitFor("sample-copy-dialog"),
        Click(ui("sample-copy-dialog-ok")),
        WaitFor("document-shell"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-copy-carburetor-studio"),
        // Step 2: the MANIFOLD's mounting face → Extrude: Add is picked by itself.
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(-5, 12.5, 20)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("2"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-face-extrude-add"),
        Click(ui("extrude-operation-0")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-new-2mm"),
        Click(ui("extrude-dialog-accept")),
        // The new part renamed CARBURETOR_GASKET; its volume, 2 × the face.
        RightClick(ui("part-row-part-3")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        Key("Ctrl+A"),
        Type("CARBURETOR_GASKET"),
        Key("Enter"),
        // A gasket material (Nylon 6/6), so the mass properties have a mass and centre of mass.
        RightClick(ui("part-row-carburetor-gasket")),
        WaitFor("part-material"),
        Click(ui("part-material")),
        WaitFor("material-dialog"),
        Click(ui("material-choose")),
        Type("nylon"),
        Click(ui("material-item-nylon-6-6")),
        Click(ui("material-dialog-accept")),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "1676.648"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-carburetor-gasket-volume"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        // Step 3: the CARBURETOR assembly; the gasket inserted beside it.
        Click(ui("tab-carburetor-assembly")),
        Key("Shift+7"),
        Key("F"),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-part-carburetor-gasket")),
        MoveTo(1250, 730),
        Wait(10),
        Click(at(1250, 730)),
        Click(ui("insert-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-gasket-inserted"),
        // Fastened: the gasket's face locked with Shift, its bolt hole's centre; then the
        // manifold's face locked, the same hole's centre.
        Click(ui("mate-fastened")),
        WaitFor("mate-dialog"),
        Hover(at(1395, 612)),
        Wait(5),
        KeyDown("Shift"),
        Hover(at(1333, 645)),
        Wait(5),
        Screenshot("07-gasket-face-locked-hole-centre"),
        Click(at(1333, 645)),
        KeyUp("Shift"),
        Hover(at(880, 300)),
        Wait(5),
        KeyDown("Shift"),
        Hover(at(1021, 410)),
        Wait(5),
        Screenshot("08-manifold-face-locked-hole-centre"),
        Click(at(1021, 410)),
        KeyUp("Shift"),
        // Flip: the gasket's face against the manifold's, not inside it.
        Click(ui("mate-flip")),
        Click(ui("mate-dialog-accept")),
        Key("Space"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-gasket-fastened"),
        // Step 4: FUEL AND POWER TRAIN; Insert → Assemblies → CARBURETOR, beside the drill body.
        Click(ui("tab-fuel-and-power-train")),
        Key("Shift+7"),
        Key("F"),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-kind-1")),
        Screenshot("10-insert-assemblies-tab"),
        Click(ui("insert-assembly-carburetor")),
        MoveTo(1250, 820),
        Wait(10),
        Click(at(1250, 820)),
        Click(ui("insert-dialog-accept")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-carburetor-inserted"),
        // Fastened: the gasket's face locked with Shift, its bore's centre; the drill body's top
        // locked, its port's centre.
        Scroll(at(1133, 700), 4),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11b-zoomed-in-to-pick"),
        Click(ui("mate-fastened")),
        WaitFor("mate-dialog"),
        Hover(at(1205, 612)),
        Wait(5),
        KeyDown("Shift"),
        Hover(at(1140, 616)),
        Wait(5),
        Screenshot("12-gasket-face-locked-bore-centre"),
        Click(at(1140, 616)),
        KeyUp("Shift"),
        Hover(at(600, 190)),
        Wait(5),
        KeyDown("Shift"),
        Hover(at(718, 135)),
        Wait(5),
        Screenshot("12b-drill-body-face-locked-port-centre"),
        Click(at(718, 135)),
        KeyUp("Shift"),
        MoveTo(1420, 900),
        Wait(3),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("13-fastened-before-flip"),
        Click(ui("mate-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("14-flipped"),
        Click(ui("mate-solve")),
        Click(ui("mate-dialog-accept")),
        Key("Space"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("15-carburetor-fastened"),
        // Step 5: the manifold's two bolt hole edges on its back face (from the top, where the
        // carburetor body doesn't hide one of them) → Insert → Standard content: ISO, Socket
        // head cap screw, M5, 25 → Insert: one on each hole, each with its Fastened mate.
        Key("Shift+5"),
        Key("F"),
        Scroll(xyz(0, 0, 22), 4),
        Wait(30),
        Click(xyz(18.25, 0, 22)),
        Click(xyz(-18.25, 0, 22)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("16-bolt-hole-edges-selected"),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-source-2")),
        Click(ui("std-standard")),
        Click(ui("std-standard-option-1")),
        Click(ui("std-size")),
        Click(ui("std-size-option-2")),
        Click(ui("std-length")),
        Click(ui("std-length-option-6")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("17-iso-4762-m5x25"),
        Click(ui("std-insert")),
        Click(ui("insert-dialog-accept")),
        Key("Space"),
        // From the front and 30° above (two 15° turns), so the body hides neither screw.
        Key("Shift+1"),
        Key("ArrowDown"),
        Key("ArrowDown"),
        Key("F"),
        Scroll(xyz(0, 0, 22), 2),
        Wait(30),
        // K: the connectors hidden (this stand-in has no explicit ones to show).
        Key("K"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("18-two-screws"),
        // Step 6: the BOM (Structured): CARBURETOR expanded; the gasket's row → Generate next
        // part number.
        Click(ui("panel-bom")),
        // The panel widened (its left edge dragged), so the Description shows whole.
        Drag(ui("bom-panel-resize"), at(560, 500)),
        Wait(10),
        DoubleClick(ui("bom-cell-1-0")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("19-bom-carburetor-expanded"),
        RightClick(ui("bom-row-4")),
        WaitFor("bom-row-part-number"),
        Hover(ui("bom-row-part-number")),
        Wait(5),
        Screenshot("20-bom-generate-next-part-number"),
        Click(ui("bom-row-part-number")),
        // Switch to: the CARBURETOR Part Studio, the gasket selected.
        RightClick(ui("bom-row-4")),
        WaitFor("bom-row-switch-to"),
        Hover(ui("bom-row-switch-to")),
        Wait(5),
        Screenshot("21-bom-switch-to"),
        Click(ui("bom-row-switch-to")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("22-switched-to-the-part-studio"),
        // Its Properties: the generated Part number; a Description typed there.
        RightClick(ui("part-row-carburetor-gasket")),
        WaitFor("part-properties"),
        Click(ui("part-properties")),
        WaitFor("properties-dialog"),
        ExpectText("properties-dialog", "PRT-000006"),
        Click(ui("props-description")),
        Type("Carburetor gasket, 2 mm"),
        Screenshot("23-properties-part-number-and-description"),
        Click(ui("props-save")),
        // Back in the assembly: the Description in the BOM.
        Click(ui("tab-fuel-and-power-train")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("24-bom-shows-the-description"),
        Click(ui("bom-panel-close")),
        // Step 7: "+" → Create Drawing… → ANSI_B_MM.
        Click(ui("insert-tab")),
        WaitFor("create-drawing"),
        Click(ui("create-drawing")),
        WaitFor("create-drawing-dialog"),
        Click(ui("template-filter-1")),
        Click(ui("template-row-ANSI_B_MM.dwt")),
        MoveTo(1400, 950),
        Wait(3),
        Screenshot("25-create-drawing-ansi-b-mm"),
        Click(ui("create-drawing-ok")),
        WaitFor("insert-view-dialog"),
        // FUEL AND POWER TRAIN, Front, 1:2; then the projected Right view.
        Click(ui("insert-view-kind-tabs-1")),
        Click(ui("browser-assembly-2")),
        Click(ui("insert-view-scale")),
        Click(ui("insert-view-scale-option-1")),
        MoveWorld(130, 150),
        Wait(40),
        MoveWorld(130, 150.5),
        Wait(20),
        Screenshot("26-insert-view-front-1-2"),
        ClickWorld(130, 150),
        MoveWorld(240, 150),
        Wait(30),
        ClickWorld(240, 150),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("27-front-and-right-views"),
        // The tab named after the assembly.
        RightClick(ui("tab-drawing-1")),
        WaitFor("tab-rename"),
        Click(ui("tab-rename")),
        Type("FUEL AND POWER TRAIN Drawing"),
        Key("Enter"),
        // The BOM: Structured – Top level, its fixed corner bottom right, snapped to the title
        // block's left edge (the block's bottom-left corner).
        Click(ui("drawing-bom")),
        WaitFor("bom-dialog"),
        Click(ui("bom-type")),
        Click(ui("bom-type-option-1")),
        Click(ui("bom-dialog-corner-bottom-right")),
        MoveWorld(255, 18),
        Wait(10),
        MoveWorld(257.5, 15),
        Wait(10),
        Screenshot("28-bom-snapped-to-the-title-block"),
        ClickWorld(257.5, 15),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("28b-bom-placed"),
        // Height (Front) and depth (Right).
        Key("D"),
        ClickWorld(100, 113),
        ClickWorld(130, 187),
        MoveWorld(72, 150),
        Wait(3),
        ClickWorld(72, 150),
        ClickWorld(220, 135),
        ClickWorld(260, 135),
        MoveWorld(240, 100),
        Wait(3),
        ClickWorld(240, 100),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("29-height-and-depth"),
        // Item-number callouts: the drill body, the carburetor, a screw.
        Click(ui("drawing-callout")),
        WaitFor("callout-dialog"),
        ClickWorld(150, 113),
        MoveWorld(178, 98),
        Wait(5),
        ClickWorld(178, 98),
        ClickWorld(120, 164),
        MoveWorld(100, 200),
        Wait(5),
        ClickWorld(100, 200),
        ClickWorld(139.9, 170),
        MoveWorld(165, 200),
        Wait(5),
        ClickWorld(165, 200),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("30-item-callouts"),
        Click(ui("callout-dialog-ok")),
        ClickWorld(330, 200),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("31-drawing-finished"),
        // Step 9: Create version "FUEL AND POWER TRAIN COMPLETE".
        Click(ui("tab-carburetor")),
        Click(ui("rail-history")),
        WaitFor("history-panel"),
        Click(ui("history-create-version")),
        WaitFor("version-popup"),
        Key("Ctrl+A"),
        Type("FUEL AND POWER TRAIN COMPLETE"),
        Screenshot("32-create-version"),
        Click(ui("version-popup-accept")),
        // Branch to create workspace "Alternate Gasket Thickness".
        RightClick(ui("history-version-1")),
        WaitFor("history-version-menu"),
        Click(ui("history-branch")),
        WaitFor("branch-dialog"),
        Type("Alternate Gasket Thickness"),
        Screenshot("33-branch-dialog"),
        Click(ui("branch-create")),
        Wait(60),
        // In the branch: the gasket's Extrude 3, 2 → 1 mm: 838.324 mm³.
        DoubleClick(ui("feature-extrude-3")),
        WaitFor("extrude-dialog"),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("1"),
        Key("Enter"),
        Click(ui("history-group-1")),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "838.324"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("34-branch-gasket-1mm"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        // Main still has the 2 mm gasket.
        Click(ui("branch-label")),
        WaitFor("workspace-menu"),
        Screenshot("35-workspace-menu"),
        Click(ui("workspace-item-0")),
        ExpectText("branch-label", "Main"),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "1676.648"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("36-main-still-2mm"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        // Merge into Main, replacing the CARBURETOR Part Studio (the History panel is open).
        WaitFor("history-panel"),
        RightClick(ui("history-workspace-1")),
        WaitFor("history-workspace-menu"),
        Click(ui("history-merge")),
        WaitFor("merge-dialog"),
        Click(ui("merge-tab-0")),
        WaitFor("merge-tab-0-menu"),
        Screenshot("37-merge-dialog"),
        Click(ui("merge-tab-0-option-0")),
        Click(ui("merge-accept")),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "838.324"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("38-merged-main-1mm"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        // Restore the entry before the merge (the version marks it): 2 mm again.
        RightClick(ui("history-version-1")),
        WaitFor("history-version-menu"),
        Hover(ui("history-restore")),
        Wait(3),
        Screenshot("39-restore-before-the-merge"),
        Click(ui("history-restore")),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "1676.648"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("40-restored-2mm"),
    ],
)
