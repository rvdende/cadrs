// P3C.6, P3C.5 / D13, D14, Ex3 Hand Brake Update (intro-to-drawings.md D13, D14, ex3-step1..11,
// overview ex3-drawing.png, result ex3-completed.png) on the stand-in Handle studio, the Hydraulic
// Brake Unit assembly and their finished drawing (`cadrs_core::samples::hand_brake`,
// `fixtures/hand_brake_standin.cadrs`; the course's public document can't be copied). Sheet points are
// `world(x, y)` in sheet mm on the ANSI A (mm) sheets: Handle at 1:2 (the Front view's origin,
// the plate's top-left corner, at (42, 118), the Top view's at (42, 160)), Grip at 1:1 (the
// Front view's origin at (52, 104), the Top view's at (52, 162)). In the Main Sketch, points are
// sketch mm on Front (the origin at the bar's top-left corner).
// 01 (ex3-step1, D14.1) the copied stand-in: the Handle studio (Handle Plate, Handle Grip).
// 02 (ex3-step2, D14.2) the Hand Brake Drawing tab, Ctrl+S: Sheets(3) with the parts and views
//    under each sheet; the Assembly sheet (P3C.5): the Hydraulic Brake Unit isometric and shaded,
//    its 10-row BOM, balloons 1–10.
// 03, 04 double-click Handle, then Grip: the finished sheets before the edits (225.00, 20.00,
//    73.00, 2x Ø8.25, 75.00; 170.00, 3x Ø5.50 THRU ⌴Ø9.75 ↧5.00).
// 05 (ex3-step3, D14.3) Handle studio, Main Sketch's menu: Edit…
// 06 (ex3-step4, D14.4) the Main Sketch in its original values; 07 225 → 250, 100 → 125, bar
//    20 → 25, offset 15 → 25, Ø8.25 → Ø15 (the small circle, equal to it, follows); 08 the small
//    circle selected; 09 deleted; accepted.
// 10 (ex3-step5, D14.5) Extrude 2: Second end position 175 mm.
// 11 (ex3-step6, D14.6) Hole 1: Size M6 (6.6, 11.25, 6 mm).
// 12 the edited studio.
// 13 (ex3-step8, D14.8) back in the drawing: the views haven't changed, the Update icon is gold;
//    14 its tooltip (6 views out of date, Ctrl+Q), the flyout closed.
// 15 (D14.8) Ctrl+Q: the Handle sheet updated (250.00, 25.00, R30.00, Ø25.40, 78.00, R16.00,
//    3x Ø5.50, 8.00); the dangling centerline (Top view), 2x Ø8.25, 75.00 and the small circle's
//    centermark are red, where they were (ex3-step9).
// 16 hover over the red 2x Ø8.25; 17 the red centerline selected; 18 deleted; 19 2x Ø8.25
//    selected; 20 deleted (D14.9).
// 21 (ex3-step10, D14.10) the red 75.00 selected: its grips; 22 its left end grip dragged onto
//    the large hole's centre (snapped); 23 released: 46.00, black again.
// 24 the red centermark selected; 25 deleted: no red remains; 26 deselected: 46.00 inside,
//    centred between its extension lines (it fits, as in ex3-step10).
// 12b (ex3-step7, D14.7) the Hydraulic Brake Unit: the three ISO 4762 cap screws selected →
//     Edit standard content instance…; 12c Size M6, Update (the heads grow); ✓.
// 12d (ex3-step8, D14.8) the Assembly sheet unchanged (M5 heads), the Update icon gold.
// 27 (ex3-step11, D14.11) the Grip sheet: Ø25.00, 185.00, 35.00, 62.50, 8.00, 8.50 and
//    3x Ø6.60 THRU ⌴Ø11.25 ↧6.00; 28 tidied, the Update icon plain again.
// 29 (D14.8, P3C.5) the Assembly sheet after the update: the M6 cap screws, the same 10 BOM rows
//    (row 8 is now the M6 configuration), the balloons on their parts; 30 a close-up of the
//    screws (no stray dashes: edge pieces another part hides are hidden, P3C wrap-up).
// 31 (X6) the view's menu: Show part intersections; 32 on: the curves where the grown Handle
//    Plate runs into the enclosure.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("hand-brake"),
        Wait(120),
        Key("Shift+7"),
        Wait(20),
        Key("F"),
        Wait(20),
        MoveTo(1500, 900),
        Wait(3),
        Screenshot("01-handle-part-studio"),
        // D14.2: the drawing, the Sheets flyout, each sheet in turn.
        Click(ui("tab-hand-brake-drawing")),
        Wait(40),
        Key("Ctrl+S"),
        Wait(15),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("02-sheets-flyout-assembly"),
        DoubleClick(ui("sheet-row-2")),
        Wait(60),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("03-handle-sheet"),
        DoubleClick(ui("sheet-row-3")),
        Wait(60),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("04-grip-sheet"),
        Key("Ctrl+S"),
        Wait(5),
        // D14.3, D14.4: the Main Sketch.
        Click(ui("tab-handle")),
        Wait(30),
        // The grip covers the bar's constraints in the sketch: hidden while the sketch is edited.
        RightClick(ui("part-row-handle-grip")),
        Wait(5),
        Click(ui("part-hide")),
        Wait(10),
        RightClick(ui("feature-main-sketch")),
        Wait(6),
        Hover(ui("feature-edit")),
        Wait(4),
        Screenshot("05-main-sketch-menu-edit"),
        Click(ui("feature-edit")),
        Wait(30),
        // Show constraints off, as in ex3-step3/4.
        Click(ui("sketch-show-constraints")),
        Wait(5),
        Key("N"),
        Wait(30),
        Key("F"),
        Wait(30),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("06-main-sketch-original"),
        DoubleClick(ui("dim-label-225")),
        Wait(4),
        Type("250"),
        Key("Enter"),
        Wait(8),
        DoubleClick(ui("dim-label-100")),
        Wait(4),
        Type("125"),
        Key("Enter"),
        Wait(8),
        DoubleClick(ui("dim-label-20")),
        Wait(4),
        Type("25"),
        Key("Enter"),
        Wait(8),
        DoubleClick(ui("dim-label-15")),
        Wait(4),
        Type("25"),
        Key("Enter"),
        Wait(8),
        DoubleClick(ui("dim-label-Ø8.25")),
        Wait(4),
        Type("15"),
        Key("Enter"),
        Wait(8),
        Key("F"),
        Wait(20),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("07-dimensions-changed"),
        // The small circle, 29 left of the large hole (Ø15 now): its rim's left side.
        ClickWorld(213.5, -28),
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("08-small-circle-selected"),
        Key("Delete"),
        Wait(8),
        Screenshot("09-small-circle-deleted"),
        Click(ui("sketch-dialog-accept")),
        Wait(30),
        RightClick(ui("part-row-handle-grip")),
        Wait(5),
        Click(ui("part-show")),
        Wait(10),
        // D14.5: Extrude 2's second end, 175 mm.
        RightClick(ui("feature-extrude-2")),
        Wait(6),
        Click(ui("feature-edit")),
        Wait(20),
        Click(ui("extrude-second-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("175"),
        Click(ui("extrude-dialog-title")),
        Wait(20),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("10-extrude-2-second-end-175"),
        Click(ui("extrude-dialog-accept")),
        Wait(30),
        // D14.6: Hole 1 → M6.
        RightClick(ui("feature-hole-1")),
        Wait(6),
        Click(ui("feature-edit")),
        Wait(20),
        Click(ui("hole-size")),
        Wait(4),
        Click(ui("hole-size-option-6")),
        Wait(20),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("11-hole-1-m6"),
        Click(ui("hole-dialog-accept")),
        Wait(30),
        Key("Shift+7"),
        Wait(20),
        Key("F"),
        Wait(20),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("12-edited-studio"),
        // D14.7: the Hydraulic Brake Unit's three ISO 4762 cap screws → M6 (ex3-step7).
        Click(ui("tab-hydraulic-brake-unit")),
        Wait(40),
        Key("F"),
        Wait(30),
        Click(ui("instance-row-10")),
        Wait(2),
        Click(ui("instance-row-11")),
        Wait(2),
        Click(ui("instance-row-12")),
        Wait(2),
        RightClick(ui("instance-row-11")),
        WaitFor("asm-std-edit"),
        Hover(ui("asm-std-edit")),
        Wait(3),
        Screenshot("12b-d14.7-edit-standard-content-instance"),
        Click(ui("asm-std-edit")),
        WaitFor("std-edit-dialog"),
        Wait(5),
        Click(ui("std-size")),
        Wait(3),
        Click(ui("std-size-option-3")),
        Wait(5),
        Click(ui("std-update")),
        Wait(15),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("12c-d14.7-m6"),
        Click(ui("std-edit-dialog-accept")),
        Wait(10),
        // D14.8: back to the drawing: nothing changed yet, the Update icon is gold.
        Click(ui("tab-hand-brake-drawing")),
        Wait(40),
        Key("Ctrl+S"),
        Wait(8),
        // D14.8: the Assembly sheet hasn't changed yet either (M5 heads, the old handle).
        DoubleClick(ui("sheet-row-1")),
        Wait(30),
        MoveTo(1590, 990),
        Wait(10),
        Screenshot("12d-d14.8-assembly-sheet-unchanged-gold"),
        DoubleClick(ui("sheet-row-2")),
        Wait(30),
        MoveTo(1590, 990),
        Wait(10),
        Screenshot("13-views-unchanged-update-gold"),
        // The flyout closed, so the tooltip covers nothing (P3C.6's delta: it covered Sheets(3)).
        Key("Ctrl+S"),
        Wait(10),
        Hover(ui("drawing-update")),
        Wait(40),
        Screenshot("14-update-tooltip"),
        MoveTo(1590, 990),
        Wait(3),
        Key("Ctrl+Q"),
        Wait(90),
        MoveTo(1590, 990),
        Wait(5),
        Screenshot("15-updated-dangling-red"),
        // D14.9: the dangling centerline and 2x Ø8.25.
        MoveWorld(115, 99.5),
        Wait(5),
        Screenshot("16-hover-dangling-dimension"),
        ClickWorld(140, 157),
        Wait(5),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("17-dangling-centerline-selected"),
        Key("Delete"),
        Wait(8),
        Screenshot("18-centerline-deleted"),
        ClickWorld(115, 99.5),
        Wait(5),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("19-dangling-2x-dimension-selected"),
        Key("Delete"),
        Wait(8),
        Screenshot("20-2x-dimension-deleted"),
        // D14.10: the red 75.00's left end onto the large hole's centre.
        ClickWorld(171.25, 64),
        Wait(5),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("21-dangling-75-selected-grips"),
        Press(world(140, 106.5)),
        MoveWorld(146, 106),
        Wait(2),
        MoveWorld(155, 105),
        Wait(2),
        MoveWorld(162, 104.5),
        Wait(2),
        MoveWorld(167, 104),
        Wait(8),
        Screenshot("22-grip-dragged-to-large-hole"),
        Release,
        Wait(10),
        MoveTo(1590, 990),
        Wait(5),
        Screenshot("23-reattached-46"),
        ClickWorld(140, 106.5),
        Wait(5),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("24-dangling-centermark-selected"),
        Key("Delete"),
        Wait(8),
        Screenshot("25-no-red-remains"),
        // Tidy: 46.00 stays inside, centred between its extension lines where it fits (as in
        // ex3-step10, P3C.8); a click on empty sheet clears the selection.
        ClickWorld(60, 40),
        Wait(5),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("26-handle-tidied"),
        // D14.11: the Grip sheet.
        Key("Ctrl+S"),
        Wait(8),
        DoubleClick(ui("sheet-row-3")),
        Wait(40),
        Key("Ctrl+S"),
        Wait(8),
        MoveTo(1590, 990),
        Wait(5),
        Screenshot("27-grip-sheet-updated"),
        DragWorld(129.5, 63, 134.5, 63),
        Wait(8),
        ClickWorld(60, 40),
        Wait(5),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("28-grip-tidied"),
        // D14.8: the Assembly sheet after the update: the M6 cap screws in the view, the BOM's row
        // 8 the M6 configuration (same name and quantity), the balloons still on their parts.
        Key("Ctrl+S"),
        Wait(8),
        DoubleClick(ui("sheet-row-1")),
        Wait(40),
        Key("Ctrl+S"),
        Wait(8),
        MoveTo(1590, 990),
        Wait(5),
        Screenshot("29-d14.8-assembly-sheet-updated"),
        Scroll(world(207, 134), 6.0),
        Wait(20),
        MoveTo(1590, 990),
        Wait(5),
        Screenshot("30-d14.8-m6-cap-screws-close-up"),
        // X6: Show part intersections (the grown Handle Plate runs into the enclosure).
        RightClick(at(950, 700)),
        WaitFor("view-menu-part-intersections"),
        Hover(ui("view-menu-part-intersections")),
        Wait(5),
        Screenshot("31-x6-view-menu-part-intersections"),
        Click(ui("view-menu-part-intersections")),
        Wait(60),
        MoveTo(1590, 990),
        Wait(5),
        Screenshot("32-x6-part-intersections"),
        Key("F"),
        Wait(10),
    ],
)
