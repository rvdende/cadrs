// M4: selection (compare reference/onshape/box_select.md and screens/18a). With no tool active,
// hovering an edge highlights it orange; clicking selects it; dragging from empty space left to
// right is a window selection (solid blue box, only what is inside), right to left a crossing
// selection (dashed yellow box, also what it touches); both add to the selection (the line clicked
// first stays selected) and include the origin. Delete removes the selection; Ctrl+Z
// brings it back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("G"),
        ClickWorld(-60, 7.5),
        ClickWorld(-15, 45),
        Key("Escape"),
        Key("Escape"),
        Key("L"),
        ClickWorld(7.5, 7.5),
        ClickWorld(52.5, 45),
        Key("Escape"),
        Key("C"),
        ClickWorld(30, -37.5),
        ClickWorld(45, -37.5),
        Key("Escape"),
        Key("Escape"),
        MoveWorld(-37.5, 45.15),
        Wait(2),
        Screenshot("01-hover-edge-orange"),
        ClickWorld(-37.5, 45.15),
        MoveWorld(0, 67.5),
        Wait(2),
        Screenshot("02-edge-selected"),
        ClickWorld(0, 67.5),
        ClickWorld(30, 26.25),
        Press(world(-75, 60)),
        Hover(world(-30, 15)),
        Hover(world(0, -7.5)),
        Wait(2),
        Screenshot("03-window-box-left-to-right"),
        Release,
        Wait(2),
        Screenshot("04-window-adds-inside-only-to-selection"),
        ClickWorld(0, 67.5),
        Press(world(37.5, 60)),
        Hover(world(0, 30)),
        Hover(world(-22.5, -52.5)),
        Wait(2),
        Screenshot("05-crossing-box-right-to-left"),
        Release,
        Wait(2),
        Screenshot("06-crossing-selects-touched"),
        Key("Delete"),
        Screenshot("07-deleted"),
        Key("Ctrl+Z"),
        Screenshot("08-undo-restores"),
    ],
)
