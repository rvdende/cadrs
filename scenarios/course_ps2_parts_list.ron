// P3.3 / PS2.8, X6, PS18.1: the Parts list and its context menu. One sketch with two separate
// squares, one extrude: two parts ("Part 1", "Part 2"), as Onshape makes a part per separate
// solid.
// 01 right-clicking Part 2: Rename, …, Hide, Isolate…, …, Delete… (the items of Onshape's menu
//    that later milestones add are shown greyed).
// 02 Hide: Part 2 is gone from the view, its row greyed with a crossed eye.
// 03 Show again: both parts in the view; right-clicking Part 1, Isolate.
// 04 Isolated: only Part 1 is shown, Part 2's row greyed, "Exit isolate" above the view.
// 05 Exit isolate; Rename Part 2 → "Bracket" (in place, one undo step).
// 06 Delete Bracket: a "Delete part 1" feature at the end of the list, "Parts (1)".
// 07 Undo brings it back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 40 40 rect 60 0 100 40"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(20, 20, 0)),
        Wait(3),
        Click(xyz(80, 20, 0)),
        Wait(3),
        Key("Enter"),
        Wait(5),
        Key("F"),
        Wait(40),
        RightClick(ui("part-row-part-2")),
        WaitFor("part-hide"),
        Hover(ui("part-hide")),
        Wait(3),
        Screenshot("01-part-context-menu"),
        Click(ui("part-hide")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-part-2-hidden"),
        RightClick(ui("part-row-part-2")),
        WaitFor("part-show"),
        Click(ui("part-show")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        RightClick(ui("part-row-part-1")),
        WaitFor("part-isolate"),
        Hover(ui("part-isolate")),
        Wait(3),
        Screenshot("03-both-shown-isolate-part-1"),
        Click(ui("part-isolate")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-part-1-isolated"),
        Click(ui("exit-isolate")),
        Wait(5),
        RightClick(ui("part-row-part-2")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        WaitFor("part-rename"),
        Wait(3),
        Type("Bracket"),
        Key("Enter"),
        Wait(5),
        ClickAt(1420, 900),
        Wait(3),
        Screenshot("05-renamed-bracket"),
        RightClick(ui("part-row-bracket")),
        WaitFor("part-delete"),
        Click(ui("part-delete")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-deleted-delete-part-feature"),
        Key("Ctrl+Z"),
        Wait(5),
        Screenshot("07-undo"),
    ],
)
