// T1: Onshape course "Introduction to Sketching", exercise 1 (Basic Sketching), every step of
// training/intro-to-sketching/ex1-step1..8.png, driven through the UI as a user would:
// 1. A new document (mm); a sketch on Top; N; P hides the planes.
// 2. A rough outline with the circle, line and (Q) construction line tools, using inference: two
//    circles at the origin, a line chain from the outer circle's top, round the notch, back to
//    its bottom (its top edge left slanted), and a construction line from the origin.
// 3. Constrained: the top edge horizontal (H), the right edges aligned (V on two corners), the
//    construction line horizontal and its end at the notch's back line's midpoint (Shift+M),
//    and the three short vertical lines equal (E).
// 4. The first dimension, 200 from the circle's center to the right edge, scales the whole
//    sketch about the origin; zooming out frames it again.
// 5. 35 (the ring's width, from inside the big circle to outside the small one), 50 and 70:
//    fully defined, all black.
// 6. Two circles on the tabs with construction lines to the right edges' midpoints; equal
//    circles, equal and horizontal construction lines; Ø25 and 35.
// 7. Accept (✓).
// 8. Normal to (N), click the plate: the region turns orange and the bottom right reads
//    "Area: 16682.523 mm²" (the body region: 200 × 150 − π·75²/2 − 70 × 50 − 2·π·12.5²).
//    Clicking the ring as well adds its area: 29327.433 mm².
Scenario(
    start: Some("landing"),
    steps: [
        // Step 1: new document, sketch on Top, N, P.
        Click(ui("create")),
        WaitFor("new-document"),
        Click(ui("new-document")),
        WaitFor("new-document-dialog"),
        Key("Ctrl+A"),
        Type("Exercise: Basic Sketching"),
        Click(ui("new-document-create")),
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("P"),
        MiddleDrag(at(913, 520), at(700, 545)),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("01-step1-sketch-on-top-normal-planes-hidden"),
        // Step 2: the rough outline.
        Key("C"),
        ClickWorld(0, 0),
        ClickWorld(60, 0),
        Key("Escape"),
        ClickWorld(0, 0),
        ClickWorld(28, 0),
        Key("Escape"),
        Key("Escape"),
        Key("L"),
        ClickWorld(0, 60),
        ClickWorld(160, 69),
        ClickWorld(160, 21),
        ClickWorld(104, 21),
        ClickWorld(104, -21),
        ClickWorld(160, -21),
        ClickWorld(160, -60),
        ClickWorld(0, -60),
        Key("Escape"),
        Key("Q"),
        ClickWorld(0, 0),
        KeyDown("Shift"),
        ClickWorld(104, -6),
        KeyUp("Shift"),
        Key("Escape"),
        Key("Q"),
        Key("Escape"),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("02-step2-rough-outline"),
        // Step 3: constraints.
        Click(world(104, -6)),
        Click(world(104, 12)),
        Key("Shift+M"),
        Click(world(60, -2)),
        Key("H"),
        Click(world(80, 64)),
        Key("H"),
        Click(world(80, -61)),
        Key("H"),
        Click(world(160, 21)),
        Click(world(160, -21)),
        Key("V"),
        Click(world(160, 45)),
        Click(world(104, 12)),
        Click(world(160, -45)),
        Key("E"),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("03-step3-constrained-symmetric-midpoint-equal"),
        // Step 4: the first dimension scales the whole sketch.
        Key("D"),
        Click(world(0, 0)),
        Click(world(160, -45)),
        MoveWorld(80, -78),
        Wait(2),
        Click(world(80, -78)),
        Type("200"),
        Key("Enter"),
        // Zoom out to frame the rescaled sketch, as the course's step 4 is framed.
        Scroll(at(1120, 560), -2),
        Wait(5),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("04-step4-first-dimension-200-scales-sketch"),
        // Step 5: 50, 70 and the ring's 35: fully defined.
        Click(world(200, 55)),
        MoveWorld(222, 50),
        Wait(2),
        Click(world(222, 50)),
        Type("50"),
        Key("Enter"),
        Click(world(165, -25)),
        MoveWorld(165, -38),
        Wait(2),
        Click(world(165, -38)),
        Type("70"),
        Key("Enter"),
        Click(world(-52.47, 52.47)),
        Click(world(-25.31, 25.31)),
        MoveWorld(-40.3, 40.3),
        Wait(2),
        Screenshot("05a-step5-ring-width-inside-outside-follows-cursor"),
        Click(world(-40.3, 40.3)),
        Type("35"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("05b-step5-fully-defined-black"),
        // Step 6: two equal circles on the tabs, placed with construction lines to the edges'
        // midpoints; Ø25 and 35.
        Key("C"),
        ClickWorld(165, 50),
        ClickWorld(175, 50),
        Type("25"),
        Key("Enter"),
        ClickWorld(165, -50),
        ClickWorld(175, -50),
        Key("Escape"),
        Key("Escape"),
        Key("Q"),
        Key("L"),
        ClickWorld(165, 50),
        ClickWorld(200, 50),
        Key("Escape"),
        ClickWorld(165, -50),
        ClickWorld(200, -50),
        Key("Escape"),
        Key("Escape"),
        Key("Q"),
        Click(world(156.16, 41.16)),
        Click(world(157.93, -42.93)),
        Key("E"),
        Click(world(192, 50)),
        Click(world(192, -50)),
        Key("E"),
        Click(world(192, 50)),
        Click(world(192, -50)),
        Key("H"),
        Key("D"),
        Click(world(192, 50)),
        MoveWorld(180, 84),
        Wait(2),
        Click(world(180, 84)),
        Type("35"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("06-step6-tab-holes-25-and-35"),
        // Step 7: accept.
        Hover(ui("sketch-dialog-accept")),
        Wait(20),
        Screenshot("07-step7-accept"),
        Click(ui("sketch-dialog-accept")),
        // Step 8: view normal, select the region: the Area readout.
        Key("N"),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("08a-step8-accepted-normal"),
        Click(world(100, 50)),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("08b-step8-region-selected-area-readout"),
        Click(world(-57, 0)),
        MoveTo(1300, 800),
        Wait(2),
        Screenshot("08c-step8-ring-added-total-area"),
    ],
)
