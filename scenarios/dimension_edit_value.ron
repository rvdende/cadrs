// M7: editing dimensions (reference/onshape/dimension.md "Editing", "Deleting", "Dragging").
// A rectangle from the origin gets width 50 and height 30 from its quick-dimension boxes.
// Double-clicking the 50 opens the value editor showing "50 mm" with the number selected (M9:
// as Onshape); typing "2*20" keeps the unit ("2*20 mm") and sets 40; double-clicking the 30,
// Ctrl+A and typing "1 in" sets 25.4. An invalid value ("12 parsecs") shows red
// with a message and is not committed; Esc closes the editor. Dragging the width's value moves
// its label. Clicking the height's value selects it and Delete removes it: the rectangle's right
// side turns blue again. Ctrl+Z brings it back, a second Ctrl+Z moves the label back, a third
// restores the height 30. Values are targeted by their label names (`dim-label-<value>`).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("G"),
        ClickWorld(0.45, 0.3),
        ClickWorld(49.12, 33.17),
        Type("50"),
        Key("Enter"),
        Type("30"),
        Key("Enter"),
        Key("Escape"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("01-rectangle-50-by-30"),
        DoubleClick(ui("dim-label-50")),
        Screenshot("02-double-click-opens-editor"),
        Type("2*20"),
        Screenshot("03-typed-expression"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("04-width-40"),
        DoubleClick(ui("dim-label-30")),
        Key("Ctrl+A"),
        Type("1 in"),
        Screenshot("05-typed-inches"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("06-height-25-4"),
        DoubleClick(ui("dim-label-40")),
        Key("Ctrl+A"),
        Type("12 parsecs"),
        Key("Enter"),
        Screenshot("07-invalid-value-error"),
        Key("Escape"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("08-escape-keeps-40"),
        Drag(ui("dim-label-40"), world(28, -17)),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("09-label-dragged"),
        Click(ui("dim-label-25.4")),
        Screenshot("10-height-dimension-selected"),
        Key("Delete"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("11-height-deleted-blue-again"),
        Key("Ctrl+Z"),
        Screenshot("12-undo-delete"),
        Key("Ctrl+Z"),
        Screenshot("13-undo-label-drag"),
        Key("Ctrl+Z"),
        Screenshot("14-undo-height-edit"),
    ],
)
