// Spline (Onshape's sketch Spline tool, `reference/onshape/surfacing.md`): click to start, click
// each point, double-click to end; a click back on the first point closes it. The preview
// follows the cursor through the points so far. Selecting an open spline shows its end
// handles; dragging one sets the tangent there (one undo step). The closed spline bounds a
// region; the open one closed by a line bounds another.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Click(ui("sketch-spline")),
        Wait(2),
        // An open spline through four points.
        ClickWorld(-40, 0),
        ClickWorld(-25, 18),
        ClickWorld(-5, 6),
        MoveWorld(10, 15),
        MoveWorld(12, 20),
        Wait(3),
        Screenshot("01-open-spline-preview"),
        DoubleClick(world(12, 20)),
        Wait(4),
        // Closed by a line.
        Key("L"),
        Wait(2),
        ClickWorld(12, 20),
        ClickWorld(-40, 0),
        Key("Escape"),
        Wait(2),
        // A closed spline: back on its first point.
        Click(ui("sketch-spline")),
        Wait(2),
        ClickWorld(20, -10),
        ClickWorld(40, -20),
        ClickWorld(45, 5),
        ClickWorld(30, 12),
        MoveWorld(20, -9),
        Wait(3),
        Screenshot("02-closed-spline-preview"),
        ClickWorld(20, -10),
        Wait(4),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("03-two-splines"),
        // Select the open spline: its end handles show; drag the start handle.
        ClickWorld(-15.18, 12.22),
        Wait(4),
        Screenshot("04-handles"),
        DragWorld(-35.51, 9.27, -45, 14),
        Wait(6),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("05-handle-dragged"),
        Click(ui("sketch-dialog-accept")),
        Wait(10),
        ClickWorld(35, -5),
        Wait(4),
        Screenshot("06-closed-region-area"),
    ],
)
