// P3B.2 / P3B.3: the mate dialog's type change after picking (A6.3), Cylindrical with limits
// (A9.1), editing without re-solving and Solve (A6.11), and the offset in the list's tooltip
// (A8.2), on the mates stand-in (`fixtures/mates_standin.cadrs`): the Socket fixed, the Pin put in
// its hole, the Magnet fastened on the pin.
// 01 (A6.3) M: a Fastened mate, the socket's rim centre and the pin's top edge picked, flipped;
//    zoomed to fit.
// 02a the type dropdown; 02 (A6.3) the type changed to Cylindrical after picking: the picks stay.
// 03 (A9.1, A6.10) Limits: Z 0 … 25 mm (it can't go into the hole), angle −180° … 180°.
// 04 accepted: "Cylindrical 1" with its limit icon.
// 05 Fastened 1: the Magnet's top edge (flipped) on the pin's end face: the magnet sits on the pin.
// 06 (A9.1, A16.4) dragging the pin up: it stops at the Z limit (25 mm), the magnet with it.
// 07 (A6.10, A6.11) Cylindrical 1 edited: type Revolute (Z held), Offset Z −15 mm: only this mate
//    is placed: the pin drops to 15 mm up; the magnet (Fastened 1) is not re-solved: it floats.
// 08 (A6.11) Solve: every mate re-solved: the magnet comes down onto the pin.
// 09 (A6.12, A8.2) accepted; hovering Revolute 1: its tooltip shows the offset, which holds.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture mates_standin"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Socket"),
        Wait(5),
        Click(ui("insert-part-socket")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Pin"),
        Wait(5),
        Click(ui("insert-part-pin")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Magnet"),
        Wait(5),
        Click(ui("insert-part-magnet")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        Click(at(1500, 880)),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        Key("M"),
        WaitFor("mate-dialog"),
        Wait(3),
        // Fitted beside the dialog.
        Key("F"),
        Wait(30),
        Hover(xyz(207.07, -7.07, 20)),
        Wait(3),
        Click(xyz(207.07, -7.07, 20)),
        Wait(5),
        Hover(xyz(-16.46, 41.46, 16)),
        Wait(3),
        Click(xyz(-16.46, 41.46, 16)),
        Wait(5),
        Click(ui("mate-flip")),
        Wait(8),
        MoveTo(1500, 880),
        Key("F"),
        Wait(30),
        Screenshot("01-a6.3-fastened-picked"),
        Click(ui("mate-type")),
        WaitFor("mate-type-option-3"),
        Wait(3),
        Hover(ui("mate-type-option-3")),
        Wait(3),
        Screenshot("02a-a6.3-type-dropdown"),
        Click(ui("mate-type-option-3")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("02-a6.3-type-changed-after-picking"),
        Click(ui("mate-limits-checkbox")),
        Wait(5),
        Click(ui("mate-limit-z-min")),
        Key("Ctrl+A"),
        Type("0 mm"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-z-max")),
        Key("Ctrl+A"),
        Type("25 mm"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-angle-min")),
        Key("Ctrl+A"),
        Type("-180 deg"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-angle-max")),
        Key("Ctrl+A"),
        Type("180 deg"),
        Key("Enter"),
        Wait(5),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("03-a9.1-cylindrical-limits"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("04-accepted"),
        // Fastened 1: the magnet on the pin's end.
        Key("M"),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(357.07, 52.93, 10)),
        Wait(3),
        Click(xyz(357.07, 52.93, 10)),
        Wait(5),
        // Zoomed in on the pin first: from the fitted view the pick of its small end face
        // landed on the Socket, which fastened the magnet to the fixed socket (Final part 3).
        Scroll(xyz(200, 0, 36), 6),
        Wait(30),
        Hover(xyz(200, 1.5, 36)),
        Wait(3),
        Click(xyz(200, 1.5, 36)),
        Wait(5),
        Click(ui("mate-flip")),
        Wait(5),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        Key("F"),
        Wait(30),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("05-magnet-fastened-on-the-pin"),
        // A9.1, A16.4: the pin (and the magnet with it) dragged up: it stops at the Z limit.
        Scroll(at(1000, 520), -3),
        Wait(30),
        Press(xyz(203.54, -3.54, 45)),
        Hover(xyz(203.54, -3.54, 60)),
        Wait(2),
        Hover(xyz(203.54, -3.54, 90)),
        Wait(2),
        Hover(xyz(203.54, -3.54, 130)),
        Wait(5),
        Screenshot("06-a9.1-drag-stops-at-z-limit"),
        Release,
        Wait(8),
        // A6.10, A6.11: Cylindrical 1 edited into a Revolute (Z held) with Offset Z −15 mm: only
        // this mate is placed: the pin moves, the magnet (Fastened 1) stays where it was.
        DoubleClick(ui("mate-row-1")),
        WaitFor("mate-dialog"),
        Wait(5),
        Click(ui("mate-type")),
        WaitFor("mate-type-option-1"),
        Click(ui("mate-type-option-1")),
        Wait(5),
        Click(ui("mate-offset-checkbox")),
        Wait(5),
        Click(ui("mate-offset-z")),
        Key("Ctrl+A"),
        Type("-15 mm"),
        Key("Enter"),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("07-a6.11-edit-moves-this-mate-only"),
        Click(ui("mate-solve")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("08-a6.11-solve-moves-the-magnet-too"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        // On the row's name (its middle is on the limit icon, whose tooltip is only "Limits").
        Hover(ui_at("mate-row-1", 0.3, 0.5)),
        Wait(70),
        Screenshot("09-a8.2-tooltip-offset-persists"),
    ],
)
