// P3.8 (P3.7 carry-over): the Split dialog's Part / Face types and options, as Onshape's Split
// (help page "Split": Part — Keep tools, Trim to face boundaries, Keep both sides with its
// opposite-direction arrow; Face — Keep tool surfaces and curves). A 100 × 60 × 40 block split
// by the Right plane (x = 0 runs along its left end, so the block is drawn from x −30). The
// volumes are asserted in `cadrs_core/tests/pattern.rs` (`split_types_and_options`).
// 01 Part split by Right, Keep both sides on: two parts.
// 02 Keep both sides off: only the piece in front of Right (x > 0) stays, the flip arrow shows.
// 03 the arrow flipped: the piece behind it (x < 0) stays instead.
// 04 the Face tab: "Faces to split" the block's top face, Right splits only that face (its new
//    edge across the top); still one part.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect -30 0 70 60"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(20, 30, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("40"),
        Key("Enter"),
        Key("F"),
        Click(ui("split")),
        WaitFor("split-dialog"),
        Click(xyz(20, 30, 40)),
        Click(ui("split-tool-field")),
        Click(ui("feature-right")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-part-split-keep-both"),
        Click(ui("split-keep-both-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-keep-front-side"),
        Click(ui("split-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-keep-back-side"),
        Click(ui("split-keep-both-checkbox")),
        Click(ui("split-type-1")),
        Click(ui("split-parts-field")),
        Click(xyz(20, 30, 40)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-face-split-top-face"),
        Click(ui("split-dialog-accept")),
    ],
)
