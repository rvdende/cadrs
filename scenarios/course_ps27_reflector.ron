// P3.8 / PS27: the Rocket Guidance Reflector exercise (intro-to-part-studios.md PS27, ex5-step1..13)
// on the stand-in (`cadrs_core::samples::reflector`, `fixtures/reflector_standin.cadrs`: Onshape's
// public document can't be copied; the substitution is recorded in the gap doc), every step
// through the UI. The volume each step takes away, the centre of mass on the Z axis and the mass
// are asserted in `cadrs_core/tests/reflector.rs`. Views turned with `view AZ EL` show pocket
// corners only visible from one side, as orbiting would.
// 01 (ex5-step2) the stand-in: "Reflector Surface Features" closed, Pattern Axis, Feature Sketch.
//    The shown Feature Sketch lies on the top face: its triangles and rectangle get a light
//    translucent fill and the face around them stays orange (P3.11: the face's own outline was
//    filled grey, covering the whole top in 01 and 02).
// 02 (PS27.1) Workspace units: Millimeter, Kilogram.
// 03 (ex5-step3) Extrude 2: Remove, the two triangles, Up to face = Face of Revolve 1 (the curved
//    bottom, picked from below), Offset distance 10 mm, downwards; Merge with all (P3.10, as
//    the course has it).
// 04 (ex5-step4) Fillet 1, 6 mm on the pockets' 12 edges (6 vertical, 6 round the floors).
// 05 (ex5-step5) Circular pattern 1: Feature pattern of Extrude 2 and Fillet 1, Axis of pattern =
//    the Pattern Axis connector, 360 deg, 4, Equal spacing, Reapply features.
// 06 (ex5-step6) Hole: Metric, Simple, at the Pattern Axis connector (the mate connector button),
//    Clearance M45 Close → Ø 46 mm, Start from part, Blind 12 mm, 118 deg.
// 07 (ex5-step7) Sketch 3 on the top face: a point Vertical below the origin, 65 from it (26 from
//    the plate's front edge, y −91 + 26).
// 08 (ex5-step8) Hole: Tapped M10 × 1.5, tap drill Ø8.5, Blind 20, tapped depth 10.02.
// 09 (ex5-step9) Linear pattern 1: Face pattern of the tapped hole's 2 faces (Create selection →
//    Pocket), Direction = the plate's straight side edge, 26 mm, 6, Skip instances (2, 0) and
//    (3, 0) clicked on their dots.
// 10 (ex5-step10) the Feature Sketch shown; Extrude 3: Remove, the rectangle, Blind 11 mm.
// 11 (ex5-step11) Fillet 2, 6 mm on the pocket's 4 vertical edges.
// 12 (ex5-step12) Mirror 1: Face mirror, Create selection → Faces → Pocket on the pocket's floor
//    (9 faces), Add selection, Mirror plane Right; seen from the front, so the pocket (+X) and
//    its mirrored preview (−X) are both in view.
// 13 (ex5-step13) Mass properties in kg (Aluminum - 1060).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("reflector"),
        Key("P"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-standin"),
        // Step 1 (PS27.1): the units.
        Click(ui("document-menu")),
        WaitFor("document-menu-popup"),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-units-mm-kg"),
        Click(ui("units-ok")),
        // Step 3 (PS27.3): Extrude 2, Remove up to the curved bottom, offset 10.
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(60, -16, 45)),
        Click(xyz(16, -60, 45)),
        Click(ui("extrude-operation-2")),
        Click(ui("extrude-end-type")),
        Click(ui("extrude-end-type-option-2")),
        Click(ui("extrude-flip")),
        Custom("view 0 -60"),
        Click(xyz(-40, 40, 2.5)),
        Key("Shift+7"),
        Click(ui("extrude-offset-checkbox")),
        Click(ui("extrude-offset-distance-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        // The P3.8 judge: Merge with all on, as the course's Extrude 2 (ex5-step3).
        Click(ui("extrude-merge-all-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-extrude-up-to-face-offset-10"),
        Click(ui("extrude-dialog-accept")),
        // Step 4 (PS27.4): Fillet 1, 6 mm, 12 edges. Each vertical corner edge is picked from
        // the side it can be seen from, the floor edges from steeply above their wall.
        Click(ui("fillet")),
        WaitFor("fillet-dialog"),
        Custom("view 67.5 40 40 -36 30 0.12"),
        Click(xyz(28, -7, 40)),
        Custom("view -45 40 40 -36 30 0.12"),
        Click(xyz(72, -7, 40)),
        Custom("view -157.5 40 40 -36 30 0.12"),
        Click(xyz(72, -51, 40)),
        Custom("view 22.5 40 40 -36 30 0.12"),
        Click(xyz(7, -28, 40)),
        Custom("view 135 40 40 -36 30 0.12"),
        Click(xyz(7, -72, 40)),
        Custom("view -112.5 40 40 -36 30 0.12"),
        Click(xyz(51, -72, 40)),
        Custom("view 0 72 40 -36 30 0.12"),
        Click(xyz(50, -7, 13.19)),
        Custom("view -90 72 40 -36 30 0.12"),
        Click(xyz(72, -29, 17.60)),
        Custom("view 135 72 40 -36 30 0.12"),
        Click(xyz(50, -29, 14.20)),
        Custom("view 90 72 40 -36 30 0.12"),
        Click(xyz(7, -50, 13.19)),
        Custom("view 180 72 40 -36 30 0.12"),
        Click(xyz(29, -72, 17.60)),
        Custom("view -45 72 40 -36 30 0.12"),
        Click(xyz(29, -50, 14.20)),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Tab"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-fillet-12-edges-6mm"),
        Click(ui("fillet-dialog-accept")),
        // Step 5 (PS27.5): Circular pattern 1, Feature pattern about the Pattern Axis, Reapply.
        Click(ui("pattern")),
        WaitFor("pattern-menu"),
        Click(ui("pattern-menu-circular")),
        WaitFor("circular-pattern-dialog"),
        Click(ui("circular-pattern-type")),
        Click(ui("circular-pattern-type-option-1")),
        Click(ui("feature-extrude-2")),
        Click(ui("feature-fillet-1")),
        Click(ui("circular-pattern-axis-field")),
        Click(ui("feature-pattern-axis")),
        Click(ui("circular-pattern-reapply-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-circular-feature-pattern-reapply"),
        Click(ui("circular-pattern-dialog-accept")),
        // Step 6 (PS27.6): the M45 clearance hole at the Pattern Axis connector.
        Click(ui("hole")),
        WaitFor("hole-dialog"),
        Click(ui("hole-connector-button")),
        Click(ui("feature-pattern-axis")),
        Click(ui("hole-type")),
        Click(ui("hole-type-option-1")),
        Click(ui("hole-size")),
        Click(ui("hole-size-option-17")),
        Click(ui("hole-fit")),
        Click(ui("hole-fit-option-0")),
        Click(ui("hole-termination")),
        Click(ui("hole-termination-option-1")),
        Click(ui("hole-depth-field")),
        Key("Ctrl+A"),
        Type("12"),
        Key("Tab"),
        Click(ui("hole-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-hole-at-connector-m45"),
        Click(ui("hole-dialog-accept")),
        // Step 7 (PS27.7): Sketch 3, a point Vertical below the origin, 65 from it; K hides the
        // connectors.
        Key("K"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(0, 82, 45)),
        Key("N"),
        Key("F"),
        MoveTo(913, 520),
        Key("Shift+S"),
        ClickWorld(2, -64),
        Key("Escape"),
        Key("V"),
        Click(world(2, -64)),
        Click(world(0, 0)),
        Key("Escape"),
        Key("D"),
        Click(world(0, 0)),
        Click(world(0, -64)),
        MoveWorld(-20, -40),
        Wait(2),
        Click(world(-20, -40)),
        Type("65"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-sketch-point-vertical-65"),
        Key("Enter"),
        Key("K"),
        Key("Shift+7"),
        // Step 8 (PS27.8): the tapped hole M10 × 1.5, Blind 20, tapped 10.02.
        Click(ui("hole")),
        WaitFor("hole-dialog"),
        Click(xyz(0, -65, 45)),
        Click(ui("hole-type")),
        Click(ui("hole-type-option-2")),
        Click(ui("hole-size")),
        Click(ui("hole-size-option-8")),
        Click(ui("hole-termination")),
        Click(ui("hole-termination-option-1")),
        Click(ui("hole-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Tab"),
        Click(ui("hole-tapped-depth-field")),
        Key("Ctrl+A"),
        Type("10.02"),
        Key("Tab"),
        Click(ui("hole-dialog-title")),
        // The typed tapped depth survives the Tab into Tap clearance and leaving it
        // (ex5-step8: 6.653).
        ExpectText("hole-tapped-depth", "10.02 mm"),
        ExpectText("hole-tap-clearance", "6.653"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-tapped-hole-m10"),
        Click(ui("hole-dialog-accept")),
        // Step 9 (PS27.9): Linear pattern 1, Face pattern of the tapped hole, 26 mm × 6, (2, 0)
        // and (3, 0) skipped.
        Click(ui("pattern")),
        WaitFor("pattern-menu"),
        Click(ui("pattern-menu-linear")),
        WaitFor("linear-pattern-dialog"),
        Click(ui("linear-pattern-type")),
        Click(ui("linear-pattern-type-option-2")),
        Click(ui("linear-pattern-create-selection")),
        WaitFor("create-selection-dialog"),
        Custom("view 0 70 0 -65 30 0.08"),
        Click(xyz(0, -60.75, 38)),
        Click(ui("create-selection-add")),
        Key("Shift+7"),
        Click(ui("linear-pattern-direction-field")),
        Click(xyz(91, 0, 45)),
        Click(ui("linear-pattern-distance-field")),
        Key("Ctrl+A"),
        Type("26"),
        Key("Tab"),
        Click(ui("linear-pattern-count-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Tab"),
        Click(ui("linear-pattern-skip-checkbox")),
        Click(xyz(0, -13, 29.575)),
        Click(xyz(0, 13, 29.575)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-face-pattern-skip-2-3"),
        Click(ui("linear-pattern-dialog-accept")),
        // Step 10 (PS27.10): the Feature Sketch shown, Extrude 3 of the rectangle, Blind 11.
        Hover(ui("feature-feature-sketch")),
        Wait(3),
        Hover(ui("feature-feature-sketch-visibility")),
        Wait(3),
        Click(ui("feature-feature-sketch-visibility")),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(81.5, 0, 45)),
        Click(ui("extrude-operation-2")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("11"),
        Key("Tab"),
        Click(ui("extrude-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-extrude-rectangle-blind-11"),
        Click(ui("extrude-dialog-accept")),
        // Step 11 (PS27.11): Fillet 2, 6 mm on the pocket's 4 vertical edges.
        Click(ui("fillet")),
        WaitFor("fillet-dialog"),
        Custom("view 135 40 81.5 0 40 0.08"),
        Click(xyz(75, -16, 40)),
        Custom("view -135 40 81.5 0 40 0.08"),
        Click(xyz(88, -16, 40)),
        Custom("view -45 40 81.5 0 40 0.08"),
        Click(xyz(88, 16, 40)),
        Custom("view 45 40 81.5 0 40 0.08"),
        Click(xyz(75, 16, 40)),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Tab"),
        Custom("view 60 50 70 0 30 0.14"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-fillet-pocket-4-edges"),
        Click(ui("fillet-dialog-accept")),
        // Step 12 (PS27.12): Mirror 1, Face mirror of the pocket (Create selection → Pocket).
        Click(ui("mirror")),
        WaitFor("mirror-dialog"),
        Click(ui("mirror-type")),
        Click(ui("mirror-type-option-2")),
        Click(ui("mirror-create-selection")),
        WaitFor("create-selection-dialog"),
        Custom("view 90 80 81.5 0 34 0.1"),
        Click(xyz(81.5, 0, 34)),
        Custom("view 60 50 70 0 30 0.14"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12a-create-selection-pocket-9-faces"),
        Click(ui("create-selection-add")),
        Click(ui("mirror-plane-field")),
        Click(ui("feature-right")),
        // Both pockets in view (P3.11: the mirrored one, across Right at x −75..−88, was off
        // screen).
        Custom("view 0 50 0 0 30 0.2"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-face-mirror-right"),
        Click(ui("mirror-dialog-accept")),
        Key("Shift+7"),
        Key("F"),
        // Step 13 (PS27.13): Mass properties in kg.
        Click(ui("part-row-reflector")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("13-mass-properties-kg"),
    ],
)
