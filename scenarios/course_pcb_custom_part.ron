// P3H.4 (PCB11.4, PCB11.6, X10): a custom part for a package. The fixture document "QFP100
// heatsink model" (`Custom("pcb-sample-part-document")`: one Part Studio, one part, modelled with
// a corner at the origin, and a version V1) stands in for a component's model.
// 01 click U1, then Custom part: Select custom part (the document, its versions, its parts);
// 02 version V1 and the part chosen; 03 OK: U1 shows the part as modelled (off the footprint);
// 04 Translate X 5 mm (a live preview); 05 Center, then Rotate Z 90 deg: in the middle of the
//    footprint, the heatsink turned; 06 ✓ Accept: the library keeps it;
// 07 the component view of QFP100_600MIL shows the custom part on the grid;
// 08 a second PCB Studio with the Vision PCB: its U1 shows the same custom part (the mapping is
//    the workspace library's, so every PCB Studio and every instance of the package follows).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-sample-part-document"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("pcb-import vision controller/Vision PCB"),
        WaitFor("pcb-board-vision-pcb"),
        Click(ui("pcb-panel-component")),
        WaitFor("pcb-component-pane"),
        Click(xyz(50.8, 38.1, 3.175)),
        ExpectText("pcb-part-name", "QFP100_600MIL"),
        Click(ui("pcb-rep-custom")),
        WaitFor("pcb-custom-part-dialog"),
        MoveTo(1100, 900),
        Screenshot("01-select-custom-part"),
        Click(ui("pcb-custom-version")),
        WaitFor("pcb-custom-version-option-1"),
        Click(ui("pcb-custom-version-option-1")),
        WaitFor("pcb-custom-part-row-0"),
        Click(ui("pcb-custom-part-row-0")),
        Screenshot("02-version-and-part"),
        Click(ui("pcb-custom-ok")),
        ExpectText("pcb-custom-source", "QFP100 with heatsink (V1)"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("03-custom-part-as-modelled"),
        Click(ui("pcb-translate-x-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Enter"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("04-translated"),
        Click(ui("pcb-custom-center")),
        Click(ui("pcb-rotate-z-field")),
        Key("Ctrl+A"),
        Type("90"),
        Key("Enter"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("05-centered-and-rotated"),
        Click(ui("pcb-custom-accept")),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("06-accepted"),
        Click(ui("pcb-components-vision-pcb")),
        WaitFor("pcb-component-vision-pcb-qfp100-600mil"),
        Click(ui("pcb-component-vision-pcb-qfp100-600mil")),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("07-component-view-custom"),
        Custom("pcb-studio"),
        Custom("pcb-import vision controller/Vision PCB"),
        WaitFor("pcb-board-vision-pcb"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("08-second-pcb-studio-follows"),
    ],
)
