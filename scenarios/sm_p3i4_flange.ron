// Flange (P3I.4, SM3; `help/feature-tools/sheetmetalflange-dialog-01.png`, `-03.png`): a 60 × 40
// plate (Sheet metal model, Thicken of a sketch region, 1 mm) gets a flange from the Sheet metal
// model ▾: the empty dialog as Onshape's (Inner, Blind 25 mm, Bend angle 90 deg, Automatic
// miter, Use model bend radius); the plate's east edge picked: a 25 mm wall bent up with the
// distance arrow; Partial flange with a Second bound (10 mm each): Overall parameters and End
// conditions, arrows at both ends; accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 60 40"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(30, 20, 0)),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-sheet-metal-menu"),
        Click(ui("sheet-metal-menu-flange")),
        WaitFor("sheet-metal-flange-dialog"),
        Wait(10),
        Custom("view 30 30 40 20 0 0.11"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-flange-dialog"),
        Click(xyz(60, 20, 1)),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-flange-on-the-east-edge"),
        Click(ui("smf-partial-checkbox")),
        Wait(30),
        Click(ui("smf-bound-distance-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        Wait(10),
        Click(ui("smf-second-bound-checkbox")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-partial-flange"),
        Click(ui("sheet-metal-flange-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-accepted"),
    ],
)
