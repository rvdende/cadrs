// T3 / S6: the Slot tool (Offset ▾) (`reference/onshape/entity_tools/slot-examples.png`,
// `slot-multi-applied.png`). "The Slot tool turns a line, an arc or an edge (usually
// construction) into a slot. The entity's length is the distance between the slot's arc
// centers." Two construction lines and a construction arc; clicking the first line makes a
// slot with its Ø width over an end; the second line and the arc, picked in the same use, get
// slots of the same width (Equal). Double-clicking the width sets 8 for all three (S6.2).
// Dragging the first line's end moves the slot with it (S6.3).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("Q"),
        Key("L"),
        ClickWorld(-55, 30),
        ClickWorld(-15, 30),
        Key("Escape"),
        ClickWorld(-55, -20),
        ClickWorld(-22, -38),
        Key("Escape"),
        Key("Escape"),
        Key("A"),
        ClickWorld(15, -25),
        ClickWorld(55, -25),
        ClickWorld(35, 10),
        Key("Escape"),
        Key("Escape"),
        Key("Q"),
        Click(ui("sketch-offset-caret")),
        WaitFor("sketch-variant-slot"),
        Screenshot("01-offset-menu-slot"),
        Click(ui("sketch-variant-slot")),
        MoveWorld(-35, 30),
        Wait(3),
        Screenshot("02-hover-line"),
        ClickWorld(-35, 30),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("03-slot-with-width"),
        ClickWorld(-38.5, -29),
        ClickWorld(35, 10),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04-three-equal-slots"),
        Key("Escape"),
        Wait(3),
        DoubleClick(ui("dim-label-Ø10")),
        WaitFor("dimension-edit"),
        Type("8"),
        Key("Enter"),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("05-width-8-for-all"),
        DragWorld(-15, 30, 5, 40),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("06-source-moved-slot-follows"),
    ],
)
