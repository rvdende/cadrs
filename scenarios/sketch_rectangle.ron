// M4: rectangles and quick dimensions (compare reference/onshape/screens/10–14 and 20). G;
// hovering the origin shows the orange snap square; the first click and the rubber band with the
// live width (below) and height (left); the second click places four lines and opens the
// quick-dimension box on the width with its value selected. Typing replaces it, Tab appends the
// unit, Enter commits the width (a dimension with arrows) and opens the height box; Enter commits
// the height. Then a center-point rectangle from the Rectangle ▾ menu: the first Esc closes its
// quick-dimension boxes, the second leaves the tool (like the line tool); and
// ✓ shows the accepted sketch as grey regions with thin grey edges.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("G"),
        MoveWorld(0.45, 0.3),
        Wait(2),
        Screenshot("01-hover-origin-snap"),
        ClickWorld(0.45, 0.3),
        MoveWorld(49.12, 33.17),
        Wait(2),
        Screenshot("02-rubber-band-live-width-height"),
        ClickWorld(49.12, 33.17),
        MoveWorld(82.5, -37.5),
        Wait(3),
        Screenshot("03-placed-quick-dim-width-box"),
        Type("5"),
        Screenshot("04-typing-replaces-value"),
        Key("Tab"),
        Screenshot("05-tab-appends-unit"),
        Type("50"),
        Screenshot("06-width-50"),
        Key("Enter"),
        Screenshot("07-width-committed-height-box-opens"),
        Type("30"),
        Key("Enter"),
        Screenshot("08-height-committed"),
        Click(ui("sketch-rectangle-caret")),
        WaitFor("sketch-variant-center-rectangle"),
        Screenshot("09-rectangle-menu"),
        Click(ui("sketch-variant-center-rectangle")),
        ClickWorld(-45, -37.5),
        MoveWorld(-22.5, -22.5),
        Wait(2),
        Screenshot("10-center-point-rectangle-rubber-band"),
        ClickWorld(-22.5, -22.5),
        Key("Escape"),
        Screenshot("11-first-esc-closes-quick-dim-boxes"),
        Key("Escape"),
        Screenshot("12-second-esc-leaves-the-tool"),
        Click(ui("sketch-dialog-accept")),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("13-sketch-accepted-grey-regions"),
    ],
)
