// P3H.6 (PCB10, the IDF Assembly exercise; PCB9.1–9.6, PCB7.4) on the authored fixture
// `fixtures/idf/secondary board/secondary board.emn/.emp` (2 × 1.5 in, uBGA48_7.4X7.1 (X2) at
// (4.064182376174947, −16.5), rotation 90, over the bottom-left corner). Compare
// `ex3-step6-keepout-sketch.png`, `ex3-step9-triad-move.png`,
// `ex3-step14-exported-emn-placement.png`, `v7-modify-placement-poster.png`.
// 01 (steps 3–4) the board imported into a PCB Studio; 02 (step 5) Create assembly, defaults:
//    the new tabs;
// 03 (step 6) the "secondary board" Part Studio, Top view: Sketch 2 on the board's top face, the
//    0.5 × 0.375 in corner profile with R0.25 at the bottom-left corner (dimensions in mm,
//    the document's units: 12.7, 9.525, R6.35);
// 04 (step 7) Extrude: Blind, "0.125 in", New; 05 the part renamed "Keep-out";
// 06 (step 8) the "secondary board" assembly, Insert: Keep-out picked; 07 ✓ inside the dialog:
//    it keeps its Part Studio position, over the uBGA;
// 08 (step 9) Top view, the uBGA clicked (its top face: "Area: 52.540 mm²", 7.4 × 7.1), the
//    triad's Y arrow dragged and "1 in" typed; 09 applied: the uBGA 25.4 mm further along Y;
// 10 (step 10) Group, a box dragged over the board (window: the 20 components); 11 grouped, the
//    board fixed;
// 12 (step 11) in PCB Studio, Sync: the dialog on the "secondary board (Assembly)", Top Plane;
// 13 (step 12) the board updated in place: the uBGA moved, the keep-out (dark) at the corner;
// 14 (steps 13–14) Export IDF 3.0 → secondary board.zip → secondary board.emn, Find
//    "uBGA48_7.4X7.1": X = 4.064182376174947, Y = −16.5 + 25.4 = 8.9, rotation 90, TOP, PLACED.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("insert-tab")),
        WaitFor("create-pcb-studio"),
        Click(ui("create-pcb-studio")),
        WaitFor("pcb-tree"),
        Wait(20),
        Click(ui("pcb-import")),
        WaitFor("pcb-import-dialog"),
        Custom("pcb-choose secondary board/secondary board.emn;secondary board/secondary board.emp"),
        Wait(5),
        Click(ui("pcb-import-ok")),
        WaitFor("pcb-board-secondary-board"),
        Wait(40),
        MoveTo(1100, 900),
        Wait(3),
        Screenshot("01-imported"),
        // Step 5.
        Click(ui("pcb-create-assembly")),
        WaitFor("pcb-create-dialog"),
        Wait(5),
        Click(ui("pcb-create-ok")),
        WaitFor("pcb-create-toast"),
        Wait(10),
        Screenshot("02-created"),
        // Step 6: the keep-out sketch on the board's top face.
        Click(ui("tab-secondary-board")),
        Wait(40),
        Key("Shift+5"),
        Wait(30),
        Key("F"),
        Wait(40),
        Custom("pcb-ex3-keepout-sketch"),
        Wait(30),
        DoubleClick(ui("feature-sketch-2")),
        WaitFor("sketch-dialog"),
        Wait(20),
        MoveTo(1450, 880),
        Wait(3),
        Screenshot("03-keepout-sketch"),
        Click(ui("sketch-dialog-accept")),
        Wait(10),
        // Step 7: Extrude Blind 0.125 in, New.
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(0, -20, 0.84)),
        Wait(3),
        Click(ui("extrude-operation-0")),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("0.125 in"),
        Wait(20),
        MoveTo(1450, 880),
        Wait(3),
        Screenshot("04-extrude-0-125-in-new"),
        Key("Enter"),
        Wait(20),
        Key("Shift+7"),
        Wait(30),
        RightClick(ui("part-row-part-2")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        Wait(3),
        Type("Keep-out"),
        Key("Enter"),
        Wait(10),
        ClickAt(1450, 880),
        Wait(5),
        Screenshot("05-keep-out-part"),
        // Step 8: Insert the Keep-out, ✓ inside the dialog.
        Click(ui("tab-secondary-board-assembly")),
        Wait(60),
        Key("Shift+5"),
        Wait(30),
        Key("F"),
        Wait(40),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(10),
        Click(ui("insert-part-keep-out")),
        Wait(5),
        MoveTo(420, 400),
        Wait(5),
        Screenshot("06-insert-keep-out"),
        Click(ui("insert-dialog-accept")),
        Wait(20),
        ClickAt(1450, 880),
        Wait(5),
        Screenshot("07-keep-out-inserted"),
        // Step 9: the interfering uBGA, 1 in along Y with the triad.
        // Its top face where the keep-out's R0.25 leaves it free (the rest is under the keep-out).
        Click(xyz(5.5, -14, 2.04)),
        Wait(10),
        Press(ui("triad-arrow-y")),
        Hover(xyz(5.5, -10, 2.04)),
        Wait(2),
        Hover(xyz(5.5, -2, 2.04)),
        Wait(3),
        Release,
        Wait(3),
        Type("1 in"),
        Wait(3),
        Screenshot("08-triad-1-in"),
        Key("Enter"),
        Wait(10),
        MoveTo(1450, 880),
        Wait(3),
        Screenshot("09-moved-1-in"),
        Key("Escape"),
        ClickAt(1450, 880),
        Wait(5),
        // Step 10: Group the components (box select), Fix the board.
        Click(ui("group")),
        WaitFor("group-dialog"),
        Wait(5),
        Press(xyz(-8, 18, 2)),
        Hover(xyz(20, 0, 2)),
        Wait(2),
        Hover(xyz(45.2, -22.4, 2)),
        Wait(5),
        Release,
        Wait(10),
        MoveTo(1450, 880),
        Wait(3),
        Screenshot("10-group-box-select"),
        Click(ui("group-dialog-accept")),
        Wait(10),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(10),
        ClickAt(1450, 880),
        Wait(5),
        Screenshot("11-grouped-and-fixed"),
        // Steps 11–12: sync the assembly, same parameters.
        Click(ui("tab-pcb-studio-1")),
        Wait(30),
        Click(ui("pcb-sync")),
        WaitFor("pcb-sync-dialog"),
        Wait(10),
        Screenshot("12-sync-dialog"),
        Click(ui("pcb-sync-ok")),
        WaitFor("pcb-sync-toast"),
        Wait(40),
        Key("Shift+5"),
        Wait(40),
        MoveTo(1100, 900),
        Wait(3),
        Screenshot("13-synced-moved-and-keep-out"),
        // Steps 13–14: Export IDF 3.0 and find the moved component in the .emn.
        Click(ui("pcb-export")),
        WaitFor("pcb-export-dialog"),
        Wait(5),
        Click(ui("pcb-export-ok")),
        WaitFor("pcb-export-toast"),
        Wait(5),
        Click(ui("pcb-export-open-emn")),
        WaitFor("pcb-emn-viewer"),
        Wait(5),
        Click(ui("pcb-emn-find-field")),
        Type("ubga48_7"),
        Key("Enter"),
        Wait(10),
        ExpectText("pcb-emn-scroll", "uBGA48_7.4X7.1 7401048 X2 4.064182376174947 8.9"),
        Screenshot("14-exported-emn-ubga48"),
    ],
)
