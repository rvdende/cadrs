// P3I.8 / X7, exercise E4 "Sheet metal rework" end to end (`ex4-sheet-metal-rework/goal.png`,
// step-02–10) through the dialogs, on its stand-in (`fixtures/sheetmetal/sm_e4_standin.cadrs`: the
// Lower Enclosure, a U-channel with an obround slot through both side walls, its model named
// "Lower Enclosure"); `samples::sheetmetal_exercises::rework_after_finish` makes the same features
// and `cadrs_core/tests/sheetmetal_exercises.rs` checks them.
// 01 the part; 02 Finish sheet metal model on it: the warning that later changes don't show in
// the flat; 03 accepted.
// 04 step 3: Sketch 3 on the right wall's face, Use (U) of the slot's outline: its four curves
//    (from the slot's sketch: the folded slot edge is a polygon, see the scenario).
// 05 step 4: Plane 1, Plane point: the slot's lower line's end (a vertex of Sketch 3) and Front.
// 06 step 5: Sketch 4 on Plane 1: a 8 × 2 rectangle out of the wall under the slot.
// 07 step 6: Sweep 1, Solid, Add: Sketch 4 along Sketch 3: a rim round the slot.
// 08 step 7: Mirror 1, Feature mirror of Sweep 1 about Right, Reapply features: the rim on the
//    left wall too.
// 09 step 8: Fillet 1, both rims' outer edges, 0.5; 10 step 9: Fillet 2, their inner edges.
// 11 step 10: the Sheet metal table and flat view, Context "Lower Enclosure": the flat shows none
//    of it (11a the context dropdown).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("fixture sheetmetal/sm_e4_standin"),
        Wait(90),
        Custom("view 40 25 0 -75 30 0.16"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-lower-enclosure"),
        Click(ui("sheet-metal-model-caret")),
        Wait(10),
        Click(ui("sheet-metal-menu-finish")),
        WaitFor("sheet-metal-finish-dialog"),
        Wait(10),
        Click(xyz(0, -120, 0.75)),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-finish-warning"),
        Click(ui("sheet-metal-finish-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-finished"),
        // Step 3: a sketch on the wall's face; Use of the slot's outline. The folded part's slot
        // edge is a polygon (sheet metal cuts are folded from the flat), so the slot's own
        // sketch (Sketch 2, shown with its eye) is what Use takes: its two lines and two arcs.
        Hover(ui("feature-sketch-2")),
        Wait(3),
        Click(ui("feature-sketch-2-visibility")),
        Wait(10),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Custom("view 65 20 35 -75 30 0.06"),
        Wait(20),
        Click(xyz(35, -40, 48)),
        Wait(20),
        Key("U"),
        Wait(3),
        Click(xyz(0, -75, 24)),
        Wait(5),
        Click(xyz(0, -75, 36)),
        Wait(5),
        Click(xyz(0, -95, 30)),
        Wait(5),
        Click(xyz(0, -55, 30)),
        Wait(10),
        Key("Escape"),
        Wait(3),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-sketch-use-slot-edges"),
        Click(ui("sketch-dialog-accept")),
        Wait(20),
        Hover(ui("feature-sketch-2")),
        Wait(3),
        Click(ui("feature-sketch-2-visibility")),
        Wait(10),
        // Step 4: Plane 1, Plane point: a vertex of the sketch and the Front plane.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Wait(3),
        Click(ui("plane-type")),
        Wait(3),
        Click(ui("plane-type-option-1")),
        Wait(5),
        Click(xyz(35, -61, 24)),
        Wait(5),
        Click(ui("feature-front")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-plane-point"),
        Click(ui("plane-dialog-accept")),
        Wait(20),
        // Step 5: Sketch 4 on Plane 1: the 8 × 2 rectangle.
        Click(ui("feature-plane-1")),
        Wait(3),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(10),
        Key("G"),
        Wait(2),
        ClickWorld(0, -2),
        Wait(3),
        ClickWorld(8, 0),
        Wait(5),
        Key("Escape"),
        Wait(3),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-rectangle-on-plane-1"),
        Click(ui("sketch-dialog-accept")),
        Wait(20),
        // Step 6: Sweep 1, Add: the rectangle along the slot's outline.
        Click(ui("sweep")),
        WaitFor("sweep-dialog"),
        Wait(3),
        Click(ui("feature-sketch-4")),
        Wait(5),
        Click(ui("sweep-operation-1")),
        Wait(5),
        Click(ui("sweep-path-field")),
        Wait(3),
        Click(ui("feature-sketch-3")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-sweep-add"),
        Click(ui("sweep-dialog-accept")),
        Wait(30),
        // Step 7: Mirror 1, Feature mirror about Right, Reapply features.
        Click(ui("mirror")),
        WaitFor("mirror-dialog"),
        Wait(5),
        Click(ui("mirror-type")),
        Wait(3),
        Click(ui("mirror-type-option-1")),
        Wait(5),
        Click(ui("feature-sweep-1")),
        Wait(3),
        Click(ui("mirror-plane-field")),
        Wait(3),
        Click(ui("feature-right")),
        Wait(10),
        Click(ui("mirror-reapply-checkbox")),
        Wait(40),
        Custom("view 30 25 0 -75 30 0.12"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-mirror-reapply"),
        Click(ui("mirror-dialog-accept")),
        Wait(30),
        // Steps 8–9: the rims' outer, then inner edges.
        Click(ui("fillet")),
        WaitFor("fillet-dialog"),
        Wait(5),
        Custom("view 65 20 35 -75 30 0.06"),
        Wait(20),
        Click(xyz(43, -75, 22)),
        Wait(3),
        Custom("view -65 20 -35 -75 30 0.06"),
        Wait(20),
        Click(xyz(-43, -75, 22)),
        Wait(3),
        Click(ui("fillet-size-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("0.5"),
        Key("Tab"),
        Wait(40),
        Custom("view 65 20 35 -75 30 0.06"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-fillet-outer-edges"),
        Click(ui("fillet-dialog-accept")),
        Wait(30),
        Click(ui("fillet")),
        WaitFor("fillet-dialog"),
        Wait(5),
        Click(xyz(43, -75, 24)),
        Wait(3),
        Custom("view -65 20 -35 -75 30 0.06"),
        Wait(20),
        Click(xyz(-43, -75, 24)),
        Wait(3),
        Click(ui("fillet-size-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("0.5"),
        Key("Tab"),
        Wait(40),
        Custom("view 65 20 35 -75 30 0.06"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-fillet-inner-edges"),
        Click(ui("fillet-dialog-accept")),
        Wait(30),
        // Step 10.
        Custom("view 40 25 0 -75 30 0.16"),
        Wait(20),
        Click(ui("panel-sheet-metal")),
        Wait(60),
        Click(ui("smt-context")),
        Wait(10),
        Screenshot("11a-context-dropdown"),
        Key("Escape"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-flat-without-the-rework"),
    ],
)
