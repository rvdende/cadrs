// P3F.4: `#` in the dimension value box lists the variables, as Onshape does.
// 01 #width = 40 mm and #wall = 3 mm, a 60 × 30 rectangle on Top, its bottom side dimensioned:
//    "#" typed in the value box lists #width and #wall with their values, then New variable….
// 02 "#wi" typed: only #width.
// 03 Enter puts "#width" in (the list closes); 04 Enter sets it: the rectangle is 40 wide.
// 05 the right side dimensioned, "#" typed and #wall clicked in the list: "#wall" put in.
// 06 "#len" typed instead and Down to New variable…: 07 Enter makes #len (holding the side's
//    value) above Sketch 1 in the feature list and puts "#len" in; 08 the side is driven by
//    it, the ƒx before both driven values.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("variable")),
        WaitFor("variable-dialog"),
        Click(ui("variable-name-field")),
        Key("Ctrl+A"),
        Type("width"),
        Click(ui("variable-value-field")),
        Key("Ctrl+A"),
        Type("40 mm"),
        Click(ui("variable-dialog-title")),
        Click(ui("variable-dialog-accept")),
        Click(ui("variable")),
        WaitFor("variable-dialog"),
        Click(ui("variable-name-field")),
        Key("Ctrl+A"),
        Type("wall"),
        Click(ui("variable-value-field")),
        Key("Ctrl+A"),
        Type("3 mm"),
        Click(ui("variable-dialog-title")),
        Click(ui("variable-dialog-accept")),
        Custom("sketch top rect 0 0 60 30"),
        Wait(10),
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Key("D"),
        Click(world(30, 0)),
        Click(world(30, -5)),
        Key("Ctrl+A"),
        Type("#"),
        Wait(3),
        Screenshot("01-hash-lists-variables"),
        Type("wi"),
        Wait(3),
        Screenshot("02-filtered"),
        Key("Enter"),
        Wait(3),
        Screenshot("03-name-put-in"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-width-40"),
        Key("D"),
        Click(world(40, 15)),
        Click(world(52, 15)),
        Key("Ctrl+A"),
        Type("#"),
        Wait(2),
        Click(ui("dimension-edit-variable-#wall")),
        Wait(3),
        Screenshot("05-clicked-wall"),
        Key("Ctrl+A"),
        Type("#len"),
        Key("Down"),
        Wait(3),
        Screenshot("06-new-variable-highlighted"),
        Key("Enter"),
        Wait(3),
        Screenshot("07-new-variable-made"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-len-above-sketch"),
    ],
)
