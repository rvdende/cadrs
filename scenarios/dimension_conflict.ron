// M7: a conflicting dimension (compare reference/onshape/screens/15, 15a and NOTES.md
// "Errors"). A rectangle from the origin with width 50 and height 30 is fully defined (black).
// The Dimension tool on two opposite corners, placed inside the rectangle, adds the diagonal:
// it would over-define the sketch, so it is created driven (light blue-grey, measured, not
// solved; `dimension.md` "Over-defining"). Right-click → "Change to driving dimension" makes it
// driving: it over-defines the sketch, so it and the edges at its corners turn red, the sketch
// turns red in the feature list and the yellow banner appears. Editing it to 70 cannot be
// solved: the rectangle keeps its size. Selecting it and pressing Delete recovers: black, no
// banner. Ctrl+Z brings the conflict back; Ctrl+Y removes it again.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0.45, 0.3),
        ClickWorld(49.12, 33.17),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("01-fully-constrained-black"),
        Key("D"),
        Wait(2),
        ClickWorld(0, 0),
        Wait(2),
        ClickWorld(50, 30),
        MoveWorld(15, 22),
        Wait(2),
        Screenshot("02-diagonal-follows-cursor-driven"),
        ClickWorld(15, 22),
        Wait(4),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("03-placed-as-driven-grey"),
        Key("Escape"),
        Wait(2),
        RightClick(ui("dim-label-58.31")),
        WaitFor("dimension-make-driving"),
        Wait(3),
        Screenshot("04-context-menu-change-to-driving"),
        Click(ui("dimension-make-driving")),
        Wait(4),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("05-driving-over-defines-red-banner"),
        DoubleClick(ui("dim-label-58.31")),
        Wait(4),
        Type("70"),
        Key("Enter"),
        Wait(4),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("06-value-70-conflicts-unsolved"),
        Click(ui("dim-label-70")),
        Wait(2),
        Key("Delete"),
        Wait(4),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("07-deleted-recovers-black"),
        Key("Ctrl+Z"),
        Wait(4),
        Screenshot("08-undo-conflict-back"),
        Key("Ctrl+Y"),
        Wait(4),
        Screenshot("09-redo-delete"),
    ],
)
