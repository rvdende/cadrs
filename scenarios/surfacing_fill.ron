// Fill (`reference/onshape/surfacing.md` FL1, FL4): a rectangle on Front (sketch lines) filled
// as a new surface; then a 60 × 40 × 20 block's four top edges filled: a flat surface on the
// top (area 2400 mm²); Add; accepted. The Continuity select offers Position (G0) only.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 60 40"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(30, 20, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Wait(10),
        Key("F"),
        Wait(40),
        Click(ui("thicken")),
        Wait(5),
        Click(ui("surfacing-menu-fill")),
        WaitFor("fill-dialog"),
        Wait(5),
        Click(xyz(30, 0, 20)),
        Wait(3),
        Click(xyz(60, 20, 20)),
        Wait(3),
        Click(xyz(30, 40, 20)),
        Wait(3),
        Click(xyz(0, 20, 20)),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-four-edges-filled"),
        Click(ui("fill-continuity")),
        Wait(5),
        Screenshot("02-continuity-options"),
        Key("Escape"),
        Wait(3),
        Click(ui("fill-operation-1")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-add"),
        Click(ui("fill-dialog-accept")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-accepted"),
    ],
)
