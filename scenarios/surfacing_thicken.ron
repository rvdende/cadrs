// Thicken (`reference/onshape/surfacing.md` TK1–TK4): the toolbar's Thicken ▾ menu (Thicken,
// Fill, Helix); a 60 × 40 × 20 block's top face picked, Thickness 1 = 5 mm: a new 60 × 40 × 5
// part on top (volume asserted in `cadrs_core/tests/surfacing.rs`); the opposite direction
// arrow sends it into the block; Mid plane splits it about the face; Add merges it; accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 60 40"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(30, 20, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Key("F"),
        Click(ui("thicken")),
        Screenshot("01-thicken-menu"),
        Click(ui("surfacing-menu-thicken")),
        WaitFor("thicken-dialog"),
        Click(xyz(30, 20, 20)),
        Click(ui("thicken-thickness1-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-top-face-5mm-new"),
        Click(ui("thicken-thickness1-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-opposite-direction"),
        Click(ui("thicken-mid-plane-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-mid-plane"),
        Click(ui("thicken-operation-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-add"),
        Click(ui("thicken-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-accepted"),
    ],
)
