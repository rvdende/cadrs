// T3 / S7: polygons (`reference/onshape/entity_tools/polygon-inscribed-circumscribed.png`,
// `polygon-inscribed-sides.png`). Polygon ▾ lists Inscribed and Circumscribed polygon
// (Onshape's names: an inscribed polygon has the circle inscribed in it).
// - Inscribed: click the center, click the size (a side's middle); moving up or right adds
//   sides (8), down or left removes them (5); the last click places it on its dash-dot
//   construction circle, with hollow points where the circle touches the sides, and the
//   diameter box: 40 (S7.3).
// - Circumscribed: center, size (a corner), and a click without moving: 6 sides, the corners
//   on the circle. Its "6x" value, double-clicked, takes 8 (S7.4): the polygon is rebuilt.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Click(ui("sketch-polygon-caret")),
        WaitFor("sketch-variant-circumscribed-polygon"),
        Wait(3),
        Screenshot("01-polygon-menu"),
        Click(ui("sketch-variant-inscribed-polygon")),
        Wait(2),
        ClickWorld(-35, 0),
        MoveWorld(-25, 5),
        MoveWorld(-15, 0),
        Wait(3),
        Screenshot("02-size"),
        ClickWorld(-15, 0),
        MoveWorld(-13, 2),
        MoveWorld(-11, 4),
        Wait(3),
        Screenshot("03-up-right-more-sides"),
        MoveWorld(-15, 0),
        MoveWorld(-17, -2),
        Wait(3),
        Screenshot("04-down-left-fewer-sides"),
        ClickWorld(-17, -2),
        Wait(4),
        Screenshot("05-placed-diameter-box"),
        Type("40"),
        Key("Enter"),
        Wait(4),
        Click(ui("sketch-polygon-caret")),
        WaitFor("sketch-variant-circumscribed-polygon"),
        Wait(2),
        Click(ui("sketch-variant-circumscribed-polygon")),
        Wait(2),
        ClickWorld(35, 0),
        MoveWorld(45, 5),
        MoveWorld(55, 0),
        Wait(2),
        ClickWorld(55, 0),
        Wait(2),
        ClickWorld(55, 0),
        Wait(4),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("06-inscribed-and-circumscribed"),
        DoubleClick(ui("dim-label-6x")),
        WaitFor("dimension-edit"),
        Wait(3),
        Screenshot("07-edit-side-count"),
        Type("8"),
        Key("Enter"),
        Wait(4),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("08-eight-sides"),
    ],
)
