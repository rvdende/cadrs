        RightClick(ui("instance-row-2")),
        WaitFor("asm-edit-in-context"),
        Click(ui("asm-edit-in-context")),
        WaitFor("context-bar"),
        Key("F"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(65, 0, 0)),
        Key("N"),
        MoveTo(913, 520),
        Key("U"),
