// P3F.4: `#` in a feature dialog's value field lists the variables, as in the dimension value box.
// 01 #width = 40 mm and #wall = 3 mm, a 60 × 30 rectangle on Top, Extrude: "#" typed in the Depth
//    field lists #width and #wall with their values, then New variable….
// 02 "#wa" typed: only #wall.
// 03 Enter puts "#wall" in (the list closes); 04 Enter sets it: the extrude is 3 mm high.
// 05 Extrude 1 edited, "#thick" typed in its Depth: no variable matches, New variable… only.
// 06 Enter makes #thick (holding the depth, 3 mm) above Extrude 1 and puts "#thick" in.
// 07 "#thick" set: the feature list has #thick above Extrude 1.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("variable")),
        WaitFor("variable-dialog"),
        Click(ui("variable-name-field")),
        Key("Ctrl+A"),
        Type("width"),
        Click(ui("variable-value-field")),
        Key("Ctrl+A"),
        Type("40 mm"),
        Click(ui("variable-dialog-title")),
        Click(ui("variable-dialog-accept")),
        Click(ui("variable")),
        WaitFor("variable-dialog"),
        Click(ui("variable-name-field")),
        Key("Ctrl+A"),
        Type("wall"),
        Click(ui("variable-value-field")),
        Key("Ctrl+A"),
        Type("3 mm"),
        Click(ui("variable-dialog-title")),
        Click(ui("variable-dialog-accept")),
        Custom("sketch top rect 0 0 60 30"),
        Wait(10),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-1")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("#"),
        Wait(3),
        Screenshot("01-hash-lists-variables"),
        Type("wa"),
        Wait(3),
        Screenshot("02-filtered"),
        Key("Enter"),
        Wait(3),
        Screenshot("03-name-put-in"),
        Key("Enter"),
        Wait(10),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-depth-wall"),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("#thick"),
        Wait(3),
        Screenshot("05-new-variable-only"),
        Key("Enter"),
        Wait(3),
        Screenshot("06-new-variable-made"),
        Key("Enter"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-thick-above-extrude"),
    ],
)
