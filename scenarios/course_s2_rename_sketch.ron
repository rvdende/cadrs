// T2 / S2.3: "Right-clicking a sketch (in the feature list or the viewport) offers Edit, Rename
// and Delete. Double-clicking the feature row edits the sketch." A sketch with a rectangle,
// accepted. Right-click its row → Rename: the row turns into a text field with the name
// selected; typing and Enter renames it (one undo step: Ctrl+Z brings the old name back,
// Ctrl+Y the new one). Right-clicking the sketch in the viewport offers the same; Rename there
// and Esc keeps the name. Double-clicking the row opens the sketch.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("G"),
        ClickWorld(-30, -20),
        ClickWorld(30, 20),
        Key("Escape"),
        Key("Escape"),
        Key("Enter"),
        RightClick(ui("feature-sketch-1")),
        WaitFor("feature-context-menu"),
        Hover(ui("feature-rename")),
        Wait(3),
        Screenshot("01-feature-menu-rename"),
        Click(ui("feature-rename")),
        WaitFor("feature-rename"),
        Screenshot("02-row-edits-in-place"),
        Type("Base plate"),
        Screenshot("03-typed"),
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-renamed"),
        Key("Ctrl+Z"),
        Screenshot("05-undo-old-name"),
        Key("Ctrl+Y"),
        Screenshot("06-redo-new-name"),
        RightClick(xyz(10, 10, 0)),
        WaitFor("viewport-context-menu"),
        Hover(ui("viewport-rename-sketch")),
        Wait(3),
        Screenshot("07-viewport-menu-edit-rename-delete"),
        Click(ui("viewport-rename-sketch")),
        WaitFor("feature-rename"),
        Type("Other"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("08-esc-keeps-the-name"),
        DoubleClick(ui("feature-base-plate")),
        WaitFor("sketch-dialog"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("09-double-click-edits"),
    ],
)
