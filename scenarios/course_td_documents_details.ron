// P3E.1 (test-drive.md TD3.5, TD3.6, TD3.7, TD3.8, X5; derived-and-linking ER8.5), against
// `test-drive/lesson-documents-page.png`: 6 seeded documents plus the linked-documents block
// (`linked-block`): "Block source" (with version V1, in the folder "Linked parts") and "Block
// consumer", whose Assembly 1 holds an instance of the block at V1.
// 01 "Block" searched (Block source is filed in "Linked parts", so the root doesn't list it);
//    right-click › Properties… on Block source: the modal with its thumbnail, Owner, Document
//    description, Document labels, Created by, Created, Modified and the location.
// 02 the description typed ("Extended hubcap").
// 03 Enter: saved (a library step), the field shows it.
// 04 closed and opened again: the description is kept.
// 05 right-click › History…: V1 from the document's history, with its time and author.
// 06 right-click › Used in…: Block consumer's Assembly 1 uses Block (V1).
// 07 Escape closes it.
// 08 double-click on a row (Block consumer): the document opens (loaded).
// 11 back, the search cleared: right-click › Properties… on the folder "Linked parts" (owner,
//    created, 2 documents).
// 12 double-click: the folder opens, a breadcrumb "‹ Documents › Linked parts" and its
//    documents (Block copy, Block source).
// 13 the breadcrumb's root: back at the top.
// 16 the grid view: folder and document cards.
// 17 a card selected in the grid.
// 18 Enter opens the selected document.
Scenario(
    start: Some("document"),
    seed_documents: 6,
    steps: [
        WaitFor("document-shell"),
        Custom("linked-block"),
        Custom("linked-block consumer 1"),
        Click(ui("app-menu")),
        Click(ui("app-documents")),
        WaitFor("doc-row-0"),
        // Block source is filed in "Linked parts" (P3E.2: listed inside its folder, not at the
        // root): the search finds it, with Block consumer and Block copy.
        Click(ui("search")),
        Type("Block"),
        Click(ui("col-name")),
        RightClick(ui("doc-name-2")),
        WaitFor("ctx-properties"),
        Click(ui("ctx-properties")),
        WaitFor("details-description"),
        Screenshot("01-properties"),
        Click(ui("details-description-field")),
        Type("Extended hubcap"),
        Screenshot("02-description-typed"),
        Key("Enter"),
        Screenshot("03-description-saved"),
        Click(ui("details-dialog-close")),
        RightClick(ui("doc-name-2")),
        WaitFor("ctx-properties"),
        Click(ui("ctx-properties")),
        WaitFor("details-description"),
        Screenshot("04-description-kept"),
        Click(ui("details-dialog-close")),
        RightClick(ui("doc-name-2")),
        WaitFor("ctx-history"),
        Click(ui("ctx-history")),
        WaitFor("details-version-0"),
        Hover(ui("details-version-0")),
        Wait(3),
        Screenshot("05-history"),
        Click(ui("details-dialog-close")),
        RightClick(ui("doc-name-2")),
        WaitFor("ctx-used-in"),
        Click(ui("ctx-used-in")),
        WaitFor("details-used-0"),
        Screenshot("06-used-in"),
        Key("Escape"),
        Screenshot("07-details-closed"),
        DoubleClick(ui("doc-name-0")),
        WaitFor("document-shell"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("08-double-click-opens"),
        Click(ui("app-menu")),
        Click(ui("app-documents")),
        WaitFor("doc-row-0"),
        Click(ui("search")),
        Key("Ctrl+A"),
        Key("Backspace"),
        WaitFor("folder-row-0"),
        RightClick(ui("folder-name-0")),
        WaitFor("folder-properties"),
        Click(ui("folder-properties")),
        WaitFor("details-folder-count"),
        Screenshot("11-folder-properties"),
        Key("Escape"),
        DoubleClick(ui("folder-name-0")),
        WaitFor("crumb-root"),
        Screenshot("12-folder-opened"),
        Click(ui("crumb-root")),
        WaitFor("folder-row-0"),
        Screenshot("13-back-at-top"),
        Click(ui("view-grid")),
        WaitFor("doc-grid"),
        Screenshot("16-grid-view"),
        Click(ui("grid-doc-1")),
        Screenshot("17-grid-card-selected"),
        Key("Enter"),
        WaitFor("document-shell"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("18-enter-opens"),
    ],
)
