// M7: dimension kinds (compare reference/onshape/dimension.md and dimension/*.png). With the
// Dimension tool (D): a circle gets a diameter "Ø" and an arc a radius "R" (no toggle), both
// written along their leader (the radius inside the arc, on its radial line); two
// lines get the angle between them, the cursor's quadrant picking which angle (60° inside the
// V, 120° in the neighbouring quadrant); two points get a horizontal distance when the label is
// dragged straight down, a vertical one when dragged to the side, and the aligned (shortest)
// distance in the diagonal regions.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        // A circle, an arc, a V of two lines and a slanted line.
        Key("C"),
        ClickWorld(-40, 35),
        ClickWorld(-25, 35),
        Key("Escape"),
        Key("A"),
        ClickWorld(5, 40),
        ClickWorld(65, 40),
        ClickWorld(35, 70),
        Key("Escape"),
        Key("L"),
        ClickWorld(-65, -62),
        ClickWorld(-20, -62),
        Key("Escape"),
        ClickWorld(-65, -62),
        ClickWorld(-50, -36.02),
        Key("Escape"),
        ClickWorld(15, -62),
        ClickWorld(55, -30),
        Key("Escape"),
        Key("Escape"),
        // Circle: diameter.
        Key("D"),
        MoveWorld(-25, 35),
        Wait(2),
        Screenshot("01-hover-circle"),
        ClickWorld(-25, 35),
        MoveWorld(-12, 52),
        Wait(2),
        Screenshot("02-diameter-follows-cursor"),
        ClickWorld(-12, 52),
        Key("Enter"),
        // Arc: radius.
        ClickWorld(35, 70),
        MoveWorld(43, 53.9),
        Wait(2),
        Screenshot("03-radius-follows-cursor"),
        ClickWorld(43, 53.9),
        Key("Enter"),
        // Two lines: the angle, by quadrant.
        ClickWorld(-30, -62),
        ClickWorld(-57.5, -49.01),
        MoveWorld(-39, -47),
        Wait(2),
        Screenshot("04-angle-inside-follows-cursor-about-60"),
        MoveWorld(-88, -48),
        Wait(2),
        Screenshot("05-angle-other-quadrant-120"),
        MoveWorld(-39, -47),
        Wait(2),
        ClickWorld(-39, -47),
        // Typing the value makes it exactly 60°.
        Type("60"),
        Key("Enter"),
        // Two points: horizontal, vertical or aligned by where the label goes.
        ClickWorld(15, -62),
        ClickWorld(55, -30),
        MoveWorld(35, -72),
        Wait(2),
        Screenshot("06-two-points-horizontal"),
        MoveWorld(68, -46),
        Wait(2),
        Screenshot("07-two-points-vertical"),
        MoveWorld(28, -38),
        Wait(2),
        Screenshot("08-two-points-aligned"),
        ClickWorld(28, -38),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("09-diameter-radius-angle-aligned"),
    ],
)
