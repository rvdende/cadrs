// Sheet metal table and flat view (P3I.3; SM1.2–SM1.4, SM13.1, SM13.2, SM13.5; compare
// `help/feature-tools/sheetmetalflatpatterntable-02.png` and lesson `13-bend-and-joint-table`
// frames t0016–t0052): a 100 × 60 × 40 block converted (T 2, R 3) with its four top edges bent.
// The right strip's Sheet metal table and flat view button opens the panel: the context
// dropdown, the Bends and Other joints tables, the flat view with its cube, dashed centrelines
// and bend labels. A row click selects the bend in the model and the flat (orange), a second
// row adds to it, a click on a bend in the model selects its row, a click in the flat view on a
// bend selects it too; the Bends caret collapses its table; a wall's face hovered or selected
// in the model shows in the flat, a wall hovered in the flat in the model; the flat view's menu
// on the separate lid names it and exports it; the button closes the panel.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 100 60"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(50, 30, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("40"),
        Key("Enter"),
        Wait(10),
        Key("F"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(5),
        Click(ui("sm-bend-radius-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("3"),
        Key("Tab"),
        Wait(5),
        Click(ui("sm-parts-field")),
        Wait(3),
        Click(xyz(50, 30, 40)),
        Wait(40),
        // Bend the four top edges: an open box (upside down) and a separate bottom.
        Click(ui("sm-bends-field")),
        Wait(20),
        Click(xyz(50, 0, 40)),
        Wait(5),
        Click(xyz(100, 30, 40)),
        Wait(5),
        Click(xyz(50, 60, 40)),
        Wait(5),
        Click(xyz(0, 30, 40)),
        Wait(20),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(40),
        Key("F"),
        Wait(20),
        Click(ui("panel-sheet-metal")),
        WaitFor("smt-panel"),
        Wait(30),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("01-panel-open"),
        Click(ui("smt-bend-row-1")),
        Wait(10),
        MoveTo(700, 900),
        Wait(5),
        Screenshot("02-row-selects-bend-in-model-and-flat"),
        Click(ui("smt-bend-row-3")),
        Wait(10),
        MoveTo(700, 900),
        Wait(5),
        Screenshot("03-second-row-adds"),
        // Click the rows again: deselected.
        Click(ui("smt-bend-row-1")),
        Wait(5),
        Click(ui("smt-bend-row-3")),
        Wait(5),
        // A click on the front bend in the model (its outside, halfway round).
        Click(xyz(50, -0.5, 40.5)),
        Wait(10),
        MoveTo(700, 900),
        Wait(5),
        Screenshot("04-model-bend-selects-row"),
        Hover(ui("smt-bend-row-2")),
        Wait(10),
        Screenshot("05-row-hover-highlights-model"),
        Click(ui("smt-bends-caret")),
        Wait(10),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("06-bends-collapsed"),
        Click(ui("smt-bends-caret")),
        Wait(10),
        // SM1.4 for walls: the box's base hovered in the model is outlined in the flat; selected,
        // it is outlined orange there.
        Hover(xyz(50, 30, 40)),
        Wait(10),
        Screenshot("08-model-face-hover-outlines-its-flat-piece"),
        Click(xyz(50, 30, 40)),
        Wait(10),
        MoveTo(700, 900),
        Wait(5),
        Screenshot("09-model-face-selected-in-the-flat"),
        Click(xyz(50, 30, 40)),
        Wait(5),
        // A wall hovered in the flat lights its face in the model.
        Hover(ui_at("smt-flat", 0.23, 0.4)),
        Wait(10),
        Screenshot("10-flat-wall-hover-lights-the-model-face"),
        // The flat view's menu on the separate lid (a multi-part model): its items name it, and
        // Export acts on it.
        RightClick(ui_at("smt-flat", 0.585, 0.73)),
        Wait(10),
        Screenshot("11-flat-menu-on-the-lid"),
        Hover(ui("smt-flat-select-other")),
        Wait(10),
        Screenshot("12-select-other"),
        Click(ui("smt-flat-export")),
        Wait(20),
        Screenshot("13-export-of-the-lids-flat"),
        Key("Escape"),
        Wait(10),
        Click(ui("panel-sheet-metal")),
        Wait(20),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("07-panel-closed"),
    ],
)
