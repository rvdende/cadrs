        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Socket"),
        Wait(5),
        Click(ui("insert-part-socket")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Ball"),
        Wait(5),
        Click(ui("insert-part-ball")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
