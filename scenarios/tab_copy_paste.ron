// A tab from one document (or one running cadrs) to another (`cadrs_app::tab_clipboard`). The
// Control Arm (`Custom("control-arm")`); the files go to `target/exports/tab_copy_paste/`,
// emptied first.
// 01 the tab menu of Part Studio 1: Copy hovered.
// 02 Ctrl+V: "Part Studio 1 (1)" is pasted right of it and open, with its features and parts.
// 03 the tab bar right-clicked beside the tabs: "Paste Part Studio 1 from <document>".
// 04 pasted again: "Part Studio 1 (2)".
// 05 the + menu: the same Paste item at its end.
// 06 the tab's Export dialog: CADRS chosen (the tab with its features; no model options).
// 07 exported: the toast names "Part Studio 1.cadrs".
// 08 + ▸ Import… of that file: its tab comes in as "Part Studio 1 (3)", features and all.
// 09 Sketch 1 selected and copied with Ctrl+C, then Ctrl+V in a new Part Studio: it is there.
// 10 its menu: Copy, and "Paste Sketch 1 from <document>".
// 11 pasted again: a second copy, under ids of its own.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("clear-dir target/exports/tab_copy_paste"),
        Custom("control-arm"),
        Key("Shift+7"),
        RightClick(ui("tab-part-studio-1")),
        WaitFor("tab-copy"),
        Hover(ui("tab-copy")),
        Wait(8),
        Screenshot("01-tab-menu-copy"),
        Click(ui("tab-copy")),
        Wait(5),
        Key("Ctrl+V"),
        WaitFor("tab-part-studio-1--1"),
        Wait(20),
        Screenshot("02-pasted-with-ctrl-v"),
        RightClick(ui_at("tab-bar", 0.5, 0.5)),
        WaitFor("paste-tab"),
        Hover(ui("paste-tab")),
        Wait(8),
        Screenshot("03-tab-bar-menu-paste"),
        Click(ui("paste-tab")),
        WaitFor("tab-part-studio-1--2"),
        Wait(10),
        Screenshot("04-pasted-from-the-bar"),
        Click(ui("insert-tab")),
        WaitFor("paste-tab"),
        Hover(ui("paste-tab")),
        Wait(8),
        Screenshot("05-plus-menu-paste"),
        Key("Escape"),
        RightClick(ui("tab-part-studio-1")),
        WaitFor("tab-export"),
        Click(ui("tab-export")),
        WaitFor("export-dialog"),
        Click(ui("export-folder")),
        Key("Ctrl+A"),
        Type("target/exports/tab_copy_paste"),
        Click(ui("export-format-cadrs")),
        Wait(5),
        Screenshot("06-export-dialog-cadrs"),
        Click(ui("export-ok")),
        WaitFor("export-toast"),
        Screenshot("07-cadrs-exported"),
        Click(ui("insert-tab")),
        Click(ui("import-files")),
        WaitFor("import-picker"),
        Click(ui("import-picker-folder")),
        Key("Ctrl+A"),
        Type("target/exports/tab_copy_paste"),
        Key("Enter"),
        WaitFor("import-picker-row-Part Studio 1.cadrs"),
        Click(ui("import-picker-row-Part Studio 1.cadrs")),
        Click(ui("import-picker-open")),
        WaitFor("tab-part-studio-1--3"),
        Wait(20),
        Screenshot("08-imported-cadrs"),
        Click(ui("feature-sketch-1")),
        Key("Ctrl+C"),
        Wait(5),
        Click(ui("insert-tab")),
        Click(ui("create-part-studio")),
        WaitFor("tab-part-studio-2"),
        Wait(10),
        Key("Ctrl+V"),
        WaitFor("feature-sketch-1"),
        Wait(20),
        Screenshot("09-feature-pasted-with-ctrl-v"),
        RightClick(ui("feature-sketch-1")),
        WaitFor("feature-paste"),
        Hover(ui("feature-paste")),
        Wait(8),
        Screenshot("10-feature-menu-copy-paste"),
        Click(ui("feature-paste")),
        Wait(20),
        Screenshot("11-feature-pasted-again"),
    ],
)
