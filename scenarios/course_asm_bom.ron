// P3B.6 / A1.8, A20, X13: the Bill of Materials (intro-to-assemblies.md A20) on the Ex3 end state
// (`fixtures/pneumatic_cylinder_ex3.cadrs`, built by `samples::pneumatic_ex3` as
// `course_asm_ex3_structure` builds it: Instances (26), Hardware (14)).
// 01 (A1.8, A20.1) the right strip's BOM button: the live BOM, structured, top level (9 items).
// 02 (A20.2) hovering the Structural Rod row highlights the four rods; 03 clicking its item
//    number selects them in the Instances list and the view (cross-highlight).
// 04 (A20.4) double-clicking the subassemblies' item numbers expands them (3.1, 3.2, 4.1, …);
//    05 Flattened: 11 items, O-Ring 0.125 ×4.
// 06-08 (A20.5) Top Cap subassembly → Properties… → Subassembly BOM behavior: 06 the list,
//    07 Show assembly only (one line), 08 Show components only (its parts at the top level).
// 09-11 (A20.6) Add column (Vendor); the header's menu: Move left; Remove column (Description).
// 12 (A20.3) double-clicking the Quantity header sorts (descending on the second double click).
// 13-15 (A20.8) a row's menu → Suppress from this BOM (the rods go, the items renumber);
//    15 overflow → Show excluded/suppressed: the row with "–"; then Unsuppress in this BOM.
// 16 (A20.9) overflow → Show top-level assembly row, with the Mass column: the totals.
// 17-21 (A20.10) a Part number cell edited in place; 18 the Barrel's Properties show it; the
//    Vendor typed there; 19 the BOM shows it; 20 double-clicking a Material cell: the material
//    picker; 21 Aluminum - 6061 picked (the mass follows).
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture pneumatic_cylinder_ex3"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        // A20.1: the right strip's BOM button.
        Click(ui("panel-bom")),
        Wait(10),
        Key("F"),
        Wait(30),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("01-a20.1-bom-structured"),
        // A20.2: hovering a row highlights its instances.
        Hover(ui("bom-row-4")),
        Wait(5),
        Screenshot("02-a20.2-hover-rods"),
        // Clicking its item number selects them (list and view).
        Click(ui("bom-cell-4-0")),
        Wait(5),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("03-a20.2-item-cross-highlight"),
        Click(at(600, 160)),
        Wait(3),
        // A20.4: double-click a subassembly's item number: expanded.
        DoubleClick(ui("bom-cell-3-0")),
        Wait(5),
        DoubleClick(ui("bom-cell-2-0")),
        Wait(5),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("04-a20.4-structured-expanded"),
        Click(ui("bom-view")),
        Wait(3),
        Click(ui("bom-view-option-1")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("05-a20.4-flattened"),
        Click(ui("bom-view")),
        Wait(3),
        Click(ui("bom-view-option-0")),
        Wait(8),
        // A20.5: the Top Cap subassembly's Properties.
        RightClick(ui("instance-row-4")),
        WaitFor("asm-properties"),
        Click(ui("asm-properties")),
        WaitFor("properties-dialog"),
        Wait(5),
        Click(ui("props-bom-behavior")),
        Wait(5),
        Screenshot("06-a20.5-subassembly-bom-behavior"),
        Click(ui("props-bom-behavior-option-1")),
        Wait(3),
        Click(ui("props-save")),
        Wait(10),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("07-a20.5-assembly-only"),
        RightClick(ui("instance-row-4")),
        WaitFor("asm-properties"),
        Click(ui("asm-properties")),
        WaitFor("properties-dialog"),
        Wait(5),
        Click(ui("props-bom-behavior")),
        Wait(3),
        Click(ui("props-bom-behavior-option-2")),
        Wait(3),
        Click(ui("props-save")),
        Wait(10),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("08-a20.5-components-only"),
        // Back to Show assembly and components (two undo steps).
        Key("Ctrl+Z"),
        Wait(5),
        Key("Ctrl+Z"),
        Wait(10),
        // A20.6: Add column, Move left, Remove column.
        Click(ui("bom-add-column")),
        Wait(5),
        Screenshot("09-a20.6-add-column"),
        Click(ui("bom-add-col-7")),
        Wait(8),
        // The panel widened (drag its left edge) so the new column is in view.
        Drag(ui("bom-panel-resize"), at(640, 400)),
        Wait(5),
        RightClick(ui("bom-header-col-6")),
        Wait(5),
        Screenshot("10-a20.6-column-menu"),
        Click(ui("bom-move-left")),
        Wait(8),
        RightClick(ui("bom-header-col-4")),
        Wait(5),
        Click(ui("bom-remove-column")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("11-a20.6-vendor-moved-description-removed"),
        // A20.3: double-click a header to sort.
        DoubleClick(ui("bom-header-col-1")),
        Wait(8),
        DoubleClick(ui("bom-header-col-1")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("12-a20.3-sorted-by-quantity"),
        // Sorted by Name, then its divider dragged left: the label is cut ("…") before the
        // sort arrow, the cells too; hovering a cut cell shows it whole.
        DoubleClick(ui("bom-header-col-3")),
        Wait(8),
        Drag(ui("bom-header-col-3-resize"), ui_at("bom-header-col-3", 0.3, 0.5)),
        Wait(8),
        Hover(ui("bom-cell-2-3")),
        Wait(40),
        Screenshot("12b-narrow-column-sort-arrow-ellipsis"),
        // Double-clicking the divider fits the column to its content again.
        DoubleClick(ui("bom-header-col-3-resize")),
        Wait(5),
        Click(ui("bom-overflow")),
        Wait(3),
        Click(ui("bom-reset-sort")),
        Wait(8),
        // A20.8: Suppress from this BOM, show excluded, unsuppress.
        RightClick(ui("bom-row-9")),
        Wait(5),
        Screenshot("13-a20.8-row-menu"),
        Click(ui("bom-suppress")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("14-a20.8-rods-suppressed"),
        Click(ui("bom-overflow")),
        Wait(5),
        Click(ui("bom-show-excluded")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("15-a20.8-show-excluded"),
        RightClick(ui("bom-row-9")),
        Wait(5),
        Click(ui("bom-unsuppress")),
        Wait(5),
        Click(ui("bom-overflow")),
        Wait(5),
        Click(ui("bom-hide-excluded")),
        Wait(5),
        // A20.9: the top-level assembly row and the totals.
        Click(ui("bom-overflow")),
        Wait(5),
        Click(ui("bom-show-top-row")),
        Wait(5),
        Click(ui("bom-add-column")),
        Wait(5),
        Click(ui("bom-add-col-11")),
        Wait(8),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("16-a20.9-top-level-row-totals"),
        // A20.10: a cell edited in place writes the part's property.
        DoubleClick(ui("bom-cell-2-2")),
        Wait(5),
        Type("CYL-BARREL-01"),
        Wait(3),
        Screenshot("17-a20.10-edit-part-number"),
        Key("Enter"),
        Wait(8),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-properties"),
        Click(ui("asm-properties")),
        WaitFor("properties-dialog"),
        Wait(5),
        Click(ui("props-vendor")),
        Wait(3),
        Type("Acme Tube Co."),
        Wait(3),
        Screenshot("18-a20.10-properties-show-it"),
        Click(ui("props-save")),
        Wait(10),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("19-a20.10-vendor-in-the-bom"),
        DoubleClick(ui("bom-cell-2-5")),
        Wait(5),
        Screenshot("20-a20.10-material-picker"),
        Click(ui("bom-material-5")),
        Wait(10),
        MoveTo(600, 250),
        Wait(3),
        Screenshot("21-a20.10-material-and-mass"),
    ],
)
