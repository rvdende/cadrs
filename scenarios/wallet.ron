// Credits: the account menu's Wallet shows the balance, takes test credits from the faucet
// (once an hour: the button waits), and transfers them, asking once before anything moves.
// An organization has a wallet of its own: a client pays it, and an owner pays out to a
// person. The scenario keeps a bank of its own (the network is off in scenarios).
Scenario(
    start: Some("landing"),
    steps: [
        WaitFor("landing-page"),
        Custom("org bank"),
        Custom("org market"),
        Click(ui("identity")),
        WaitFor("wallet"),
        Screenshot("01-account-menu"),
        Click(ui("wallet")),
        WaitFor("wallet-dialog"),
        ExpectText("wallet-balance", "0 credits"),
        Screenshot("02-empty-wallet"),

        // The faucet: a thousand, and then an hour to wait.
        Click(ui("wallet-faucet")),
        ExpectText("wallet-balance", "1,000 credits"),
        ExpectText("wallet-faucet-wait", "Again in"),
        ExpectText("wallet-move-0", "+1,000"),
        ExpectText("wallet-move-0", "Test credits"),
        Screenshot("03-after-the-faucet"),

        // A transfer to a shop, found by typing its name; asked about once.
        Click(ui("wallet-transfer")),
        WaitFor("wallet-transfer-dialog"),
        // Nothing chosen: said, and nothing asked.
        Click(ui("wallet-transfer-ok")),
        Click(ui("wallet-to-choose")),
        WaitFor("wallet-to-search"),
        Type("cape"),
        Key("Enter"),
        ExpectText("wallet-to-choose-label", "Cape Waterjet"),
        Click(ui("wallet-amount")),
        Type("250"),
        Click(ui("wallet-note")),
        Type("deposit for the bracket"),
        Screenshot("04-transfer"),
        Click(ui("wallet-transfer-ok")),
        WaitFor("wallet-confirm"),
        ExpectText("wallet-confirm-text", "Send 250 credits from Alex Designer to Cape Waterjet?"),
        Screenshot("05-confirm"),
        Click(ui("wallet-confirm-ok")),
        ExpectText("wallet-balance", "750 credits"),
        ExpectText("wallet-move-0", "Cape Waterjet"),
        ExpectText("wallet-move-0", "deposit for the bracket"),
        Screenshot("06-sent"),

        // More than there is isn't asked about.
        Click(ui("wallet-transfer")),
        WaitFor("wallet-transfer-dialog"),
        Click(ui("wallet-to-choose")),
        Type("rhine"),
        Key("Enter"),
        Click(ui("wallet-amount")),
        Type("5000"),
        Click(ui("wallet-transfer-ok")),
        Screenshot("07-not-enough"),
        Click(ui("wallet-transfer-cancel")),
        Click(ui("wallet-close")),

        // An organization has a wallet of its own.
        Click(ui("identity")),
        WaitFor("org-new"),
        Click(ui("org-new")),
        WaitFor("new-organization-dialog"),
        Custom("org logo"),
        WaitFor("org-new-logo-picture"),
        Click(ui("org-new-name")),
        Type("Stellenbosch Print"),
        Click(ui("org-new-tagline")),
        Type("3D printing in PETG and PLA, next day"),
        Click(ui("org-new-country")),
        Type("South Africa"),
        Click(ui("org-new-city")),
        Type("Stellenbosch"),
        Click(ui("org-new-email")),
        Type("print@example.org"),
        Click(ui("new-organization-ok")),
        WaitFor("org-nav"),
        Click(ui("org-nav-wallet")),
        ExpectText("org-wallet-balance", "0 credits"),
        Screenshot("08-organization-wallet"),
        // A client pays it: said as it happens.
        Custom("org pay 900"),
        ExpectText("org-wallet-balance", "900 credits"),
        ExpectText("org-wallet-move-0", "+900"),
        Screenshot("09-paid-by-a-client"),

        // A payout to a person: its members first.
        Click(ui("org-wallet-payout")),
        WaitFor("wallet-transfer-dialog"),
        Click(ui("wallet-to-choose")),
        WaitFor("wallet-to-search"),
        Type("alex"),
        Key("Enter"),
        Click(ui("wallet-amount")),
        Type("300"),
        Click(ui("wallet-note")),
        Type("November"),
        Screenshot("10-payout"),
        Click(ui("wallet-transfer-ok")),
        WaitFor("wallet-confirm"),
        ExpectText("wallet-confirm-text", "Pay out 300 credits from Stellenbosch Print to Alex Designer?"),
        Click(ui("wallet-confirm-ok")),
        ExpectText("org-wallet-balance", "600 credits"),
        ExpectText("org-wallet-move-0", "Paid out"),
        ExpectText("org-wallet-move-0", "November"),
        Screenshot("11-paid-out"),

        // Anyone can hold credits for a shop. What is held shows in its wallet, each with
        // Return; those for none of its orders go back in one go.
        Custom("org stray 3"),
        WaitFor("org-wallet-hold-0"),
        ExpectText("org-wallet-held", "3 held for you"),
        ExpectText("org-wallet-return-strays", "Return the 3 held for no order"),
        Screenshot("11b-held-for-no-order"),
        Click(ui("org-wallet-return-strays")),
        WaitFor("wallet-confirm"),
        Click(ui("wallet-confirm-ok")),
        ExpectText("org-wallet-move-0", "Returned to the client"),
        ExpectText("org-wallet-balance", "600 credits"),

        // It arrived in the person's wallet.
        Click(ui("identity")),
        WaitFor("wallet"),
        ExpectText("wallet", "1,050 credits"),
        Click(ui("wallet")),
        WaitFor("wallet-dialog"),
        ExpectText("wallet-balance", "1,050 credits"),
        ExpectText("wallet-move-0", "Payout received"),
        Screenshot("12-payout-received"),
    ],
)
