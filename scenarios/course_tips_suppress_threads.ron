// P3F.3 (`essential-tips.md` T10.1, T10.2, X6): suppression and cosmetic threads. A 50 mm cube
// with two M10×1.5 tapped holes, Blind 20 mm, from its top.
// 01 the Hole dialog, Tapped M10: the preview drills the plain Ø8.5 tap drill; the thread is
//    cosmetic: its major diameter drawn as a ¾ circle at each entry.
// 02 accepted: the row reads the callout with the thread ("M10x1.50 ↧ 20 mm").
// 03 looking into a hole: the thread's helix drawn on the tap drill's wall (no helical faces).
// 04 the hole suppressed (feature menu): greyed and struck through in the list, left out of the
//    rebuild; the cube is whole again (Mass properties: 125000.000 mm³).
// 05 unsuppressed: the holes and their threads are back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 50 50"),
        Wait(5),
        Key("P"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(25, 25, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("50"),
        Key("Enter"),
        Wait(10),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(xyz(25, 25, 50)),
        Wait(3),
        Key("N"),
        Wait(40),
        MoveTo(913, 520),
        Key("Shift+S"),
        Wait(2),
        ClickWorld(15, 25),
        Wait(2),
        ClickWorld(35, 25),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Enter"),
        Wait(10),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        Click(ui("hole")),
        WaitFor("hole-dialog"),
        Wait(5),
        Click(xyz(15, 25, 50)),
        Wait(3),
        Click(xyz(35, 25, 50)),
        Wait(10),
        Click(ui("hole-type")),
        Wait(3),
        Click(ui("hole-type-option-2")),
        Wait(5),
        Click(ui("hole-size")),
        Wait(3),
        Click(ui("hole-size-option-8")),
        Wait(5),
        Click(ui("hole-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("20"),
        Click(ui("hole-dialog-title")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-tapped-m10-cosmetic"),
        Click(ui("hole-dialog-accept")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-callout-in-the-list"),
        Custom("view 35 55 15 25 45 0.035"),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-thread-helix-in-the-hole"),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        RightClick(ui("feature-m10x1-50---20-mm")),
        WaitFor("feature-suppress"),
        Click(ui("feature-suppress")),
        Wait(20),
        Click(ui("part-row-part-1")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(10),
        ExpectText("mass-dialog", "125000.000"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-suppressed-cube-whole"),
        Click(ui("mass-dialog-cancel")),
        Wait(5),
        RightClick(ui("feature-m10x1-50---20-mm")),
        WaitFor("feature-unsuppress"),
        Click(ui("feature-unsuppress")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-unsuppressed"),
    ],
)
