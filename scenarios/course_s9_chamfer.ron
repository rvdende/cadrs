// T3 / S9.2: "Chamfer: select connected entities or vertices. By default it's two equal
// distances (45°), with a drag arrow for live sizing. Then type the first distance, press
// Enter, type the second, press Enter." (`reference/onshape/entity_tools/chamfer-creation-01.png`)
// Fillet ▾ → Sketch chamfer. A rectangle; clicking its top-right corner chamfers it with two
// equal distances along the edges (measured from the corner, which stays with dash-dot
// extensions), then 12, Enter, 6, Enter, with its grey resize arrow. Picking the bottom and
// left lines chamfers the corner they share with the same distances, linked to the first. Pressing on the bottom-right corner and dragging sizes a chamfer live.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(-45, -25),
        ClickWorld(45, 25),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-fillet-caret")),
        WaitFor("sketch-variant-chamfer"),
        Wait(3),
        Screenshot("01-fillet-menu"),
        Click(ui("sketch-variant-chamfer")),
        Wait(2),
        ClickWorld(45, 25),
        Wait(4),
        Screenshot("02-chamfer-first-distance-box"),
        Type("12"),
        Key("Enter"),
        Wait(4),
        Screenshot("03-second-distance-box"),
        Type("6"),
        Key("Enter"),
        Wait(4),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04-chamfer-12-by-6"),
        ClickWorld(0, -25),
        Wait(2),
        ClickWorld(-45, 0),
        Wait(4),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04b-linked-chamfer-same-distances"),
        Press(world(45, -25)),
        MoveWorld(43, -25),
        MoveWorld(38, -25),
        MoveWorld(35, -25),
        Wait(3),
        Screenshot("05-drag-sizes-live"),
        Release,
        Wait(4),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("06-three-chamfers"),
    ],
)
