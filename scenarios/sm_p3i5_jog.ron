// Jog (P3I.5, SM19.1): a line across a 100 × 60 × 2 plate, Jog 1 with Jog offset 10 (anchor
// Inside: 10 from the face to the far wall's inner face), then Nominal, then Preserve material off
// (the sheet grows so the far end stays at x = 100), accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(xyz(50, 30, 0)),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Custom("sketch top chain 70 -15 70 75"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-jog")),
        WaitFor("sheet-metal-jog-dialog"),
        Click(xyz(70, 70, 0)),
        Click(ui("sm-jog-offset-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        Custom("view 30 30 50 30 10 0.11"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-jog-10-inside"),
        Click(ui("sm-jog-anchor")),
        Screenshot("02-anchor-menu"),
        Click(ui("sm-jog-anchor-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-nominal"),
        Click(ui("smt-preserve-material-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-preserve-material-off"),
        Click(ui("sheet-metal-jog-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-accepted"),
    ],
)
