// P3H.4 (PCB3.9, PCB3.10, PCB4.7): the PCB Studio BOM. The Vision PCB's 29 components in 8 rows
// grouped by part number: Qty, Designator (ranges: C1-C10, R1-R10), Part name, Part number.
// 01 the right edge's BOM toggle: the grouped BOM; 02 click the R1-R10 row: the ten resistors
//    light up in the view; 03 click U1 in the view: its row is selected; 03b Ctrl+click R1:
//    the R1-R10 row is tinted (some of its members selected), then U1 alone again; 04 double-click U1's
//    designator, type U10, Enter: renamed (the rows re-sort: U2 before U10); 05 double-click
//    C1-C10: the row opens into one row per capacitor; 06 rename C1 to C2: refused (C2 is on the
//    board), with a message; 07 Ctrl+Z: U10 is U1 again.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("pcb-import vision controller/Vision PCB"),
        WaitFor("pcb-board-vision-pcb"),
        Click(ui("pcb-panel-bom")),
        WaitFor("pcb-bom-pane"),
        ExpectText("pcb-bom-designator-4", "R1-R10"),
        MoveTo(1100, 900),
        Screenshot("01-bom-grouped"),
        Click(ui("pcb-bom-row-4")),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("02-row-lights-the-resistors"),
        Click(xyz(50.8, 38.1, 3.175)),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("03-u1-selects-its-row"),
        // P3H.5 (P3H.4 judge): Ctrl+click R1 too: its group row (R1-R10) is tinted, as some of
        // its members are selected.
        KeyDown("Ctrl"),
        Click(xyz(17.78, 58.42, 1.9)),
        KeyUp("Ctrl"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("03b-r1-added-group-row-tinted"),
        Click(xyz(50.8, 38.1, 3.175)),
        Wait(10),
        DoubleClick(ui("pcb-bom-designator-5")),
        WaitFor("pcb-bom-edit-field"),
        Key("Ctrl+A"),
        Type("U10"),
        Key("Enter"),
        ExpectText("pcb-bom-designator-6", "U10"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("04-u1-renamed-u10"),
        DoubleClick(ui("pcb-bom-designator-0")),
        WaitFor("pcb-bom-designator-0-0"),
        MoveTo(1100, 900),
        Screenshot("05-group-opened"),
        DoubleClick(ui("pcb-bom-designator-0-0")),
        WaitFor("pcb-bom-edit-field"),
        Key("Ctrl+A"),
        Type("C2"),
        Key("Enter"),
        WaitFor("pcb-refdes-toast"),
        MoveTo(1100, 900),
        Screenshot("06-duplicate-refused"),
        Key("Ctrl+Z"),
        ExpectText("pcb-bom-designator-5", "U1"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("07-undone"),
    ],
)
