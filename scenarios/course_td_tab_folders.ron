// P3E.2 (test-drive.md TD5.3, X6; essential-tips.md X1): tab folders. "Exercise: Move to
// Document" (`move-doc setup`: Hexapod, Pneumatic Piston, Piston Assembly, Topplate, Baseplate)
// with "Drawing 1" (`move-doc drawing`).
// 01 "+" → the menu's Create folder (enabled) hovered.
// 02 "Folder 1" made right of the active tab, its name being edited in place.
// 03 renamed "Plates"; the folder tab hovered (its tooltip counts its tabs).
// 04 Topplate dragged onto the Plates folder: a blue box round the folder, the tab's ghost, the
//    dragged tab dimmed.
// 05 dropped: Topplate is in the folder (gone from the top level).
// 06 Baseplate dragged between Hexapod and Plates: the blue drop line (a reorder).
// 07 Baseplate dropped there; then dragged onto Plates too: the folder holds both.
// 08 Plates opened (a click): Home and the breadcrumb "Plates", its two tabs.
// 09 inside the folder: Baseplate's menu → Move to folder ▸ (Top level, New folder).
// 10 Topplate dragged onto Home: the blue box round Home.
// 11 dropped: Topplate left the folder (the bar stays in Plates, where the active Baseplate is).
// 12 Ctrl+Z: one undo step puts Topplate back in Plates.
// 13 Home; the folder's menu: Open, Rename…, Delete folder… hovered.
// 14 Delete folder…: the dialog asks about its 2 tabs.
// 15 Delete folder only: the tabs are back at the top level where the folder was.
// 16 Ctrl+Z: the folder is back with its tabs (one step); the bar opens it, where the active
//    Baseplate is.
// 17 reloaded (back to the documents page, the document opened again): the folder and the
//    order are as they were.
// 18 the folder opened after the reload: Topplate and Baseplate.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(20),
        Custom("move-doc setup"),
        Wait(90),
        Custom("move-doc drawing"),
        Wait(40),
        Click(ui("tab-hexapod")),
        Wait(30),
        Key("F"),
        Wait(30),
        Click(ui("insert-tab")),
        WaitFor("insert-tab-menu"),
        Wait(5),
        Hover(ui("create-folder")),
        Wait(20),
        Screenshot("01-create-folder"),
        Click(ui("create-folder")),
        WaitFor("tab-folder-folder-1"),
        Wait(10),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-folder-renaming"),
        Key("Ctrl+A"),
        Type("Plates"),
        Key("Enter"),
        WaitFor("tab-folder-plates"),
        Wait(10),
        Hover(ui("tab-folder-plates")),
        Wait(50),
        Screenshot("03-folder-plates"),
        Press(ui("tab-topplate")),
        Wait(2),
        Hover(ui_at("tab-topplate", 0.3, 0.2)),
        Wait(2),
        Hover(ui_at("tab-folder-plates", 0.45, 0.5)),
        Wait(2),
        Hover(ui_at("tab-folder-plates", 0.5, 0.5)),
        Wait(5),
        Screenshot("04-drag-onto-folder"),
        Release,
        Wait(20),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("05-topplate-in-folder"),
        Press(ui("tab-baseplate")),
        Wait(2),
        Hover(ui_at("tab-baseplate", 0.3, 0.2)),
        Wait(2),
        Hover(ui_at("tab-folder-plates", 0.08, 0.5)),
        Wait(2),
        Hover(ui_at("tab-folder-plates", 0.06, 0.5)),
        Wait(5),
        Screenshot("06-drag-reorder-line"),
        Release,
        Wait(20),
        Press(ui("tab-baseplate")),
        Wait(2),
        Hover(ui_at("tab-baseplate", 0.3, 0.2)),
        Wait(2),
        Hover(ui_at("tab-folder-plates", 0.45, 0.5)),
        Wait(2),
        Hover(ui_at("tab-folder-plates", 0.5, 0.5)),
        Wait(3),
        Release,
        Wait(20),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("07-both-in-folder"),
        Click(ui("tab-folder-plates")),
        WaitFor("tab-folder-home"),
        Wait(10),
        Hover(ui("tab-folder-home")),
        Wait(50),
        Screenshot("08-folder-open-home"),
        RightClick(ui("tab-baseplate")),
        WaitFor("tab-context-menu"),
        Wait(5),
        Hover(ui("tab-move-folder")),
        Wait(25),
        Screenshot("09-move-to-folder-menu"),
        Key("Escape"),
        Wait(10),
        Key("Escape"),
        Wait(10),
        Press(ui("tab-topplate")),
        Wait(2),
        Hover(ui_at("tab-topplate", 0.3, 0.2)),
        Wait(2),
        Hover(ui_at("tab-folder-home", 0.45, 0.5)),
        Wait(2),
        Hover(ui_at("tab-folder-home", 0.5, 0.5)),
        Wait(5),
        Screenshot("10-drag-onto-home"),
        Release,
        Wait(20),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("11-topplate-at-top-level"),
        Key("Ctrl+Z"),
        Wait(20),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("12-undo-one-step"),
        Click(ui("tab-folder-home")),
        Wait(15),
        RightClick(ui("tab-folder-plates")),
        WaitFor("tab-folder-menu"),
        Wait(5),
        Hover(ui("tab-folder-delete")),
        Wait(20),
        Screenshot("13-folder-menu"),
        Click(ui("tab-folder-delete")),
        WaitFor("delete-tab-folder-dialog"),
        Wait(10),
        Hover(ui("delete-tab-folder-keep")),
        Wait(20),
        Screenshot("14-delete-dialog"),
        Click(ui("delete-tab-folder-keep")),
        Wait(20),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("15-folder-deleted-tabs-kept"),
        Key("Ctrl+Z"),
        Wait(20),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("16-undo-delete"),
        Click(ui("back-to-documents")),
        WaitFor("doc-row-0"),
        Wait(20),
        DoubleClick(ui("doc-name-0")),
        WaitFor("document-shell"),
        Wait(90),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("17-reloaded"),
        Click(ui("tab-folder-plates")),
        WaitFor("tab-folder-home"),
        Wait(15),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("18-reloaded-folder-open"),
    ],
)
