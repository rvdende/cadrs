// The library browser (A in the Schematic; "From library" in the component editors).
// 01 a new board's Schematic, A: the libraries as a closed tree; 02 Device opened; 03 the filter
// "battery": matching parts only, Battery_Cell chosen with its preview; 04 placed on the sheet;
// 05 a component "Regulator" started from Regulator_Linear:AMS1117-3.3 (the symbol); 06 its
// footprint, copied with it (SOT-223); 07 the footprint browser narrowed by the symbol's
// filters... none, so all footprints; filter "SOT-23-5", chosen and previewed.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-add-board")),
        WaitFor("pcb-name-edit"),
        Key("Ctrl+A"),
        Type("Browser"),
        Key("Enter"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        MoveTo(900, 500),
        Key("A"),
        WaitFor("eda-chooser"),
        Screenshot("01-libraries"),
        Click(ui("eda-chooser-lib-device")),
        WaitFor("eda-chooser-device-r"),
        Screenshot("02-device-open"),
        Click(ui("eda-chooser-filter-field")),
        Type("battery"),
        WaitFor("eda-chooser-device-battery-cell"),
        Click(ui("eda-chooser-device-battery-cell")),
        Wait(3),
        Screenshot("03-battery-cell"),
        Click(ui("eda-chooser-ok")),
        Click(flat(101.6, 101.6)),
        Custom("eda-zoom 80 85 125 120"),
        MoveTo(1100, 860),
        Screenshot("04-placed"),
        // A component from a library part.
        Click(ui("pcb-add-component")),
        WaitFor("pcb-name-edit"),
        Key("Ctrl+A"),
        Type("Regulator"),
        Key("Enter"),
        Click(ui("pcb-part-regulator")),
        WaitFor("sym-from-library"),
        Click(ui("sym-from-library")),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("AMS1117-3.3"),
        WaitFor("eda-chooser-regulator-linear-ams1117-3-3"),
        Click(ui("eda-chooser-regulator-linear-ams1117-3-3")),
        Wait(3),
        Screenshot("05-regulator-chosen"),
        Click(ui("eda-chooser-ok")),
        Custom("eda-fit"),
        MoveTo(1100, 860),
        Screenshot("06-regulator-symbol"),
        Click(ui("eda-mode-footprint")),
        WaitFor("fp-from-library"),
        Custom("eda-fit"),
        MoveTo(1100, 860),
        Screenshot("07-regulator-footprint"),
        Click(ui("fp-from-library")),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("SOT-23-5"),
        WaitFor("eda-chooser-package-to-sot-smd-sot-23-5"),
        Click(ui("eda-chooser-package-to-sot-smd-sot-23-5")),
        Wait(3),
        Screenshot("08-footprint-browser"),
        Click(ui("eda-chooser-cancel")),
    ],
)
