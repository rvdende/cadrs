// P3H.4 (PCB3.3): search. Type a term, then the magnifier (or Enter): designators, packages,
// part numbers and board names that contain it light up in the view and the BOM, with "n of m";
// the up/down arrows step through them (framing the current one); ✕ clears.
// 01 "R" on the Vision PCB: 13 matches (J1, J2 by HDR, R1-R10, Y1 by CRYSTAL), 1 of 13 (J1)
//    selected and framed; 02 down twice: 3 of 13 (R1); 03 up: 2 of 13 (J2); 03b the Down key in
//    the field: 3 of 13; 04 ✕: cleared, the match's selection too. The matches are tinted blue,
//    the current one orange (selected).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("pcb-import vision controller/Vision PCB"),
        WaitFor("pcb-board-vision-pcb"),
        Click(ui("pcb-panel-bom")),
        WaitFor("pcb-bom-pane"),
        Click(ui("pcb-search-field")),
        Type("R"),
        Click(ui("pcb-search-go")),
        ExpectText("pcb-search-count", "1 of 13"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("01-search-r"),
        Click(ui("pcb-search-next")),
        Click(ui("pcb-search-next")),
        ExpectText("pcb-search-count", "3 of 13"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("02-down-twice"),
        Click(ui("pcb-search-prev")),
        ExpectText("pcb-search-count", "2 of 13"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("03-up"),
        // P3H.5 (P3H.4 judge): Down in the search field steps too.
        Click(ui("pcb-search-field")),
        Key("Down"),
        ExpectText("pcb-search-count", "3 of 13"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("03b-down-key"),
        Click(ui("pcb-search-clear")),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("04-cleared"),
    ],
)
