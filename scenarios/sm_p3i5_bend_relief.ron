// Bend relief (P3I.5, SM8): an L-shaped plate bent along y = 30 with Hold line alignment: the bend
// covers the arm (x 0–60) while the base carries on to x = 100, so its x = 60 end gets the model's
// Obround bend relief; Bend relief 1 picked there sets Rectangle – Scaled, then Extend bend relief.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top poly 0 0 100 0 100 30 60 30 60 60 0 60"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(20, 20, 0)),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Custom("sketch top chain -10 30 110 30"),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(40),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Wait(10),
        Click(xyz(105, 30, 0)),
        Wait(30),
        Click(ui("sm-bend-alignment")),
        Wait(5),
        Click(ui("sm-bend-alignment-option-1")),
        Wait(20),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Wait(30),
        Custom("view 20 40 50 30 5 0.1"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-bend-with-relief"),
        Click(ui("sheet-metal-model-caret")),
        Wait(40),
        Click(ui("sheet-metal-menu-bend-relief")),
        WaitFor("sheet-metal-bend-relief-dialog"),
        Wait(10),
        Click(xyz(60, 29, 0)),
        Wait(20),
        Click(ui("sm-bend-relief-type")),
        Wait(5),
        Click(ui("sm-bend-relief-type-option-1")),
        Wait(30),
        Custom("view 20 40 60 30 0 0.06"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-rectangle-relief"),
        Click(ui("smt-extend-bend-relief-checkbox")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-extended"),
        Click(ui("sheet-metal-bend-relief-dialog-accept")),
        Wait(30),
    ],
)
