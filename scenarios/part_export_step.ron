// Export parts to STEP (right-click a part → Export…). Two boxes on Top: 50 × 30 × 25 and
// 20 × 20 × 25 beside it, one extrude making two parts.
// 01 Both parts selected in the Parts list, the context menu open on Part 2: Export… enabled.
// 02 The Export dialog (P3F.2's): File name "Part Studio 1", Format STEP, Version AP214
//    (read-only), Y axis up unchecked, Keep assembly structure disabled (parts), Export unique
//    parts as individual files checked, and the Folder with Browse… (the scenario's exports
//    folder).
// 03 Export: the toast says 2 files went to the folder ("Part Studio 1 - Part 1.step" and
//    "Part Studio 1 - Part 2.step"). Run with CADRS_EXPORT_DIR set to keep them out of Downloads.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0, 0),
        Wait(2),
        ClickWorld(50, 30),
        Wait(3),
        Key("G"),
        Wait(2),
        ClickWorld(70, 0),
        Wait(2),
        ClickWorld(90, 20),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        ClickWorld(25, 15),
        Wait(3),
        ClickWorld(80, 10),
        Wait(3),
        Key("Enter"),
        Wait(10),
        Click(ui("part-row-part-1")),
        Wait(2),
        Click(ui("part-row-part-2")),
        Wait(2),
        RightClick(ui("part-row-part-2")),
        Wait(3),
        Hover(ui("part-export")),
        Wait(3),
        Screenshot("01-context-menu-export"),
        Click(ui("part-export")),
        WaitFor("export-dialog"),
        Wait(5),
        Screenshot("02-export-dialog"),
        Click(ui("export-ok")),
        WaitFor("export-toast"),
        Wait(5),
        Screenshot("03-exported-toast"),
    ],
)
