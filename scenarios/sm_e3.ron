// P3I.8 / X7, exercise E3 "Drawings" end to end (`ex3-drawings/goal.png`, step-02–12) on its
// stand-in document (`fixtures/sheetmetal/sm_e3_standin.cadrs`: the Sheet Metal Box, a 200 × 125
// × 150 block converted with its four bottom edges bent and its top open, 1.5 mm, R1.5).
// 01 the box; 01b the Sheet metal table and flat view, right-click on the flat: New sketch,
// Export DXF/DWG of flat pattern, Create drawing of flat pattern (SM14.1, SM15.1, SM16.1);
// 01c Export DXF/DWG of flat pattern (step 2–3); then as `sm_p3i7_e3`: 02 Parts list → Create
// drawing; 03 ANSI_A MM, Four views; 04–05 the folded views dimensioned; 06–08 Insert sheet,
// Insert view → Flat patterns, placed with its bend notes; 09–10 bend notes dragged; 11 the flat
// dimensioned; 12 Hide bend notes. The measured value: the flat is 500.833 × 425.833
// (`cadrs_core/tests/sheetmetal_exercises.rs`).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("fixture sheetmetal/sm_e3_standin"),
        Wait(90),
        Key("F"),
        Wait(30),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("01-sheet-metal-box"),
        Click(ui("panel-sheet-metal")),
        Wait(60),
        RightClick(ui("smt-flat")),
        Wait(10),
        Screenshot("01b-flat-view-menu"),
        Click(ui("smt-flat-export")),
        WaitFor("flat-export-dialog"),
        Wait(10),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("01c-export-dxf-of-flat"),
        Click(ui("flat-export-ok")),
        Wait(30),
        Click(ui("panel-sheet-metal")),
        Wait(20),
        RightClick(ui("part-row-sheet-metal-box")),
        Wait(6),
        Hover(ui("part-drawing")),
        Wait(4),
        Screenshot("02-parts-list-menu"),
        Click(ui("part-drawing")),
        WaitFor("create-drawing-dialog"),
        Wait(8),
        Click(ui("template-row-ANSI_A_MM.dwt")),
        Wait(5),
        Click(ui("template-option-four-views")),
        Wait(8),
        MoveTo(1400, 950),
        Wait(3),
        Screenshot("03-create-drawing-ansi-a-mm-four-views"),
        Click(ui("create-drawing-ok")),
        Wait(120),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("04-four-views"),
        // Dimension the folded views: the front's width and height, the side's depth.
        Key("D"),
        Wait(3),
        ClickWorld(79.4, 92),
        Wait(3),
        ClickWorld(129.35, 92),
        Wait(3),
        ClickWorld(104.4, 121),
        Wait(5),
        ClickWorld(104.4, 73.2),
        Wait(3),
        ClickWorld(104.4, 110.9),
        Wait(3),
        ClickWorld(70, 92),
        Wait(5),
        ClickWorld(155.1, 92),
        Wait(3),
        ClickWorld(186.9, 92),
        Wait(3),
        ClickWorld(171, 121),
        Wait(5),
        Key("Escape"),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("05-folded-views-dimensioned"),
        Key("Ctrl+S"),
        Wait(10),
        Click(ui("drawing-insert-sheet")),
        Wait(15),
        Key("Ctrl+S"),
        Wait(10),
        Click(ui("drawing-insert-view")),
        WaitFor("insert-view-dialog"),
        Wait(5),
        Click(ui("insert-view-filter-flat")),
        Wait(8),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("06-insert-view-flat-patterns"),
        Click(ui("browser-flat-1")),
        Wait(5),
        Click(ui("insert-view-scale")),
        Wait(5),
        Click(ui("insert-view-scale-option-3")),
        Wait(5),
        MoveWorld(139, 135),
        Wait(40),
        MoveWorld(140, 135),
        Wait(10),
        Screenshot("07-flat-following-the-cursor"),
        ClickWorld(140, 135),
        Wait(30),
        Key("Escape"),
        Wait(5),
        ClickWorld(240, 190),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("08-flat-placed-bend-notes"),
        // SM16.4: drag bend notes off their lines (leaders), and one back onto its line.
        DragWorld(140, 150.7, 205, 168),
        Wait(10),
        DragWorld(156.9, 135, 215, 115),
        Wait(10),
        DragWorld(116.8, 135, 60, 160),
        Wait(10),
        ClickWorld(240, 190),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("09-bend-notes-dragged"),
        DragWorld(215, 115, 161.5, 150),
        Wait(10),
        ClickWorld(240, 190),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("10-bend-note-reattached"),
        // SM16.6: dimension the flat: its width, a bend line to the edge, its height.
        Key("D"),
        Wait(3),
        ClickWorld(90.2, 135),
        Wait(3),
        ClickWorld(189.8, 135),
        Wait(3),
        ClickWorld(105, 194),
        Wait(5),
        ClickWorld(160.04, 140),
        Wait(3),
        ClickWorld(189.8, 140),
        Wait(3),
        ClickWorld(175, 160),
        Wait(5),
        ClickWorld(140, 177.8),
        Wait(3),
        ClickWorld(140, 92.2),
        Wait(3),
        ClickWorld(75, 110),
        Wait(5),
        Key("Escape"),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("11-flat-dimensioned"),
        // SM16.4: right-click a bend note → Hide bend notes.
        RightClick(world(140, 125.6)),
        Wait(6),
        Screenshot("12a-bend-note-menu"),
        Click(ui("flat-menu-bend-notes")),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("12-bend-notes-hidden"),
        Key("Ctrl+Z"),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("13-undo-bend-notes-shown"),
    ],
)
