// P3I.8 / X7, exercise E3 "Drawings" end to end (`ex3-drawings/goal.png`, step-02–12) on its
// stand-in document (`fixtures/sheetmetal/sm_e3_standin.cadrs`: the Sheet Metal Box, the
// exercise's sloped enclosure: 200 wide, 250 deep, 200 high at the back and 125 at the front, a
// 75 deep shelf, the slope left open and flanged along both sloping edges; 1.5 mm, R1.5, seven
// bends, two oblique in the flat).
// 01 the box; 01b the Sheet metal table and flat view, right-click on the flat: New sketch,
// Export DXF/DWG of flat pattern, Create drawing of flat pattern (SM14.1, SM15.1, SM16.1);
// 01c Export DXF/DWG of flat pattern (step 2–3); 02 Parts list → Create drawing; 03 ANSI_A MM,
// Four views; 04–05 the folded views dimensioned on their outer edges (203 wide, 203 high, 253
// deep: the faces are the sheet's inside); 06–08 Insert sheet, Insert view → Flat patterns
// ("Flat pattern of Sheet Metal Box"), placed with its bend notes along the lines (the oblique
// flange lines' notes turned with them); 09–10 bend notes dragged off (leaders stay on their
// attach points) and one dropped back; 11 the flat dimensioned: its length, the shelf, the
// width of the strip and the 113.2° between a side's front edge and its flange (`goal.png`);
// 12 Hide bend notes; 13 undo. The measured value: the flat is 651.249 × 647.556
// (`cadrs_core/tests/sheetmetal_exercises.rs`, closed forms).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("fixture sheetmetal/sm_e3_standin"),
        Wait(90),
        Key("F"),
        Wait(30),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("01-sheet-metal-box"),
        Click(ui("panel-sheet-metal")),
        Wait(60),
        RightClick(ui("smt-flat")),
        Wait(10),
        Screenshot("01b-flat-view-menu"),
        Click(ui("smt-flat-export")),
        WaitFor("flat-export-dialog"),
        Wait(10),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("01c-export-dxf-of-flat"),
        Click(ui("flat-export-ok")),
        Wait(30),
        Click(ui("panel-sheet-metal")),
        Wait(20),
        RightClick(ui("part-row-sheet-metal-box")),
        Wait(6),
        Hover(ui("part-drawing")),
        Wait(4),
        Screenshot("02-parts-list-menu"),
        Click(ui("part-drawing")),
        WaitFor("create-drawing-dialog"),
        Wait(8),
        Click(ui("template-row-ANSI_A_MM.dwt")),
        Wait(5),
        Click(ui("template-option-four-views")),
        Wait(8),
        MoveTo(1400, 950),
        Wait(3),
        Screenshot("03-create-drawing-ansi-a-mm-four-views"),
        Click(ui("create-drawing-ok")),
        Wait(120),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("04-four-views"),
        // Dimension the folded views on their outer edges: the front's width and height (the
        // height clear of the view), the side's depth.
        Key("D"),
        Wait(3),
        ClickWorld(100.5, 108),
        Wait(3),
        ClickWorld(126.78, 108),
        Wait(3),
        ClickWorld(113.6, 124),
        Wait(5),
        ClickWorld(113.6, 89.53),
        Wait(3),
        ClickWorld(113.6, 115.36),
        Wait(3),
        ClickWorld(84, 102.4),
        Wait(5),
        ClickWorld(142.28, 95),
        Wait(3),
        ClickWorld(174.36, 100),
        Wait(3),
        ClickWorld(158.3, 80),
        Wait(5),
        Key("Escape"),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("05-folded-views-dimensioned"),
        Key("Ctrl+S"),
        Wait(10),
        Click(ui("drawing-insert-sheet")),
        Wait(15),
        Key("Ctrl+S"),
        Wait(10),
        Click(ui("drawing-insert-view")),
        WaitFor("insert-view-dialog"),
        Wait(5),
        Click(ui("insert-view-filter-flat")),
        Wait(8),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("06-insert-view-flat-patterns"),
        Click(ui("browser-flat-1")),
        Wait(5),
        Click(ui("insert-view-scale")),
        Wait(5),
        Click(ui("insert-view-scale-option-3")),
        Wait(5),
        MoveWorld(139, 135),
        Wait(40),
        MoveWorld(140, 135),
        Wait(10),
        Screenshot("07-flat-following-the-cursor"),
        ClickWorld(140, 135),
        Wait(30),
        Key("Escape"),
        Wait(5),
        ClickWorld(240, 190),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("08-flat-placed-bend-notes"),
        // SM16.4: drag bend notes off their lines (leaders to where they were attached): both
        // flanges' and the front bend's; then the front bend's back onto its line.
        DragWorld(115.8, 190.7, 78, 200),
        Wait(10),
        DragWorld(118.4, 84.1, 80, 72),
        Wait(10),
        DragWorld(96.6, 135.5, 55, 150),
        Wait(10),
        ClickWorld(240, 190),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("09-bend-notes-dragged"),
        DragWorld(55, 150, 98.6, 128),
        Wait(10),
        ClickWorld(240, 190),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("10-bend-note-reattached"),
        // SM16.6: dimension the flat: its length, the shelf (a bend line to the end), the
        // strip's width and the angle between a side's front edge and its flange's edge.
        Key("D"),
        Wait(3),
        ClickWorld(74.93, 135),
        Wait(3),
        ClickWorld(205.08, 135),
        Wait(3),
        ClickWorld(140, 64),
        Wait(5),
        ClickWorld(190.08, 140),
        Wait(3),
        ClickWorld(205.08, 140),
        Wait(3),
        ClickWorld(197.6, 162),
        Wait(5),
        ClickWorld(180, 115.02),
        Wait(3),
        ClickWorld(180, 154.98),
        Wait(3),
        ClickWorld(214, 135),
        Wait(5),
        Key("Escape"),
        Wait(3),
        // The Angular dimension: a side's front edge and its flange's outer edge, 113.2°.
        Click(ui_at("drawing-dimension", 0.85, 0.5)),
        WaitFor("drawing-dim-angular"),
        Click(ui("drawing-dim-angular")),
        Wait(5),
        ClickWorld(100.0, 168),
        Wait(3),
        ClickWorld(115.45, 192.26),
        Wait(3),
        MoveWorld(88, 189),
        Wait(3),
        ClickWorld(88, 189),
        Wait(5),
        Key("Escape"),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("11-flat-dimensioned"),
        // SM16.4: right-click a bend note → Hide bend notes.
        RightClick(world(146.6, 135.5)),
        Wait(6),
        Screenshot("12a-bend-note-menu"),
        Click(ui("flat-menu-bend-notes")),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("12-bend-notes-hidden"),
        Key("Ctrl+Z"),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("13-undo-bend-notes-shown"),
    ],
)
