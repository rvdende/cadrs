// P3H.6 (PCB8, the Vision Controller exercise; PCB7.1–7.6, X7) on the authored fixture
// `fixtures/idf/vision controller/Vision PCB.emn/.emp`. Compare
// `ex2-step5-create-assembly-dialog.png`, `v6-create-assembly-bom-poster.png`,
// `ex2-step7-area-check.png`.
// 01 (step 3) Insert new element → Create PCB Studio; 02 (step 4) Import ECAD files with both
//    files chosen; 03 imported: Vision PCB;
// 04 (step 5) Create assembly from 'Vision PCB': Board ✓, Components ✓, Keep-In and Keep-Out
//    Areas ☐, the note, OK / Cancel; (the progress card is waited for, not photographed);
// 06 done: the toast and the new tabs Vision PCB (Part Studio), Vision PCB components, Vision PCB
//    (Assembly); 07 the Part Studio: Sketch 1 and "Board [Vision PCB]"; 07b the components
//    Part Studio: one part per package, side by side (P3H.7 moves them to component documents);
// 08 the Vision PCB assembly (Open assembly): the board and 29 components, no mates, instances
//    named from their packages; 09 its Bill of materials: one row per part number with
//    Quantity and Description;
// 10 (step 6) Group, Top view, a box dragged over the board (window: what is inside it);
// 11 released: the 29 components in the Group's Instances (the board, not wholly inside,
//    isn't); 12 accepted, then the board fixed (its lock in the list);
// 13 (step 7) Top view, U1 (the large central IC) clicked: its top face selected, "Area:
//    232.258 mm²" at the bottom right (15.24 × 15.24 = 232.2576 mm²).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("insert-tab")),
        WaitFor("create-pcb-studio"),
        Click(ui("create-pcb-studio")),
        WaitFor("pcb-tree"),
        Wait(20),
        Screenshot("01-pcb-studio"),
        Click(ui("pcb-import")),
        WaitFor("pcb-import-dialog"),
        Custom("pcb-choose vision controller/Vision PCB.emn;vision controller/Vision PCB.emp"),
        Wait(5),
        ExpectText("pcb-import-chosen", "2 files chosen"),
        Screenshot("02-import-ecad-files"),
        Click(ui("pcb-import-ok")),
        WaitFor("pcb-board-vision-pcb"),
        Wait(40),
        MoveTo(1100, 900),
        Wait(3),
        Screenshot("03-imported"),
        // Step 5: Create assembly, defaults.
        Click(ui("pcb-create-assembly")),
        WaitFor("pcb-create-dialog"),
        Wait(10),
        ExpectText("pcb-create-dialog", "Create assembly from 'Vision PCB'"),
        Screenshot("04-create-assembly-dialog"),
        Click(ui("pcb-create-ok")),
        // The progress card shows while the kernel thread builds the tabs (too quick here to
        // photograph: the next frame already has the result).
        WaitFor("pcb-create-progress"),
        WaitFor("pcb-create-toast"),
        Wait(10),
        Screenshot("06-created"),
        Click(ui("tab-vision-pcb")),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-board-part-studio"),
        Click(ui("tab-vision-pcb-components")),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07b-components-part-studio"),
        Click(ui("tab-vision-pcb-assembly")),
        Wait(60),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08-vision-pcb-assembly"),
        Click(ui("assembly-bom")),
        WaitFor("bom-panel"),
        Wait(20),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("09-bom"),
        Click(ui("assembly-bom")),
        Wait(10),
        // Step 6: Group, box-select the components, ✓; Fix the board.
        Key("Shift+5"),
        Wait(40),
        Key("F"),
        Wait(40),
        Click(ui("group")),
        WaitFor("group-dialog"),
        Wait(5),
        Press(xyz(-3, 82, 3)),
        Hover(xyz(40, 40, 3)),
        Wait(2),
        Hover(xyz(98, 1.5, 3)),
        Wait(2),
        Hover(xyz(99.5, 0.8, 3)),
        Wait(5),
        Screenshot("10-group-box-select"),
        Release,
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("11-components-in-group"),
        Click(ui("group-dialog-accept")),
        Wait(10),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(10),
        ClickAt(1450, 880),
        Wait(5),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("12-grouped-and-fixed"),
        // Step 7: U1's top face, Area.
        Click(xyz(50.8, 38.1, 3.175)),
        Wait(10),
        ExpectText("measure-summary", "Area: 232.258 mm"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("13-u1-top-face-area"),
    ],
)
