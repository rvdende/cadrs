// T4 / S17.1: "Press-and-drag across entities trims everything touched." (M;
// `reference/onshape/edit_tools/trim-points-02.png`: a thin grey trail, touched pieces gone
// while dragging). A horizontal line crossed by four verticals. With Trim, a press-drag trail
// runs across the tops of the verticals and dips through the horizontal line between the two
// middle ones: every piece the trail touches is trimmed back to its crossings as the trail
// reaches it (the trail is drawn thin grey). Releasing records it all as one step: one Ctrl+Z
// brings back every piece.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("L"),
        Wait(2),
        ClickWorld(-60, -5),
        ClickWorld(60, -5),
        Key("Escape"),
        Wait(2),
        ClickWorld(-35, -35),
        ClickWorld(-35, 30),
        Key("Escape"),
        Wait(2),
        ClickWorld(-12, -35),
        ClickWorld(-12, 30),
        Key("Escape"),
        Wait(2),
        ClickWorld(12, -35),
        ClickWorld(12, 30),
        Key("Escape"),
        Wait(2),
        ClickWorld(35, -35),
        ClickWorld(35, 30),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-lines"),
        Key("M"),
        Wait(2),
        Press(world(-50, 15)),
        MoveWorld(-45, 15),
        MoveWorld(-30, 15),
        MoveWorld(-20, 15),
        Wait(3),
        Screenshot("02-dragging-first-piece-gone"),
        MoveWorld(-8, 15),
        MoveWorld(0, -12),
        MoveWorld(8, 15),
        MoveWorld(25, 15),
        MoveWorld(48, 15),
        Wait(3),
        Screenshot("03-trail-across-everything"),
        Release,
        Wait(4),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-released-all-trimmed"),
        Key("Ctrl+Z"),
        Wait(4),
        Screenshot("05-one-undo-restores-all"),
    ],
)
