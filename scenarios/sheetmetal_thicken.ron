// Sheet metal model, Thicken (P3I.2, SM2.4): two sketch regions on Top picked in *Faces or sketch
// regions to thicken*: two flat parts 1.5 mm thick on the sketch's side; the opposite direction
// arrow of Thickness puts them under the sketch. Accepted; the sketch is hidden as an extrude's
// is.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 60 40 rect 70 0 110 40"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(xyz(30, 20, 0)),
        Click(xyz(90, 20, 0)),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Tab"),
        Custom("view 30 30 50 20 0 0.15"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-two-regions"),
        Click(ui("sm-thickness-flip")),
        Custom("view 30 15 50 20 0 0.15"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-under-the-sketch"),
        Click(ui("sheet-metal-model-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
    ],
)
