// Holes at the ends of a construction line: an 80 × 50 × 20 plate with a sketch on its top
// holding only a construction line from (20, 25) to (60, 25).
// 01 Hole, both ends of the line picked one by one: a hole at each, "Vertex of Sketch 2" twice.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 80 50"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(40, 25, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(40, 25, 20)),
        Key("N"),
        MoveTo(913, 520),
        Key("L"),
        Key("Q"),
        ClickWorld(20, 25),
        ClickWorld(60, 25),
        Key("Escape"),
        Key("Escape"),
        Key("Enter"),
        Key("Shift+7"),
        Key("F"),
        Click(ui("hole")),
        WaitFor("hole-dialog"),
        Click(xyz(20, 25, 20)),
        Click(xyz(60, 25, 20)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-holes-at-construction-ends"),
    ],
)
