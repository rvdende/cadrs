// P3D.1 (IR5.5, X6): the feature context menu's items, on the Control Arm's fully defined
// Sketch 1 on Top (`control-arm-sketch`) and a circle sketched on Front (Sketch 2).
// 01 right-click Sketch 1: the menu in the course's order (`ex1-step2.png`): Rename, Edit…,
//    "Edit healthy moment of Sketch 1…" (disabled until Repair, P3D.4), Copy sketch, Show
//    dimensions | Add selection to folder… | Hide, Show all sketches | Section view… (disabled)
//    | Suppress, Dynamic suppression ▸ | Add comment (disabled: collaboration) | Zoom to
//    selection | Show dependencies… | Roll to here | Edit sketch appearance… | Delete.
// 02 Dynamic suppression ▸: suppression by a variable or a configuration (both disabled:
//    cadrs has neither yet).
// 03 Show dimensions, seen from the top: Sketch 1's dimensions drawn although it isn't being
//    edited.
// 04 the menu again: the item now reads "Hide dimensions".
// 05 Hide on both sketches: nothing shown (each row's eye too).
// 06 Show all sketches: both back, in one undo step.
// 07 Zoom to selection on Sketch 2: the view fitted to its circle.
// 08 Copy sketch on Sketch 1: "Sketch 1 copied. Paste it into a sketch with Ctrl+V."
// 09 a new sketch on Right, Ctrl+V: Sketch 1's geometry, constraints and dimensions pasted in
//    (selected), as one undo step.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("control-arm-sketch"),
        Wait(5),
        Custom("sketch front circle 0 60 12"),
        Wait(10),
        Key("P"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        RightClick(ui("feature-sketch-1")),
        WaitFor("feature-context-menu"),
        Wait(3),
        Hover(ui("feature-rename")),
        Wait(3),
        Screenshot("01-menu"),
        Hover(ui("feature-dynamic-suppression")),
        Wait(10),
        Screenshot("02-dynamic-suppression"),
        Click(ui("feature-show-dimensions")),
        Wait(10),
        Key("Shift+5"),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-show-dimensions"),
        RightClick(ui("feature-sketch-1")),
        WaitFor("feature-context-menu"),
        Wait(2),
        Hover(ui("feature-hide-dimensions")),
        Wait(3),
        Screenshot("04-hide-dimensions-item"),
        Click(ui("feature-hide-dimensions")),
        Wait(5),
        RightClick(ui("feature-sketch-1")),
        WaitFor("feature-context-menu"),
        Wait(2),
        Click(ui("feature-hide")),
        Wait(5),
        RightClick(ui("feature-sketch-2")),
        WaitFor("feature-context-menu"),
        Wait(2),
        Click(ui("feature-hide")),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-both-hidden"),
        RightClick(ui("feature-sketch-2")),
        WaitFor("feature-context-menu"),
        Wait(2),
        Click(ui("feature-show-all-sketches")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-show-all"),
        RightClick(ui("feature-sketch-2")),
        WaitFor("feature-context-menu"),
        Wait(2),
        Click(ui("feature-zoom-to")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-zoom-to-selection"),
        RightClick(ui("feature-sketch-1")),
        WaitFor("feature-context-menu"),
        Wait(2),
        Click(ui("feature-copy-sketch")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-copied"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-right")),
        Wait(10),
        Key("N"),
        Wait(40),
        MoveTo(900, 500),
        Wait(3),
        Key("Ctrl+V"),
        Wait(20),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-pasted"),
    ],
)
