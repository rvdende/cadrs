// Frame (`cadrs_core::frame`, issue #266). A 400 x 300 rectangle on Top and a 300 post line up
// from one corner on Front; the toolbar's Frame with the rectangle's four lines picked: T-slot
// 20x20 members mitred at the corners. The profile set to Square tube 40x40x3, then the corners
// to Butt and flipped; the post added to the path (three members at one corner: the first runs
// on, the others butt against it); accepted. Then the Cut list panel.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        SetTimeout(60.0),
        Custom("sketch top rect 0 0 400 300"),
        Custom("sketch front chain 0 0 0 300"),
        Key("Shift+7"),
        Key("F"),
        Click(ui("frame")),
        WaitFor("frame-dialog"),
        Click(xyz(200, 0, 0)),
        Click(xyz(400, 150, 0)),
        Click(xyz(200, 300, 0)),
        Click(xyz(0, 150, 0)),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("01-t-slot-mitred"),
        Click(ui("frame-family")),
        Click(ui("frame-family-option-1")),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("02-square-tube"),
        Click(ui("frame-corner")),
        Click(ui("frame-corner-option-1")),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("03-butt"),
        Click(ui("frame-corner-flip")),
        Click(xyz(0, 0, 150)),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("04-flipped-with-post"),
        Click(ui("frame-dialog-accept")),
        Click(ui("panel-cut-list")),
        WaitFor("cut-list-panel"),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("05-cut-list"),
        Click(ui("cut-list-row-0")),
        MoveTo(1420, 900),
        Wait(2),
        Screenshot("06-row-selected"),
    ],
)
