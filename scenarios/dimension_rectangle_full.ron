// M7: the Dimension tool on a rectangle from the origin (compare reference/onshape/screens/16,
// 16a, 16b, 17, 17a and NOTES.md "Dimension tool"). G draws a rectangle from the origin; Esc
// skips both quick-dimension boxes, so it is blue (under-defined). D: hovering the bottom edge
// turns it orange; clicking picks it and the dimension follows the cursor with its live value;
// clicking below places it and opens the value editor with the value selected; typing 50 and
// Enter sets it. The same for the right edge: 30. The rectangle is then fully defined: black.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0.45, 0.3),
        MoveWorld(49.12, 33.17),
        Wait(2),
        ClickWorld(49.12, 33.17),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("01-rectangle-blue-no-dimensions"),
        Key("D"),
        Wait(2),
        MoveWorld(25, 0.2),
        Wait(2),
        Screenshot("02-dimension-tool-hover-edge-orange"),
        ClickWorld(25, 0.2),
        Wait(2),
        MoveWorld(28, -8),
        Wait(2),
        Screenshot("03-dimension-follows-cursor"),
        ClickWorld(28, -8),
        Wait(4),
        Screenshot("04-placed-edit-popup-value-selected"),
        Type("50"),
        Wait(2),
        Screenshot("05-typing-50"),
        Key("Enter"),
        Wait(4),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("06-width-50-committed"),
        MoveWorld(50, 15),
        Wait(2),
        Screenshot("07-hover-right-edge"),
        ClickWorld(50, 15),
        Wait(2),
        MoveWorld(65, 17),
        Wait(2),
        Screenshot("08-height-follows-cursor"),
        ClickWorld(65, 17),
        Wait(4),
        Screenshot("09-height-popup"),
        Type("30"),
        Key("Enter"),
        Wait(4),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("10-fully-constrained-black"),
        Key("Escape"),
        Wait(2),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("11-tool-closed"),
    ],
)
