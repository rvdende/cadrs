// T2 / S1.2: "right-click a plane or face and choose New sketch. The picked plane pre-fills the
// dialog." Right-clicking the Top plane (a right press and release that does not move; a moving
// one orbits) opens the viewport menu for it; New sketch starts Sketch 1 with "Top plane" in
// its plane field and the sketch toolbar active (the view does not rotate). A right-click on
// empty space offers only view commands. Then the same on a part's top face: an extrude, and
// New sketch from its face.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        MoveTo(560, 575),
        Wait(3),
        Screenshot("01-hover-top-plane"),
        RightClick(at(560, 575)),
        WaitFor("viewport-context-menu"),
        Hover(ui("viewport-new-sketch")),
        Wait(3),
        Screenshot("02-right-click-top-plane-menu"),
        Click(ui("viewport-new-sketch")),
        WaitFor("sketch-dialog"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-new-sketch-on-top-plane-prefilled"),
        // A rectangle, accepted, extruded: then New sketch on the part's top face.
        Key("G"),
        ClickWorld(-20, -15),
        ClickWorld(20, 15),
        Key("Escape"),
        Key("Escape"),
        Key("Enter"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        ClickWorld(5, 5),
        Key("Enter"),
        RightClick(at(1300, 850)),
        WaitFor("viewport-context-menu"),
        Screenshot("04-right-click-empty-space"),
        Key("Escape"),
        RightClick(xyz(5, 5, 25)),
        WaitFor("viewport-context-menu"),
        Hover(ui("viewport-new-sketch")),
        Wait(3),
        Screenshot("05-right-click-part-face-menu"),
        Click(ui("viewport-new-sketch")),
        WaitFor("sketch-dialog"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-new-sketch-on-face-prefilled"),
    ],
)
