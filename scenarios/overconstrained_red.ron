// M6: a conflicting constraint (compare reference/onshape/screens/15, 15a and NOTES.md
// "Errors"). A line drawn horizontal gets the Horizontal constraint from inference. Selecting
// it and pressing V adds Vertical, which cannot hold with Horizontal: it is left unsolved, its
// glyph is white on red, the line is red, "Sketch 1" turns red in the feature list with the ⓘ
// in the header, the dialog title turns red, and the yellow banner appears. Clicking the red
// glyph selects it and Delete removes it: back to normal (blue, no banner). Ctrl+Z brings the
// conflict back; right-click on the glyph offers Delete, which removes it again.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("L"),
        ClickWorld(0, 20),
        ClickWorld(50, 20.3),
        Key("Escape"),
        Key("Escape"),
        MoveWorld(80, -50),
        Wait(2),
        Screenshot("01-horizontal-line"),
        Click(world(25, 20)),
        Key("V"),
        MoveWorld(80, -50),
        Wait(2),
        Screenshot("02-vertical-conflicts-red-banner"),
        MoveTo(1023, 463),
        Wait(2),
        Screenshot("03-hover-red-glyph"),
        Click(at(1023, 463)),
        Key("Delete"),
        MoveWorld(80, -50),
        Wait(2),
        Screenshot("04-deleted-back-to-normal"),
        Key("Ctrl+Z"),
        Screenshot("05-undo-conflict-back"),
        RightClick(at(1023, 463)),
        WaitFor("sketch-glyph-delete"),
        Screenshot("06-right-click-glyph-menu"),
        Click(ui("sketch-glyph-delete")),
        MoveWorld(80, -50),
        Wait(2),
        Screenshot("07-deleted-from-menu"),
    ],
)
