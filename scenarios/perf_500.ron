// M8 performance: a sketch with 500 entities (100 constrained rectangles with a circle inside
// each, 20 width dimensions: 500 curves, 800 points), then frame times while idle, hovering,
// dragging a corner (the solver runs every frame) and drawing a line with inference. Frame-time
// reports go to target/scenarios/perf_500/perf-*.txt (run with --release for real numbers).
// Zoomed out, the glyphs are too dense and hidden (01); zoomed in they come back (04). The
// corner is dragged out and back several times and ends where it started (02 matches 01).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        MeasureStart("populate"),
        Custom("populate-sketch 500"),
        Wait(3),
        MeasureEnd,
        Key("F"),
        Wait(40),
        MoveTo(1500, 900),
        Wait(2),
        Screenshot("01-500-entities-zoom-to-fit"),
        MeasureStart("idle"),
        Wait(120),
        MeasureEnd,
        MeasureStart("hover"),
        MoveWorld(5, 5),
        MoveWorld(18, 34),
        MoveWorld(31, 63),
        MoveWorld(44, 92),
        MoveWorld(57, 121),
        MoveWorld(70, 150),
        MoveWorld(83, 179),
        MoveWorld(96, 18),
        MoveWorld(109, 47),
        MoveWorld(122, 76),
        MoveWorld(135, 105),
        MoveWorld(148, 134),
        MoveWorld(161, 163),
        MoveWorld(174, 192),
        MoveWorld(187, 31),
        MoveWorld(10, 60),
        MoveWorld(23, 89),
        MoveWorld(36, 118),
        MoveWorld(49, 147),
        MoveWorld(62, 176),
        MoveWorld(75, 15),
        MoveWorld(88, 44),
        MoveWorld(101, 73),
        MoveWorld(114, 102),
        MoveWorld(127, 131),
        MoveWorld(140, 160),
        MoveWorld(153, 189),
        MoveWorld(166, 28),
        MoveWorld(179, 57),
        MoveWorld(192, 86),
        MoveWorld(15, 115),
        MoveWorld(28, 144),
        MoveWorld(41, 173),
        MoveWorld(54, 12),
        MoveWorld(67, 41),
        MoveWorld(80, 70),
        MoveWorld(93, 99),
        MoveWorld(106, 128),
        MoveWorld(119, 157),
        MoveWorld(132, 186),
        MoveWorld(145, 25),
        MoveWorld(158, 54),
        MoveWorld(171, 83),
        MoveWorld(184, 112),
        MoveWorld(7, 141),
        MeasureEnd,
        MeasureStart("drag"),
        // Every drop is in an empty gap between cells: a drop on another cell's point or curve
        // would infer a constraint there (S11.4), as Onshape does.
        DragWorld(134, 110, 137, 115),
        DragWorld(137, 115, 157, 115),
        DragWorld(157, 115, 137, 115),
        DragWorld(137, 115, 134, 110),
        DragWorld(134, 110, 157, 135),
        DragWorld(157, 135, 134, 110),
        MeasureEnd,
        Wait(3),
        Screenshot("02-after-dragging-a-corner"),
        Key("L"),
        Wait(2),
        ClickWorld(-30, -15),
        MeasureStart("draw-line"),
        MoveWorld(-30, -15),
        MoveWorld(-26, -12),
        MoveWorld(-22, -9),
        MoveWorld(-18, -6),
        MoveWorld(-14, -3),
        MoveWorld(-10, -15),
        MoveWorld(-6, -12),
        MoveWorld(-2, -9),
        MoveWorld(2, -6),
        MoveWorld(6, -3),
        MoveWorld(10, -15),
        MoveWorld(14, -12),
        MoveWorld(18, -9),
        MoveWorld(22, -6),
        MoveWorld(26, -3),
        MoveWorld(30, -15),
        MoveWorld(34, -12),
        MoveWorld(38, -9),
        MoveWorld(42, -6),
        MoveWorld(46, -3),
        MoveWorld(50, -15),
        MoveWorld(54, -12),
        MoveWorld(58, -9),
        MoveWorld(62, -6),
        MoveWorld(66, -3),
        MoveWorld(70, -15),
        MoveWorld(74, -12),
        MoveWorld(78, -9),
        MoveWorld(82, -6),
        MoveWorld(86, -3),
        MeasureEnd,
        Screenshot("03-drawing-a-line"),
        Key("Escape"),
        Key("Escape"),
        Wait(2),
        // Zoomed in, the constraint glyphs come back (they are hidden while too dense).
        Scroll(at(900, 400), 8),
        Wait(3),
        MoveTo(1500, 900),
        Wait(2),
        Screenshot("04-zoomed-in-glyphs-shown"),
    ],
)
