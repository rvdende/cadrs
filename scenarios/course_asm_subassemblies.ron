// P3B.4 / A17.1–A17.5, A16.2, A4.6, X9, X11: subassemblies on the Ex2 end state
// (`fixtures/pneumatic_cylinder_ex2.cadrs`: "Cylinder assembly", 17 instances, 14 mates).
// 01 (A17.3, ex3-step4) Retaining Plate, Top Cap, O-Ring 0.125 <3>, <4> selected → right-click
//    → Move to new subassembly; 02 a new tab "Assembly 1" and its instance where the plate was;
//    every part where it was.
// 03 (A4.6, X11) right-click it → Switch to Assembly 1; 04 its tab: 4 instances, 3 mates (the
//    O-rings' Fastened 3, 4 and Fastened 12, which takes over from Group 1).
// 05 (A17.3, ex3-step6) back in Cylinder assembly: right-click Rear Cap → Create empty
//    subassembly; 06 "Assembly 1 <1>" after the Rear Cap (the other tab was renamed).
// 07 (A17.4, ex3-step7) Rear Cap, Rear Cap mount, O-Ring <1>, <2> dragged onto it: the badge
//    "4 items"; 08 dropped (the parent keeps 10 instances).
// 09 (A16.2) the subassembly row's lock (rigid) on hover; 10 opened (▸): its 4 instances.
// 11 (A17.4, ex3-step11) the Rear Cap mount dragged out to the top of the list.
// 12 (A16.2) the lock clicked twice: flexible (its mates act here; the DOF triad stands for the
//    open lock), then rigid again, as the frame shows (the lock back on the Assembly 1 row).
// 13 (A17.5, ex3-step12) right-click the Assembly 1 instance → Dissolve subassembly; 14 its
//    instances are back at the top level, and its tab stays; 15 the empty tab: Instances (0).
// 16 (A2.3, A17.2) Insert → Assemblies: the other Assembly tabs (not Cylinder assembly, which
//    can't contain itself); 17 a second Top Cap subassembly clicked in beside the cylinder.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture pneumatic_cylinder_ex2"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        Key("F"),
        Wait(30),
        // A17.3: Move to new subassembly.
        Click(ui("instance-row-3")),
        Wait(2),
        Click(ui("instance-row-4")),
        Wait(2),
        Click(ui("instance-row-8")),
        Wait(2),
        Click(ui("instance-row-9")),
        Wait(2),
        RightClick(ui("instance-row-9")),
        WaitFor("asm-move-to-new"),
        Hover(ui("asm-move-to-new")),
        Wait(3),
        Screenshot("01-a17.3-move-to-new-menu"),
        Click(ui("asm-move-to-new")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02-a17.3-moved-to-assembly-1"),
        // A4.6: Switch to the subassembly.
        RightClick(ui("instance-row-3")),
        WaitFor("asm-switch-to"),
        Hover(ui("asm-switch-to")),
        Wait(3),
        Screenshot("03-a4.6-switch-to-subassembly"),
        Click(ui("asm-switch-to")),
        Wait(10),
        Key("F"),
        Wait(30),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("04-a17.3-subassembly-tab"),
        RightClick(ui("tab-assembly-1")),
        WaitFor("tab-rename"),
        Click(ui("tab-rename")),
        Wait(2),
        Key("Ctrl+A"),
        Type("Top Cap subassembly"),
        Key("Enter"),
        Wait(5),
        // A17.3: Create empty subassembly.
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-empty-sub"),
        Hover(ui("asm-empty-sub")),
        Wait(3),
        Screenshot("05-a17.3-create-empty-menu"),
        Click(ui("asm-empty-sub")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("06-a17.3-empty-subassembly"),
        // A17.4: drag four instances onto it.
        Click(at(1350, 650)),
        Wait(3),
        Click(ui("instance-row-2")),
        Wait(2),
        Click(ui("instance-row-5")),
        Wait(2),
        Click(ui("instance-row-6")),
        Wait(2),
        Click(ui("instance-row-7")),
        Wait(2),
        Press(ui("instance-row-7")),
        Wait(2),
        Hover(ui_at("instance-row-5", 0.5, 0.2)),
        Wait(2),
        Hover(ui_at("instance-row-3", 0.5, 0.5)),
        Wait(5),
        Screenshot("07-a17.4-four-items-badge"),
        Release,
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08-a17.4-dropped"),
        // A16.2: the lock (rigid), then open the subassembly.
        Hover(ui("instance-row-2")),
        Wait(3),
        Screenshot("09-a16.2-lock-rigid"),
        Click(ui_at("instance-row-2", 0.05, 0.5)),
        Wait(5),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("10-a17.4-opened"),
        // A17.4: the Rear Cap mount dragged out, to the top.
        Press(ui("instance-child-rear-cap-mount-1")),
        Wait(2),
        Hover(ui_at("instance-row-1", 0.5, 0.6)),
        Wait(2),
        Hover(ui_at("instance-row-1", 0.5, 0.1)),
        Wait(5),
        Release,
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("11-a17.4-dragged-out"),
        // A16.2: flexible, then rigid again.
        Hover(ui("instance-row-3")),
        Wait(3),
        Click(ui("instance-row-3-lock")),
        Wait(5),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("12-a16.2-flexible"),
        Click(ui("instance-row-3-lock")),
        Wait(5),
        // A17.5: Dissolve subassembly.
        RightClick(ui("instance-row-3")),
        WaitFor("asm-dissolve"),
        Hover(ui("asm-dissolve")),
        Wait(3),
        Screenshot("13-a17.5-dissolve-menu"),
        Click(ui("asm-dissolve")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("14-a17.5-dissolved-tab-stays"),
        Click(ui("tab-assembly-1")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("15-a17.5-empty-tab"),
        // A2.3, A17.2: Insert → Assemblies.
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(3),
        Click(ui("insert-kind-1")),
        Wait(5),
        Hover(ui("insert-assembly-top-cap-subassembly")),
        Wait(3),
        Screenshot("16-a17.2-insert-assemblies-tab"),
        Click(ui("insert-assembly-top-cap-subassembly")),
        Wait(3),
        MoveTo(1250, 820),
        Wait(5),
        Click(at(1250, 820)),
        Wait(5),
        Click(ui("insert-dialog-accept")),
        Wait(10),
        MoveTo(1450, 250),
        Wait(3),
        Screenshot("17-a17.2-second-top-cap-subassembly"),
    ],
)
