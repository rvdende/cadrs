// M1: Create ▾ › Document… › name it › Create opens the document with Part Studio 1 and
// Assembly 1; back to documents shows it in the list. Then Create ▾ › Folder….
Scenario(
    start: Some("landing"),
    steps: [
        Click(ui("create")),
        WaitFor("new-document"),
        Click(ui("new-document")),
        WaitFor("new-document-dialog"),
        Wait(3),
        Screenshot("01-new-document-dialog"),
        Type("Bracket"),
        Screenshot("02-name-typed"),
        Click(ui("new-document-create")),
        WaitFor("document-loading"),
        Wait(2),
        Screenshot("03-loading"),
        Wait(30),
        Screenshot("04-document-open"),
        Click(ui("back-to-documents")),
        WaitFor("doc-row-0"),
        Wait(2),
        Screenshot("05-back-to-documents"),
        WaitFor("recent-name-0"),
        Wait(2),
        Screenshot("06-last-opened"),
        Click(ui("create")),
        WaitFor("new-folder"),
        Click(ui("new-folder")),
        WaitFor("new-folder-dialog"),
        Wait(3),
        Screenshot("07-new-folder-dialog"),
        Type("Fixtures"),
        Key("Enter"),
        Wait(3),
        Screenshot("08-folder-created"),
    ],
)
