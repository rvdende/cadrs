// P3.6 / PS16: Shell on a 100 × 60 × 40 box (its volumes asserted in
// `cadrs_core/tests/applied.rs` and the kernel's `shell_options`).
// 01 PS16.1 Shell 1, the top face removed, 4 mm inward (V = 100·60·40 − 92·52·36 = 67 776 mm³).
// 02 PS16.2 the opposite-direction arrow: the walls grow outward.
// 03 PS16.3 Hollow: the part picked instead of faces, a closed box with a 92 × 52 × 32 void
//    (translucent-free; seen whole).
// 03a P3.11 (P3.6 judge: the void wasn't shown): the part made transparent (Parts list → Make
//    transparent…): the 92 × 52 × 32 void shows inside the box, its edges through the walls;
//    made opaque again before going on.
// 04 PS16.4 back to the open shell, 35 mm: the walls would cross (the box is 60 wide): the title is
//    red and the dialog says why; ✓ stays enabled (P3.7: a failing feature can be kept, red in
//    the list, as the funnel's Shell in ex4-step10.png), and the part is tinted red.
// 05 20 mm, accepted.
// 06 PS16.4 / PS11.1 Extrude 1's depth made 15 mm: the shell's 20 mm walls no longer fit, so
//    Shell 1 fails: red in the list with the ⓘ, the part as it was before it.
// 07 hovering the ⓘ: the reason.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 100 60"),
        Wait(5),
        Key("P"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(50, 30, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("40"),
        Key("Enter"),
        Wait(10),
        Key("F"),
        Wait(40),
        Click(ui("shell")),
        WaitFor("shell-dialog"),
        Wait(5),
        Click(xyz(50, 30, 40)),
        Wait(3),
        Click(ui("shell-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("4"),
        Key("Tab"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-shell-top-open-4mm"),
        Click(ui("shell-thickness-flip")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-shell-outward"),
        Click(ui("shell-thickness-flip")),
        Wait(10),
        Click(ui("shell-hollow-checkbox")),
        Wait(10),
        Click(xyz(50, 0, 20)),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-shell-hollow"),
        // P3.11 (P3.6 judge): the void, seen through the part made transparent.
        RightClick(ui("part-row-part-1")),
        WaitFor("part-transparent"),
        Click(ui("part-transparent")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03a-hollow-void-through-transparent-part"),
        RightClick(ui("part-row-part-1")),
        WaitFor("part-opaque"),
        Click(ui("part-opaque")),
        Wait(10),
        Click(ui("shell-hollow-checkbox")),
        Wait(10),
        Click(ui("shell-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("35"),
        Key("Tab"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-shell-35mm-walls-cross-red"),
        Click(ui("shell-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-shell-20mm-accepted"),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        Wait(5),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("15"),
        Key("Enter"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-extrude-15mm-shell-fails"),
        Hover(ui("feature-shell-1-info")),
        Wait(40),
        Screenshot("07-shell-failure-reason"),
    ],
)
