// Sheet metal model dialog (P3I.2, SM2.1–SM2.7, X1, X5): the toolbar's Sheet metal model group
// with its ▾ (the other sheet metal tools in Onshape's order, greyed until built), the dialog
// on each tab as `help/feature-tools/sheetmetal-dialog-convert-02.png`, `sheetmetal-extrude-02.png`
// and `sheetmetal-thicken-02.png` lay it out (Selections red while empty; General, Material,
// Relief with Onshape's defaults in mm), the Bend calculation and relief type dropdowns, an
// out-of-range K Factor turning its field red with the range as its tooltip, and Search tools
// finding the sheet metal tools.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Screenshot("01-toolbar-menu"),
        Key("Escape"),
        Wait(3),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-convert"),
        Click(ui("sheet-metal-model-operation-1")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-extrude"),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-thicken"),
        Click(ui("sm-bend-calculation")),
        Wait(5),
        Screenshot("05-bend-calculation-menu"),
        Key("Escape"),
        Wait(3),
        Click(ui("sm-corner-relief-type")),
        Wait(5),
        Screenshot("06-corner-relief-menu"),
        Key("Escape"),
        Wait(3),
        Click(ui("sm-k-factor-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Tab"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Hover(ui("sm-k-factor-field")),
        Wait(40),
        Screenshot("07-k-factor-out-of-range"),
        Click(ui("sm-k-factor-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("0.45"),
        Key("Tab"),
        Wait(10),
        Click(ui("sm-relief-header")),
        Click(ui("sm-material-header")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-sections-collapsed"),
        Click(ui("sheet-metal-model-dialog-cancel")),
        Wait(5),
        Key("Alt+C"),
        Wait(5),
        Type("sheet"),
        Wait(5),
        Screenshot("09-search-tools"),
        Key("Escape"),
    ],
)
