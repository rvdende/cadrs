// P3E.3b (TD6.6, PS2.11): the Analysis tools, every step through the UI, on a 100 mm cube on
// Top whose +X side the Draft feature drafted 5° about Top (it leans in as it rises), with its
// front-left vertical edge filleted R12, beside a Ø40 boss extruded 30 mm with its Draft 5°
// flipped (it widens as it rises: −5° against +Z). Values in
// `cadrs_core/tests/measure_analysis.rs` and `cadrs_core::analysis`.
// 01 the bottom-right Analysis tool's menu: Draft analysis…, Curvature, Zebra stripes.
// 02 Draft analysis…: the dialog (Pull direction Top plane, Draft angle 3°) and the legend at
//    the right: the tops +90° (dark green, 6° to 90°), the drafted +X side 5° (green, 3° to 6°),
//    the front side and the fillet 0° (yellow, 0° to 3°), the boss's widening side −5° (light
//    red, −6° to −3°).
// 03 the flip: the pull runs down: the tops dark red, the +X side −5°, the boss's side +5°.
// 04 flipped back, Draft angle 6°: the 5° side is no longer enough (yellow, 0° to 6°; the legend
//    reads 12° to 90°, 6° to 12°, …), the boss's side −6° to 0°.
// 05 ✓: the analysis stays with the dialog closed (the legend too).
// 06 the menu again: "Exit draft analysis"; 07 picked: the parts' own colours.
// 08 Curvature: combs on every curved edge: the boss's circles and the fillet's arcs (taller:
//    R12 is more curved than R20 and R22.6).
// 09 the boss's top edge selected: the comb on it alone.
// 10 Zebra stripes (with the combs still on): black and white bands, packed on the fillet and
//    round the boss, broad on the flat faces.
// 11 both turned off from the menu: the plain parts again.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 100 100"),
        Wait(5),
        Key("P"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(50, 50, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("100"),
        Key("Enter"),
        Wait(10),
        Key("F"),
        Wait(40),
        Click(ui("draft")),
        WaitFor("draft-dialog"),
        Wait(5),
        Click(ui("feature-top")),
        Wait(3),
        Click(xyz(100, 50, 50)),
        Wait(3),
        Click(ui("draft-angle-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        Wait(20),
        Click(ui("draft-dialog-accept")),
        Wait(20),
        Key("Shift+F"),
        WaitFor("fillet-dialog"),
        Wait(5),
        Click(xyz(0, 0, 50)),
        Wait(3),
        Click(ui("fillet-size-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("12"),
        Key("Tab"),
        Wait(10),
        Click(ui("fillet-dialog-accept")),
        Wait(20),
        Custom("sketch top circle 180 50 20"),
        Wait(5),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(180, 50, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        Wait(5),
        Click(ui("extrude-draft-checkbox")),
        Wait(15),
        Click(ui("extrude-draft-angle-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        Wait(5),
        Click(ui("extrude-draft-angle-flip")),
        Wait(10),
        Click(ui("extrude-dialog-accept")),
        Wait(20),
        Key("Space"),
        Key("Shift+7"),
        Wait(10),
        Key("F"),
        Wait(40),
        Click(ui("view-analysis")),
        WaitFor("analysis-draft"),
        Hover(ui("analysis-draft")),
        Wait(3),
        Screenshot("01-analysis-menu"),
        Click(ui("analysis-draft")),
        WaitFor("draft-analysis-dialog"),
        Wait(10),
        ExpectText("draft-pull", "Top plane"),
        ExpectText("draft-legend-1", "3° to 6°"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-draft-analysis-top-3deg"),
        Click(ui("draft-flip")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-pull-flipped"),
        Click(ui("draft-flip")),
        Wait(5),
        Click(ui("draft-angle-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("6"),
        Key("Enter"),
        Wait(10),
        ExpectText("draft-legend-1", "6° to 12°"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-draft-angle-6deg"),
        Click(ui("draft-analysis-dialog-accept")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-accepted-legend-stays"),
        Click(ui("view-analysis")),
        WaitFor("analysis-draft"),
        Hover(ui("analysis-draft")),
        Wait(3),
        ExpectText("analysis-draft", "Exit draft analysis"),
        Screenshot("06-menu-exit-draft"),
        Click(ui("analysis-draft")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-draft-ended"),
        Click(ui("view-analysis")),
        WaitFor("analysis-curvature"),
        Click(ui("analysis-curvature")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-curvature-combs"),
        Click(xyz(196, 34, 30)),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-comb-on-selected-edge"),
        Key("Space"),
        Click(ui("view-analysis")),
        WaitFor("analysis-zebra"),
        Click(ui("analysis-zebra")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-zebra-stripes"),
        Click(ui("view-analysis")),
        WaitFor("analysis-zebra"),
        Click(ui("analysis-zebra")),
        Wait(5),
        Click(ui("view-analysis")),
        WaitFor("analysis-curvature"),
        Click(ui("analysis-curvature")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-analysis-off"),
    ],
)
