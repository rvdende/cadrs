// T1 / S13.3: "the first dimension scales the whole sketch". A 40 × 25 rectangle from the origin
// and a circle in it, no dimensions. The Dimension tool on the bottom edge opens the value
// editor at 40; typing 100 scales everything 2.5× about the origin (the sketch is attached to
// it): the rectangle becomes 100 × 62.5 and the circle grows with it, keeping the shape. One
// Ctrl+Z undoes the value and the scaling together (the placed dimension, at 40, stays);
// Ctrl+Y redoes it. A second dimension (the right edge, 50) only changes its own edge.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        MiddleDrag(at(913, 520), at(760, 640)),
        Wait(5),
        Key("G"),
        Wait(2),
        ClickWorld(0, 0),
        ClickWorld(40, 25),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("C"),
        Wait(2),
        ClickWorld(28, 12),
        ClickWorld(34, 12),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("01-no-dimensions-yet"),
        Key("D"),
        Wait(2),
        Click(world(15, 0)),
        MoveWorld(15, -10),
        Wait(2),
        Click(world(15, -10)),
        Wait(3),
        Screenshot("02-first-dimension-editor-40"),
        Type("100"),
        Wait(2),
        Screenshot("03-typing-100"),
        Key("Enter"),
        Wait(5),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("04-whole-sketch-scaled-2-5x-about-origin"),
        Key("Ctrl+Z"),
        Wait(4),
        Screenshot("05-one-undo-restores-scale-and-value"),
        Key("Ctrl+Y"),
        Wait(4),
        Screenshot("06-redo"),
        Click(world(100, 45)),
        MoveWorld(115, 30),
        Wait(2),
        Click(world(115, 30)),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(4),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("07-second-dimension-changes-only-its-edge"),
    ],
)
