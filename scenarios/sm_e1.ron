// P3I.8 / X7, exercise E1 "Importing DXF & Bend" end to end (`ex1-importing-dxf-bend/step-*.png`)
// on its stand-in: the flat DXF of our tray (`fixtures/sheetmetal/flat_pattern_e1.dxf`, P3I.6).
// 01 Sketch on Top → Insert DXF or DWG; 02 the DXF inserted (outline, cut-outs, six bend lines);
// 03 Sheet metal model → Thicken of the seven regions with step 5's settings (1 mm, R1, K 0.45,
// rolled K 0.5, Minimal gap 0.025, Corner relief Closed, Bend relief Tear); 04 accepted, Sketch 1
// shown again; 05–10 six Bend features along the bend lines (each Bend hides Sketch 1 again, as in
// Onshape, so it is shown before the next) (Inner, the opposite angle so they fold up), the short
// end flanges first; Sketch 1 hidden again; 11 Assign material → Carbon Steel; 12 Mass properties
// (`cadrs_core/tests/sheetmetal_exercises.rs` checks E1_MASS on the same steps).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        // The exercise's document, by its name (step 1).
        Click(ui("document-name")),
        Key("Ctrl+A"),
        Type("Exercise: Import DXF"),
        Key("Enter"),
        Custom("sketch-dxf-dir fixtures/sheetmetal"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Click(ui("sketch-dxf")),
        WaitFor("sketch-dxf-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-insert-dxf"),
        Click(ui("sketch-dxf-file-flat_pattern_e1.dxf")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-dxf-in-sketch"),
        Click(ui("sketch-dialog-accept")),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(xyz(40, 60, 0)),
        Click(xyz(20, -23, 0)),
        Click(xyz(100, -53, 0)),
        Click(xyz(20, 145, 0)),
        Click(xyz(100, 173, 0)),
        Click(xyz(206, 60, 0)),
        Click(xyz(-6, 60, 0)),
        // Step 5's Relief settings: Minimal gap 0.025, Closed corners, Tear bend reliefs.
        Click(ui("sm-minimal-gap-field")),
        Key("Ctrl+A"),
        Type("0.025"),
        Key("Tab"),
        Click(ui("sm-corner-relief-type")),
        Click(ui("sm-corner-relief-type-option-4")),
        Click(ui("sm-bend-relief-type")),
        Click(ui("sm-bend-relief-type-option-2")),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-thicken-seven-regions"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Hover(ui("feature-sketch-1")),
        Wait(5),
        Click(ui("feature-sketch-1-visibility")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-sheet-and-bend-lines"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Custom("view 30 -40 100 60 0 0.22"),
        Click(xyz(199.1388, 60, 0)),
        Click(ui("sm-bend-alignment")),
        Click(ui("sm-bend-alignment-option-3")),
        Click(ui("sm-bend-angle-control-flip")),
        Custom("view 30 35 100 60 0 0.22"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-east-flange"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        // The Bend hid Sketch 1 again (as Onshape does): show it for the next line (E1 step 10).
        Hover(ui("feature-sketch-1")),
        Wait(5),
        Click(ui("feature-sketch-1-visibility")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Custom("view 30 -40 100 60 0 0.22"),
        Click(xyz(0.8612, 60, 0)),
        Click(ui("sm-bend-alignment")),
        Click(ui("sm-bend-alignment-option-3")),
        Click(ui("sm-bend-angle-control-flip")),
        Custom("view 30 35 100 60 0 0.22"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-west-flange"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        // The Bend hid Sketch 1 again (as Onshape does): show it for the next line (E1 step 10).
        Hover(ui("feature-sketch-1")),
        Wait(5),
        Click(ui("feature-sketch-1-visibility")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Custom("view 30 -40 100 60 0 0.22"),
        Click(xyz(100, -47.4165, 0)),
        Click(ui("sm-bend-alignment")),
        Click(ui("sm-bend-alignment-option-3")),
        Click(ui("sm-bend-angle-control-flip")),
        Custom("view 30 35 100 60 0 0.22"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-south-lip"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        // The Bend hid Sketch 1 again (as Onshape does): show it for the next line (E1 step 10).
        Hover(ui("feature-sketch-1")),
        Wait(5),
        Click(ui("feature-sketch-1-visibility")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Custom("view 30 -40 100 60 0 0.22"),
        Click(xyz(100, 167.4165, 0)),
        Click(ui("sm-bend-alignment")),
        Click(ui("sm-bend-alignment-option-3")),
        Click(ui("sm-bend-angle-control-flip")),
        Custom("view 30 35 100 60 0 0.22"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-north-lip"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        // The Bend hid Sketch 1 again (as Onshape does): show it for the next line (E1 step 10).
        Hover(ui("feature-sketch-1")),
        Wait(5),
        Click(ui("feature-sketch-1-visibility")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Custom("view 30 -40 100 60 0 0.22"),
        Click(xyz(100, 0.8612, 0)),
        Click(ui("sm-bend-alignment")),
        Click(ui("sm-bend-alignment-option-3")),
        Click(ui("sm-bend-angle-control-flip")),
        Custom("view 30 35 100 60 0 0.22"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-south-wall"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        // The Bend hid Sketch 1 again (as Onshape does): show it for the next line (E1 step 10).
        Hover(ui("feature-sketch-1")),
        Wait(5),
        Click(ui("feature-sketch-1-visibility")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Custom("view 30 -40 100 60 0 0.22"),
        Click(xyz(100, 119.1388, 0)),
        Click(ui("sm-bend-alignment")),
        Click(ui("sm-bend-alignment-option-3")),
        Click(ui("sm-bend-angle-control-flip")),
        Custom("view 30 35 100 60 0 0.22"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-north-wall"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        // Sketch 1 hidden again, so it doesn't cover the folded part.
        Hover(ui("feature-sketch-1")),
        Wait(5),
        Click(ui("feature-sketch-1-visibility")),
        Key("Shift+7"),
        Key("F"),
        RightClick(ui("part-row-part-1")),
        Click(ui("part-material")),
        Click(ui("material-choose")),
        Type("carbon"),
        Click(ui("material-item-carbon-steel")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-carbon-steel"),
        Click(ui("material-dialog-accept")),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-mass-properties"),
    ],
)
