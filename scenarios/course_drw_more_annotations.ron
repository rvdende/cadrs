        // The revision table.
        Click(ui("drawing-table")),
        WaitFor("table-dialog"),
        Click(ui("table-revision")),
        Wait(3),
        // One row to fill in (the table stays clear of the 200.00 below Front).
        Click(ui("table-rows-field")),
        Key("Ctrl+A"),
        Type("1"),
        Wait(3),
        // Its fixed corner bottom right, on the title block's top right corner (clear of the
        // views and the ordinates above Top).
        Click(ui("table-corner-bottom-right")),
        Wait(3),
        MoveWorld(266.7, 57.15),
        Wait(5),
        Screenshot("13-revision-table-preset"),
        ClickWorld(266.7, 57.15),
        Wait(5),
        Key("Escape"),
        Wait(3),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("14-revision-table"),
        ClickWorld(150, 30),
        Wait(3),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("15-finished-sheet"),
    ],
)
