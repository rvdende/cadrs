// P3C.8 / D6.4, X14: baseline, ordinate, chamfer and arc length dimensions, a GD&T feature control
// frame with datums A and B, a surface finish symbol, a weld symbol and a revision table on the
// P3C.8 bar (`Custom("bar-drawing")`: 200 × 20 × 10, a Ø6 hole at x 30, an M6 tapped hole at
// x 170, 1 mm chamfers at x 0, R8 rounds at x 200). ANSI A in mm, 1:1: Front's model origin at
// sheet (30, 112) (the bar at y 102..112), Top's at (30, 158) (y 148..168); sheet points are
// `world(x, y)` in sheet mm.
// 01 the bar's drawing. 02 Dimension ▾: baseline, ordinate, chamfer and arc length enabled.
// 03 Ordinate: the zero point (the chamfered end's middle) hovered. 04 the ordinates placed
//    above Top and extended to the Ø6 hole, the tapped hole and the far end: 0.00, 30.00,
//    170.00, 200.00.
// 05 Baseline from the same end to the two holes: 30.00 and 170.00 stacked below Top.
// 06 Chamfer on the chamfer's edge, following the cursor: "1.00 x 45°" from the Chamfer
//    feature, its leader clear of the 0.00 ordinate. 07 Arc length on the lower R8 round: ⌒12.57.
// 08 Geometric tolerance: the feature control frame card (Position, Ø0.05 Ⓜ, A, B).
// 09 the frame placed on a leader to the Ø6 hole's side in Front.
// 10 Datum features A (Front's bottom) and B (its end): boxed letters on filled triangles.
// 11 Surface finish (material removal required, Ra 1.6) on Front's top.
// 12 Weld symbol: a 5 fillet on the arrow side at the bar's end.
// 13 Table: the Revision table preset with one row, fixed corner bottom right. 14 placed on the
//    title block's top right corner: REV | DESCRIPTION | DATE | APPROVED.
// 15 the finished sheet.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("bar-drawing"),
        Wait(120),
        Key("F"),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("01-bar-drawing"),
        // Ordinate dimensions from the chamfered end, above Top.
        Hover(ui("drawing-dimension-caret")),
        Wait(3),
        Click(ui("drawing-dimension-caret")),
        WaitFor("drawing-dim-ordinate"),
        Hover(ui("drawing-dim-ordinate")),
        Wait(5),
        Screenshot("02-dimension-menu"),
        Click(ui("drawing-dim-ordinate")),
        Wait(3),
        MoveWorld(30, 158),
        Wait(5),
        Screenshot("03-ordinate-zero-hover"),
        ClickWorld(30, 158),
        Wait(3),
        MoveWorld(30, 190),
        Wait(3),
        ClickWorld(30, 190),
        Wait(3),
        ClickWorld(60, 158),
        Wait(3),
        ClickWorld(200, 158),
        Wait(3),
        ClickWorld(230, 158),
        Wait(3),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("04-ordinates"),
        // Baseline dimensions below Top.
        Hover(ui("drawing-dimension-caret")),
        Wait(3),
        Click(ui("drawing-dimension-caret")),
        WaitFor("drawing-dim-baseline"),
        Click(ui("drawing-dim-baseline")),
        Wait(3),
        ClickWorld(30, 158),
        Wait(3),
        ClickWorld(60, 158),
        Wait(3),
        MoveWorld(45, 140),
        Wait(3),
        ClickWorld(45, 140),
        Wait(3),
        ClickWorld(200, 158),
        Wait(3),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("05-baseline"),
        // Chamfer dimension.
        Hover(ui("drawing-dimension-caret")),
        Wait(3),
        Click(ui("drawing-dimension-caret")),
        WaitFor("drawing-dim-chamfer"),
        Click(ui("drawing-dim-chamfer")),
        Wait(3),
        ClickWorld(30.5, 167.5),
        Wait(3),
        MoveWorld(35.8, 174),
        Wait(5),
        Screenshot("06-chamfer-following-cursor"),
        ClickWorld(35.8, 174),
        Wait(3),
        Key("Escape"),
        // Arc length on the lower round.
        Hover(ui("drawing-dimension-caret")),
        Wait(3),
        Click(ui("drawing-dimension-caret")),
        WaitFor("drawing-dim-arc-length"),
        Click(ui("drawing-dim-arc-length")),
        Wait(3),
        ClickWorld(227.66, 150.34),
        Wait(3),
        MoveWorld(241, 141),
        Wait(3),
        ClickWorld(241, 141),
        Wait(3),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("07-chamfer-and-arc-length"),
        // GD&T: a feature control frame on the Ø6 hole, datums A and B.
        Click(ui("drawing-gdt")),
        WaitFor("gdt-card"),
        Wait(5),
        MoveWorld(57, 107),
        Wait(5),
        Screenshot("08-feature-control-frame-card"),
        ClickWorld(57, 107),
        Wait(3),
        MoveWorld(72, 124),
        Wait(3),
        ClickWorld(72, 124),
        Wait(3),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("09-feature-control-frame"),
        Hover(ui("drawing-gdt-caret")),
        Wait(3),
        Click(ui("drawing-gdt-caret")),
        WaitFor("drawing-gdt-datum"),
        Click(ui("drawing-gdt-datum")),
        WaitFor("datum-card"),
        ClickWorld(150, 102),
        Wait(3),
        ClickWorld(150, 94),
        Wait(3),
        Key("Escape"),
        Hover(ui("drawing-gdt-caret")),
        Wait(3),
        Click(ui("drawing-gdt-caret")),
        WaitFor("drawing-gdt-datum"),
        Click(ui("drawing-gdt-datum")),
        WaitFor("datum-card"),
        ClickWorld(30, 107),
        Wait(3),
        ClickWorld(18, 107),
        Wait(3),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("10-datums"),
        Key("Escape"),
        // Surface finish on Front's top.
        Click(ui("drawing-surface-finish")),
        WaitFor("finish-card"),
        ClickWorld(175, 112),
        Wait(3),
        ClickWorld(175, 112),
        Wait(3),
        MoveTo(1500, 960),
