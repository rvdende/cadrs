// #96: an angle dimension turns its line like a hinge, to any value. Two lines from the origin,
// 45° apart, get an angle dimension placed between them; typing 270 turns the second line on
// round, past the first, to point down (the arc and value round the outside). Dragging the
// value between the lines measures the same lines the other way round (90), and dragging it
// outside again gives 270. Typing 180 puts the line in line with the first, and -30 turns it back
// past it (the arc the short way back). A length typed as -40 flips the first line to the other
// side of its start; the second, hinged on it, turns round with it.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("L"),
        ClickWorld(0, 0),
        ClickWorld(40, 0),
        Key("Escape"),
        ClickWorld(0, 0),
        ClickWorld(25, 25),
        Key("Escape"),
        Key("Escape"),
        Key("D"),
        ClickWorld(30, 0),
        ClickWorld(18, 18),
        MoveWorld(22, 8),
        Wait(2),
        ClickWorld(22, 8),
        Wait(2),
        Type("45"),
        Key("Enter"),
        Key("Escape"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("01-angle-45-inside"),
        DoubleClick(ui("dim-label-45°")),
        Key("Ctrl+A"),
        Type("270"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("02-angle-270-turned-past-the-first-line"),
        Drag(ui("dim-label-270°"), world(14, -14)),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("03-dragged-between-the-lines-90"),
        Drag(ui("dim-label-90°"), world(-12, 14)),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("04-dragged-outside-270"),
        DoubleClick(ui("dim-label-270°")),
        Key("Ctrl+A"),
        Type("180"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("05-angle-180-in-line"),
        DoubleClick(ui("dim-label-180°")),
        Key("Ctrl+A"),
        Type("-30"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("06-angle-minus-30"),
        // A length typed negative puts the line's end on the other side of its start; the line
        // hinged on it turns round with it.
        Key("D"),
        ClickWorld(32, 0),
        MoveWorld(32, 10),
        Wait(2),
        ClickWorld(32, 10),
        Wait(2),
        Type("40"),
        Key("Enter"),
        Key("Escape"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("07-length-40"),
        DoubleClick(ui("dim-label-40")),
        Key("Ctrl+A"),
        Type("-40"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("08-length-minus-40-flipped"),
    ],
)
