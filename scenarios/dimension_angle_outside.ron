// #96: an angle dimension past 180° is measured round the outside, as Onshape. Two lines from
// the origin, 45° apart, get an angle dimension placed between them; typing 270 measures the
// angle round the outside (the lines end up 90° apart, the arc and value outside them). Dragging
// the value back between the lines measures the angle between them again (90), and dragging it
// outside once more measures it round the outside (270). Typing 360 is refused with a message.
// A length typed as -40 flips the line to the other side of its start.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("L"),
        ClickWorld(0, 0),
        ClickWorld(40, 0),
        Key("Escape"),
        ClickWorld(0, 0),
        ClickWorld(25, 25),
        Key("Escape"),
        Key("Escape"),
        Key("D"),
        ClickWorld(30, 0),
        ClickWorld(18, 18),
        MoveWorld(22, 8),
        Wait(2),
        ClickWorld(22, 8),
        Wait(2),
        Type("45"),
        Key("Enter"),
        Key("Escape"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("01-angle-45-inside"),
        DoubleClick(ui("dim-label-45°")),
        Key("Ctrl+A"),
        Type("270"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("02-angle-270-round-the-outside"),
        Drag(ui("dim-label-270°"), world(20, 9)),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("03-dragged-between-the-lines-90"),
        Drag(ui("dim-label-90°"), world(-12, -14)),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("04-dragged-outside-270"),
        DoubleClick(ui("dim-label-270°")),
        Key("Ctrl+A"),
        Type("360"),
        Key("Enter"),
        Wait(2),
        Screenshot("05-360-refused"),
        Key("Escape"),
        // A length typed negative puts the line's end on the other side of its start.
        Key("D"),
        ClickWorld(20, 0),
        MoveWorld(20, -8),
        Wait(2),
        ClickWorld(20, -8),
        Wait(2),
        Type("40"),
        Key("Enter"),
        Key("Escape"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("06-length-40"),
        DoubleClick(ui("dim-label-40")),
        Key("Ctrl+A"),
        Type("-40"),
        Key("Enter"),
        MoveWorld(90, -45),
        Wait(2),
        Screenshot("07-length-minus-40-flipped"),
    ],
)
