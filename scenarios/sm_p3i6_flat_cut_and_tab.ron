        Wait(40),
        Custom("view 210 25 30 -40 15 0.09"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-slot-wrapped-across-the-bends"),
        Key("Shift+7"),
        Wait(20),
        Key("F"),
        Wait(20),
        RightClick(ui("feature-sheet-metal-model-1")),
        Wait(5),
        Click(ui("feature-flat-sketch")),
