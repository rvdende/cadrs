// P3I.6 (SM14; lesson `14-modeling-in-the-flat-view`, frames t0048–t0080): a sheet metal Extrude
// of an open U on Front (a channel 50 up, 120 across, 50 up, 120 deep), the panel's flat view
// beside the 3D view as Onshape's, workspace units inches (the lesson's). The flat view's menu ›
// New sketch: the sketch is drawn in the flat view (01), with the flat's bend lines to work
// against. The lesson's slot, exactly 6.0 × 0.5 in on the flat, its left end 0.75 in from Bend A
// (02, dimensioned in the flat view). Closing the panel while sketching leaves it open, with a
// short note in the flat view (02b). Accepted; the slot's region picked in the flat view and
// Extrude (Shift+E) opens the abbreviated Extrude, Remove chosen (all on material), the region
// orange in the flat view and wrapped onto the folded walls in 3D (03); accepted, the slot is cut
// at its exact flat size, wrapped round both bends (04). A second sketch on the flat: a tab over
// the right wall's free edge (05), picked in the flat view and extruded Add (06), folded on that
// wall (07).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch front chain 0 50 0 0 120 0 120 50"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-1")),
        Wait(10),
        Click(xyz(60, 0, 0)),
        Wait(5),
        Click(xyz(0, 0, 25)),
        Wait(5),
        Click(xyz(120, 0, 25)),
        Wait(5),
        Click(ui("sm-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("120"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(40),
        // Inches, as the lesson.
        Click(ui("document-menu")),
        WaitFor("document-menu-popup"),
        Wait(3),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        Wait(5),
        Click(ui("units-length")),
        WaitFor("units-length-menu"),
        Wait(3),
        Click(ui("units-length-option-3")),
        Wait(3),
        Click(ui("units-ok")),
        Wait(10),
        Click(ui("panel-sheet-metal")),
        Wait(60),
        Key("F"),
        Wait(20),
        RightClick(ui("smt-flat")),
        Wait(10),
        Click(ui("smt-flat-sketch")),
        WaitFor("sketch-dialog"),
        Wait(30),
        // The slot: a corner rectangle, typed 6 × 0.5 in.
        Key("G"),
        Wait(2),
        ClickWorld(31, -66.35),
        ClickWorld(183.4, -53.65),
        Wait(5),
        Type("6"),
        Key("Enter"),
        Wait(3),
        Type("0.5"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(3),
        MoveWorld(110, -20),
        Wait(3),
        Screenshot("01-sketch-in-the-flat-view"),
        // Its left end 0.75 in from Bend A's centre line.
        Key("D"),
        Wait(2),
        Click(world(31, -60)),
        Wait(2),
        Click(world(49.1, -100)),
        Wait(2),
        MoveWorld(40, -85),
        Wait(2),
        Click(world(40, -85)),
        Wait(5),
        Type("0.75"),
        Key("Enter"),
        Wait(5),
        Key("Escape"),
        Wait(3),
        MoveWorld(110, -20),
        Wait(3),
        Screenshot("02-slot-dimensioned-against-a-bend-line"),
        // Closing the panel mid-sketch: the flat view stays (the sketch has nowhere else to be).
        Click(ui("panel-sheet-metal")),
        Wait(20),
        MoveWorld(110, -20),
        Wait(3),
        Screenshot("02b-panel-stays-open-while-sketching"),
        Click(ui("sketch-dialog-accept")),
        Wait(30),
        // The slot's region, picked in the flat view.
        Click(flat(110, -60)),
        Wait(5),
        Key("Shift+E"),
        WaitFor("flat-extrude-dialog"),
        Wait(30),
        MoveTo(1580, 980),
        Wait(3),
        Screenshot("03-abbreviated-extrude-remove"),
        Click(ui("flat-extrude-dialog-accept")),
        Wait(40),
        Key("Shift+7"),
        Wait(20),
        Key("F"),
        Wait(20),
        MoveTo(1580, 980),
        Wait(3),
        Screenshot("04-slot-wrapped-across-the-bends"),
        RightClick(ui("smt-flat")),
        Wait(10),
        Click(ui("smt-flat-sketch")),
        WaitFor("sketch-dialog"),
        Wait(20),
        Key("G"),
        Wait(2),
        ClickWorld(205, -70),
        ClickWorld(230, -50),
        Wait(3),
        Key("Escape"),
        Key("Escape"),
        Wait(5),
        MoveWorld(110, -20),
        Wait(3),
        Screenshot("05-tab-in-the-flat-view"),
        Click(ui("sketch-dialog-accept")),
        Wait(30),
        Click(flat(225, -60)),
        Wait(5),
        Key("Shift+E"),
        WaitFor("flat-extrude-dialog"),
        Wait(30),
        MoveTo(1580, 980),
        Wait(3),
        Screenshot("06-abbreviated-extrude-add"),
        Click(ui("flat-extrude-dialog-accept")),
        Wait(40),
        Key("Shift+7"),
        Wait(20),
        Key("F"),
        Wait(20),
        MoveTo(1580, 980),
        Wait(3),
        Screenshot("07-tab-folded"),
    ],
)
