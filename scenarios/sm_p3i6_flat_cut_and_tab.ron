// P3I.6 (SM14; lesson `14-modeling-in-the-flat-view`, frames t0056–t0080): a sheet metal Extrude
// of an open U on Front (a channel, 80 deep). The model's context menu › "New sketch on flat
// pattern": a sketch in the flat's coordinates (its plane on the anchor wall). A slot 82 × 6
// across both bend lines; Extrude (Shift+E) with the sketch selected opens the abbreviated
// Extrude (Add | Remove, Remove chosen: all on material); accepted, the folded part has the slot
// wrapped round both bends at its exact flat size. Then a second flat sketch with a 14 × 20 tab
// over the right wall's free edge, extruded Add (chosen: not all on material): the tab appears
// folded on that wall.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch front chain 0 30 0 0 60 0 60 30"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-1")),
        Wait(10),
        Click(xyz(30, 0, 0)),
        Wait(5),
        Click(xyz(0, 0, 15)),
        Wait(5),
        Click(xyz(60, 0, 15)),
        Wait(5),
        Click(ui("sm-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("80"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(40),
        Key("F"),
        Wait(20),
        RightClick(ui("feature-sheet-metal-model-1")),
        Wait(5),
        Screenshot("01-new-sketch-on-flat-pattern"),
        Click(ui("feature-flat-sketch")),
        WaitFor("sketch-dialog"),
        Wait(10),
        Key("G"),
        Wait(2),
        ClickWorld(15, -45),
        ClickWorld(97, -39),
        Wait(3),
        Key("Escape"),
        Key("Escape"),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-slot-in-the-flat"),
        Click(ui("sketch-dialog-accept")),
        Wait(20),
        Click(ui("feature-sketch-2")),
        Wait(3),
        Key("Shift+E"),
        WaitFor("flat-extrude-dialog"),
