// P3.8 / PS26: Mirror. The Control Arm (its two extrudes New) cut to its y ≥ 0 half, then (PS26.2)
// a Part mirror of both halves across Front with Add: one symmetric part of the course's full
// volume, 368 749.705 mm³ (asserted in `cadrs_core/tests/pattern.rs`); then (PS26.3) a Feature
// mirror of a hole across Right.
// 01 the half arm (Extrude 3 removed y < 0 from both parts): 184 374.852 mm³.
// 02 Mirror 1: Part mirror, Add, Parts to mirror Part 1 and Part 2, Mirror plane Front plane.
// 03 accepted: one part; Mass and section properties: 368 749.705 mm³ and 50 179.711 mm²,
//    the course's values.
// 04 a hole (Ø5, through all, up from the Top plane) at a sketch point on the right web,
//    Mirror 2: Feature mirror of it across Right: the same hole in the left web.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("control-arm"),
        Custom("sketch top rect -200 -200 200 0"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-2")),
        Click(ui("extrude-operation-2")),
        Click(ui("extrude-merge-all-checkbox")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("100"),
        Key("Enter"),
        Key("F"),
        Click(ui("part-row-part-1")),
        Click(ui("part-row-part-2")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-half-control-arm"),
        Click(ui("mass-dialog-cancel")),
        ClickAt(1420, 900),
        Click(ui("mirror")),
        WaitFor("mirror-dialog"),
        Click(ui("mirror-operation-1")),
        Click(ui("part-row-part-1")),
        Click(ui("part-row-part-2")),
        Click(ui("mirror-plane-field")),
        Click(ui("feature-front")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-part-mirror-add-front"),
        Click(ui("mirror-dialog-accept")),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-one-part-full-volume"),
        Click(ui("mass-dialog-cancel")),
        ClickAt(1420, 900),
        Custom("sketch top point 55 0"),
        Click(ui("hole")),
        WaitFor("hole-dialog"),
        Click(ui("feature-sketch-3")),
        Click(ui("hole-termination")),
        Click(ui("hole-termination-option-0")),
        Click(ui("hole-termination-flip")),
        Click(ui("hole-dialog-accept")),
        Click(ui("mirror")),
        WaitFor("mirror-dialog"),
        Click(ui("mirror-type")),
        Click(ui("mirror-type-option-1")),
        Click(ui("feature-ø-5-mm-thru")),
        Click(ui("mirror-plane-field")),
        Click(ui("feature-right")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-feature-mirror-hole-right"),
        Click(ui("mirror-dialog-accept")),
    ],
)
