// P3E.1 (test-drive.md TD3.1 Label…, TD3.3 Labels, TD3.7 labels column, TD3.8 labels in the
// details panel; derived-and-linking ER1.2 Labels location), against
// `test-drive/lesson-documents-page.png`: the documents page with 8 seeded documents.
// 01 Create ▾ open, the pointer on Label….
// 02 Create label dialog, "Fixtures" typed.
// 03 created: the sidebar's Labels section opens and lists Fixtures; the toast with Undo.
// 04 two more labels (Hardware from the sidebar's tag icon, Medical Devices): the list.
// 05 a click on a row selects it (no open): the Details panel opens on the right with the
//    thumbnail, Owner, Document description and Document labels (search field, three
//    checkboxes, Create new label), Created by.
// 06 "har" typed in Search labels: only Hardware is left.
// 07 Hardware checked: the Labels column appears in the list with the Hardware chip, and the
//    chip under Document labels.
// 08 the row menu's Labels ▸ submenu on another document (Fixtures hovered): each label with its
//    colour dot, a check mark on those the document has.
// 09 Fixtures given to two more documents from the menu: the Labels column.
// 10 the sidebar's Fixtures clicked: only the 3 documents with Fixtures; heading "Fixtures".
// 11 right-click Fixtures in the sidebar: Rename… / Delete….
// 12 Rename label dialog → "Jigs".
// 13 renamed: the sidebar, heading and chips read Jigs.
// 14 Delete… confirmation ("taken off 3 documents").
// 15 deleted: back to Owned by me, the chips gone.
// 16 Ctrl+Z: Jigs back on its 3 documents.
// 16b (P3E.2, P3E.1 judge) Owned by me in the grid view: the cards carry their label chips.
// 16c the list: Motor mount selected (Details), then moved to the trash: the selection and the
//     Details panel are cleared ("Select a document to see its details").
// 16d the Trash: Motor mount selected: its Details are read-only (description and labels shown,
//     not editable; "restore it to edit"). Then Ctrl+Z restores it.
// 17 (ER1.2) a document opened by double-click → Assembly 1 → Insert → Other documents: the
//    locations list the labels (Hardware, Jigs, Medical Devices) after the folders.
// 18 the Jigs location: its documents.
Scenario(
    start: Some("landing"),
    seed_documents: 8,
    steps: [
        WaitFor("doc-row-0"),
        Click(ui("create")),
        WaitFor("new-label"),
        Hover(ui("new-label")),
        Wait(3),
        Screenshot("01-create-menu-label"),
        Click(ui("new-label")),
        WaitFor("new-label-dialog"),
        Type("Fixtures"),
        Screenshot("02-create-label-dialog"),
        Key("Enter"),
        WaitFor("label-item-fixtures"),
        Screenshot("03-label-created"),
        Click(ui("labels-new")),
        WaitFor("new-label-dialog"),
        Type("Hardware"),
        Key("Enter"),
        WaitFor("label-item-hardware"),
        Click(ui("create")),
        WaitFor("new-label"),
        Click(ui("new-label")),
        WaitFor("new-label-dialog"),
        Type("Medical Devices"),
        Key("Enter"),
        WaitFor("label-item-medical-devices"),
        Screenshot("04-three-labels"),
        Click(ui("doc-name-0")),
        WaitFor("details-label-search"),
        Screenshot("05-row-selected-details"),
        Click(ui("details-label-search-field")),
        Type("har"),
        Screenshot("06-label-search"),
        Click(ui("details-label-hardware")),
        WaitFor("doc-label-0-hardware"),
        Screenshot("07-label-assigned"),
        RightClick(ui("doc-name-1")),
        WaitFor("ctx-labels"),
        Hover(ui("ctx-labels")),
        WaitFor("ctx-label-fixtures"),
        Hover(ui("ctx-label-fixtures")),
        Wait(3),
        Screenshot("08-row-menu-labels"),
        Click(ui("ctx-label-fixtures")),
        RightClick(ui("doc-name-2")),
        WaitFor("ctx-labels"),
        Hover(ui("ctx-labels")),
        WaitFor("ctx-label-fixtures"),
        Click(ui("ctx-label-fixtures")),
        RightClick(ui("doc-name-4")),
        WaitFor("ctx-labels"),
        Hover(ui("ctx-labels")),
        WaitFor("ctx-label-fixtures"),
        Click(ui("ctx-label-fixtures")),
        MoveTo(900, 900),
        Wait(3),
        Screenshot("09-labels-column"),
        Click(ui("label-item-fixtures")),
        Screenshot("10-label-filter"),
        RightClick(ui("label-item-fixtures")),
        WaitFor("label-context-menu"),
        Hover(ui("label-rename")),
        Wait(3),
        Screenshot("11-label-menu"),
        Click(ui("label-rename")),
        WaitFor("rename-label-dialog"),
        Type("Jigs"),
        Screenshot("12-rename-label-dialog"),
        Key("Enter"),
        WaitFor("label-item-jigs"),
        Screenshot("13-label-renamed"),
        RightClick(ui("label-item-jigs")),
        WaitFor("label-delete"),
        Click(ui("label-delete")),
        WaitFor("delete-label-dialog"),
        Screenshot("14-delete-label-confirm"),
        Click(ui("delete-label-dialog-ok")),
        Screenshot("15-label-deleted"),
        Key("Ctrl+Z"),
        WaitFor("label-item-jigs"),
        Screenshot("16-delete-undone"),
        Click(ui("filter-owned")),
        Click(ui("view-grid")),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("16b-grid-label-chips"),
        Click(ui("view-list")),
        Click(ui("doc-name-0")),
        RightClick(ui("doc-name-0")),
        WaitFor("ctx-trash"),
