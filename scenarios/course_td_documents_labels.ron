        Click(ui("filter-trash")),
        Click(ui("doc-name-0")),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("16d-trash-details-read-only"),
        Key("Ctrl+Z"),
        Click(ui("filter-owned")),
        Wait(3),
        DoubleClick(ui("doc-name-3")),
        WaitFor("document-shell"),
        Click(ui("tab-assembly-1")),
        Click(ui("insert")),
