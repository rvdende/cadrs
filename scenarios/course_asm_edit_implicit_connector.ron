// P3B.7 / A23 "Editing implicit mate connectors" on the mates stand-in
// (`fixtures/mates_standin.cadrs`): a Pin slot mate whose slot connector's X runs across the
// slot (reoriented while mating), put right by editing the mate's connector.
// 01 the Slot Plate and the Pin (fixed) inserted.
// 02a Pin slot (top view): the slot's floor, then the pin's top edge; Reorient turns the slot
//    connector's X across the slot (the plate turns with it). 02 accepted.
// 03 (A23.1) the mate expanded: its two connectors.
// 04 (A23.1) hovering the slot's connector highlights it.
// 05 (A23.2) right-click the connector: Edit….
// 06 (A23.2) the Mate connector dialog on it: X (red) across the slot.
// 07 (A23.3) Realign, Secondary axis = the slot's edge: X along the slot.
// 08 (A23.4) Move: Z 6 mm (the plate follows; flipped, it then stands clear of the pin rather
//    than meeting its top face flush).
// 09 (A23.4) Flip primary axis.
// 10 (A23.4) Reorient secondary axis (90°).
// 11 accepted (flip and reorient undone): the edits kept on the mate's connector.
// 12 dragging the plate: it slides along the slot (the realigned X).
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture mates_standin"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-part-slot-plate")),
        Wait(2),
        Click(ui("insert-part-pin")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        Key("Shift+5"),
        Wait(20),
        Key("F"),
        Wait(30),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("01-plate-and-pin-fixed"),
        // Pin slot (top view): the slot's floor, then the pin's top edge (its centre).
        Click(ui("mate-pin-slot")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(-20, 0, 4)),
        Wait(3),
        Click(xyz(-20, 0, 4)),
        Wait(5),
        Hover(xyz(-20, 40, 16)),
        Wait(3),
        Click(xyz(-20, 40, 16)),
        Wait(8),
        // Reorient: the slot connector's X across the slot (the plate turns with it).
        Click(ui("mate-reorient")),
        Wait(8),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("02a-pin-slot-reoriented-in-dialog"),
        Click(ui("mate-dialog-accept")),
        Wait(10),
        Key("F"),
        Wait(30),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("02-pin-slot-x-across-the-slot"),
        // A23.1: expand the mate.
        RightClick(ui("mate-row-1")),
        WaitFor("mate-expand"),
        Hover(ui("mate-expand")),
        Wait(5),
        Click(ui("mate-expand-connectors")),
        Wait(8),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("03-a23.1-mate-expanded"),
        Hover(ui("mate-row-1-connector-1")),
        Wait(8),
        Screenshot("04-a23.1-hover-highlights-connector"),
        // A23.2: right-click → Edit.
        RightClick(ui("mate-row-1-connector-1")),
        WaitFor("connector-edit"),
        Wait(3),
        Hover(ui("connector-edit")),
        Wait(3),
        Screenshot("05-a23.2-connector-menu"),
        Click(ui("connector-edit")),
        WaitFor("mate-connector-dialog"),
        Wait(8),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("06-a23.2-edit-connector-dialog"),
        // A23.3: Realign, the secondary axis to the slot's edge.
        Click(ui("mate-connector-realign-checkbox")),
        Wait(5),
        Click(ui("mate-connector-secondary-field")),
        Wait(3),
        Hover(xyz(-15, 55, 22)),
        Wait(3),
        Click(xyz(-15, 55, 22)),
        Wait(10),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("07-a23.3-realigned-to-slot-edge"),
        // A23.4: Move, Flip, Reorient.
        Custom("view 25 40 -20 45 16 0.13"),
        Wait(10),
        Click(ui("mate-connector-move-checkbox")),
        Wait(5),
        Click(ui("mate-connector-z-field")),
        Key("Ctrl+A"),
        Type("6 mm"),
        Key("Tab"),
        Wait(10),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("08-a23.4-move-z"),
        Click(ui("mate-connector-flip")),
        Wait(10),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("09-a23.4-flip-primary"),
        Click(ui("mate-connector-flip")),
        Wait(5),
        Click(ui("mate-connector-reorient")),
        Wait(10),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("10-a23.4-reorient-secondary"),
        Click(ui("mate-connector-reorient")),
        Wait(3),
        Click(ui("mate-connector-reorient")),
        Wait(3),
        Click(ui("mate-connector-reorient")),
        Wait(5),
        Click(ui("mate-connector-dialog-accept")),
        Wait(10),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("11-accepted-edits-on-the-mate"),
        // The plate slides along the slot's (realigned) X.
        Key("Shift+5"),
        Wait(10),
        Key("F"),
        Wait(20),
        Press(xyz(-20, 15, 18)),
        Hover(xyz(-20, 12, 18)),
        Wait(2),
        Hover(xyz(-20, 6, 18)),
        Wait(2),
        Hover(xyz(-20, 0, 18)),
        Wait(8),
        Screenshot("12-plate-slides-along-slot"),
        Release,
        Wait(5),
    ],
)
