// P3B.7 / A24 "Exercise: Creating Explicit Mate Connectors" on the step stool stand-in
// (`fixtures/step_stool_standin.cadrs`, inch and pound, as the course sets them).
// 00 (A24.1) the workspace units: Inch / Pound.
// 01 (A24.1, A24.2) the copy opened: Step Stool Assembly, pre-mated except the hinge (Large Frame
//    Bar fixed, Cross Bar Fastened to the Base Frame Bar, which still has DOF; the base frame
//    hangs a little off where the hinge will put it).
// 02 (A24.3) Switch to the Base Frame Bar studio: 3 parts.
// 03 (A24.4) Ctrl+M: the Mate connector dialog.
// 04 (A24.5) Between entities: Origin entity the lug hole's edge.
// 05 (A24.5) Between entity the other lug's inside face; owner Base Frame Bar: the connector
//    midway on the hinge axis.
// 06 (A24.6) Switch to Large Frame Bar: the Hole Positions sketch shows.
// 07 (A24.7, A24.8) Mate connector 1: On entity, the sketch circle's centre, owner Large Frame Bar.
// 08 (A24.9) Back in the assembly: both connectors on their instances.
// 09 (A24.10) Revolute between them, limits −42.5° … 0°: the base frame snaps onto the hinge.
// 10 (A24.10) Revolute 1 accepted (the same view); K hides the connectors. The instances that
//    carry Part Studio connectors have a ▸; the Base Frame Bar's opened lists its "Mate
//    connector 1", hovered: highlighted in the view (ex4-step11).
// 11 (A24.11) dragging the base frame: it stops at −42.5°.
// 12 Apply limit position (−42.5°): mass properties, CoM (0, −2.422, 12.755) in; the panel's mass
//    unit set to g, as the course's panel shows it.
// 13 (A24.11) Revolute 1 → Reset.
// 14 (A24.12) mass properties of the assembly (g, in, g·in²): 18 131.792 g, CoM (0, −0.033,
//    11.642) in.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture step_stool_standin"),
        Wait(20),
        Click(ui("tab-step-stool-assembly")),
        Wait(10),
        Key("Shift+7"),
        Wait(10),
        Key("F"),
        Wait(30),
        // A24.1: inch and pound.
        Click(ui("document-menu")),
        WaitFor("document-menu-units"),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        Wait(5),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("00-a24.1-workspace-units-inch-pound"),
        Click(ui("units-cancel")),
        Wait(5),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("01-a24.1-a24.2-assembly-opened"),
        // A24.3: Switch to the Base Frame Bar's studio.
        RightClick(ui("instance-row-2")),
        WaitFor("asm-switch-to"),
        Wait(3),
        Click(ui("asm-switch-to")),
        Wait(30),
        Key("Shift+7"),
        Wait(5),
        Key("F"),
        Wait(30),
        Click(at(1500, 880)),
        Wait(3),
        Screenshot("02-a24.3-base-frame-bar-studio"),
        // A24.4: Ctrl+M.
        Key("Ctrl+M"),
        WaitFor("mate-connector-dialog"),
        Wait(10),
        Screenshot("03-a24.4-mate-connector-dialog"),
        // A24.5: Between entities; the lug hole's edge (inner face, x −4.5 in).
        Click(ui("mate-connector-origin-type")),
        WaitFor("mate-connector-origin-type-option-1"),
        Click(ui("mate-connector-origin-type-option-1")),
        Wait(5),
        Click(ui("mate-connector-origin-field")),
        Wait(3),
        Custom("view 65 20 0 -12.7 584.2 0.55"),
        Wait(10),
        Hover(xyz(-114.3, -12.7, 590.55)),
        Wait(5),
        Click(xyz(-114.3, -12.7, 590.55)),
        Wait(10),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("04-a24.5-origin-entity-hole-edge"),
        // The other lug's inside face (x 4.5 in), seen from the other side.
        Custom("view -65 20 0 -12.7 584.2 0.55"),
        Wait(10),
        Click(ui("mate-connector-between-field")),
        Wait(3),
        Hover(xyz(114.3, -30.0, 571.5)),
        Wait(5),
        Click(xyz(114.3, -30.0, 571.5)),
        Wait(15),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("05-a24.5-between-entity-owner"),
        Click(ui("mate-connector-dialog-accept")),
        Wait(20),
        // A24.6: the Large Frame Bar's studio, its Hole Positions sketch.
        Click(ui("tab-large-frame-bar")),
        Wait(30),
        Custom("view 70 15 0 -12.7 575 0.3"),
        Wait(20),
        Screenshot("06-a24.6-large-frame-bar-hole-positions"),
        // A24.7, A24.8: On entity, the sketch circle.
        Key("Ctrl+M"),
        WaitFor("mate-connector-dialog"),
        Wait(10),
        Custom("view 30 20 0 -12.7 584.2 0.45"),
        Wait(10),
        Hover(xyz(0, -12.7, 590.55)),
        Wait(5),
        Click(xyz(0, -12.7, 590.55)),
        Wait(10),
        // Owner entity: the Large Frame Bar (a sketch has no part).
        Click(ui("mate-connector-owner-field")),
        Wait(3),
        Click(xyz(60, 0, 540)),
        Wait(15),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-a24.8-on-entity-sketch-circle"),
        Click(ui("mate-connector-dialog-accept")),
        Wait(20),
        // A24.9: both connectors on their instances.
        Click(ui("tab-step-stool-assembly")),
        Wait(30),
        Custom("view 30 20 0 -12.7 480 1.1"),
        Wait(20),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08-a24.9-connectors-in-the-assembly"),
        // A24.10: Revolute between them (the Large Frame Bar's first), limits -42.5 ... 0 deg.
        Click(ui("mate-revolute")),
        WaitFor("mate-dialog"),
        Wait(5),
        Hover(xyz(0, -12.7, 584.2)),
        Wait(5),
        Click(xyz(0, -12.7, 584.2)),
        Wait(8),
        // The base frame's connector, where the base frame hangs before the hinge.
        Hover(xyz(0, -50.8, 558.8)),
        Wait(5),
        Click(xyz(0, -50.8, 558.8)),
        Wait(10),
        Click(ui("mate-limits-checkbox")),
        Wait(5),
        Click(ui("mate-limit-angle-min")),
        Key("Ctrl+A"),
        Type("-42.5 deg"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-angle-max")),
        Key("Ctrl+A"),
        Type("0 deg"),
        Key("Enter"),
        Wait(5),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("09-a24.10-revolute-limits"),
        Click(ui("mate-dialog-accept")),
        Wait(10),
        Key("K"),
        Wait(10),
        // The Base Frame Bar's connectors (ex4-step11).
        Click(ui_at("instance-row-2", 0.05, 0.5)),
        Wait(5),
        Hover(ui("instance-connector-mate-connector-1")),
        Wait(8),
        Screenshot("10-a24.10-revolute-accepted-k-hides-connectors"),
        Click(ui_at("instance-row-2", 0.05, 0.5)),
        Wait(3),
        Custom("view 30 20 0 -200 300 1.8"),
        Wait(20),
        // A24.11: drag the base frame open; it stops at -42.5 deg.
        Press(xyz(0, -38.1, 150)),
        Hover(xyz(0, -80, 150)),
        Wait(3),
        Hover(xyz(0, -200, 150)),
        Wait(3),
        Hover(xyz(0, -400, 200)),
        Wait(3),
        Hover(xyz(0, -700, 250)),
        Wait(8),
        Screenshot("11-a24.11-drag-stops-at-limit"),
        Release,
        Wait(5),
        // The opening limit's mass properties (CoM (0, -2.422, 12.755) in).
        RightClick(ui("mate-row-2")),
        WaitFor("mate-apply-limit"),
        Hover(ui("mate-apply-limit")),
        Wait(5),
        Click(ui("mate-limit-angle-min")),
        Wait(8),
        Click(ui("instance-root")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(5),
        // The panel's mass unit: g (the course's panel reads grams with the pound setting).
        Click(ui("mass-unit")),
        WaitFor("mass-unit-option-1"),
        Click(ui("mass-unit-option-1")),
        Wait(5),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("12-a24.11-open-limit-mass"),
        Click(ui("mass-dialog-cancel")),
        Wait(5),
        // A24.11: Revolute 1 -> Reset.
        RightClick(ui("mate-row-2")),
        WaitFor("mate-reset"),
        Hover(ui("mate-reset")),
        Wait(3),
        Screenshot("13-a24.11-reset-menu"),
        Click(ui("mate-reset")),
        Wait(8),
        // A24.12: the assembly's mass properties.
        Click(at(1350, 600)),
        Wait(3),
        Click(ui("instance-root")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(5),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("14-a24.12-mass-properties"),
    ],
)
