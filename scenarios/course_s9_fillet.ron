// T3 / S9.1: "Fillet: click a corner vertex and type a radius. Further clicks reuse the same
// radius. Press-and-drag on a vertex sizes the fillet live." Shift+F
// (`reference/onshape/entity_tools/sketchfilletvertexexample.png`). A rectangle; the top-right
// corner, clicked, is filleted (tangent arc, the corner kept as a hollow virtual sharp) and
// the radius editor ("10 mm", number selected) takes 8. The top-left corner, clicked, gets the
// same radius: linked, one "R8" drives both, and its orange resize arrow, dragged, resizes both
// live (`sketch-fillet-manipulator.png`). No glyphs on the fillets' own pieces. Pressing on
// the bottom-right corner and dragging sizes a fillet live; releasing places it at that radius.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(-45, -25),
        ClickWorld(45, 25),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Shift+F"),
        Wait(2),
        MoveWorld(45, 25),
        Wait(3),
        Screenshot("01-fillet-tool-hover-corner"),
        ClickWorld(45, 25),
        Wait(4),
        Screenshot("02-filleted-radius-box"),
        Type("8"),
        Key("Enter"),
        Wait(4),
        ClickWorld(-45, 25),
        Wait(4),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("03-second-fillet-same-radius-resize-arrow"),
        Press(world(-47.5, 27.5)),
        MoveWorld(-48, 28),
        MoveWorld(-48.5, 28.5),
        MoveWorld(-49.5, 29.5),
        Wait(3),
        Screenshot("03b-dragging-the-arrow-resizes-both"),
        Release,
        Wait(4),
        Press(world(45, -25)),
        MoveWorld(43, -25),
        MoveWorld(38, -25),
        MoveWorld(33, -25),
        Wait(3),
        Screenshot("04-drag-sizes-live"),
        Release,
        Wait(4),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("05-three-fillets"),
    ],
)
