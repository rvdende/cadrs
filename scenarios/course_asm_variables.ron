// P3F.4 (`intro-to-assemblies.md` A1.8 "Variable table"; `intro-to-parametric-cad.md` P5.2): a
// Variable in an assembly driving a mate offset, on the mates stand-in
// (`fixtures/mates_standin.cadrs`): the Socket fixed, the Pin fastened in its hole.
// 01 the assembly toolbar's Variable (ƒx): #depth = 5 mm, the first row of the Mate Features.
// 02 (P3F.3–P3F.4 judge) the mate dialog open: Fastened 1 (the pin's top edge on the socket's
//    rim, flipped), Offset checked and "#depth" typed into Offset Z: the pin previewed 5 mm in.
// 03 accepted: the pin's top 5 mm into the hole.
// 04 the Variable table (right strip) of the assembly: #depth 5 mm.
// 05 #depth = 15 mm typed in the table: the mate's offset follows and the pin is re-solved 15 mm
//    in, one undo step.
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture mates_standin"),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Socket"),
        Click(ui("insert-part-socket")),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Pin"),
        Click(ui("insert-part-pin")),
        Click(ui("insert-dialog-accept")),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Click(at(1500, 880)),
        Key("Shift+7"),
        Key("F"),
        Click(ui("asm-variable")),
        WaitFor("variable-dialog"),
        Click(ui("variable-name-field")),
        Key("Ctrl+A"),
        Type("depth"),
        Click(ui("variable-value-field")),
        Key("Ctrl+A"),
        Type("5 mm"),
        Click(ui("variable-dialog-title")),
        ExpectText("variable-evaluated", "5 mm"),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("01-assembly-variable"),
        Click(ui("variable-dialog-accept")),
        Key("M"),
        WaitFor("mate-dialog"),
        Key("F"),
        Hover(xyz(207.07, -7.07, 20)),
        Wait(3),
        Click(xyz(207.07, -7.07, 20)),
        Hover(xyz(-16.46, 41.46, 16)),
        Wait(3),
        Click(xyz(-16.46, 41.46, 16)),
        Click(ui("mate-flip")),
        // Fitted to the parts where the pick placed the pin (before a field has the focus, which
        // would take the F; Final part 3).
        MoveTo(1500, 880),
        Key("F"),
        Click(ui("mate-offset-checkbox")),
        Click(ui("mate-offset-z")),
        Key("Ctrl+A"),
        Type("#depth"),
        Key("Enter"),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("02-mate-dialog-offset-depth"),
        Click(ui("mate-dialog-accept")),
        MoveTo(1500, 880),
        Key("F"),
        Screenshot("03-offset-z-depth"),
        Click(ui("panel-variables")),
        WaitFor("variables-panel"),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("04-assembly-variable-table"),
        Click(ui("variable-row-depth-field")),
        Key("Ctrl+A"),
        Type("15 mm"),
        Key("Enter"),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("05-depth-15-re-solved"),
    ],
)
