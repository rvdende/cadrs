// P3.4 / PS8.9 (the course's optional variant of the Reducer Coupling, in inches): one Revolve of
// the whole outline (both flanges and the transition), then a hole extrude (Remove) per flange.
// The sketches come from set-up commands (the outline as `cadrs_core/tests/revolve.rs` draws it:
// the flanges 0.62 and 0.75 thick, the transition from Ø2.625 to Ø3.75, the bores Ø2 and
// Ø3.125); the features are made through their dialogs.
// 01 Revolve 1 of the whole outline about the centreline, Full.
// 02 Extrude 1, Remove, the whole of Sketch 2 (4 × Ø0.625 on the Ø4.75 bolt circle), 0.62 in.
// 03 Extrude 2, Remove, the whole of Sketch 3 (4 × Ø0.75 on Ø6), starting offset 5.245 in,
//    0.75 in.
// 04 Mass properties: Volume 53.932 in³ and Surface area 248.367 in², the same as the three-feature
//    build of `course_ps8_reducer_coupling` 11 (asserted in `cadrs_core/tests/revolve.rs`).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("document-menu")),
        WaitFor("document-menu-popup"),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        Click(ui("units-length")),
        Click(ui("units-length-option-3")),
        Click(ui("units-mass")),
        Click(ui("units-mass-option-2")),
        Click(ui("units-ok")),
        Custom("sketch front centreline 0 0 177.8 0 poly 0 25.4 0 76.2 15.748 76.2 15.748 33.3375 133.223 47.625 133.223 95.25 152.273 95.25 152.273 39.6875 133.223 39.6875 15.748 25.4"),
        Key("Shift+7"),
        Key("F"),
        Key("Shift+W"),
        WaitFor("revolve-dialog"),
        Click(xyz(7.62, 0, 50.8)),
        Click(ui("revolve-axis-field")),
        Click(xyz(100, 0, 0)),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-one-revolve-full"),
        Key("Enter"),
        Custom("sketch right circle 60.325 0 7.9375 circle -60.325 0 7.9375 circle 0 60.325 7.9375 circle 0 -60.325 7.9375"),
        Custom("sketch right circle 76.2 0 9.525 circle -76.2 0 9.525 circle 0 76.2 9.525 circle 0 -76.2 9.525"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-2")),
        Click(ui("extrude-operation-2")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("0.62"),
        Click(ui("extrude-dialog-title")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-extrude-1-remove-flange-holes"),
        Key("Enter"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-3")),
        Click(ui("extrude-operation-2")),
        Click(ui("extrude-starting-offset-checkbox")),
        Click(ui("extrude-start-offset-field")),
        Key("Ctrl+A"),
        Type("5.245"),
        Click(ui("extrude-dialog-title")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("0.75"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-extrude-2-remove-offset-5-245"),
        Key("Enter"),
        ClickAt(1420, 900),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-mass-properties-same"),
    ],
)
