// Final re-audit / S9.1: "Fillet: click a corner vertex and type a radius" where a line meets an
// arc (the phase 2 fillet took two lines only). A vertical line and a 3-point arc leaving its top end
// to the right. Shift+F: hovering the corner highlights it (01);
// clicking fillets it: a tangent arc from the line to the arc, both trimmed back, the corner
// kept as a hollow virtual sharp on the line and on the arc's circle, the radius box open (02);
// 6 typed: R6, tangent to both (03). A second corner where two arcs meet (the arc and a second
// 3-point arc from its end) takes the same radius, linked (04).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("L"),
        Wait(2),
        ClickWorld(-5, -25),
        ClickWorld(-5, 15),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("A"),
        Wait(2),
        ClickWorld(-5, 15),
        ClickWorld(25, 45),
        ClickWorld(16, 24),
        Wait(4),
        Key("Escape"),
        Wait(3),
        ClickWorld(25, 45),
        ClickWorld(-15, 55),
        ClickWorld(6.5, 55.8),
        Wait(4),
        Key("Escape"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Shift+F"),
        Wait(2),
        MoveWorld(-5, 15),
        Wait(3),
        Screenshot("01-fillet-tool-hover-line-arc-corner"),
        ClickWorld(-5, 15),
        Wait(4),
        Screenshot("02-filleted-radius-box"),
        Type("6"),
        Key("Enter"),
        Wait(4),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("03-r6-tangent-to-line-and-arc"),
        ClickWorld(25, 45),
        Wait(4),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04-arc-arc-corner-same-radius"),
    ],
)
