// Form (P3I.9, SM20; `help/feature-tools/formed-03-02.png`, `forms-selectPS-dialog-01.png`,
// `form-06a.png`): a 120 × 80 × 40 block converted to sheet metal (2 mm) and ten sketch points
// on its top. Form from the Sheet metal model's ▾: the empty dialog (Form Part Studio, Location(s)
// with the mate connector icon and the opposite direction arrow, Target face(s)); Select Part
// Studio opens beside it on Libraries (cadrs sheet metal forms; Type; Form; the form's Length,
// Width and Height); the Type menu; Louver picked with Done; "Vertices of Sketch 2" as locations
// and the top as target: ten louvers; the opposite direction; accepted; Search tools finds Tag.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sm9 louver-box"),
        Wait(10),
        Key("Shift+7"),
        Wait(60),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-form")),
        WaitFor("sheet-metal-form-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-dialog"),
        Click(ui("form-studio-field")),
        WaitFor("form-picker"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-select-part-studio"),
        Click(ui("form-picker-type")),
        Wait(5),
        Screenshot("03-type-menu"),
        Key("Escape"),
        Wait(3),
        Click(ui("form-picker-done")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-louver-picked"),
        Click(ui("feature-sketch-2")),
        Wait(10),
        Click(ui("form-targets-field")),
        Wait(3),
        Click(xyz(60, 74, 42)),
        Wait(90),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-louvers"),
        Click(ui("form-flip")),
        Wait(90),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-opposite-direction"),
        Click(ui("form-flip")),
        Wait(60),
        Click(ui("sheet-metal-form-dialog-accept")),
        Wait(30),
        Custom("view 30 35 60 40 40 0.12"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-accepted"),
        Key("Alt+C"),
        Wait(5),
        Type("tag"),
        Wait(5),
        Screenshot("08-search-tag"),
        Key("Escape"),
        // P3I.8: the louvers' outlines and centermarks in the flat view (SM20.3).
        Key("Escape"),
        Wait(10),
        Click(ui("panel-sheet-metal")),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-flat-view-with-louvers"),
    ],
)
