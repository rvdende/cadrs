// Form (P3I.9, SM20; `help/feature-tools/formed-03-02.png`, `forms-selectPS-dialog-01.png`,
// `form-06a.png`, `formed-07.png`): a sheet metal L bracket (2 mm; a 140 × 100 base and a 50 high
// upright) and ten sketch points over its base. Form from the Sheet metal model's ▾: the empty
// dialog (Form Part Studio, Location(s) with the mate connector icon and the opposite direction
// arrow, Target face(s)); Select Part Studio opens beside it on Libraries (cadrs sheet metal
// forms; Type; Form; the form's Length, Width, Height and Angle); the Type menu; the search
// "dim" leaves Raised forms / Dimple, cleared again; Libraries ▸ My sheet metal forms lists the
// document's own "My dimple" (back to cadrs sheet metal forms); Louver picked with Done; "Vertices of
// Sketch 2" as locations and the base as target: ten louvers, their ends closed by sloping end
// walls (an orange dot and triad on each location while the dialog is open); the opposite
// direction; accepted; seen from +y, the louvers' open mouths; Search tools finds Tag, whose dialog opens (Form,
// Part to add, Part to remove, Sketch for flat view, Form origin mate connector); the louvers'
// outlines and centermarks in the flat view; the Form's eye hides them there and greys its row.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sm9 louver-bracket"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-form")),
        WaitFor("sheet-metal-form-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-dialog"),
        Click(ui("form-studio-field")),
        WaitFor("form-picker"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-select-part-studio"),
        Click(ui("form-picker-type")),
        Screenshot("03-type-menu"),
        Key("Escape"),
        Click(ui("form-picker-search-field")),
        Type("dim"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03b-search-dim"),
        Click(ui("form-picker-search-field")),
        Key("Ctrl+A"),
        Key("Backspace"),
        // Libraries ▸ My sheet metal forms: this document's own form Part Studios.
        Click(ui("form-picker-library")),
        Click(ui("form-picker-library-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03c-my-sheet-metal-forms"),
        Click(ui("form-picker-library")),
        Click(ui("form-picker-library-option-0")),
        Click(ui("form-picker-done")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-louver-picked"),
        Click(ui("feature-sketch-2")),
        Click(ui("form-targets-field")),
        Click(xyz(78, -44, 1)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-louvers"),
        Click(ui("form-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-opposite-direction"),
        Click(ui("form-flip")),
        Click(ui("sheet-metal-form-dialog-accept")),
        Custom("view 30 35 75 0 15 0.12"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-accepted"),
        // From the other side (+y): the louvers' open mouths.
        Custom("view 210 30 75 0 15 0.12"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07b-louver-mouths"),
        Custom("view 30 35 75 0 15 0.12"),
        Key("Alt+C"),
        Type("tag"),
        Screenshot("08-search-tag"),
        Key("Enter"),
        WaitFor("tag-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08b-tag-dialog"),
        Key("Escape"),
        // P3I.8: the louvers' outlines and centermarks in the flat view (SM20.3).
        Key("Escape"),
        Click(ui("panel-sheet-metal")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-flat-view-with-louvers"),
        // The Form's eye hides its sketch (the outlines) on the flat view, as Onshape's
        // (`form-10.png`–`form-12.png`); the centermarks stay.
        Hover(ui("feature-form-1")),
        Wait(10),
        Click(ui("feature-form-1-visibility")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-form-hidden-flat-without-outlines"),
    ],
)
