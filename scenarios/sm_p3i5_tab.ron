// Tab (P3I.5, SM5): a 20 × 25 profile sketched over the plate's y = 60 edge and a block it runs into;
// Tab 1 merges it with the plate (Flange to merge filled automatically: the parallel wall it
// touches), Subtraction offset 0.5 and the block as Subtraction scope: a clearance pocket round the
// tab is cut out of the block.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 100 60"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(50, 30, 0)),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Custom("sketch top rect 40 50 60 75"),
        Wait(10),
        Custom("sketch top rect 30 66 70 90"),
        Wait(10),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(50, 85, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        Wait(30),
        Click(ui("extrude-dialog-accept")),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-tab")),
        WaitFor("sheet-metal-tab-dialog"),
        Wait(10),
        Click(xyz(50, 63, 0)),
        Wait(20),
        Click(ui("sm-tab-offset-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("0.5"),
        Key("Tab"),
        Wait(30),
        Click(ui("sm-tab-scope-field")),
        Wait(3),
        Click(xyz(70, 80, 5)),
        Wait(40),
        Custom("view 20 35 50 60 5 0.12"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-tab-and-scope"),
        Click(ui("sheet-metal-tab-dialog-accept")),
        Wait(30),
        Custom("view 20 -35 50 60 0 0.12"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-accepted-pocket-from-below"),
    ],
)
