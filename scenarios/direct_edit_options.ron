// #22: Onshape's other direct-edit options, on a 60 × 40 × 20 block with two Ø10 holes
// (at x = 15 and 45) and a 10 × 10 × 30 block beside it (x 70…80).
// 01 Delete face: Heal ▾ (Heal, Cap, Leave open); Delete fillet faces under the faces.
// 02 Cap, a hole's wall picked: the hole is capped over (two caps, a solid).
// 03 Leave open: the wall gone and nothing in its place (a surface).
// 04 Create selection (+), Hole with Select patterns, a hole's wall clicked: both holes' walls.
// 05 Move face, Translate, End type Up to entity, the block's top picked, then the tall block's
//    top corner: the top goes up to z = 30.
// 06 Offset distance 5: it stops 5 short (z = 25).
// 07 Rotate: Axis of rotation, Angle and Reapply fillet.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 60 40 circle 15 20 5 circle 45 20 5"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(5, 5, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Custom("sketch top rect 70 0 80 10"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(75, 5, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Enter"),
        Key("F"),
        Click(ui("move-face")),
        Click(ui("direct-edit-menu-delete-face")),
        WaitFor("delete-face-dialog"),
        Click(ui("delete-face-void")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-void-options"),
        Click(ui("delete-face-void-option-1")),
        Click(xyz(11.46, 23.54, 18)),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("02-cap"),
        Click(ui("delete-face-void")),
        Click(ui("delete-face-void-option-2")),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("03-leave-open"),
        Click(ui("delete-face-dialog-cancel")),
        Click(ui("move-face")),
        Click(ui("direct-edit-menu-delete-face")),
        WaitFor("delete-face-dialog"),
        Click(ui("delete-face-create-selection")),
        WaitFor("create-selection-dialog"),
        Click(ui("create-selection-rule")),
        Click(ui("create-selection-rule-option-2")),
        Click(ui("create-selection-patterns-checkbox")),
        Click(xyz(11.46, 23.54, 18)),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("04-hole-with-patterns"),
        Click(ui("create-selection-dialog-cancel")),
        Click(ui("delete-face-dialog-cancel")),
        Click(ui("move-face")),
        Click(ui("direct-edit-menu-move-face")),
        WaitFor("move-face-dialog"),
        Click(ui("move-face-type")),
        Click(ui("move-face-type-option-0")),
        Click(xyz(30, 32, 20)),
        Click(ui("move-face-end")),
        Click(ui("move-face-end-option-1")),
        Click(xyz(80, 10, 30)),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("05-translate-up-to-a-vertex"),
        Click(ui("move-face-offset-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("06-offset-distance"),
        Click(ui("move-face-type")),
        Click(ui("move-face-type-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-rotate-reapply-fillet"),
    ],
)
