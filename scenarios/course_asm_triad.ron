// P3B.1 / A3.1–A3.4, X4: the triad manipulator on the Ex1 stand-in (one instance at its studio
// position, `fixtures/motor_mount_standin.cadrs`).
// 01 a click on the base's top face: the triad at the clicked spot, Z along the face normal.
// 02 dragging the origin (relocate): the connector points of the face under the pointer show as
//    dots and it snaps to the corner vertex; 03 dropped there (the part didn't move).
// 04 dragging the X arrow: the instance moves along X with a distance box; 05 released.
// 06 dragging the Y plane square (the XZ plane); 07 dragging the Z ring: the angle box.
// 08 right-click the X ring: Rotate 90° / Rotate 180°; 09 rotated 90° about the triad's X.
// 10 undone step by step (Ctrl+Z ×3): back where it was inserted.
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture motor_mount_standin"),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-part-dc-motor-mount-stand-in")),
        Click(ui("insert-dialog-accept")),
        Key("Shift+7"),
        Key("F"),
        Scroll(at(900, 520), -2),
        Wait(20),
        Click(xyz(-15, 20, 12.7)),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("01-triad-on-face"),
        Press(ui("triad-origin")),
        Hover(xyz(-25, 10, 12.7)),
        Wait(2),
        Hover(xyz(-37, 1, 12.7)),
        Wait(5),
        Screenshot("02-relocating-snap-dots"),
        Release,
        Wait(3),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("03-relocated-to-vertex"),
        Press(ui("triad-arrow-x")),
        Hover(xyz(-10, 0, 12.7)),
        Wait(2),
        Hover(xyz(10, 0, 12.7)),
        Wait(5),
        Screenshot("04-arrow-drag-distance"),
        Release,
        Wait(3),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("05-moved-along-x"),
        // The value box stays after the drag: type an exact distance, Enter (one undo step).
        Type("1 in"),
        Screenshot("05a-typing-exact-distance"),
        Key("Enter"),
        Screenshot("05b-exact-distance-applied"),
        Press(ui("triad-plane-y")),
        Hover(xyz(0, 0, 20)),
        Wait(2),
        Hover(xyz(10, 0, 30)),
        Wait(5),
        Screenshot("06-plane-drag"),
        Release,
        Wait(3),
        Press(ui("triad-ring-z")),
        Hover(xyz(60, 10, 40)),
        Wait(2),
        Hover(xyz(70, 30, 40)),
        Wait(5),
        Screenshot("07-ring-drag-angle"),
        Release,
        Wait(3),
        RightClick(ui("triad-ring-x")),
        WaitFor("asm-rotate-90"),
        Hover(ui("asm-rotate-90")),
        Wait(3),
        Screenshot("08-ring-menu"),
        Click(ui("asm-rotate-90")),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("09-rotated-90"),
        Key("Ctrl+Z"),
        Key("Ctrl+Z"),
        Key("Ctrl+Z"),
        Key("Ctrl+Z"),
        Screenshot("10-undone"),
    ],
)
