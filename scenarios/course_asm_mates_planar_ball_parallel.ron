// P3B.3 / A10.1–A10.3, A7.6–A7.8, A6.8, A16.4: Planar, Ball and Parallel mates on the mates
// stand-in (`fixtures/mates_standin.cadrs`): the Table and the Socket fixed; the Puck, the Magnet
// and the Ball.
// 01 the five parts inserted, Table and Socket fixed.
// 02 (A10.1) Planar: the Table's top face, then the Puck's top edge: the puck lands face to face,
//    inside the table.
// 03 (A6.8) Flip primary axis: the puck sits on the table.
// 04 accepted: "Planar 1"; the Puck has 3 DOF (triad icon).
// 05 (A7.6, A16.4) dragging the puck: it slides on the table (and stays on it).
// 06 (A10.2) Ball: the socket's rim centre, then the ball's centre: the ball sits in the socket.
// 07 accepted: "Ball 1".
// 08 (A10.3) Parallel: the Table's top face and the Magnet's top edge, flipped: placed touching.
// 09 accepted: "Parallel 1".
// 10 (A7.8) dragging the magnet up: it lifts off the table (the touching position isn't held),
//    staying parallel.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture mates_standin"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Table"),
        Wait(5),
        Click(ui("insert-part-table")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Puck"),
        Wait(5),
        Click(ui("insert-part-puck")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Magnet"),
        Wait(5),
        Click(ui("insert-part-magnet")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Socket"),
        Wait(5),
        Click(ui("insert-part-socket")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Ball"),
        Wait(5),
        Click(ui("insert-part-ball")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        RightClick(ui("instance-row-4")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        Click(at(1500, 880)),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        MoveTo(1500, 880),
        Wait(2),
        Screenshot("01-inserted-table-socket-fixed"),
        // A10.1: Planar.
        Click(ui("mate-planar")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(330, 4, 8)),
        Wait(3),
        Click(xyz(330, 4, 8)),
        Wait(5),
        Hover(xyz(310.6, 49.4, 12)),
        Wait(3),
        Click(xyz(310.6, 49.4, 12)),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("02-a10.1-planar-picked"),
        Click(ui("mate-flip")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("03-a6.8-planar-flipped"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("04-planar-accepted"),
        // A16.4: the puck slides on the table.
        Press(xyz(330, 0, 20)),
        Hover(xyz(320, -5, 20)),
        Wait(2),
        Hover(xyz(305, -20, 20)),
        Wait(2),
        Hover(xyz(300, -25, 20)),
        Wait(5),
        Screenshot("05-a7.6-planar-drag-slides"),
        Release,
        Wait(5),
        // A10.2: Ball.
        Click(ui("mate-ball")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(207.07, -7.07, 20)),
        Wait(3),
        Click(xyz(207.07, -7.07, 20)),
        Wait(5),
        Hover(xyz(245.77, -5.77, 15.77)),
        Wait(3),
        Click(xyz(245.77, -5.77, 15.77)),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("06-a10.2-ball-picked"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("07-ball-accepted"),
        // A10.3: Parallel.
        Click(ui("mate-parallel")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(330, 3, 8)),
        Wait(3),
        Click(xyz(330, 3, 8)),
        Wait(5),
        Hover(xyz(357.07, 52.93, 10)),
        Wait(3),
        Click(xyz(357.07, 52.93, 10)),
        Wait(5),
        Click(ui("mate-flip")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("08-a10.3-parallel-placed-touching"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("09-parallel-accepted"),
        Press(xyz(330, 0, 18)),
        Hover(xyz(330, 0, 30)),
        Wait(2),
        Hover(xyz(330, 0, 50)),
        Wait(2),
        Hover(xyz(330, 0, 90)),
        Wait(5),
        Screenshot("10-a7.8-parallel-lifts"),
        Release,
        Wait(5),
    ],
)
