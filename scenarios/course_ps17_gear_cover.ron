// P3.6 / PS17: the Jackhammer Gear Cover exercise (intro-to-part-studios.md PS17, ex3-step1..10) on
// the stand-in (`cadrs_core::samples::gear_cover`, `fixtures/gear_cover_standin.cadrs`: Onshape's
// public document can't be copied; the substitution is recorded in the gap doc), every step
// through the UI. The volumes and the mass are asserted in `cadrs_core/tests/gear_cover.rs`.
// 01 (ex3-step1/2) the stand-in: "Base Features (6)" closed, Parts (1) "Gear Cover".
// 02 (PS17.1) Workspace units: Millimeter, Kilogram.
// 03 (ex3-step3) Shell 1: the bottom face (Face of Extrude 1), 4 mm, seen from below (zoomed to
//    fit after the view turns).
// 04 (ex3-step4) Sketch 4 on the bosses' top, all through the sketcher: Use of the two bosses'
//    edges; a vertical construction centreline from the origin; six points placed roughly, the
//    two "A" points made Concentric with the bosses' edges (Shift+O), the other two pairs
//    Symmetric about the centreline (Shift+Q); dimensions 4 (A to the middle pair, as the
//    course's 4), 60 and 24 (vertical; the course's 95 and 93 don't fit the 200 mm stand-in) and
//    16 (the back pair from the centreline, as the course's 16).
// 05 (ex3-step5) Hole: Metric, Counterbore, the six points, Merge scope Gear Cover, Clearance M5
//    Close → Ø 5.3 mm, Start from part, Through all, counterbore Ø 9.75 × 5; the title is the
//    callout.
// 06 accepted: with the shell first, the counterbores are cut through 4 mm walls.
// 07a (ex3-step6) Shell 1 mid-drag: the blue drop line under the last row.
// 07 Shell 1 dropped at the bottom of the list: the counterbores are whole, the shell wraps them
//    (seen from below, zoomed to fit).
// 07b (PS11.3) Sketch 4 dragged below the hole: the hole uses its points, so it fails (red; its
//    long callout ends in "…" so the ⓘ shows, hovered: "Sketch 4 is below this feature in the
//    list; move it back above"); undone (Ctrl+Z).
// 08 (ex3-step7) Chamfer 1 (the course's Chamfer 2): the two bosses' top edges, Offset, Distance and angle, 2 mm, 45 deg.
// 09 (ex3-step8) Fillet 1: three bottom edges (their tangent chain), Radius 1 mm, Allow edge
//    overflow on.
// 10 (ex3-step9) Fillet 2 on the slope's edge (Edge of Extrude 2): Radius 3 mm, then 11 Width 3 mm,
//    11b zoomed in on the front corner (the inset of ex3-step9).
// 12 (ex3-step10) Mass properties: the mass in kg (Aluminum - 380).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("gear-cover"),
        Key("P"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-standin-base-features"),
        // Step 1 (PS17.1): the units.
        Click(ui("document-menu")),
        WaitFor("document-menu-popup"),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-units-mm-kg"),
        Click(ui("units-ok")),
        // Step 3 (PS17.3): Shell the bottom face, 4 mm.
        Click(ui("shell")),
        WaitFor("shell-dialog"),
        Key("Shift+6"),
        Click(xyz(0, -100, 0)),
        Click(ui("shell-thickness-field")),
        Key("Ctrl+A"),
        Type("4"),
        Key("Tab"),
        Key("Left"),
        Key("Down"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-shell-bottom-4mm"),
        Click(ui("shell-dialog-accept")),
        Key("Shift+7"),
        // Step 4 (PS17.4): Sketch 4 on the bosses' top face.
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(-30, -40, 46)),
        Key("N"),
        Key("F"),
        MoveTo(913, 520),
        Key("U"),
        ClickWorld(-15, -40),
        ClickWorld(45, -40),
        Key("Escape"),
        // The vertical construction centreline through the origin.
        Key("L"),
        Key("Q"),
        ClickWorld(0, 0),
        ClickWorld(0, -215),
        Key("Escape"),
        Key("Escape"),
        // Six points, placed roughly.
        Key("Shift+S"),
        ClickWorld(-27, -37),
        ClickWorld(27, -43),
        ClickWorld(-35.5, -98),
        ClickWorld(33, -101),
        ClickWorld(-17.5, -14.5),
        ClickWorld(15, -17),
        Key("Escape"),
        // The two "A" points concentric with the bosses' edges (point, then circle, Shift+O).
        Click(world(-27, -37)),
        Click(world(-45, -40)),
        Key("Shift+O"),
        Click(world(27, -43)),
        Click(world(15, -40)),
        Key("Shift+O"),
        // The other two pairs symmetric about the centreline (Shift+Q: the axis, then pairs).
        Key("Shift+Q"),
        Click(world(0, -60)),
        Click(world(-35.5, -98)),
        Click(world(33, -101)),
        Click(world(-17.5, -14.5)),
        Click(world(15, -17)),
        Key("Escape"),
        // The dimensions: 4 (A to the middle pair, horizontal), 60 and 24 (vertical), 16 (the
        // top pair from the centreline).
        Key("D"),
        Click(world(-30, -40)),
        Click(world(-35.5, -98)),
        MoveWorld(-33, -125),
        Wait(2),
        Click(world(-33, -125)),
        Type("4"),
        Key("Enter"),
        Key("Escape"),
        Key("D"),
        Click(world(-30, -40)),
        Click(world(-34, -98)),
        MoveWorld(-75, -70),
        Wait(2),
        Click(world(-75, -70)),
        Type("60"),
        Key("Enter"),
        Key("Escape"),
        Key("D"),
        Click(world(-17.5, -14.5)),
        Click(world(-30, -40)),
        MoveWorld(-75, -25),
        Wait(2),
        Click(world(-75, -25)),
        Type("24"),
        Key("Enter"),
        Key("Escape"),
        Key("D"),
        Click(world(0, -60)),
        Click(world(17.5, -16)),
        MoveWorld(10, 6),
        Wait(2),
        Click(world(10, 6)),
        Type("16"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-sketch-points"),
        Key("Enter"),
        Key("Shift+7"),
        // Step 5 (PS17.5): the hole.
        Click(ui("hole")),
        WaitFor("hole-dialog"),
        Click(ui("hole-style-1")),
        Click(xyz(-30, -40, 46)),
        Click(xyz(30, -40, 46)),
        Click(xyz(-34, -100, 46)),
        Click(xyz(34, -100, 46)),
        Click(xyz(-16, -16, 46)),
        Click(xyz(16, -16, 46)),
        // Merge scope already holds the Gear Cover (the part the points lie on, P3.8): a pick
        // on it here would toggle it off again.
        Click(ui("hole-type")),
        Click(ui("hole-type-option-1")),
        Click(ui("hole-fit")),
        Click(ui("hole-fit-option-0")),
        Click(ui("hole-termination")),
        Click(ui("hole-termination-option-0")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-hole-dialog-callout"),
        Click(ui("hole-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-hole-shell-first"),
        // Step 6 (PS17.6): drag Shell 1 to the bottom of the list (07a: mid-drag, the drop line
        // above the rollback bar).
        Press(ui("feature-shell-1")),
        Wait(2),
        Hover(ui_at("feature-shell-1", 0.5, 1.5)),
        Wait(2),
        Hover(ui_at("rollback-bar", 0.5, -1.0)),
        Wait(2),
        Hover(ui_at("rollback-bar", 0.5, 0.0)),
        Wait(5),
        Screenshot("07a-drag-drop-line"),
        Release,
        Wait(20),
        Key("Shift+6"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-shell-reordered-below"),
        Key("Shift+7"),
        Drag(ui("feature-sketch-4"), ui_at("rollback-bar", 0.5, 0.0)),
        // The hole's ⓘ (its long callout ends in "…" so the ⓘ shows) gives the reason.
        Hover(ui("feature-ø-5-3-mm-thru----ø-9-75-mm---5-mm-info")),
        Wait(40),
        Screenshot("07b-sketch-below-hole-fails"),
        Key("Ctrl+Z"),
        // Step 7 (PS17.7): Chamfer, Distance and angle 2 mm × 45°.
        Click(ui("chamfer")),
        WaitFor("chamfer-dialog"),
        Click(xyz(-15, -40, 46)),
        Click(xyz(45, -40, 46)),
        Click(ui("chamfer-type")),
        Click(ui("chamfer-type-option-2")),
        Click(ui("chamfer-distance-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-chamfer-distance-angle"),
        Click(ui("chamfer-dialog-accept")),
        // Step 8 (PS17.8): Fillet 1, three bottom edges, R1, overflow on.
        Click(ui("fillet")),
        WaitFor("fillet-dialog"),
        Click(xyz(55, -100, 0)),
        Click(xyz(49.142, -194.142, 0)),
        Click(xyz(49.142, -5.858, 0)),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("1"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-fillet-bottom-r1"),
        Click(ui("fillet-dialog-accept")),
        // Step 9 (PS17.9): Fillet 2 on the slope's edge: Radius 3, then Width 3.
        Click(ui("fillet")),
        WaitFor("fillet-dialog"),
        Click(xyz(55, -140, 36)),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("3"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-fillet-slope-radius-3"),
        Click(ui("fillet-measurement")),
        Click(ui("fillet-measurement-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-fillet-slope-width-3"),
        // Zoomed in on the front corner, as ex3-step9's inset: the even 3 mm band.
        Scroll(at(560, 780), 6),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11b-fillet-width-zoomed"),
        Click(ui("fillet-dialog-accept")),
        Key("F"),
        // Step 10 (PS17.10): Mass properties in kg.
        Click(ui("part-row-gear-cover")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-mass-properties-kg"),
    ],
)
