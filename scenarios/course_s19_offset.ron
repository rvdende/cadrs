// T1 / S19.1: the Offset tool (O): "pick an entity or a loop. Dragging a piece picks the whole
// chain. Click the arrow to flip the side. Click to place, then type the distance." (Compare
// training/intro-to-sketching/ex2-step8.png.) A line, an arc, a circle and an L-shaped chain.
// - The line, picked from above: the offset preview follows the cursor's distance, with an arrow
//   pointing to its side; clicking the arrow flips it below. Clicking elsewhere places it and
//   opens the distance box: 8 typed. The offset line is parallel, its distance a driving
//   dimension.
// - The arc, picked from inside: inward, 6. The circle, from outside: outward, 5.
// - Pressing on the L and dragging picks the whole chain (both lines); its offset keeps one
//   distance at the corner, 5.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(-60, 40),
        ClickWorld(-15, 40),
        Key("Escape"),
        ClickWorld(-60, -15),
        ClickWorld(-25, -15),
        ClickWorld(-25, -50),
        Key("Escape"),
        Key("Escape"),
        Key("A"),
        ClickWorld(10, 25),
        ClickWorld(50, 25),
        ClickWorld(30, 45),
        Key("Escape"),
        Key("Escape"),
        Key("C"),
        ClickWorld(30, -30),
        ClickWorld(42, -30),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("01-line-arc-circle-and-chain"),
        Key("O"),
        MoveWorld(-35, 40.5),
        Wait(2),
        Screenshot("02-offset-tool-hover-line"),
        Click(world(-35, 40.5)),
        MoveWorld(-30, 48),
        Wait(3),
        Screenshot("03-offset-preview-with-arrow"),
        Click(world(-37.5, 51.5)),
        Screenshot("04-arrow-clicked-side-flipped"),
        Click(world(-30, 51)),
        Screenshot("05-placed-distance-box"),
        Type("8"),
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("06-line-offset-8-below"),
        Click(world(30, 44.5)),
        MoveWorld(22, 37),
        Wait(3),
        Screenshot("07-arc-offset-inward-preview"),
        Click(world(22, 37)),
        Type("6"),
        Key("Enter"),
        Click(world(30, -17.5)),
        MoveWorld(18, -18),
        Wait(3),
        Screenshot("08-circle-offset-outward-preview"),
        Click(world(18, -18)),
        Type("5"),
        Key("Enter"),
        Press(world(-45, -15)),
        MoveWorld(-45, -18),
        Wait(2),
        MoveWorld(-44, -21),
        Wait(2),
        Release,
        Wait(2),
        MoveWorld(-40, -22),
        Wait(3),
        Screenshot("09-drag-picks-the-whole-chain"),
        Click(world(-40, -22)),
        Type("5"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("10-arc-circle-and-chain-offsets"),
    ],
)
