// P3H.4 (PCB3.8, PCB4.6, PCB11.5, PCB11.7a): the Component properties pane. Compare
// `v8-component-properties-poster.png`: a right pane headed "Component" with read-only Part name
// and Part number and the Representation radios (None, From ECAD data with its open-link icon,
// Custom part).
// 01 the right edge's Component toggle: the pane, empty until a component is picked;
// 02 click U1 (QFP100_600MIL) in the view: it is selected (the board view stays) and the pane
//    shows its Part name and Part number, From ECAD data chosen;
// 03 Representation None: U1 is no longer shown; 04 back to From ECAD data: the box is back;
// 05 Ctrl+Z: None again (each choice is one undo step); 06 Ctrl+Z: From ECAD data.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("pcb-import vision controller/Vision PCB"),
        WaitFor("pcb-board-vision-pcb"),
        Wait(40),
        Click(ui("pcb-panel-component")),
        WaitFor("pcb-component-pane"),
        Wait(20),
        MoveTo(1100, 900),
        Screenshot("01-component-pane"),
        Click(xyz(50.8, 38.1, 3.175)),
        Wait(10),
        ExpectText("pcb-part-name", "QFP100_600MIL"),
        ExpectText("pcb-part-number", "VPU-7100"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("02-u1-properties"),
        Click(ui("pcb-rep-none")),
        Wait(20),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("03-representation-none"),
        Click(ui("pcb-rep-ecad")),
        Wait(20),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("04-from-ecad-data"),
        Key("Ctrl+Z"),
        Wait(20),
        Screenshot("05-undo-none-again"),
        Key("Ctrl+Z"),
        Wait(20),
        Screenshot("06-undo-from-ecad-data"),
    ],
)
