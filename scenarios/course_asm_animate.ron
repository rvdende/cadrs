// P3B.3 / A16.5, A6.13 (Animate…), X7: the Animate dialog on a Pin slot mate of the mates stand-in
// (`fixtures/mates_standin.cadrs`; the Slot Plate fixed, the Pin in the slot, limits X ±20 mm).
// 01 (A6.13) the mate menu: Animate… among its items.
// 02 (A16.5) the Animate dialog: the mate, the DOF pick (X translation / Z rotation), Start / End
//    at the limits (−20 / 20 mm), Steps 25, Playback Single, reverse, Current value (the pin's
//    position now, 0 mm, until ▶), Play / Stop.
// 03 Playback type: Single, Reciprocate, Loop.
// 04–07 Reciprocate playing: the pin runs to the far end of the slot and back (current value
//    shown, and the direction under it): 04 going out (→ toward End), 05 at the far
//    end +20 mm, 06 coming back (← toward Start), 07 back
//    at the start −20 mm (one step a frame; Reciprocate holds a moment at each end).
// 08 Stop (during the hold at the start): the pin stays where it is, −20 mm; the current value
//    reads its position.
// 09 Reverse direction ✓, Steps 10, Play (Single): fewer steps play faster; it ends at Start.
// 10 closed: the assembly is back where it was.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture mates_standin"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-part-slot-plate")),
        Wait(2),
        Click(ui("insert-part-pin")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        Click(ui("mate-pin-slot")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(-20, 2, 4)),
        Wait(3),
        Click(xyz(-20, 2, 4)),
        Wait(5),
        Hover(xyz(-16.46, 41.46, 16)),
        Wait(3),
        Click(xyz(-16.46, 41.46, 16)),
        Wait(5),
        Click(ui("mate-flip")),
        Wait(5),
        Click(ui("mate-limits-checkbox")),
        Wait(5),
        Click(ui("mate-limit-x-min")),
        Key("Ctrl+A"),
        Type("-20 mm"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-x-max")),
        Key("Ctrl+A"),
        Type("20 mm"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-angle-min")),
        Key("Ctrl+A"),
        Type("-90 deg"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-angle-max")),
        Key("Ctrl+A"),
        Type("90 deg"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        RightClick(ui("mate-row-1")),
        WaitFor("mate-animate"),
        Hover(ui("mate-animate")),
        Wait(3),
        Screenshot("01-a6.13-mate-menu-animate"),
        Click(ui("mate-animate")),
        WaitFor("animate-dialog"),
        Wait(5),
        MoveTo(1300, 850),
        Wait(3),
        Screenshot("02-a16.5-animate-dialog"),
        Click(ui("animate-playback")),
        WaitFor("animate-playback-option-1"),
        Wait(3),
        Screenshot("03-a16.5-playback-types"),
        Click(ui("animate-playback-option-1")),
        Wait(3),
        Click(ui("animate-play")),
        Wait(10),
        Screenshot("04-a16.5-reciprocate-going-out"),
        Wait(4),
        Screenshot("05-a16.5-reciprocate-at-end-plus-20"),
        Wait(1),
        Screenshot("06-a16.5-reciprocate-coming-back"),
        Wait(17),
        Screenshot("07-a16.5-reciprocate-back-at-start-minus-20"),
        // Stopped while the pin holds at the start (Reciprocate's dwell), not mid-travel, where a
        // frame more or less under load changed where it stopped.
        Click(ui("animate-stop")),
        Wait(10),
        MoveTo(1300, 850),
        Wait(3),
        Screenshot("08-a16.5-stopped"),
        Click(ui("animate-reverse")),
        Wait(2),
        Click(ui("animate-steps")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Enter"),
        Wait(3),
        Click(ui("animate-playback")),
        WaitFor("animate-playback-option-0"),
        Click(ui("animate-playback-option-0")),
        Wait(3),
        Click(ui("animate-play")),
        Wait(20),
        MoveTo(1300, 850),
        Wait(3),
        Screenshot("09-a16.5-reversed-single-10-steps"),
        Click(ui("animate-dialog-cancel")),
        Wait(8),
        Screenshot("10-closed-back-in-place"),
    ],
)
