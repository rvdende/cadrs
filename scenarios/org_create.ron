// Organizations: the account menu › New organization… asks for a logo, a name, a tagline, what
// the organization offers, where it makes things and an e-mail address, and says under each
// field what is wrong with it. Created, it opens on its Overview, which says what a listing in
// the marketplace still needs (a machine); with one added it can be listed. Then its modules:
// locations, stock, prices, a client's request quoted, an issue opened from it, members,
// clients, parts, jobs and chat; a client is blocked. An organization isn't one of the documents: the account menu
// lists it, and opening it again shows what was saved. Last, it is removed from this device.
Scenario(
    start: Some("landing"),
    steps: [
        WaitFor("landing-page"),
        Click(ui("identity")),
        WaitFor("org-new"),
        Screenshot("01-account-menu"),
        Click(ui("org-new")),
        WaitFor("new-organization-dialog"),
        // Nothing filled in: every field says what it needs, and nothing is made.
        Click(ui("new-organization-ok")),
        ExpectText("org-new-logo-error", "Choose a logo"),
        ExpectText("org-new-name-error", "2 to 60"),
        ExpectText("org-new-email-error", "e-mail"),
        Screenshot("02-what-is-missing"),
        // A picture too small for a logo is refused with its size.
        Custom("org logo 300 300"),
        ExpectText("org-new-logo-error", "300 × 300"),
        Custom("org logo"),
        WaitFor("org-new-logo-picture"),
        Click(ui("org-new-name")),
        Type("Cape Waterjet"),
        Click(ui("org-new-tagline")),
        Type("Waterjet cutting in steel, aluminium and glass"),
        Click(ui("org-new-country")),
        Type("South Africa"),
        Click(ui("org-new-city")),
        Type("Stellenbosch"),
        Click(ui("org-new-email")),
        Type("sales@capewaterjet.example"),
        // What was wrong is put right as it is typed: no line is left under a field.
        ExpectText("org-new-name", "Cape Waterjet"),
        Screenshot("03-new-organization-dialog"),
        Click(ui("new-organization-ok")),
        WaitFor("org-nav"),
        ExpectText("org-page-title", "Cape Waterjet"),
        ExpectText("org-overview-tagline", "Waterjet cutting"),
        // Not in the marketplace yet: it manufactures and has no machine.
        WaitFor("org-listing-private"),
        Screenshot("04-overview"),

        Click(ui("org-nav-machines")),
        WaitFor("org-add-machine"),
        Click(ui("org-add-machine")),
        WaitFor("org-machine-dialog"),
        Type("Flow Mach 500"),
        // Its materials are picked from the Part Studio's, found by typing, each with the
        // thickest of it the machine cuts.
        Click(ui("org-machine-material-choose")),
        WaitFor("org-machine-material-search"),
        Type("a36"),
        Click(ui("org-machine-material-item-steel-a36")),
        WaitFor("org-machine-material-0"),
        Click(ui("org-machine-thickness-0")),
        Type("100"),
        // One the list doesn't have is taken as typed.
        Click(ui("org-machine-material-choose")),
        Type("glass"),
        Click(ui("org-machine-material-item-typed")),
        WaitFor("org-machine-material-1"),
        Click(ui("org-machine-thickness-1")),
        Type("25"),
        // A press elsewhere closes the open list, which lay over OK.
        Click(ui("org-machine-material-choose")),
        WaitFor("org-machine-material-search"),
        Screenshot("05a-machine-materials-open"),
        Click(ui("org-machine-name")),
        Screenshot("05-machine-dialog"),
        Click(ui("org-machine-ok")),
        WaitFor("org-machine-0"),
        ExpectText("org-machine-0", "Flow Mach 500"),
        ExpectText("org-machine-0", "Steel - A36 ≤ 100 mm, glass ≤ 25 mm"),
        // It stands at the one place things are made.
        ExpectText("org-machine-0", "Workshop"),
        Screenshot("06-machines"),

        // Everything a listing needs is here now: asked for, it is listed.
        Click(ui("org-nav-overview")),
        WaitFor("org-listed"),
        Click(ui("org-listed")),
        WaitFor("org-listing-listed"),
        Screenshot("07-listed"),

        // The location the dialog made, and a second one.
        Click(ui("org-nav-locations")),
        WaitFor("org-location-0"),
        ExpectText("org-location-0", "Stellenbosch"),
        Click(ui("org-add-location")),
        WaitFor("org-location-dialog"),
        Type("Cape Town counter"),
        Click(ui("org-location-production")),
        Click(ui("org-location-pickup")),
        Click(ui("org-location-city")),
        Type("Cape Town"),
        Click(ui("org-location-country")),
        Type("ZA"),
        Click(ui("org-location-lat")),
        Type("-33.92"),
        Click(ui("org-location-lon")),
        Type("18.42"),
        Screenshot("08-location-dialog"),
        Click(ui("org-location-ok")),
        WaitFor("org-location-1"),
        WaitFor("org-locations-map"),
        Screenshot("09-locations"),
        // Removing asks first: what goes is gone for every member.
        Click(ui("org-location-remove-1")),
        WaitFor("org-confirm-remove"),
        ExpectText("org-confirm-remove", "It is removed for every member"),
        Screenshot("09b-confirm-remove"),
        Click(ui("org-confirm-remove-cancel")),
        WaitFor("org-location-1"),

        // The profile: a description of several lines. While it holds something not saved yet,
        // what arrives from elsewhere (a client's request) doesn't make the page again and throw
        // it away; saving does, with the request counted in the navigation.
        Click(ui("org-nav-profile")),
        WaitFor("org-profile-save"),
        Click(ui("org-profile-about")),
        Type("Two 3 x 1.5 m tables."),
        Key("Enter"),
        Type("Drawings in by noon are cut the next day."),
        Click(ui("org-page-title")),
        Custom("org request"),
        // The navigation counts it at once, and a line says there is news not shown yet.
        ExpectText("org-nav-requests", "1"),
        WaitFor("org-news-waits"),
        ExpectText("org-profile-about", "Drawings in by noon"),
        Screenshot("10-profile"),
        Click(ui("org-profile-save")),
        ExpectText("org-nav-requests", "1"),

        Click(ui("org-nav-stock")),
        WaitFor("org-add-material"),
        Click(ui("org-add-material")),
        WaitFor("org-material-dialog"),
        Click(ui("org-material-name-choose")),
        WaitFor("org-material-name-search"),
        Type("a36"),
        Click(ui("org-material-name-item-steel-a36")),
        Click(ui("org-material-thickness")),
        Key("Ctrl+A"),
        Type("10"),
        Click(ui("org-material-ok")),
        WaitFor("org-material-0"),
        Click(ui("org-material-0-1")),
        Click(ui("org-material-0-1")),
        Click(ui("org-material-0--1")),
        ExpectText("org-material-count-0", "1"),
        Screenshot("11-stock"),

        Click(ui("org-nav-prices")),
        WaitFor("org-rates-save"),
        Click(ui("org-rates-currency")),
        Key("Ctrl+A"),
        Type("ZAR"),
        Click(ui("org-rates-setup")),
        Key("Ctrl+A"),
        Type("250"),
        Click(ui("org-rate-machine-0")),
        Type("1200"),
        Click(ui("org-rate-material-0")),
        Type("1000"),
        Click(ui("org-rates-save")),
        Screenshot("12-prices"),

        // The client's request: numbered, quoted at the shop's prices.
        Click(ui("org-nav-requests")),
        WaitFor("org-request-0"),
        ExpectText("org-request-0", "R-0001"),
        ExpectText("org-request-client-0", "Alex Maker"),
        Click(ui("org-request-quote-0")),
        WaitFor("org-request-price-0"),
        ExpectText("org-request-price-0", "ZAR"),
        Screenshot("13-requests"),

        // Something went wrong with it: an issue, opened from the request.
        Click(ui("org-request-issue-0")),
        WaitFor("org-issue-dialog"),
        Type("Taper on the thick cuts"),
        Click(ui("org-issue-details")),
        Type("Holes measure 8.2 at the top and 8.6 at the bottom"),
        Screenshot("14-issue-dialog"),
        Click(ui("org-issue-ok")),
        WaitFor("org-issue-0"),
        ExpectText("org-issue-0", "I-0001"),
        ExpectText("org-issue-0", "R-0001"),
        // Closing it needs a decision and the reasoning.
        Click(ui("org-issue-edit-0")),
        WaitFor("org-issue-edit-dialog"),
        Screenshot("15-issue"),
        Click(ui("org-issue-edit-cancel")),
        Screenshot("16-issues"),

        Click(ui("org-nav-members")),
        WaitFor("org-member-0"),
        Screenshot("17-members"),

        // Running the shop: a client kept by hand, a part with what goes into it, the jobs.
        Click(ui("org-nav-clients")),
        WaitFor("org-add-client"),
        Click(ui("org-add-client")),
        WaitFor("org-client-dialog"),
        Click(ui("org-client-name")),
        Type("Walk-in Workshop"),
        Click(ui("org-client-ok")),
        ExpectText("org-clients", "Walk-in Workshop"),
        Screenshot("18-clients"),
        Click(ui("org-nav-parts")),
        WaitFor("org-add-part"),
        Click(ui("org-add-part")),
        WaitFor("org-part-dialog"),
        Type("Gate bracket"),
        Click(ui("org-part-bom")),
        Type("0.5 Steel - A36 10, 4 M8 bolt"),
        Click(ui("org-part-ok")),
        WaitFor("org-part-0"),
        Screenshot("19-parts"),
        Click(ui("org-nav-jobs")),
        ExpectText("org-page-title", "Jobs"),
        Screenshot("20-jobs"),
        Click(ui("org-nav-chat")),
        WaitFor("org-chat-input"),
        Click(ui("org-chat-input")),
        Type("Waterjet down for maintenance at 3"),
        Click(ui("org-chat-send")),
        WaitFor("org-chat-0"),
        ExpectText("org-chat-0", "Waterjet down for maintenance at 3"),
        Screenshot("21-chat"),

        // Another request, from someone whose requests aren't wanted: blocked, which declines
        // what of theirs waits; the list under the requests lets them in again.
        Custom("org request"),
        Click(ui("org-nav-requests")),
        WaitFor("org-request-block-0"),
        Click(ui("org-request-block-0")),
        WaitFor("org-sweeping-dialog"),
        Click(ui("org-sweeping-ok")),
        WaitFor("org-blocked-0"),
        ExpectText("org-blocked-0", "Alex Maker"),
        ExpectText("org-request-0", "Declined"),
        Screenshot("21b-blocked"),

        // Back at the documents: the organization isn't one of them. The account menu has it.
        Click(ui("app-menu")),
        Click(ui("app-documents")),
        WaitFor("landing-page"),
        Click(ui("identity")),
        WaitFor("org-open-0"),
        ExpectText("org-open-0", "Cape Waterjet"),
        Screenshot("22-account-menu"),
        Click(ui("org-open-0")),
        WaitFor("org-nav"),
        Click(ui("org-nav-stock")),
        WaitFor("org-material-count-0"),
        ExpectText("org-material-count-0", "1"),
        Screenshot("23-reopened"),

        // A 3D printer: a space of three sizes, and materials by name. Typing "petg" finds
        // PETG and Enter takes it; Esc closes the open list, not the dialog.
        Click(ui("org-nav-machines")),
        WaitFor("org-add-machine"),
        Click(ui("org-add-machine")),
        WaitFor("org-machine-dialog"),
        Type("Prusa MK4"),
        Click(ui("org-machine-process-7")),
        ExpectText("org-machine-size-label", "Work space"),
        Click(ui("org-machine-x")),
        Key("Ctrl+A"),
        Type("250"),
        Click(ui("org-machine-y")),
        Key("Ctrl+A"),
        Type("210"),
        Click(ui("org-machine-kerf")),
        Key("Ctrl+A"),
        Type("220"),
        Click(ui("org-machine-material-choose")),
        WaitFor("org-machine-material-search"),
        Type("petg"),
        Screenshot("23b-printer-materials"),
        Key("Enter"),
        WaitFor("org-machine-material-0"),
        ExpectText("org-machine-material-0", "PETG"),
        Click(ui("org-machine-material-choose")),
        Type("pla"),
        Click(ui("org-machine-material-item-pla")),
        WaitFor("org-machine-material-1"),
        Click(ui("org-machine-material-choose")),
        WaitFor("org-machine-material-search"),
        Key("Escape"),
        Screenshot("23c-printer-dialog"),
        Click(ui("org-machine-ok")),
        WaitFor("org-machine-1"),
        ExpectText("org-machines", "Prusa MK4"),
        ExpectText("org-machines", "250 × 210 × 220 mm"),
        ExpectText("org-machines", "PETG, PLA"),
        Screenshot("23d-machines"),

        // A paid order: another client asks, the shop quotes, and the client accepts and pays.
        // The credits are held for the shop, which sees them on the order; an order that
        // won't be made has its payment returned, asked about once.
        Custom("org bank"),
        Custom("org request"),
        Click(ui("org-nav-requests")),
        WaitFor("org-request-quote-0"),
        Click(ui("org-request-quote-0")),
        WaitFor("org-request-price-0"),
        ExpectText("org-request-price-0", "credits)"),
        Custom("org accept"),
        ExpectText("org-request-payment-0", "credits held"),
        Screenshot("23e-order-paid-held"),
        Click(ui("org-nav-overview")),
        WaitFor("org-overview-wallet"),
        ExpectText("org-overview-wallet", "held for you"),
        Screenshot("23f-overview-wallet"),
        Click(ui("org-nav-wallet")),
        ExpectText("org-wallet-held", "held for you"),
        ExpectText("org-wallet-move-0", "Held for you"),
        ExpectText("org-wallet-hold-0", "Alex Maker"),
        ExpectText("org-wallet-hold-0", "R-0003"),
        Screenshot("23g-wallet-held"),
        Click(ui("org-nav-requests")),
        WaitFor("org-request-return-0"),
        Click(ui("org-request-return-0")),
        WaitFor("wallet-confirm"),
        ExpectText("wallet-confirm-text", "Return the"),
        Screenshot("23h-return-payment"),
        Click(ui("wallet-confirm-ok")),
        ExpectText("org-request-payment-0", "credits returned"),

        // Removed from this device: while it is listed it has to leave the marketplace first.
        Click(ui("org-nav-profile")),
        WaitFor("org-remove"),
        Click(ui("org-remove")),
        WaitFor("org-remove-dialog"),
        Screenshot("24-remove-dialog"),
        Click(ui("org-remove-ok")),
        Click(ui("org-nav-overview")),
        WaitFor("org-listed"),
        Click(ui("org-listed")),
        WaitFor("org-listing-private"),
        Click(ui("org-nav-profile")),
        WaitFor("org-remove"),
        Click(ui("org-remove")),
        WaitFor("org-remove-dialog"),
        Click(ui("org-remove-ok")),
        // Back at the documents, with no organization in the account menu.
        WaitFor("landing-page"),
        Click(ui("identity")),
        WaitFor("org-new"),
        Screenshot("25-removed"),
    ],
)
