// Organizations: Create ▾ › New organization… founds a shop and opens its screen. Add a
// machine and a stock material, take a sheet in, then back to the documents page, where the
// organization is listed like a document; opening it again shows what was saved.
Scenario(
    start: Some("landing"),
    steps: [
        Click(ui("create")),
        WaitFor("new-organization"),
        Click(ui("new-organization")),
        WaitFor("new-organization-dialog"),
        Type("Cape Waterjet"),
        Screenshot("01-new-organization-dialog"),
        Click(ui("new-organization-create")),
        WaitFor("org-profile-name"),
        ExpectText("org-name", "Cape Waterjet"),
        Screenshot("02-overview"),
        // Where it is: its picture on the documents page becomes a map with its pin.
        Click(ui("org-profile-lat")),
        Type("-33.93"),
        Click(ui("org-profile-lon")),
        Type("18.86"),
        Click(ui("org-profile-save")),

        Click(ui("org-tabs-2")),
        WaitFor("org-add-machine"),
        Click(ui("org-add-machine")),
        WaitFor("org-machine-dialog"),
        Type("Flow Mach 500"),
        Click(ui("org-machine-materials")),
        Type("mild steel 100, glass 25"),
        Screenshot("03-machine-dialog"),
        Click(ui("org-machine-ok")),
        WaitFor("org-machine-0"),
        ExpectText("org-machine-0", "Flow Mach 500"),
        Screenshot("04-machines"),

        Click(ui("org-tabs-3")),
        WaitFor("org-add-material"),
        Click(ui("org-add-material")),
        WaitFor("org-material-dialog"),
        Type("mild steel"),
        Click(ui("org-material-ok")),
        WaitFor("org-material-0"),
        Click(ui("org-material-0-1")),
        Click(ui("org-material-0-1")),
        Click(ui("org-material-0--1")),
        ExpectText("org-material-count-0", "1 (1 free)"),
        Screenshot("05-stock"),

        Click(ui("org-tabs-1")),
        WaitFor("org-member-0"),
        Screenshot("06-members"),

        // Running the shop: a client kept by hand, a part with what goes into it, the jobs.
        Click(ui("org-tabs-7")),
        WaitFor("org-add-client"),
        Click(ui("org-add-client")),
        WaitFor("org-client-dialog"),
        Click(ui("org-client-name")),
        Type("Walk-in Workshop"),
        Click(ui("org-client-ok")),
        WaitFor("org-client-0"),
        ExpectText("org-client-0", "Walk-in Workshop"),
        Click(ui("org-tabs-8")),
        WaitFor("org-add-part"),
        Click(ui("org-add-part")),
        WaitFor("org-part-dialog"),
        Type("Gate bracket"),
        Click(ui("org-part-bom")),
        Type("0.5 mild steel 3, 4 M8 bolt"),
        Click(ui("org-part-ok")),
        WaitFor("org-part-0"),
        Screenshot("06b-parts"),
        Click(ui("org-tabs-6")),
        WaitFor("organization"),
        Screenshot("06c-jobs"),
        Click(ui("org-tabs-9")),
        WaitFor("org-chat-input"),
        Click(ui("org-chat-input")),
        Type("Waterjet down for maintenance at 3"),
        Click(ui("org-chat-send")),
        WaitFor("org-chat-0"),
        ExpectText("org-chat-0", "Waterjet down for maintenance at 3"),
        Screenshot("06d-chat"),

        Click(ui("app-menu")),
        Click(ui("app-documents")),
        WaitFor("doc-row-0"),
        ExpectText("doc-name-0", "Cape Waterjet"),
        Screenshot("07-listed"),
        DoubleClick(ui("doc-row-0")),
        WaitFor("org-profile-name"),
        Click(ui("org-tabs-3")),
        WaitFor("org-material-count-0"),
        ExpectText("org-material-count-0", "1 (1 free)"),
        Screenshot("08-reopened"),
    ],
)
