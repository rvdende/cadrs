// M3: create a sketch on the Front plane by clicking its row in the feature list, turn the view
// normal to it (N) and accept. Then start Sketch 2, pick the Right plane and cancel it with ✕:
// Sketch 2 disappears and a toast offers to restore it.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Key("Shift+S"),
        WaitFor("sketch-dialog"),
        Hover(ui("feature-front")),
        Wait(3),
        Screenshot("01-hover-front-row"),
        Click(ui("feature-front")),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-front-plane-selected"),
        Key("N"),
        Screenshot("03-normal-to-front"),
        Key("Enter"),
        Screenshot("04-sketch-1-accepted"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-right")),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("05-sketch-2-on-right"),
        Click(ui("sketch-dialog-cancel")),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("06-sketch-2-cancelled"),
    ],
)
