// P3.3 / PS4.3, PS4.7, PS4.8, PS1.1: extrude end types. The sketches are added by the `sketch`
// set-up command (rectangles and circles on Top and Front); every extrude goes through the
// dialog.
// 01 a block, 40 × 40 × 50 (Extrude 1). A 30 × 30 square beside it, Extrude 2: the end type
//    list (Blind, Up to next, Up to face, Up to part, Up to vertex, Through all).
// 02 Up to face: the field waits for the face; the block's top face picked, "Face of
//    Extrude 1", and the preview rises to its height (50).
// 03 Second end position, Blind 10: the square also goes 10 below the sketch plane.
// 04 a Ø16 circle on Top under the block; Extrude 3 takes the whole sketch from the feature
//    list ("Sketch 3"), Remove, Through all: a hole through the block, whatever its height.
// 05 a Ø20 circle on Front; Extrude 4 Symmetric, 60 (total): the cylinder runs 30 each side of
//    the Front plane.
// 06 the result: three parts, one with the hole.
//    Then a wedge beside the block (a triangle on Front, Extrude 5, 10 deep: Part 4).
// 07 a planar face as the input: Extrude 6 on the block's top face ("Face of Extrude 1",
//    outlined in orange), Blind 20. It touches the block, so Add: the block stays opaque and
//    the added body is the translucent preview; the hole carries through.
// 08 accepted: the block is 20 taller and one part; its sides are single faces (the Add
//    merges the faces that meet on one plane: no seam at the old top).
// 09 Extrude 7 on the new top face, Blind 20, Starting offset checked and expanded: 10, so it
//    starts 10 above the face (and, no longer touching the block, is New).
// 10 Direction checked: the wedge's sloping edge ("Edge of Extrude 5", orange): the prism
//    leans along it.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 60 0 100 40"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(80, 20, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("50"),
        Key("Enter"),
        Custom("sketch top rect 0 0 30 30"),
        Key("F"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(15, 15, 0)),
        Click(ui("extrude-end-type")),
        WaitFor("extrude-end-type-menu"),
        Hover(ui("extrude-end-type-option-2")),
        Wait(3),
        Screenshot("01-end-type-list"),
        Click(ui("extrude-end-type-option-2")),
        Click(xyz(90, 30, 50)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-up-to-face"),
        Click(ui("extrude-second-end-checkbox")),
        Click(ui("extrude-second-depth-field")),
        Key("Ctrl+A"),
        Type("10"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-second-end-blind-10"),
        Key("Enter"),
        // Through all, Remove, the whole sketch.
        Custom("sketch top circle 80 20 8"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-3")),
        Click(ui("extrude-operation-2")),
        Click(ui("extrude-end-type")),
        WaitFor("extrude-end-type-menu"),
        Click(ui("extrude-end-type-option-5")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-remove-through-all"),
        Key("Enter"),
        // Symmetric.
        Custom("sketch front circle 15 70 10"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-4")),
        Click(ui("extrude-symmetric-checkbox")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("60"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-symmetric-60"),
        Key("Enter"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-result"),
        // A wedge beside the block (a triangle on Front, 10 deep): its sloping edge is the
        // direction later.
        Custom("sketch front tri 115 0 145 0 115 40"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-5")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Enter"),
        Key("F"),
        // A planar face as the input: the block's top face (with the hole), Blind 20.
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(95, 35, 50)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-face-input"),
        // Accepted: the block is 20 taller, one part, its sides single faces (no seam at 50).
        Key("Enter"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-face-extrude-added-no-seam"),
        // A second extrude on the (new) top face.
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(95, 35, 70)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Click(ui("extrude-dialog-title")),
        // Starting offset, 10: the chevron row expands to its value.
        Click(ui("extrude-starting-offset-checkbox")),
        Click(ui("extrude-start-offset-field")),
        Key("Ctrl+A"),
        Type("10"),
        Click(ui("extrude-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-starting-offset-10"),
        // Direction: the wedge's sloping edge; the prism leans along it.
        Click(ui("extrude-direction-checkbox")),
        Click(xyz(130, 0, 20)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-direction-edge"),
        Key("Enter"),
    ],
)
