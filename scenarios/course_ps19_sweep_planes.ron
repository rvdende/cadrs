// P3.7 / PS19.4–PS19.5: a profile on a plane normal to the path, tied to it by Pierce, and a
// profile partway along the path. Sketch 1 on Top is the path of `course_ps19_sweep` (an 80 line
// along X, R20, a 60 line along Y).
// 01 PS19.4 Plane 1, Curve point: the path's last line and its end point: a plane square to
//    the path there.
// 02 Sketch 2 on Plane 1: a Ø10 circle drawn off the path, its centre Pierced to the path's
//    line (Shift+G, the centre, the line): it jumps onto the path.
// 03 Sweep 1: the circle along the whole path, from its end.
// 04 PS19.5 Plane 2, Offset 30 from Right: square to the path's first line, 30 along it;
//    Sketch 3 on it: a Ø6 circle Pierced to the path the same way.
// 05 Sweep 2 (New): from partway along, the Ø6 tube runs both ways, over the whole path.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(0, 0),
        ClickWorld(80, 0),
        ClickWorld(80, 60),
        Key("Escape"),
        Key("Escape"),
        Key("Shift+F"),
        ClickWorld(80, 0),
        Type("20"),
        Key("Enter"),
        Key("Escape"),
        Click(ui("sketch-dialog-accept")),
        Key("Shift+7"),
        Key("F"),
        // PS19.4: a Curve point plane at the path's start.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-6")),
        Click(xyz(80, 40, 0)),
        Click(xyz(80, 60, 0)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-curve-point-plane-at-the-path-end"),
        Click(ui("plane-dialog-accept")),
        // Sketch 2 on it: a circle, Pierced to the path.
        Click(ui("feature-plane-1")),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Key("C"),
        ClickWorld(12, 12),
        KeyDown("Shift"),
        ClickWorld(17, 12),
        KeyUp("Shift"),
        Type("10"),
        Key("Enter"),
        Key("Escape"),
        Key("Shift+7"),
        Key("Shift+G"),
        Click(world(12, 12)),
        Click(xyz(80, 35, 0)),
        Key("Escape"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-profile-pierced-to-the-path"),
        Click(ui("sketch-dialog-accept")),
        // Sweep 1.
        Click(ui("sweep")),
        WaitFor("sweep-dialog"),
        Click(ui("feature-sketch-2")),
        Click(ui("sweep-path-field")),
        Click(ui("feature-sketch-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-sweep-from-the-curve-point-plane"),
        Click(ui("sweep-dialog-accept")),
        // PS19.5: a profile partway along (the first tube hidden and Sketch 1 shown with its eye,
        // so the path can be picked).
        RightClick(ui("part-row-part-1")),
        WaitFor("part-hide"),
        Click(ui("part-hide")),
        Hover(ui("feature-sketch-1")),
        Wait(3),
        Hover(ui("feature-sketch-1-visibility")),
        Wait(3),
        Click(ui("feature-sketch-1-visibility")),
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("feature-right")),
        Click(ui("plane-offset-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Enter"),
        Click(ui("feature-plane-2")),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Key("C"),
        ClickWorld(20, 20),
        KeyDown("Shift"),
        ClickWorld(23, 20),
        KeyUp("Shift"),
        Type("6"),
        Key("Enter"),
        Key("Escape"),
        Key("Shift+7"),
        Key("Shift+G"),
        Click(world(20, 20)),
        Click(xyz(15, 0, 0)),
        Key("Escape"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-offset-plane-profile-partway-along"),
        Click(ui("sketch-dialog-accept")),
        Click(ui("sweep")),
        WaitFor("sweep-dialog"),
        Click(ui("feature-sketch-3")),
        Click(ui("sweep-path-field")),
        Click(ui("feature-sketch-1")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-sweep-both-ways-from-partway"),
        Click(ui("sweep-dialog-accept")),
    ],
)
