// Final re-audit / S12.10: Normal (Shift+K) takes "a line and a curve, or a curve and a plane".
// A sketch on Top with two slanted lines. Shift+K, the first line, then the Front plane's row in
// the feature list: the line turns normal to Front (square to its trace, the X axis here),
// the trace shown as a construction line linked to the plane (Use's link glyph) with the
// Normal glyph (01, 02). The second line, then Right: it turns normal to Right (along X, 03).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(-40, 10),
        ClickWorld(-20, 40),
        Key("Escape"),
        ClickWorld(10, -30),
        ClickWorld(40, -15),
        Key("Escape"),
        Key("Shift+K"),
        ClickWorld(-30, 25),
        Hover(ui("feature-front")),
        Wait(5),
        Screenshot("01-normal-line-picked-front-hovered"),
        Click(ui("feature-front")),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("02-line-normal-to-front"),
        ClickWorld(25, -22.5),
        Click(ui("feature-right")),
        Key("Escape"),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("03-second-line-normal-to-right"),
    ],
)
