// T3 / S4.2: "3-point circle: three clicks on the circumference." (`circle_arc.md`) Circle ▾
// lists Center point circle, 3 point circle and Ellipse. Between the first two clicks the
// preview is the chord with its length; then the circle through the three points follows the
// cursor with its live diameter. Placing it opens the diameter box: 50 typed. A circle through
// a line's end keeps it on the circle (coincident).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(-60, -40),
        ClickWorld(-30, 4),
        Key("Escape"),
        Key("Escape"),
        Click(ui("sketch-circle-caret")),
        WaitFor("sketch-variant-3-point-circle"),
        Screenshot("01-circle-menu"),
        Click(ui("sketch-variant-3-point-circle")),
        ClickWorld(-30, 4),
        MoveWorld(-10, 20),
        MoveWorld(0, 30),
        Wait(3),
        Screenshot("02-chord"),
        ClickWorld(0, 30),
        MoveWorld(20, 20),
        MoveWorld(30, 22),
        Wait(3),
        Screenshot("03-circle-through-three"),
        ClickWorld(30, 22),
        Screenshot("04-diameter-box"),
        Type("50"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("05-diameter-50"),
    ],
)
