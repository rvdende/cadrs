// P3C.7 / D2.4, X13: sheet sketch Line and Spline, Insert DXF/DWG and Insert image on the Ex1
// drawing of the Universal Joint Flange stand-in (`Custom("ujoint-drawing")`). Sheet points are
// `world(x, y)` in sheet mm on the ANSI A sheet (the title block's Company cell is x 160–202,
// y 13–21; its tolerance cell x 108–160, y 39–57). The logo files are our own: `fixtures/logo.dxf`
// and `fixtures/logo.png` are drawn by `cadrs_core/tests/drawing_export.rs`.
// 01 the drawing: Line, Spline, Insert DXF or DWG and Insert image are enabled.
// 02 Line: the first end placed, the line following the cursor (orange) with the hint; 02b the
//    second line's rubber band snapped vertical, the V tag by the cursor.
// 03 two chained lines (the second snapped vertical), Esc.
// 04 Spline: three points placed, the curve through them and the cursor previewed.
// 05 the spline finished with a double-click; 06 selected: its point grips; 07 a point dragged.
// 08 the first line selected; 09 deleted; 10 undone (Ctrl+Z).
// 11 Insert DXF or DWG: the file picker in the working folder; 12 in fixtures, logo.dxf picked.
// 13 the logo following the cursor into the title block's Company cell; 14 placed (selected,
//    hovered), its empty-field "--" hidden.
// 15 Insert image: the picker (it remembers fixtures), logo.png picked; 16 the image following
//    the cursor; 17 placed inside the tolerance cell, selected: its corner grips (cursor on one).
// 18 its top-right corner dragged: smaller, the same aspect ratio.
// 19 the finished sheet; 20 zoomed on the title block.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("ujoint-drawing"),
        Wait(120),
        Key("F"),
        Wait(10),
        Hover(ui("drawing-line")),
        Wait(40),
        Screenshot("01-sheet-sketch-tools"),
        // Line: a chain of two lines.
        Click(ui("drawing-line")),
        Wait(5),
        ClickWorld(20, 48),
        Wait(3),
        MoveWorld(60, 50),
        Wait(5),
        Screenshot("02-line-following-cursor"),
        ClickWorld(70, 48),
        Wait(3),
        MoveWorld(71.2, 22),
        Wait(5),
        Screenshot("02b-vertical-inferred"),
        ClickWorld(71.2, 22),
        Wait(3),
        Key("Escape"),
        Wait(3),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("03-two-lines"),
        // Spline.
        Key("Escape"),
        Click(ui("drawing-spline")),
        Wait(5),
        ClickWorld(20, 20),
        Wait(3),
        ClickWorld(32, 36),
        Wait(3),
        ClickWorld(44, 24),
        Wait(3),
        MoveWorld(56, 38),
        Wait(5),
        Screenshot("04-spline-preview"),
        DoubleClick(world(56, 38)),
        Wait(5),
        Key("Escape"),
        Wait(3),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("05-spline"),
        Click(world(20.5, 20.3)),
        Wait(5),
        MoveWorld(32, 36),
        Wait(5),
        Screenshot("06-spline-selected-grips"),
        Drag(world(32, 36), world(32, 43)),
        Wait(5),
        Screenshot("07-spline-point-dragged"),
        Click(world(45, 48)),
        Wait(5),
        Screenshot("08-line-selected"),
        Key("Delete"),
        Wait(5),
        Screenshot("09-line-deleted"),
        Key("Ctrl+Z"),
        Wait(5),
        Screenshot("10-undone"),
        Key("Escape"),
        // Insert DXF: the logo in the Company cell.
        Click(ui("drawing-insert-dxf")),
        WaitFor("dxf-picker"),
        Wait(10),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("11-dxf-file-picker"),
        Click(ui("dxf-picker-row-fixtures")),
        WaitFor("dxf-picker-row-logo.dxf"),
        Click(ui("dxf-picker-row-logo.dxf")),
        Wait(5),
        Hover(ui("dxf-picker-open")),
        Wait(5),
        Screenshot("12-logo-dxf-picked"),
        Click(ui("dxf-picker-open")),
        Wait(10),
        MoveWorld(150, 30),
        Wait(3),
        MoveWorld(173.5, 14.2),
        Wait(5),
        Screenshot("13-logo-following-cursor"),
        ClickWorld(173.5, 14.2),
        Wait(5),
        MoveWorld(181, 16),
        Wait(5),
        Screenshot("14-logo-placed"),
        // Insert image: the badge in the tolerance cell.
        Click(ui("drawing-insert-image")),
        WaitFor("image-picker"),
        WaitFor("image-picker-row-logo.png"),
        Click(ui("image-picker-row-logo.png")),
        Wait(5),
        Hover(ui("image-picker-open")),
        Wait(5),
        Screenshot("15-image-picker"),
        Click(ui("image-picker-open")),
        Wait(10),
        MoveWorld(130, 60),
        Wait(3),
        MoveWorld(141.3, 44),
        Wait(5),
        Screenshot("16-image-following-cursor"),
        ClickWorld(141.3, 44),
        Wait(5),
        MoveWorld(159.3, 53),
        Wait(5),
        Screenshot("17-image-placed-grips"),
        Drag(world(159.3, 53), world(155.3, 51)),
        Wait(5),
        Screenshot("18-image-resized-aspect-kept"),
        ClickWorld(240, 120),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("19-finished-sheet"),
        Scroll(world(172, 26), 4),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("20-title-block-zoom"),
    ],
)
