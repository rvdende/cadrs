// P3C.4 / D10, X9, X12: a table on the Ex1 flange stand-in's drawing (`samples::ujoint`, inches;
// Front and Right at 1:2 on an ANSI A sheet; sheet points are `world(x, y)` in sheet mm). The
// table's cells start 1.25 × 0.25 in (the drawing properties' row height; rows grow to fit text).
// 01 D10.1: the Table tool's dialog (rows 3, columns 4, title row, header row, fixed corner top
//    left); 02 the table following the cursor (orange).
// 03 D10.2: placed at (130, 196); typing went into the title, Tab moved on through the header
//    and the rows; 04 Shift+Tab moved back a cell (DOWEL PIN) and " .25" was typed there.
// 05 D10.3: the typing accepted, the cell selected and the cell toolbar above the table.
// 06 Shift+click selects the MATERIAL cells of the three rows; 07 Merge cells: one cell over the
//    three rows; 08 Unmerge cell; 09 Ctrl+Z: merged again; 09b Insert row below; 09c (after
//    undo) Delete column; each undone. Merge is disabled for one cell, Unmerge without a merge.
// 10 D10.4: the table selected (a first click on it; a click on a cell of the selected table
//    selects the cell): the fixed corner's grip black (top left), the other corners and
//    the midpoint grips of the free sides blue; 11 the right midpoint grip dragged: the columns
//    widen from the fixed corner; 12 a corner grip dragged: the table moves.
// 13 right-click → Table properties…: the fixed corner set to bottom right; 14 accepted: the black
//    grip is bottom right and the midpoint grips moved to the left and top sides; 15 the left
//    midpoint grip dragged: the table grows to the left, the bottom-right corner staying put.
// 16 double-click a cell: it is edited with the note toolbar (all selected, made italic);
// 17 accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("ujoint-flange"),
        Click(ui("insert-tab")),
        WaitFor("create-drawing"),
        Click(ui("create-drawing")),
        WaitFor("create-drawing-dialog"),
        Click(ui("template-filter-1")),
        Click(ui("template-row-ANSI_A_INCH.dwt")),
        Click(ui("create-drawing-ok")),
        WaitFor("insert-view-dialog"),
        Click(ui("browser-part-1-1")),
        Click(ui("insert-view-scale")),
        Click(ui("insert-view-scale-option-1")),
        MoveWorld(66, 97),
        Wait(25),
        ClickWorld(66, 97.6),
        MoveWorld(180, 97),
        Wait(25),
        ClickWorld(180, 97.6),
        Key("Escape"),
        // D10.1: the Table dialog.
        Click(ui("drawing-table")),
        WaitFor("table-dialog"),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("01-table-dialog"),
        MoveWorld(130, 196),
        Wait(5),
        Screenshot("02-table-following-cursor"),
        // D10.2: place it; typing fills the cells, Tab moves on.
        ClickWorld(130, 196),
        Type("FASTENERS"),
        Key("Tab"),
        Type("ITEM"),
        Key("Tab"),
        Type("PART"),
        Key("Tab"),
        Type("QTY"),
        Key("Tab"),
        Type("MATERIAL"),
        Key("Tab"),
        Type("1"),
        Key("Tab"),
        Type("SHCS 1/4-20"),
        Key("Tab"),
        Type("8"),
        Key("Tab"),
        Type("STEEL"),
        Key("Tab"),
        Type("2"),
        Key("Tab"),
        Type("WASHER"),
        Key("Tab"),
        Type("8"),
        Key("Tab"),
        Key("Tab"),
        Type("3"),
        Key("Tab"),
        Type("DOWEL PIN"),
        Key("Tab"),
        Type("2"),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("03-typing-tab"),
        Key("Shift+Tab"),
        Type(" .25"),
        Screenshot("04-shift-tab"),
        Key("Escape"),
        Screenshot("05-cell-toolbar"),
        // D10.3: Shift+click selects a range; merge and unmerge.
        ClickWorld(241.1, 180.1),
        KeyDown("Shift"),
        ClickWorld(241.1, 167.4),
        KeyUp("Shift"),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("06-shift-click-range"),
        Click(ui("cell-merge")),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("07-merged"),
        Click(ui("cell-unmerge")),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("08-unmerged"),
        Key("Ctrl+Z"),
        Screenshot("09-undo-unmerge"),
        // The cell toolbar's rows and columns (each undone).
        Click(ui("cell-row-below")),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("09b-row-inserted-below"),
        Key("Ctrl+Z"),
        Click(ui("cell-col-delete")),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("09c-column-deleted"),
        Key("Ctrl+Z"),
        // D10.4: grips.
        Key("Escape"),
        ClickWorld(145.9, 186.5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("10-table-grips"),
        Press(world(257, 178.1)),
        MoveWorld(259, 178.1),
        Wait(2),
        MoveWorld(262, 178.1),
        Wait(2),
        MoveWorld(264, 178.1),
        Wait(5),
        Release,
        Wait(8),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("11-resized-from-fixed-corner"),
        Press(world(130, 196)),
        MoveWorld(127, 195.5),
        Wait(2),
        MoveWorld(124, 194.8),
        Wait(2),
        MoveWorld(122, 194),
        Wait(5),
        Screenshot("12-corner-grip-moves"),
        Release,
        Wait(8),
        // Table properties: the fixed corner to the bottom right.
        RightClick(world(150, 184)),
        Click(ui("table-menu-properties")),
        WaitFor("table-properties"),
        Click(ui("table-props-corner-bottom-right")),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("13-table-properties"),
        Click(ui("table-properties-ok")),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("14-fixed-corner-bottom-right"),
        Press(world(122, 176.1)),
        MoveWorld(119, 176.1),
        Wait(2),
        MoveWorld(115, 176.1),
        Wait(2),
        MoveWorld(112, 176.1),
        Wait(5),
        Release,
        Wait(8),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("15-grows-from-new-corner"),
        // D10.2: double-click a cell to edit it with the note toolbar.
        DoubleClick(world(166, 171.8)),
        Click(ui("note-italic")),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("16-cell-note-editor"),
        Click(ui("note-ok")),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("17-table"),
    ],
)
