// P3I.8 / X7, exercise E2 "Creating sheet metal parts" end to end (slides
// `ex2-creating-sheet-metal-parts/step-*.png`) in a new document, on the stand-in profile: the
// exercise's (15 high walls, 125 wide) with the R35 arc replaced by a trapezoid of lines (a cadrs
// sheet metal Extrude bends only between lines). 03 Sheet metal model → Extrude 80, 1 mm, R1, minimal gap 0.025, bend relief scales 1.5 × 1;
// 04–05 Flange 1 on the two back edges, Inner 8, Partial flange (Per chain, Hold adjacent edges,
// 10); 06 Hem on the flange's top edges (Straight, Flattened, 5, In place); 07–08 a 20 × 10
// rectangle off the right base's front edge (on Top) and Tab 1; 09 Flange 2, a 10 lip on the
// right wall's top edge; 10 Flange 3, 10 on the right wall's vertical front end edge; 11 Make
// joint between the lip's end and Flange 3's top edge, Rip, Butt joint – Direction 1; 12 Corner at the rear-left corner, Round – Sized
// 3.3; 13 Carbon Steel; 14 Mass properties: 0.111 kg (`cadrs_core/tests/sheetmetal_exercises.rs`
// checks 0.111320 kg on the same steps).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch front chain 0 15 0 0 40 0 52 10 73 10 85 0 125 0 125 15"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-1")),
        Click(xyz(0, 0, 7.5)),
        Click(xyz(20, 0, 0)),
        Click(xyz(46, 0, 5)),
        Click(xyz(62.5, 0, 10)),
        Click(xyz(79, 0, 5)),
        Click(xyz(105, 0, 0)),
        Click(xyz(125, 0, 7.5)),
        Click(ui("sm-depth-field")),
        Key("Ctrl+A"),
        Type("80"),
        Key("Tab"),
        Click(ui("sm-minimal-gap-field")),
        Key("Ctrl+A"),
        Type("0.025"),
        Key("Tab"),
        Click(ui("sm-bend-relief-depth-scale-field")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Tab"),
        Click(ui("sm-bend-relief-width-scale-field")),
        Key("Ctrl+A"),
        Type("1"),
        Key("Tab"),
        Custom("view 30 30 62 -40 8 0.16"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-extrude"),
        Click(ui("sheet-metal-model-dialog-accept")),
        // Step 4.
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-flange")),
        WaitFor("sheet-metal-flange-dialog"),
        Custom("view 30 30 30 0 8 0.18"),
        Click(xyz(20, 0, 1)),
        Click(xyz(1, 0, 8)),
        Click(ui("smf-distance-field")),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-flange-two-back-edges"),
        // Step 5.
        Click(ui("smf-partial-checkbox")),
        Click(ui("smf-chain")),
        Click(ui("smf-chain-option-1")),
        Click(ui("smf-bound-distance-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-partial-flange"),
        Click(ui("sheet-metal-flange-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05b-flange-1"),
        // Step 6.
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-hem")),
        WaitFor("sheet-metal-hem-dialog"),
        Click(xyz(15, 0, 8)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06a-first-hem-edge"),
        Click(xyz(8, 0, 13)),
        Click(ui("smf-hem-total-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        Click(ui("smf-hem-alignment")),
        Click(ui("smf-hem-alignment-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-hem-two-back-edges"),
        Click(ui("sheet-metal-hem-dialog-accept")),
        // Steps 7–8.
        Custom("sketch top rect 95 -90 115 -80"),
        Custom("view 30 30 105 -70 4 0.08"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-tab-sketch"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-tab")),
        WaitFor("sheet-metal-tab-dialog"),
        Click(xyz(105, -86, 0)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-tab"),
        Click(ui("sheet-metal-tab-dialog-accept")),
        // Step 9 (`step-09.png`): Flange 2 on the right wall's top edge, a 10 mm lip turned in.
        Custom("view 30 30 62 -40 8 0.16"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-flange")),
        WaitFor("sheet-metal-flange-dialog"),
        Click(xyz(124, -40, 15)),
        Click(ui("smf-distance-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-flange-2"),
        Click(ui("sheet-metal-flange-dialog-accept")),
        // Step 10 (`step-10.png`): Flange 3 on the right wall's vertical front end edge, 10 mm,
        // turned in (as tall as the wall between its bends).
        Custom("view 30 20 118 -80 8 0.035"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-flange")),
        WaitFor("sheet-metal-flange-dialog"),
        Click(xyz(124, -80, 8)),
        Click(ui("smf-distance-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-flange-3"),
        Click(ui("sheet-metal-flange-dialog-accept")),
        // Step 11 (`step-11.png`): Make joint, "Edge of Flange 2" (the lip's front end) and "Edge
        // of Flange 3" (its top edge): Rip, Butt joint – Direction 1.
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-make-joint")),
        WaitFor("sheet-metal-make-joint-dialog"),
        Click(xyz(119, -80, 16)),
        Click(xyz(119, -80, 14)),
        Click(ui("smf-rip-style")),
        Click(ui("smf-rip-style-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-make-joint-butt-1"),
        Click(ui("sheet-metal-make-joint-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11b-joined"),
        // Step 12.
        Custom("view 30 30 15 0 8 0.06"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-corner")),
        WaitFor("sheet-metal-corner-dialog"),
        Click(xyz(4, -4, 1)),
        Click(ui("sm-corner-type")),
        Click(ui("sm-corner-type-option-2")),
        Click(ui("sm-corner-size-field")),
        Key("Ctrl+A"),
        Type("3.3"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-corner-round-sized"),
        Click(ui("sheet-metal-corner-dialog-accept")),
        // Steps 13–14.
        Custom("view 30 30 62 -40 8 0.16"),
        RightClick(ui("part-row-part-1")),
        Click(ui("part-material")),
        Click(ui("material-choose")),
        Type("carbon"),
        Click(ui("material-item-carbon-steel")),
        Click(ui("material-dialog-accept")),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("14-mass-properties"),
    ],
)
