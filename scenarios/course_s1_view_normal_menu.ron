// T2 / S1.5: "N, or right-click → View normal to sketch plane, turns the view normal to the
// sketch plane." A sketch on Front, a circle, seen in the default view; right-clicking empty
// space in the sketch opens the sketch's menu (grouped like the dimension menu,
// `dimension/dimension-driven-01.png`); View normal to sketch plane turns the view, animated.
// Then, after ✓, right-clicking the sketch's region in the modeling view offers the same for
// the sketch.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-front")),
        Wait(3),
        Key("C"),
        Wait(2),
        ClickWorld(0, 30),
        ClickWorld(20, 30),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        RightClick(at(1250, 800)),
        WaitFor("sketch-context-menu"),
        Wait(3),
        Hover(ui("viewport-normal-to")),
        Wait(3),
        Screenshot("01-right-click-sketch-menu"),
        Click(ui("viewport-normal-to")),
        Wait(10),
        Screenshot("02-turning-normal-to-front"),
        Wait(40),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-normal-to-sketch-plane"),
        Key("Shift+7"),
        Wait(40),
        Key("Enter"),
        Wait(10),
        RightClick(xyz(0, 0, 30)),
        WaitFor("viewport-context-menu"),
        Wait(3),
        Hover(ui("viewport-normal-to")),
        Wait(3),
        Screenshot("04-right-click-accepted-sketch"),
        Click(ui("viewport-normal-to")),
        Wait(45),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("05-normal-to-the-sketch"),
    ],
)
