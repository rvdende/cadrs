// Tabs and folders dragged out of a folder's list, and into one through its list (a dragged tab
// resting on a folder opens the folder's list).
// 01 Brackets holds Part Studio 2, Part Studio 3 and the folder Hardware; its list open.
// 02 Part Studio 2 pressed in the list and dragged onto the bar before Part Studio 1: the list
//    closes, the blue line is before Part Studio 1 and the ghost is Part Studio 2 (not the
//    folder).
// 03 dropped there: no line, ghost or dimmed tab left behind.
// 04 Part Studio 1 dragged from the bar, resting on Brackets: Brackets' list opens.
// 05 down the list between Part Studio 3 and Hardware: a line between those rows.
// 06 resting on Hardware's row: a box round it, and Hardware's (empty) list opens to its side.
// 07 onto Hardware's "Empty folder" row and dropped: Part Studio 1 is in Hardware; the lists
//    close.
// 08 Brackets' list, Hardware's list: Part Studio 1 in it.
// 09 Hardware dragged out of Brackets' list onto the bar after Part Studio 2: a folder tab of its
//    own.
Scenario(
    start: Some("landing"),
    steps: [
        Click(ui("create")),
        WaitFor("new-document"),
        Click(ui("new-document")),
        WaitFor("new-document-create"),
        Type("Drag out"),
        Click(ui("new-document-create")),
        WaitFor("document-shell"),
        Wait(10),
        MoveTo(1420, 600),
        Click(ui("insert-tab")),
        WaitFor("insert-tab-menu"),
        Click(ui("create-part-studio")),
        WaitFor("tab-part-studio-2"),
        Click(ui("insert-tab")),
        WaitFor("insert-tab-menu"),
        Click(ui("create-part-studio")),
        WaitFor("tab-part-studio-3"),
        Click(ui("insert-tab")),
        WaitFor("insert-tab-menu"),
        Click(ui("create-folder")),
        WaitFor("tab-folder-folder-1"),
        Key("Ctrl+A"),
        Type("Brackets"),
        Key("Enter"),
        WaitFor("tab-folder-brackets"),
        Click(ui("insert-tab")),
        WaitFor("insert-tab-menu"),
        Click(ui("create-folder")),
        WaitFor("tab-folder-folder-1"),
        Key("Ctrl+A"),
        Type("Hardware"),
        Key("Enter"),
        WaitFor("tab-folder-hardware"),
        Drag(ui("tab-part-studio-2"), ui_at("tab-folder-brackets", 0.5, 0.5)),
        Wait(10),
        Drag(ui("tab-part-studio-3"), ui_at("tab-folder-brackets", 0.5, 0.5)),
        Wait(10),
        Drag(ui("tab-folder-hardware"), ui_at("tab-folder-brackets", 0.5, 0.5)),
        Wait(10),
        Click(ui("tab-folder-brackets")),
        WaitFor("tab-folder-pick-part-studio-2"),
        Wait(5),
        Screenshot("01-list-open"),
        // Out of the list onto the bar.
        Press(ui("tab-folder-pick-part-studio-2")),
        Wait(2),
        Hover(ui_at("tab-folder-pick-part-studio-2", 0.4, 0.3)),
        Wait(2),
        Hover(ui_at("tab-part-studio-1", 0.3, 0.5)),
        Wait(2),
        Hover(ui_at("tab-part-studio-1", 0.2, 0.5)),
        Wait(5),
        Screenshot("02-dragging-out"),
        Release,
        Wait(10),
        MoveTo(1420, 600),
        Wait(5),
        Screenshot("03-dropped"),
        // From the bar into a folder, through its list.
        Press(ui("tab-part-studio-1")),
        Wait(2),
        Hover(ui_at("tab-part-studio-1", 0.6, 0.4)),
        Wait(2),
        Hover(ui_at("tab-folder-brackets", 0.5, 0.5)),
        Wait(40),
        WaitFor("tab-folder-pick-part-studio-3"),
        Wait(5),
        Screenshot("04-folder-springs-open"),
        Hover(ui_at("tab-folder-pick-part-studio-3", 0.5, 0.9)),
        Wait(5),
        Screenshot("05-between-rows"),
        Hover(ui_at("tab-folder-sub-hardware", 0.5, 0.5)),
        WaitFor("tab-folder-empty-hardware"),
        Wait(5),
        Screenshot("06-onto-nested-folder"),
        Hover(ui_at("tab-folder-sub-hardware", 0.97, 0.5)),
        Wait(2),
        Hover(ui_at("tab-folder-empty-hardware", 0.5, 0.5)),
        Wait(5),
        Release,
        Wait(10),
        MoveTo(1420, 600),
        Wait(5),
        Screenshot("07-dropped-in-nested"),
        Click(ui("tab-folder-brackets")),
        WaitFor("tab-folder-sub-hardware"),
        Hover(ui("tab-folder-sub-hardware")),
        WaitFor("tab-folder-pick-part-studio-1"),
        Wait(5),
        Screenshot("08-in-hardware"),
        // A folder out of the list onto the bar.
        Drag(ui("tab-folder-sub-hardware"), ui_at("tab-part-studio-2", 0.9, 0.5)),
        Wait(10),
        MoveTo(1420, 600),
        WaitFor("tab-folder-hardware"),
        Wait(5),
        Screenshot("09-folder-dragged-out"),
    ],
)
