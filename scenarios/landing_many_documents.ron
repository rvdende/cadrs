// M1/M8: a library of 30 sample documents (the list scrolls, with a scrollbar): hover, open by
// double-clicking a row (P3E.1: a click selects it and shows the Details panel; and back), sort by name, context menu, rename, move to trash (with
// confirmation), the Trash filter, restore, undo and delete permanently; Copy… (a new document,
// undoable), a folder listed as a row, and scrolling the list.
Scenario(
    start: Some("landing"),
    seed_documents: 30,
    steps: [
        Screenshot("01-list"),
        Hover(ui("doc-row-2")),
        Wait(2),
        Screenshot("02-row-hover"),
        DoubleClick(ui("doc-name-2")),
        WaitFor("document-loading"),
        Screenshot("03-row-opens-loading"),
        Screenshot("04-row-opened-document"),
        Click(ui("back-to-documents")),
        WaitFor("doc-row-0"),
        Click(ui("col-name")),
        Screenshot("05-sorted-by-name"),
        Click(ui("col-name")),
        Screenshot("06-sorted-by-name-descending"),
        Click(ui("col-modified")),
        RightClick(ui("doc-name-1")),
        WaitFor("doc-context-menu"),
        Hover(ui("ctx-rename")),
        Wait(2),
        Screenshot("07-context-menu"),
        Click(ui("ctx-rename")),
        WaitFor("rename-dialog"),
        Screenshot("08-rename-dialog"),
        Type("Bracket v3"),
        Key("Enter"),
        Screenshot("09-renamed"),
        RightClick(ui("doc-name-3")),
        WaitFor("ctx-trash"),
        Click(ui("ctx-trash")),
        WaitFor("trash-dialog"),
        Screenshot("10-trash-confirm"),
        Click(ui("trash-dialog-ok")),
        Screenshot("11-after-trash"),
        Click(ui("filter-trash")),
        Screenshot("12-trash-filter"),
        RightClick(ui("doc-name-0")),
        WaitFor("ctx-restore"),
        Hover(ui("ctx-restore")),
        Wait(2),
        Screenshot("13-trash-context-menu"),
        Click(ui("ctx-restore")),
        Screenshot("14-restored"),
        Key("Ctrl+Z"),
        Screenshot("15-restore-undone"),
        RightClick(ui("doc-name-0")),
        WaitFor("ctx-delete-forever"),
        Click(ui("ctx-delete-forever")),
        WaitFor("purge-dialog"),
        Screenshot("16-delete-permanently-confirm"),
        Click(ui("purge-dialog-ok")),
        Screenshot("17-trash-emptied"),
        Click(ui("toast-undo")),
        Screenshot("18-toast-undo"),
        Click(ui("filter-owned")),
        RightClick(ui("doc-name-0")),
        WaitFor("ctx-copy"),
        Click(ui("ctx-copy")),
        WaitFor("copy-dialog"),
        Screenshot("19-copy-dialog"),
        Key("Enter"),
        Screenshot("20-copied"),
        Key("Ctrl+Z"),
        Screenshot("21-copy-undone"),
        Key("Ctrl+Y"),
        Click(ui("create")),
        WaitFor("new-folder"),
        Click(ui("new-folder")),
        WaitFor("new-folder-dialog"),
        Type("Brackets"),
        Key("Enter"),
        Screenshot("22-folder-row-listed"),
        Scroll(ui("doc-name-6"), -12),
        Wait(3),
        Screenshot("23-scrolled-with-scrollbar"),
    ],
)
