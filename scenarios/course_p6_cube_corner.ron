// P3.9 / P6.4 (intro-to-parametric-cad.md): clicking a corner of the view cube turns the view to
// the trimetric view from that corner. On the Control Arm (`control-arm add`).
// 01 the Front view; the pointer on the cube's front-right-top corner: its patch (the corner
//    squares of the three faces that meet there) lights up.
// 02 clicked: the trimetric view from that corner (the default view's 30°/30°).
// 03 back to Front, the front-left-bottom corner clicked: the view from below, front left.
// 04 the Top view, the back-right-top corner clicked: the view from behind, right, above.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("control-arm add"),
        Wait(10),
        Key("P"),
        Wait(3),
        Key("Shift+1"),
        Wait(40),
        Key("F"),
        Wait(40),
        Hover(ui_at("view-cube-image", 0.739, 0.261)),
        Wait(5),
        Screenshot("01-front-view-corner-hover"),
        Click(ui_at("view-cube-image", 0.739, 0.261)),
        Wait(60),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-front-right-top-trimetric"),
        Key("Shift+1"),
        Wait(40),
        Click(ui_at("view-cube-image", 0.261, 0.739)),
        Wait(60),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-front-left-bottom"),
        Key("Shift+5"),
        Wait(40),
        Click(ui_at("view-cube-image", 0.739, 0.261)),
        Wait(60),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-back-right-top"),
    ],
)
