// P3.9 / P6.4 (intro-to-parametric-cad.md): clicking a corner's dot on the view ball turns the
// view to the trimetric view from that corner. On the Control Arm (`control-arm add`).
// 01 the Front view; the pointer on the ball's front-right-top dot: it grows, blue, and "Top
//    front right" shows beside the ball.
// 02 clicked: the trimetric view from that corner (the default view's 30°/30°).
// 03 back to Front, the front-left-bottom corner clicked: the view from below, front left.
// 04 the Top view, the back-right-top corner clicked: the view from behind, right, above.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("control-arm add"),
        Key("P"),
        Key("Shift+1"),
        Key("F"),
        Hover(ui_at("view-cube-image", 0.739, 0.261)),
        Wait(5),
        Screenshot("01-front-view-corner-hover"),
        Click(ui_at("view-cube-image", 0.739, 0.261)),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-front-right-top-trimetric"),
        Key("Shift+1"),
        Click(ui_at("view-cube-image", 0.261, 0.739)),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-front-left-bottom"),
        Key("Shift+5"),
        Click(ui_at("view-cube-image", 0.739, 0.261)),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-back-right-top"),
    ],
)
