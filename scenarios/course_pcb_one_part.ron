// P3H.6 (PCB7.9, X9): one part for the whole PCB. In the Vision PCB assembly made by Create
// assembly: a Part Studio created in its context, Transform → Copy in place over every context
// part, Composite part with Closed over the
// copies, then Insert and go to Assembly with the composite part: one instance.
// 01 the Vision PCB assembly; 02 Create Part Studio in context (the assembly as context);
// 03 the Transform dialog, type Copy in place; 04 a window box over the whole board; 05 every
// context part (30) in Parts to transform; 06 accepted: 30 parts in the Parts list, in place;
// 07 the Composite part dialog with the 30 copies (box again) and Closed checked;
// 08 accepted: one part "Composite part 1" in the Parts list; 08b its row double-clicked: the
//    dialog again (the studio before it, its members selected), Esc;
// 09 Insert and go to Assembly with it; 10 the assembly: one more instance, "Composite part 1 <1>".
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("insert-tab")),
        WaitFor("create-pcb-studio"),
        Click(ui("create-pcb-studio")),
        WaitFor("pcb-tree"),
        Wait(20),
        Click(ui("pcb-import")),
        WaitFor("pcb-import-dialog"),
        Custom("pcb-choose vision controller/Vision PCB.emn;vision controller/Vision PCB.emp"),
        Wait(5),
        Click(ui("pcb-import-ok")),
        WaitFor("pcb-board-vision-pcb"),
        Wait(40),
        Click(ui("pcb-create-assembly")),
        WaitFor("pcb-create-dialog"),
        Wait(5),
        Click(ui("pcb-create-ok")),
        WaitFor("pcb-create-toast"),
        Wait(10),
        Click(ui("tab-vision-pcb-assembly")),
        Wait(60),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("01-vision-pcb-assembly"),
        // Create Part Studio in context (origin: the assembly Origin).
        Click(ui("display-states")),
        WaitFor("display-states-menu-in-context"),
        Click(ui("display-states-menu-in-context")),
        WaitFor("origin-dialog"),
        Wait(10),
        Click(ui("origin-dialog-accept")),
        WaitFor("context-bar"),
        Wait(30),
        Key("Shift+5"),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02-part-studio-in-context"),
        // Transform → Copy in place over every context part.
        Click(ui("transform")),
        WaitFor("transform-dialog"),
        Wait(10),
        Click(ui("transform-type")),
        Wait(5),
        Click(ui("transform-type-option-5")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("03-transform-copy-in-place"),
        Press(xyz(-6, 82, 1.6)),
        Hover(xyz(40, 40, 1.6)),
        Wait(2),
        Hover(xyz(106, -4, 1.6)),
        Wait(2),
        Hover(xyz(107.5, -5.5, 1.6)),
        Wait(5),
        Screenshot("04-box-over-the-board"),
        Release,
        Wait(40),
        ExpectText("transform-parts-field", "Board [Vision PCB] <1>"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("05-context-parts-picked"),
        Click(ui("transform-dialog-accept")),
        Wait(60),
        ExpectText("feature-transform-1", "Transform 1"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06-copied-in-place"),
        // Composite part, Closed, over the copies.
        Click(ui("composite-part")),
        WaitFor("composite-dialog"),
        Wait(10),
        Press(xyz(-6, 82, 1.6)),
        Hover(xyz(40, 40, 1.6)),
        Wait(2),
        Hover(xyz(107.5, -5.5, 1.6)),
        Wait(5),
        Release,
        Wait(20),
        Click(ui("composite-closed-checkbox")),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-composite-part-closed"),
        Click(ui("composite-dialog-accept")),
        Wait(60),
        ExpectText("part-row-composite-part-1", "Composite part 1"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08-one-part"),
        // A feature row's double-click edits it; Esc leaves it as it was.
        DoubleClick(ui("feature-composite-part-1")),
        WaitFor("composite-dialog"),
        Wait(20),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08b-edit-composite-part"),
        Key("Escape"),
        Wait(20),
        ExpectText("part-row-composite-part-1", "Composite part 1"),
        // Insert and go to Assembly: one instance.
        Click(ui("part-row-composite-part-1")),
        Wait(2),
        Click(ui("context-insert")),
        WaitFor("insert-go-dialog"),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("09-insert-and-go-to-assembly"),
        Click(ui("insert-go-dialog-accept")),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("10-assembly-with-one-part"),
    ],
)
