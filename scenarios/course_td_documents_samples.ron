// P3E.1 (test-drive.md TD4.1 "Make a copy", X5; exercise step 1's pattern): the bundled samples
// under Explore cadrs (`cadrs_core::documents_page::SAMPLES`, the course stand-ins in
// `fixtures/`), opened as your own editable copy.
// 01 Explore cadrs: "Samples" with the six course stand-ins (thumbnail, name, course, owner
//    "cadrs samples"); the pointer on a row.
// 02 a click selects a sample: the Details panel with its thumbnail, "Open a copy", Owner,
//    Course and description.
// 03 right-click: the menu's "Open a copy…".
// 04 Open a copy (the panel's button): the dialog, "Copy of Block source" selected.
// 05 Open a copy: the copy opens as a document of your own (loading).
// 06 the copy: the Block studio, 50 × 30 × 25.
// 07 back to documents: "Copy of Block source" in Owned by me, selected, its details (owner:
//    you).
Scenario(
    start: Some("landing"),
    seed_documents: 4,
    steps: [
        WaitFor("doc-row-0"),
        Click(ui("filter-explore")),
        WaitFor("sample-row-0"),
        Wait(5),
        Hover(ui("sample-name-2")),
        Wait(3),
        Screenshot("01-samples-list"),
        Click(ui("sample-name-0")),
        WaitFor("details-open-copy"),
        Wait(5),
        Screenshot("02-sample-details"),
        RightClick(ui("sample-name-0")),
        WaitFor("sample-open-copy"),
        Hover(ui("sample-open-copy")),
        Wait(3),
        Screenshot("03-sample-context-menu"),
        Key("Escape"),
        Wait(3),
        Click(ui("details-open-copy")),
        WaitFor("sample-copy-dialog"),
        Wait(3),
        Screenshot("04-open-a-copy-dialog"),
        Click(ui("sample-copy-dialog-ok")),
        WaitFor("document-loading"),
        Wait(2),
        Screenshot("05-copy-opening"),
        Wait(40),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("06-copy-opened"),
        Click(ui("back-to-documents")),
        WaitFor("filter-owned"),
        Click(ui("filter-owned")),
        WaitFor("doc-row-0"),
        Wait(3),
        Click(ui("doc-name-0")),
        WaitFor("details-owner"),
        Wait(5),
        Screenshot("07-copy-in-owned-by-me"),
    ],
)
