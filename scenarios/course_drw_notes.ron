// P3C.4 / D9, X3, X9, X12: notes on the Ex1 flange stand-in (`samples::ujoint`, inches) with
// Front and Right at 1:2 on an ANSI A sheet (sheet points are `world(x, y)` in sheet mm; Front's
// origin at (66, 65.85), Right's at (180, 65.85)).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("ujoint-flange"),
        Wait(90),
        Click(ui("insert-tab")),
        WaitFor("create-drawing"),
        Click(ui("create-drawing")),
        WaitFor("create-drawing-dialog"),
        Wait(8),
        Click(ui("template-filter-1")),
        Wait(5),
        Click(ui("template-row-ANSI_A_INCH.dwt")),
        Wait(5),
        Click(ui("create-drawing-ok")),
        WaitFor("insert-view-dialog"),
        Wait(15),
        Click(ui("browser-part-1-1")),
        Wait(5),
        Click(ui("insert-view-scale")),
        Wait(5),
        Click(ui("insert-view-scale-option-1")),
        Wait(5),
        MoveWorld(66, 97),
        Wait(25),
        ClickWorld(66, 97.6),
        Wait(25),
        MoveWorld(180, 97),
        Wait(25),
        ClickWorld(180, 97.6),
        Wait(25),
        Key("Escape"),
        Wait(5),
        // D9.1: N, then a click on empty sheet: a free note, typed in place with the toolbar.
        Key("N"),
        Wait(3),
        MoveWorld(125, 196),
        Wait(3),
        Screenshot("01-note-tool"),
        ClickWorld(125, 196),
        Wait(5),
        Click(ui("note-bold")),
        Wait(2),
        Type("GENERAL NOTES"),
        Click(ui("note-bold")),
        Wait(2),
        Key("Enter"),
        Click(ui("note-numbered")),
        Wait(2),
        Type("BREAK ALL SHARP EDGES "),
        Click(ui("note-italic")),
        Wait(2),
        Type(".02 MAX"),
        Click(ui("note-italic")),
        Wait(2),
        Key("Enter"),
        Type("HOLES "),
        Click(ui("note-symbol")),
        Wait(5),
        Click(ui("note-symbol-diameter")),
        Wait(2),
        Type(".266 THRU "),
        Click(ui("note-symbol")),
        Wait(5),
        Screenshot("02-symbol-menu"),
        Click(ui("note-symbol-counterbore")),
        Wait(2),
        Click(ui("note-symbol")),
        Wait(5),
        Click(ui("note-symbol-diameter")),
        Wait(2),
        Type(".438"),
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("03-rich-text-editing"),
        Click(ui("note-ok")),
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("04-free-note"),
        // D9.1: a note with a leader: pick the front view's lug face, then place the text.
        Key("N"),
        Wait(3),
        MoveWorld(91.4, 130),
        Wait(5),
        ClickWorld(91.4, 130),
        Wait(3),
        MoveWorld(100, 160),
        Wait(5),
        Screenshot("05-leader-note-placing"),
        ClickWorld(100, 160),
        Wait(5),
        Type("MACHINE LUG FACES"),
        Wait(2),
        Click(ui("note-ok")),
        Wait(5),
        // D9.2: right-click → Add leader, to the right view's lug side.
        RightClick(world(110, 158.5)),
        Wait(5),
        Hover(ui("note-menu-add-leader")),
        Wait(5),
        Screenshot("06-note-menu-add-leader"),
        Click(ui("note-menu-add-leader")),
        Wait(3),
        MoveWorld(164.125, 120),
        Wait(5),
        ClickWorld(164.125, 120),
        Wait(3),
        Key("Escape"),
        Wait(3),
        ClickWorld(110, 158.5),
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("07-note-with-two-leaders"),
        // D9.4: a parametric note: the part's name (UPPERCASE), material and part number (not set:
        // dashes), the sheet scale and the date.
        Key("Escape"),
        Key("N"),
        Wait(3),
        ClickWorld(18, 196),
        Wait(5),
        Type("PART: "),
        Click(ui("note-insert-reference")),
        WaitFor("note-prop-card"),
        Wait(3),
        Click(ui("note-prop-format")),
        Wait(5),
        Click(ui("note-prop-format-option-1")),
        Wait(5),
        Screenshot("08-insert-reference-property"),
        Click(ui("note-prop-ok")),
        Wait(3),
        Key("Enter"),
        Type("MATERIAL: "),
        Click(ui("note-insert-reference")),
        WaitFor("note-prop-card"),
        Click(ui("note-prop-property")),
        Wait(5),
        Click(ui("note-prop-property-option-4")),
        Wait(5),
        Click(ui("note-prop-ok")),
        Wait(3),
        Key("Enter"),
        Type("PART NO.: "),
        Click(ui("note-insert-reference")),
        WaitFor("note-prop-card"),
        Click(ui("note-prop-property")),
        Wait(5),
        Click(ui("note-prop-property-option-2")),
        Wait(5),
        Click(ui("note-prop-ok")),
        Wait(3),
        Key("Enter"),
        Type("SCALE: "),
        Click(ui("note-insert-drawing")),
        WaitFor("note-prop-card"),
        Wait(3),
        Click(ui("note-prop-ok")),
        Wait(3),
        Key("Enter"),
        Type("DATE: "),
        Click(ui("note-insert-drawing")),
        WaitFor("note-prop-card"),
        Click(ui("note-prop-property")),
        Wait(5),
        Click(ui("note-prop-property-option-7")),
        Wait(5),
        Click(ui("note-prop-date")),
        Wait(5),
        Click(ui("note-prop-date-option-2")),
        Wait(5),
        Screenshot("09-insert-drawing-property-date"),
        Click(ui("note-prop-ok")),
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("10-parametric-note-editing"),
        Click(ui("note-ok")),
        Wait(5),
        Key("Escape"),
        Wait(3),
        Screenshot("11-parametric-note"),
        // The note follows the property: rename the part in its Part Studio…
        Click(ui("tab-universal-joint")),
        Wait(40),
        RightClick(ui("part-row-universal-joint-flange--stand-in")),
        Wait(5),
        Click(ui("part-rename")),
        Wait(5),
        Key("Ctrl+A"),
        Type("Universal Joint Yoke"),
        Key("Enter"),
        Wait(10),
        Click(ui("tab-drawing-1")),
        Wait(40),
        // …and the scale: Front (the sheet's first view) at 1:4.
        RightClick(world(66, 97.6)),
        Wait(8),
        Click(ui("view-menu-properties")),
        WaitFor("view-properties-dialog"),
        Wait(5),
        Click(ui("view-props-scale")),
        Wait(5),
        Click(ui("view-props-scale-option-2")),
        Wait(5),
        Click(ui("view-props-ok")),
        Wait(40),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("12-note-follows-name-and-scale"),
        // D9.5: the free note's grips: turn it, then wrap it narrower.
        ClickWorld(165, 190),
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("13-note-grips"),
        Press(world(163.2, 203.9)),
        MoveWorld(162, 204),
        Wait(2),
        MoveWorld(160.5, 203.8),
        Wait(2),
        MoveWorld(159.3, 203.4),
        Wait(5),
        Screenshot("14-rotating"),
        Release,
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("15-rotated"),
        Key("Ctrl+Z"),
        Wait(5),
        ClickWorld(165, 190),
        Wait(3),
        Press(world(202.5, 189.1)),
        MoveWorld(195, 189.1),
        Wait(2),
        MoveWorld(183, 189.1),
        Wait(2),
        MoveWorld(175, 189.1),
        Wait(5),
        Release,
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("16-resized-wraps"),
        // Double-click edits it.
        DoubleClick(world(145, 186)),
        Wait(5),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("17-double-click-edits"),
        Key("Escape"),
        Wait(5),
    ],
)
