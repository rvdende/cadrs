// T5 / S21.1: sketch imprinting. "When sketching on a part face, the face's edges imprint on the
// sketch: the overlaps become selectable regions without projecting anything. It's on by
// default." A 50 × 30 box, 25 high; a sketch on its top face with a Ø20 circle over the face's
// right edge. The face's edges split the circle: its half on the face is a region of its own
// ("Area: 157.080 mm²"), and so is the face around it. Extruding just that half makes a half
// cylinder standing on the box: its body touches the box, so the extrude picks Add by itself
// (PS5.2, since P3.3) and the result is one part (04; before P3.3 every extrude was a new part,
// two parts).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("G"),
        ClickWorld(0.45, 0.3),
        MoveWorld(49.12, 33.17),
        Wait(2),
        ClickWorld(49.12, 33.17),
        Type("50"),
        Key("Enter"),
        Type("30"),
        Key("Enter"),
        Key("Escape"),
        Click(ui("sketch-dialog-accept")),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        ClickWorld(25, 15),
        Key("Enter"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(25, 15, 25)),
        Key("N"),
        Key("C"),
        // Shift: no inference. Unshifted, the centre snaps to the midpoint of the face's right
        // edge (snapping to part edges), which fixes it, and the 50 below would be driven.
        KeyDown("Shift"),
        ClickWorld(50, 15),
        KeyUp("Shift"),
        ClickWorld(60, 15),
        Type("20"),
        Key("Enter"),
        Key("Escape"),
        // Its center 50 from the origin: on the face's right edge.
        Key("D"),
        ClickWorld(50, 15),
        ClickWorld(0, 0),
        ClickWorld(25, -8),
        Type("50"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-circle-over-the-face-edge"),
        Click(world(45, 15)),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("02-half-on-the-face-selected-area"),
        Click(world(45, 15)),
        Click(world(20, 15)),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-face-around-the-circle-selected"),
        Click(world(20, 15)),
        Click(ui("sketch-dialog-accept")),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(45, 15, 25)),
        Click(ui("extrude-depth-field")),
        Type("10"),
        Key("Enter"),
        Key("Shift+7"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("04-half-extruded-one-part"),
    ],
)
