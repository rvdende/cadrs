// Find in parts list / Find in instance list (the view's menu) and Select all instances (the
// instance menu), on the Ex2 end state (`fixtures/pneumatic_cylinder_ex2.cadrs`) in a short
// window, so the lists scroll.
// 01 Part Studio: the Parts group closed; 02 right-click the Rear Cap's face: Find in parts
//    list; 03 chosen: the group open, the list scrolled to the Rear Cap, selected.
// 04 Assembly: the list scrolled to its end; 05 right-click the Retaining Plate: Find in
//    instance list; 06 chosen: the list scrolled back to it, selected.
// 07 the four Structural Rods in a folder "Rods", closed; 08 Find in instance list on a rod in
//    the view: the folder open, the rod selected.
// 09 right-click Structural Rod <1>'s row: Select all instances; 10 chosen: the four rods.
Scenario(
    start: Some("document"),
    window_size: Some((1600, 600)),
    steps: [
        Custom("fixture pneumatic_cylinder_ex2"),
        Key("F"),
        Click(ui("parts-section-header-chevron")),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("01-parts-closed"),
        RightClick(at(880, 420)),
        WaitFor("viewport-find-part"),
        Hover(ui("viewport-find-part")),
        Wait(3),
        Screenshot("02-find-in-parts-list-menu"),
        Click(ui("viewport-find-part")),
        MoveTo(1300, 250),
        Wait(5),
        Screenshot("03-found-in-parts-list"),
        Click(ui("tab-cylinder-assembly")),
        Key("F"),
        Scroll(ui("instances-pane"), -20.0),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("04-instances-scrolled-down"),
        RightClick(at(900, 240)),
        WaitFor("asm-find"),
        Hover(ui("asm-find")),
        Wait(3),
        Screenshot("05-find-in-instance-list-menu"),
        Click(ui("asm-find")),
        MoveTo(1300, 250),
        Wait(5),
        Screenshot("06-found-in-instance-list"),
        Click(at(1350, 500)),
        Click(ui("instance-row-10")),
        Click(ui("instance-row-11")),
        Click(ui("instance-row-12")),
        Click(ui("instance-row-13")),
        RightClick(ui("instance-row-12")),
        WaitFor("asm-folder"),
        Click(ui("asm-folder")),
        WaitFor("folder-name-popup"),
        Type("Rods"),
        Click(ui("folder-name-popup-accept")),
        Click(at(1350, 500)),
        Click(ui("instance-folder-rods-chevron")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-rods-folder-closed"),
        RightClick(at(881, 330)),
        WaitFor("asm-find"),
        Click(ui("asm-find")),
        MoveTo(1300, 250),
        Wait(5),
        Screenshot("08-found-in-closed-folder"),
        Click(at(1350, 500)),
        RightClick(ui("instance-row-10")),
        WaitFor("asm-select-all-instances"),
        Hover(ui("asm-select-all-instances")),
        Wait(3),
        Screenshot("09-select-all-instances-menu"),
        Click(ui("asm-select-all-instances")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("10-all-instances-selected"),
    ],
)
