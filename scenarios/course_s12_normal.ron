// T4 / S12.10: Normal (Shift+K): "a line and a curve". The line becomes normal to the circle:
// its direction passes through the circle's center (`reference/onshape/constraints.md` row 10;
// the glyph is our own line-meets-arc artwork, `edit_tools/normaliconLG.png` for the idea).
// Tool first: Shift+K, click a line, click a circle: the line swings to point at the circle's
// center and a Normal glyph sits on it; the tool stays on. Selection first: select a second
// line and circle, then Constraints ▾ → Normal (the row is enabled with its Shift+K keycap):
// that line turns to the other circle's center.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("C"),
        ClickWorld(-35, 15),
        ClickWorld(-20, 15),
        Key("Escape"),
        ClickWorld(35, 35),
        ClickWorld(45, 35),
        Key("Escape"),
        Key("Escape"),
        Key("L"),
        ClickWorld(-12, -38),
        ClickWorld(8, -12),
        Key("Escape"),
        ClickWorld(20, -30),
        ClickWorld(55, -8),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-circles-and-lines"),
        Key("Shift+K"),
        ClickWorld(-2, -25),
        MoveWorld(-35, 0),
        Wait(3),
        Screenshot("02-tool-first-line-picked"),
        ClickWorld(-35, 0),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-line-normal-to-circle-glyph"),
        Key("Escape"),
        ClickWorld(37.5, -19),
        ClickWorld(45, 35),
        Click(ui("sketch-constraints-caret")),
        WaitFor("sketch-constraint-normal"),
        Hover(ui("sketch-constraint-normal")),
        Wait(3),
        Screenshot("04-selection-first-menu-normal-enabled"),
        Click(ui("sketch-constraint-normal")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("05-second-line-normal"),
    ],
)
