// T2 / S11.6: "Hovering an entity shows its constraints, and hovering a glyph highlights its
// entities. Holding Shift while moving keeps glyphs visible so they can be clicked. The Show
// constraints checkbox shows all of them." A rectangle; Show constraints unchecked: no glyphs.
// Hovering the top edge shows its glyphs (⊥ —); moving off it hides them again. Hovering it
// with Shift held, the glyphs stay while the pointer travels to them: the hovered glyph turns
// orange and highlights its lines, and a click selects it: amber with a darker rim, its lines highlighted, still shown after
// the pointer leaves (Delete would remove it). Checking
// Show constraints shows every glyph again.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(-30, -20),
        ClickWorld(30, 20),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-show-constraints")),
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-show-constraints-off-no-glyphs"),
        MoveWorld(-8, 20),
        Wait(3),
        Screenshot("02-hover-top-edge-shows-its-glyphs"),
        MoveWorld(-8, 30),
        Wait(3),
        Screenshot("03-moving-off-hides-them"),
        MoveWorld(-8, 20),
        Wait(3),
        KeyDown("Shift"),
        MoveTo(876, 434),
        Wait(2),
        MoveTo(869, 426),
        Wait(2),
        MoveTo(865, 421),
        Wait(3),
        Screenshot("04-shift-held-glyphs-stay-hovered-glyph"),
        Click(at(865, 421)),
        Wait(3),
        KeyUp("Shift"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("05-glyph-clicked-selected"),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-show-constraints")),
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-show-constraints-on-all-glyphs"),
    ],
)
