// T4 / S17.3: "Extend: click an entity, move, and click to extend it to a boundary. Closed
// regions shade immediately." (X, Trim ▾; `reference/onshape/edit_tools/extend-line-02.png`).
// A U of three lines and a line from the left wall that stops short of the right wall. With
// Extend (X), hovering the short line near its free end highlights it and shows, in the
// rubber-band blue, how that end would grow to the right wall. Clicking picks it; moving past
// the wall, the extension stops at the wall (the first curve in the way); the second click
// extends it. Its new end lies on the wall and the closed box below it shades at once. Arcs
// extend along their circle (`edit_tools/extend-arc-02-01.png`): a 3-point arc in the lower box,
// hovered near its right end, grows round to the bottom wall.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("L"),
        Wait(2),
        ClickWorld(-40, 30),
        ClickWorld(-40, -30),
        ClickWorld(40, -30),
        ClickWorld(40, 30),
        Key("Escape"),
        Wait(2),
        ClickWorld(-40, 15),
        ClickWorld(5, 15),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-open-u-and-short-line"),
        Key("X"),
        Wait(2),
        MoveWorld(2, 15),
        Wait(3),
        Screenshot("02-hover-previews-extension-to-wall"),
        ClickWorld(2, 15),
        Wait(2),
        MoveWorld(60, 18),
        Wait(3),
        Screenshot("03-picked-cursor-past-wall-stops-at-wall"),
        ClickWorld(60, 18),
        Wait(4),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-extended-region-shades"),
        Key("Escape"),
        Wait(2),
        Key("A"),
        Wait(2),
        ClickWorld(-30, -22),
        ClickWorld(0, -22),
        ClickWorld(-15, -12),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("X"),
        Wait(2),
        MoveWorld(-1.5, -20.5),
        Wait(3),
        Screenshot("05-hover-arc-previews-extension"),
        ClickWorld(-1.5, -20.5),
        Wait(3),
        MoveWorld(8, -38),
        Wait(3),
        Screenshot("06-arc-extension-stops-at-bottom-wall"),
        ClickWorld(8, -38),
        Wait(4),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("07-arc-extended"),
    ],
)
