// M8: cursors and tooltips. Screenshots show a software cursor at the pointer (the cursor the
// app asks the OS for). A toolbar button shows the pointing hand and, after a short delay, a
// light tooltip (#d3dae4, #333 text) with its shortcut as keycaps; a text field shows the text
// caret; a drawing tool shows a crosshair over the viewport; with no tool, a point or edge shows
// the move cursor and dragging it a grabbing hand; orbiting (right-drag) shows the grabbing hand
// and panning (middle-drag) the move cursor.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Hover(ui("sketch")),
        Wait(40),
        Screenshot("01-sketch-button-tooltip-shift-s"),
        Hover(ui("undo")),
        Wait(40),
        Screenshot("02-undo-tooltip-ctrl-z"),
        Hover(ui("feature-filter")),
        Wait(3),
        Screenshot("03-text-caret-over-filter"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Hover(ui("sketch-line")),
        Wait(40),
        Screenshot("04-line-tooltip-l"),
        Key("L"),
        MoveWorld(-20, 10),
        Wait(3),
        Screenshot("05-crosshair-while-drawing"),
        ClickWorld(-40, -10),
        ClickWorld(20, 25),
        Key("Escape"),
        Key("Escape"),
        Wait(2),
        MoveWorld(20, 25),
        Wait(3),
        Screenshot("06-move-cursor-over-point"),
        Press(world(20, 25)),
        MoveWorld(28, 30),
        Wait(2),
        MoveWorld(34, 32),
        Wait(3),
        Screenshot("07-grabbing-while-dragging"),
        Release,
        Wait(3),
        PressWith("right", at(1200, 700)),
        MoveTo(1230, 710),
        Wait(2),
        MoveTo(1260, 720),
        Wait(3),
        Screenshot("08-grabbing-while-orbiting"),
        ReleaseWith("right"),
        Wait(3),
        PressWith("middle", at(1200, 700)),
        MoveTo(1220, 690),
        Wait(2),
        MoveTo(1240, 680),
        Wait(3),
        Screenshot("09-move-while-panning"),
        ReleaseWith("middle"),
        Wait(3),
    ],
)
