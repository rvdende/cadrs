// P3E.3b (TD6.2, D2.2): the 3D view mouse controls preference, on the bar sample
// (`samples::drawing_bar`: the Bar Part Studio and its Bar Drawing). Every step through the UI;
// the mapping table is `cadrs_core::preferences` (unit tests `the_mapping_table`,
// `sheets_pan_with_the_rotate_and_pan_gestures`).
// 01 the Bar in Isometric, Onshape's controls: a right-drag rotates it.
// 02 the account menu (top right): Preferences…
// 03 the Preferences dialog: 3D view mouse controls Onshape: Rotate "Right drag", Rotate without
//    roll "Alt+Right drag", Pan "Middle drag, Ctrl+Right drag", Zoom "Scroll wheel,
//    Shift+Middle drag".
// 04 its list: Onshape, SolidWorks, Inventor, Creo; 05 SolidWorks picked: Rotate "Middle drag",
//    Pan "Ctrl+Middle drag", Zoom "Scroll wheel, Shift+Middle drag".
// 06 OK, back in Isometric: the same right-drag as 01 leaves the view as it was.
// 07 a middle-drag (Onshape's pan) rotates it now.
// 08 Isometric again, Ctrl+middle-drag: pans (the bar moves right and down, unturned).
// 08b the Bar Drawing (D2.2), fitted (F): the sheet before any drag; 09 a middle-drag pans it
//    (right and down); 10 a right-drag (Onshape's sheet
//    pan) does nothing with SolidWorks' controls.
// 11 Preferences again: SolidWorks kept (written to the store's preferences.ron); Onshape picked
//    and OK: 12 a right-drag pans the sheet again.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("bar-drawing"),
        Wait(120),
        ClickAt(150, 985),
        Wait(40),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        RightDrag(at(800, 500), at(950, 560)),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-onshape-right-drag-rotates"),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        Click(ui("account")),
        WaitFor("account-preferences"),
        Hover(ui("account-preferences")),
        Wait(3),
        Screenshot("02-account-menu"),
        Click(ui("account-preferences")),
        WaitFor("preferences-dialog"),
        Wait(5),
        ExpectText("pref-mouse-rotate", "Right drag"),
        ExpectText("pref-mouse-pan", "Ctrl+Right drag"),
        ExpectText("pref-mouse-turntable", "Alt+Right drag"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-preferences-onshape"),
        Click(ui("pref-mouse-preset")),
        Wait(5),
        Hover(ui("pref-mouse-preset-option-1")),
        Wait(3),
        Screenshot("04-preset-list"),
        Click(ui("pref-mouse-preset-option-1")),
        Wait(5),
        ExpectText("pref-mouse-rotate", "Middle drag"),
        ExpectText("pref-mouse-pan", "Ctrl+Middle drag"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-solidworks-gestures"),
        Click(ui("pref-ok")),
        Wait(10),
        RightDrag(at(800, 500), at(950, 560)),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-right-drag-does-nothing"),
        MiddleDrag(at(800, 500), at(950, 560)),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-middle-drag-rotates"),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        KeyDown("Ctrl"),
        MiddleDrag(at(800, 500), at(950, 560)),
        KeyUp("Ctrl"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-ctrl-middle-drag-pans"),
        Click(ui("tab-bar-drawing")),
        Wait(40),
        Key("F"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08b-sheet-before-pan"),
        MiddleDrag(at(800, 500), at(950, 560)),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-sheet-middle-drag-pans"),
        RightDrag(at(800, 500), at(650, 440)),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-sheet-right-drag-nothing"),
        Click(ui("account")),
        WaitFor("account-preferences"),
        Click(ui("account-preferences")),
        WaitFor("preferences-dialog"),
        Wait(5),
        ExpectText("pref-mouse-preset", "SolidWorks"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-preferences-kept-solidworks"),
        Click(ui("pref-mouse-preset")),
        Wait(5),
        Click(ui("pref-mouse-preset-option-0")),
        Wait(5),
        Click(ui("pref-ok")),
        Wait(10),
        RightDrag(at(800, 500), at(650, 440)),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-onshape-right-drag-pans-sheet"),
    ],
)
