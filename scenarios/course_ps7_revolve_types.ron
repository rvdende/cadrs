// P3.4 / PS7: the Revolve feature. The sketches are added by the `sketch` set-up command (a
// construction centreline and a 5 × 20 rectangle 5 mm off it on Front, a Ø10 circle 20 mm from a
// second centreline, then part geometry for other axes); every revolve and extrude goes through
// its dialog (Shift+W, Shift+E).
// 01 Revolve 1: the rectangle picked ("Face of Sketch 1"); the type list open (Full, Blind,
//    Symmetric, Up to next / face / part / vertex).
// 02 the Revolve axis field active and the centreline hovered (orange).
// 03 Full (the default), the axis picked ("Edge of Sketch 1", the centreline orange): a tube
//    r 5..10, 20 long, as the translucent preview. No arrow for a whole turn.
// 04 Blind: the Revolve angle field, 90 deg, and the flip button; a quarter of the tube, with the
//    arrow manipulator at the middle of its end face, the cursor on it (highlighted).
// 05 the arrow being dragged along the turn (highlighted); the angle follows it.
// 06 released: the dragged angle kept.
// 07 Second end position (PS7.3): 90° back the other way too.
// 08 Thin (PS7.4): Thickness 1, 1 mm inside the rectangle: a tube wall.
// 09 Surface: the rectangle's loop turned into sheets ("Sketch curves to revolve").
// 10 Solid, Symmetric 90: the quarter split across the sketch plane (45° each way).
// 11 Revolve 1 accepted: Part 1, with the silhouettes of its curved faces; Sketch 1 hidden.
// 12 a torus: Revolve 2, Full, a Ø10 circle 20 mm from its axis.
// 13 the torus accepted: no edges, only the silhouettes of its toroidal face (from a grid of
//    meridians, P3.4).
// 14 the torus selected (the selection's orange with dark edges), Mass and section properties:
//    V = 2π²Rr² = 2π²·20·25 = 9869.604 mm³ and A = 4π²Rr = 3947.842 mm² (Pappus).
// 15 (PS7.2) a Ø8 cylinder (Extrude 1) and a 5 × 10 rectangle 10 mm from its axis: Revolve 3's
//    axis is the cylinder's face ("Face of Extrude 1": its axis).
// 16 the axis re-picked as the cylinder's top circular edge ("Edge of Extrude 1": its axis).
// 17 a 5 × 5 bar (Extrude 2): Revolve 4 about the bar's straight edge on the Front plane ("Edge
//    of Extrude 2"), Up to face: the bar's face through that edge (a quarter turn), less an Offset
//    angle of 5 deg.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch front centreline 0 0 0 30 rect 5 0 10 20"),
        Key("P"),
        Key("Shift+7"),
        Key("F"),
        Key("Shift+W"),
        WaitFor("revolve-dialog"),
        Click(xyz(7.5, 0, 10)),
        Click(ui("revolve-type")),
        Hover(ui("revolve-type-option-1")),
        Wait(3),
        Screenshot("01-type-list"),
        Click(ui("revolve-type-option-0")),
        Click(ui("revolve-axis-field")),
        Hover(xyz(0, 0, 25)),
        Wait(5),
        Screenshot("02-axis-hover"),
        Click(xyz(0, 0, 25)),
        Key("F"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("03-full"),
        Click(ui("revolve-type")),
        Click(ui("revolve-type-option-1")),
        Hover(ui("revolve-arrow")),
        Wait(5),
        Screenshot("04-blind-90-arrow-hovered"),
        Press(ui("revolve-arrow")),
        Wait(2),
        MoveTo(1000, 480),
        Wait(3),
        MoveTo(930, 470),
        Wait(5),
        Screenshot("05-dragging-the-arrow"),
        Release,
        Wait(8),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("06-released"),
        Click(ui("revolve-angle-field")),
        Key("Ctrl+A"),
        Type("90"),
        Click(ui("revolve-dialog-title")),
        Click(ui("revolve-second-end-checkbox")),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("07-second-end-90"),
        Click(ui("revolve-second-end-checkbox")),
        Click(ui("revolve-body-type-2")),
        Click(ui("revolve-thickness1-field")),
        Key("Ctrl+A"),
        Type("1"),
        Click(ui("revolve-dialog-title")),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("08-thin-1"),
        Click(ui("revolve-body-type-1")),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("09-surface"),
        Click(ui("revolve-body-type-0")),
        Click(ui("revolve-type")),
        Click(ui("revolve-type-option-2")),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("10-symmetric-90"),
        Key("Enter"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("11-accepted"),
        // The torus.
        Custom("sketch front centreline 40 0 40 30 circle 60 10 5"),
        Key("F"),
        Key("Shift+W"),
        WaitFor("revolve-dialog"),
        Click(xyz(60, 0, 10)),
        Click(ui("revolve-axis-field")),
        Click(xyz(40, 0, 25)),
        Key("F"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("12-torus"),
        Key("Enter"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("13-torus-silhouettes"),
        ClickAt(1420, 900),
        Click(ui("part-row-part-2")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("14-torus-mass"),
        Click(ui("mass-dialog-cancel")),
        ClickAt(1420, 900),
        // Part geometry as the axis (PS7.2): a cylinder, its face and its circular edge.
        Custom("sketch top circle -70 0 4"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-3")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Custom("sketch front rect -60 0 -55 10"),
        Key("F"),
        Key("Shift+W"),
        WaitFor("revolve-dialog"),
        Click(xyz(-57.5, 0, 5)),
        Click(ui("revolve-axis-field")),
        Click(xyz(-67.17, -2.83, 10)),
        Key("F"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("15-axis-cylindrical-face"),
        Click(xyz(-66, 0, 20)),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("16-axis-circular-edge"),
        Key("Enter"),
        // A bar: its straight edge on the Front plane as the axis, Up to face.
        Custom("sketch top rect -45 0 -40 5"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-5")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Custom("sketch front rect -30 0 -25 10"),
        Key("F"),
        Key("Shift+W"),
        WaitFor("revolve-dialog"),
        Click(xyz(-27.5, 0, 5)),
        Click(ui("revolve-axis-field")),
        Click(xyz(-40, 0, 12)),
        Click(ui("revolve-type")),
        Click(ui("revolve-type-option-4")),
        Click(xyz(-40, 2.5, 15)),
        Click(ui("revolve-offset-checkbox")),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("17-axis-straight-edge-up-to-face"),
    ],
)
