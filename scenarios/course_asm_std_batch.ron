// P3B.5 / A19.1–A19.6, A19.8: standard content, batch placement (intro-to-assemblies.md A19,
// lesson-standard-content.png, ex3-step2.png), on the Ex2 end state
// (`fixtures/pneumatic_cylinder_ex2.cadrs`).
// 01 the Retaining Plate zoomed to, Piston & Rod hidden; the plate's six Ø0.266 hole edges
//    clicked (selected).
// 02 (A19.1, A19.3, A19.4) Insert → Standard content: ANSI inch / Bolts & screws / Hex bolts /
//    Hex cap screw; the Size list open.
// 02a (A19.2) a wrong size, 1/2-20; 02b Auto-size: from the selected Ø0.266 holes the bolt rounds
//    down to 1/4 (1/4-20, the first of that diameter); then 1/4-28 picked, as the course does.
// 03 1/4-28 x 0.75, thread length 0.75, Stainless Steel; Part number and Description filled in,
//    the preview (an end and a side view).
// 04 (A19.6) Insert: six screws, one on each selected hole, each with a Fastened mate.
// 05 (A19.8) ✓: the six screws in the Instances list with the standard content icon, and
//    Fastened 12–17 in the Mate Features list.
// With the rods shown (a hole edge a rod fills is still picked):
// 06a (A19.2) Insert → Standard content → Nuts (Size 1/4-20), Auto-size with nothing selected:
//    armed; 06b a click on a rod's top edge (a Ø0.375 shaft): the nut rounds up to 3/8-16.
// 06 A Top Cap rod-hole edge clicked, Insert: a Hex nut 3/8-16 on it (the selection stays).
// 07 (A19.7) Washers / Plain washer 3/8 N → Insert closest to selection: the washer goes under
//    the nut, which moves up by its thickness; 08 Insert furthest from selection: another on top.
// 09 (A19.5) Single placement: nothing selected, Insert arms it; hovering another rod-hole edge
//    (behind its rod) shows the washer there; 10 A flips it into the hole's side: drawn
//    translucent over the Top Cap it goes into; 11 A again, click: placed with its Fastened mate.
// 12 ISO / Socket head cap screw M12: the hex socket in the preview's end view and on the screw
//    shown over a free rod hole.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture pneumatic_cylinder_ex2"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        // Piston & Rod hidden (its rod runs through the plate).
        Hover(ui("instance-row-14")),
        Wait(3),
        Click(ui("instance-row-14-eye")),
        Wait(5),
        RightClick(ui("instance-row-3")),
        WaitFor("asm-zoom-selection"),
        Click(ui("asm-zoom-selection")),
        Wait(30),
        Key("Escape"),
        Wait(3),
        Click(at(262, 100)),
        Wait(3),
        // The six hole edges (their outer points on the plate's top face, z 6.625 in).
        Click(xyz(17.348, 0.0, 168.275)),
        Wait(3),
        Click(xyz(8.674, 15.024, 168.275)),
        Wait(3),
        Click(xyz(-8.674, 15.024, 168.275)),
        Wait(3),
        Click(xyz(-17.348, 0.0, 168.275)),
        Wait(3),
        Click(xyz(-8.674, -15.024, 168.275)),
        Wait(3),
        Click(xyz(8.674, -15.024, 168.275)),
        Wait(3),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("01-six-hole-edges-selected"),
        // A19.1: the Standard content tab.
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(3),
        Click(ui("insert-source-2")),
        Wait(10),
        Click(ui("std-size")),
        Wait(5),
        Screenshot("02-a19.1-standard-content-size-list"),
        // A19.2: a wrong size, then Auto-size from the selected holes.
        Click(ui("std-size-option-9")),
        Wait(5),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02a-a19.2-size-wrong-1-2-20"),
        Click(ui("std-autosize")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02b-a19.2-auto-size-1-4-20"),
        Click(ui("std-size")),
        Wait(3),
        Click(ui("std-size-option-1")),
        Wait(5),
        Click(ui("std-material")),
        Wait(3),
        Click(ui("std-material-option-1")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("03-a19.3-hex-cap-screw-1-4-28"),
        // A19.6: one on each selected hole.
        Click(ui("std-insert")),
        Wait(15),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("04-a19.6-six-screws-inserted"),
        Click(ui("insert-dialog-accept")),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("05-a19.8-standard-content-rows"),
        // Auto-size from a rod (A19.2), then stacking (A19.7), with the rods shown.
        Click(at(262, 100)),
        Wait(3),
        Key("F"),
        Wait(30),
        Scroll(xyz(0.0, 0.0, 165.1), 3),
        Wait(20),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(3),
        Click(ui("insert-source-2")),
        Wait(10),
        Click(ui("std-category")),
        Wait(3),
        Click(ui("std-category-option-1")),
        Wait(5),
        Click(ui("std-autosize")),
        Wait(5),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06a-a19.2-nut-auto-size-armed"),
        // A rod's top edge: a Ø0.375 shaft.
        Click(xyz(27.498, 20.762, 177.8)),
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06b-a19.2-nut-auto-size-3-8-16"),
        // The Top Cap's rod-hole edge, its rod shown.
        Click(xyz(27.498, 27.498, 165.1)),
        Wait(3),
        Click(ui("std-insert")),
        Wait(15),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06-hex-nut-on-the-rod-hole"),
        Click(ui("std-category")),
        Wait(3),
        Click(ui("std-category-option-2")),
        Wait(5),
        Click(ui("std-size")),
        Wait(3),
        Click(ui("std-size-option-4")),
        Wait(5),
        Click(ui("std-insert-closest")),
        Wait(15),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-a19.7-washer-closest-nut-moves-up"),
        Click(ui("std-insert-furthest")),
        Wait(15),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08-a19.7-washer-furthest-on-top"),
        // Single placement (A19.5): ✓ (which clears the selection), then Insert again with
        // nothing selected.
        Click(ui("insert-dialog-accept")),
        Wait(10),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(3),
        Click(ui("insert-source-2")),
        Wait(10),
        Click(ui("std-category")),
        Wait(3),
        Click(ui("std-category-option-2")),
        Wait(5),
        Click(ui("std-size")),
        Wait(3),
        Click(ui("std-size-option-4")),
        Wait(5),
        Click(ui("std-insert")),
        Wait(5),
        Hover(xyz(-27.498, 27.498, 165.1)),
        Wait(10),
        Screenshot("09-a19.5-washer-on-hover"),
        Key("A"),
        Wait(10),
        Screenshot("10-a19.5-a-flips"),
        Key("A"),
        Wait(5),
        Click(xyz(-27.498, 27.498, 165.1)),
        Wait(15),
        Key("Escape"),
        Wait(3),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("11-a19.5-placed"),
        Click(ui("insert-dialog-accept")),
        Wait(10),
        // ISO 4762: the socket head cap screw's hex socket, in the preview's end view, and on the
        // screw placed on a free rod hole (single placement).
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(3),
        Click(ui("insert-source-2")),
        Wait(10),
        Click(ui("std-standard")),
        Wait(3),
        Click(ui("std-standard-option-1")),
        Wait(10),
        Click(ui("std-size")),
        Wait(3),
        Click(ui("std-size-option-6")),
        Wait(10),
        Click(ui("std-insert")),
        Wait(5),
        Hover(xyz(-22.117, -28.446, 165.1)),
        Wait(15),
        Screenshot("12-iso-4762-hex-socket"),
        Key("Escape"),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(10),
    ],
)
