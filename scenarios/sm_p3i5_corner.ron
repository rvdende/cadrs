// Corner (P3I.5, SM7): a cross-shaped plate (Thicken, 2 mm) with its four flaps bent down by four
// Bends (Hold line): where two bends of the base meet are its corners, with the model's Simple
// corner relief; Corner 1 picked at the (10, 10) corner sets Round – Sized, 8 mm diameter, for
// that corner only (viewed from below).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top poly 10 0 90 0 90 10 100 10 100 50 90 50 90 60 10 60 10 50 0 50 0 10 10 10"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(50, 30, 0)),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Custom("sketch top chain 10 -8 10 68 chain 90 -8 90 68 chain -8 10 108 10 chain -8 50 108 50"),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(40),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Wait(10),
        Click(xyz(10, -6, 0)),
        Wait(30),
        Click(ui("sm-bend-alignment")),
        Wait(5),
        Click(ui("sm-bend-alignment-option-1")),
        Wait(20),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Wait(30),
        // The Bend hid Sketch 2 (its line's sketch), as Onshape does: shown again for the next.
        Hover(ui("feature-sketch-2")),
        Wait(5),
        Click(ui("feature-sketch-2-visibility")),
        Wait(20),
        Click(ui("sheet-metal-model-caret")),
        Wait(40),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Wait(10),
        Click(xyz(90, -6, 0)),
        Wait(30),
        Click(ui("sm-bend-alignment")),
        Wait(5),
        Click(ui("sm-bend-alignment-option-1")),
        Wait(20),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Wait(30),
        // The Bend hid Sketch 2 (its line's sketch), as Onshape does: shown again for the next.
        Hover(ui("feature-sketch-2")),
        Wait(5),
        Click(ui("feature-sketch-2-visibility")),
        Wait(20),
        Click(ui("sheet-metal-model-caret")),
        Wait(40),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Wait(10),
        Click(xyz(-6, 10, 0)),
        Wait(30),
        Click(ui("sm-bend-alignment")),
        Wait(5),
        Click(ui("sm-bend-alignment-option-1")),
        Wait(20),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Wait(30),
        // The Bend hid Sketch 2 (its line's sketch), as Onshape does: shown again for the next.
        Hover(ui("feature-sketch-2")),
        Wait(5),
        Click(ui("feature-sketch-2-visibility")),
        Wait(20),
        Click(ui("sheet-metal-model-caret")),
        Wait(40),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Wait(10),
        Click(xyz(-6, 50, 0)),
        Wait(30),
        Click(ui("sm-bend-alignment")),
        Wait(5),
        Click(ui("sm-bend-alignment-option-1")),
        Wait(20),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Wait(30),
        Custom("view 30 -35 50 30 -5 0.11"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-tray-simple-corners"),
        Click(ui("sheet-metal-model-caret")),
        Wait(40),
        Click(ui("sheet-metal-menu-corner")),
        WaitFor("sheet-metal-corner-dialog"),
        Wait(10),
        Click(xyz(14, 14, 2)),
        Wait(20),
        Click(ui("sm-corner-type")),
        Wait(5),
        Click(ui("sm-corner-type-option-2")),
        Wait(20),
        Click(ui("sm-corner-size-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        Wait(30),
        Custom("view 30 -35 10 10 -5 0.04"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-round-sized-corner"),
        Click(ui("sheet-metal-corner-dialog-accept")),
        Wait(30),
        Custom("view 30 -35 50 30 -5 0.11"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
        // Close up: the round relief's sides follow its circle, no facet lines.
        Custom("view 30 -35 90 10 -3 0.02"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-round-relief-close-up"),
        Custom("view 30 -35 10 50 -3 0.02"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04b-close-up"),
    ],
)
