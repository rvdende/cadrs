// Corner (P3I.5, SM7): an open box by Convert of a 100 × 60 × 20 block (top face excluded, the four
// bottom edges bent; thickness 2, radius 3): Simple corner reliefs; Corner 1 picked at the back right
// corner sets Round – Sized with an 8 mm diameter for that corner only.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 100 60"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(50, 30, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("20"),
        Key("Tab"),
        Wait(30),
        Click(ui("extrude-dialog-accept")),
        Wait(30),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sm-bend-radius-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("3"),
        Key("Tab"),
        Wait(30),
        Click(ui("sm-parts-field")),
        Wait(3),
        Click(xyz(50, 30, 20)),
        Wait(40),
        Click(ui("sm-exclude-field")),
        Wait(3),
        Click(xyz(50, 30, 20)),
        Wait(10),
        Click(ui("sm-bends-field")),
        Wait(3),
        Click(xyz(50, 0, 0)),
        Wait(5),
        Click(xyz(100, 30, 0)),
        Wait(5),
        Click(xyz(50, 60, 0)),
        Wait(5),
        Click(xyz(0, 30, 0)),
        Wait(40),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(40),
        Custom("view 30 30 100 60 0 0.1"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-open-box-simple-corners"),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-corner")),
        WaitFor("sheet-metal-corner-dialog"),
        Wait(10),
        Click(xyz(97, 62, 5)),
        Wait(20),
        Click(ui("sm-corner-type")),
        Wait(5),
        Click(ui("sm-corner-type-option-2")),
        Wait(20),
        Click(ui("sm-corner-size-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        Wait(30),
        Custom("view 30 30 100 60 10 0.05"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-round-sized-corner"),
        Click(ui("sheet-metal-corner-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
    ],
)
