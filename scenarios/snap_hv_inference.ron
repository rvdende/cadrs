// M5: horizontal/vertical and alignment inference (reference/onshape/inference.md, NOTES.md).
// A line drawn 3 px off horizontal snaps horizontal with the "—" glyph, the next one vertical
// with "|". The next segment of a chain snaps perpendicular to the previous one; a hovered line
// wakes and a new line snaps parallel to it (the reference line orange, the new one dotted, "∥"
// at the cursor); a line leaving an arc's end snaps tangent. Hovering a point wakes it: a new line's end then aligns with it, with a dotted guide
// and the "|" glyph. Holding Shift suppresses all inference (and no constraint is created). A
// rectangle gets Onshape's automatic constraints: "⊥ —" on one side, "∥" on two, coincident
// corners (compare screens/12a). With "Show constraints" unchecked only the hovered entity's
// glyphs show. Finally a hovered rectangle corner wakes, and a point level with it far to the
// left aligns horizontally with it (dotted guide and "—").
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("L"),
        ClickWorld(-90, 40),
        MoveWorld(-40, 40.8),
        Wait(2),
        Screenshot("01-near-horizontal-snaps"),
        ClickWorld(-40, 40.8),
        MoveWorld(-39.4, 5),
        Wait(2),
        Screenshot("02-near-vertical-snaps"),
        ClickWorld(-39.4, 5),
        Key("Escape"),
        ClickWorld(-20, -40),
        MoveWorld(-89.8, 40.2),
        Wait(2),
        Screenshot("03-hover-wakes-point"),
        MoveWorld(-89.4, -5),
        Wait(2),
        Screenshot("04-aligned-with-woken-point"),
        KeyDown("Shift"),
        MoveWorld(-89.5, -5.2),
        Wait(2),
        Screenshot("05-shift-suppresses-inference"),
        ClickWorld(-89.5, -5.2),
        KeyUp("Shift"),
        Key("Escape"),
        MoveWorld(20, -32),
        ClickWorld(20, -22),
        ClickWorld(50, -7),
        MoveWorld(43.4, 7),
        Wait(2),
        Screenshot("06-perpendicular-to-previous-segment"),
        ClickWorld(43.4, 7),
        Key("Escape"),
        MoveWorld(27.5, -18.1),
        Wait(2),
        ClickWorld(20, -42),
        MoveWorld(50.3, -27.2),
        Wait(2),
        Screenshot("07-parallel-to-woken-line"),
        ClickWorld(50.3, -27.2),
        Key("Shift+A"),
        MoveWorld(70, -47),
        Wait(2),
        ClickWorld(70, -47),
        MoveWorld(61.5, -65.1),
        Wait(2),
        Screenshot("08-tangent-to-arc"),
        ClickWorld(61.5, -65.1),
        Key("Escape"),
        Key("G"),
        ClickWorld(5, 20),
        ClickWorld(55, 50),
        Key("Escape"),
        Key("Escape"),
        MoveWorld(100, -40),
        Wait(3),
        Screenshot("09-rectangle-auto-constraints"),
        Click(ui("sketch-show-constraints")),
        MoveWorld(25, 50.3),
        Wait(3),
        Screenshot("10-show-constraints-off-hovered-edge-only"),
        Key("L"),
        MoveWorld(55.3, 50.2),
        Wait(2),
        MoveWorld(-60, 50.6),
        Wait(2),
        Screenshot("11-horizontal-alignment-with-woken-point"),
    ],
)
