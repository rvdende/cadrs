// Onshape import: the Derived feature (since the merge with phase3c, the P3G.4 Derived dialog,
// `derived_ui`). The Control Arm (the course's two extrudes) in Part Studio 1, then Part
// Studio 2 derives its parts.
// 01 Part Studio 2, Derived (toolbar) → Current document → Part Studio 1 picked: the source
//    card, Derive: Part Studio (everything), Locations, Placement, Include mate connectors.
// 02 Part Studio unticked, Part 1 ticked: only Part 1 comes in.
// 03 accepted: Derived 1 in the feature list with its icon, the part in the Parts list with
//    the source's name.
// 04 the source studio changed (Part 1 renamed Arm): the derived part follows.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("control-arm"),
        Key("F"),
        Click(ui("insert-tab")),
        WaitFor("create-part-studio"),
        Click(ui("create-part-studio")),
        Click(ui("derived")),
        WaitFor("derived-dialog"),
        Click(ui("derived-studio-part-studio-1")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-derived-all-parts"),
        Click(ui("derived-all-checkbox")),
        Click(ui("derived-part-part-1-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-derived-one-part"),
        Click(ui("derived-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
        Click(ui("tab-part-studio-1")),
        Custom("rename-part Part 1 = Arm"),
        Click(ui("tab-part-studio-2")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-source-renamed"),
    ],
)
