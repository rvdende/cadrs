// M3: create and accept Sketch 1 on Top, rotate the view, then double-click Sketch 1 in the
// feature list: the dialog reopens with "Top plane" filled. Clear the plane with its ✕, pick
// Front instead and accept. Ctrl+Z undoes the whole edit, so the sketch is back on Top
// (reopened to show the field).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        RightDrag(at(1300, 700), at(1220, 730)),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("01-accepted-and-rotated"),
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-edit-dialog-top-plane"),
        Click(ui("sketch-plane-field-clear")),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("03-plane-cleared"),
        Click(ui("feature-front")),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("04-front-plane-selected"),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        Key("Ctrl+Z"),
        Wait(3),
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("05-undo-restores-top"),
        Key("Escape"),
        Wait(3),
        Screenshot("06-edit-closed"),
    ],
)
