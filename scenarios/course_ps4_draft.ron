// P3.10 / PS4.9, X3: Draft, as a feature and as the extrude's option (values asserted in
// `cadrs_core/tests/part_studio_options.rs`: `draft_feature_on_a_cube`, `extrude_with_draft`;
// the kernel's `draft_cube_sides`).
// 01 PS4.9 the Draft dialog (the toolbar's Draft): Neutral plane | Parting line, Neutral plane =
//    Top (picked in the feature list), the 100³ cube's four sides picked (two in the Isometric
//    view, two from behind), Draft angle 5°: the preview narrows as it rises from Top; the faces
//    to draft are tinted amber on the drafted body (P3.11, P3.10 judge; they keep their names
//    through the draft now) and outlined where they were before it.
// 02 accepted ("Draft 1" in the list); Mass properties: the frustum h(a² + ab + b²)/3 with
//    a = 100, b = 100 − 200·tan 5°: 835 228.361 mm³.
// 03 X3 the extrude's Draft: a Ø40 circle beside it extruded 30 mm with Draft 5° (the angle
//    inline on its row, with its flip): the cone frustum narrowing up.
// 04 the Draft's Opposite direction: the sides lean out instead.
// 05 the Up to face end, the drafted cube's top picked, with the Offset distance 5 mm inline on
//    its checkbox row (P3.8 judge) and no Symmetric (it only splits a depth): the drafted boss
//    (narrowing again) stops 5 mm under the cube's top, 95 mm up (P3.10 judge: built, not just
//    the empty field's error).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 100"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(50, 50, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("100"),
        Key("Enter"),
        Key("F"),
        Click(ui("draft")),
        WaitFor("draft-dialog"),
        Click(ui("feature-top")),
        Click(xyz(100, 50, 50)),
        Click(xyz(50, 0, 50)),
        Custom("view -135 30"),
        Click(xyz(0, 50, 50)),
        Click(xyz(50, 100, 50)),
        Key("Shift+7"),
        Click(ui("draft-angle-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-draft-neutral-top-four-sides-5deg"),
        Click(ui("draft-dialog-accept")),
        Click(ui("part-row-part-1")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-accepted-mass-frustum"),
        Key("Escape"),
        Key("Escape"),
        Custom("sketch top circle 200 50 20"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(200, 50, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        Click(ui("extrude-draft-checkbox")),
        Click(ui("extrude-draft-angle-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-extrude-draft-5deg"),
        Click(ui("extrude-draft-angle-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-extrude-draft-flipped"),
        Click(ui("extrude-draft-angle-flip")),
        Click(ui("extrude-end-type")),
        Click(ui("extrude-end-type-option-2")),
        Click(xyz(50, 50, 100)),
        Click(ui("extrude-offset-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-up-to-face-offset-inline-no-symmetric"),
    ],
)
