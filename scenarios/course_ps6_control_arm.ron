// P3.3 / PS6: the course's Control Arm exercise (intro-to-part-studios.md PS6, screenshots
// ex1-step1..6), step by step.
// 01 (ex1-step1) the document menu with Workspace units… (millimetres); the document and its
//    Part Studio are renamed "Control Arm" and the Assembly tab deleted (02).
// 03 (ex1-step2) Sketch 1 on Top, drawn through the tools and fully defined (black): the hub
//    Ø70 with its Ø35 bore and the centre-point 45 × 10 keyway, the left eye Ø35 with its Ø20
//    hole, a vertical construction centreline, the right eye and hole drawn undimensioned and
//    made Symmetric to the left ones (which sizes them), the four webs on the circles and made
//    Tangent, the left eye Horizontal with the origin, and the 250 overall (far side to far
//    side of the eyes). The planes are hidden (P), as in ex1-step3..6. Zoom to fit (F) after
//    the sketch, in each Extrude dialog and after each extrude frames the whole arm, beside a
//    dialog when one is open.
// 04 (ex1-step3) Extrude 1, Solid / New, Blind 40 mm: the hub ring, the right web and the right
//    eye ring, three "Face of Sketch 1" rows, the preview in the isometric view.
// 05 Extrude 1 accepted: Sketch 1 is hidden (greyed in the list), Part 1.
// 06 (ex1-step4) hovering Sketch 1's row shows its eye; its tooltip reads "Show Sketch 1".
// 07 (ex1-step4) the eye clicked (Sketch 1 shown), Extrude 2 on the left web and eye ring:
//    Add is picked by itself (its body touches Part 1), Blind 25 mm, "Merge with all" below;
//    Part 1 stays opaque, the added body is the translucent preview with the regions' orange
//    outlines, and the shown sketch is hidden behind the part.
// 08 Extrude 2 accepted: one part, the 15 mm step where the hub meets the left web; Sketch 1
//    hidden again.
// 09 (ex1-step5) right-clicking Part 1 in the Parts list: the menu, Rename first.
// 10 Rename → "Control Arm".
// 11 (ex1-step6) the part selected, Mass and section properties: the part's name in red (no
//    material), Volume 368749.705 mm³, Surface area 50179.711 mm² (the course's self-check,
//    50 179.71); the centre of mass rows stay blank without a material, as in ex1-step6.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        // Step 1: workspace units, names, tabs.
        Click(ui("document-menu")),
        WaitFor("document-menu-popup"),
        Wait(3),
        Hover(ui("document-menu-units")),
        Wait(3),
        Screenshot("01-document-menu-workspace-units"),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        Wait(5),
        Click(ui("units-ok")),
        Wait(5),
        Click(ui("document-name")),
        Wait(3),
        Key("Ctrl+A"),
        Type("Control Arm"),
        Key("Enter"),
        Wait(3),
        DoubleClick(ui("tab-part-studio-1")),
        Wait(3),
        Key("Ctrl+A"),
        Type("Control Arm"),
        Key("Enter"),
        Wait(3),
        RightClick(ui("tab-assembly-1")),
        WaitFor("tab-delete"),
        Click(ui("tab-delete")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-renamed-assembly-deleted"),
        // Step 2: the sketch on Top, drawn with the tools (planes hidden, P).
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("P"),
        Wait(3),
        MoveTo(913, 520),
        Key("Z"),
        Wait(10),
        Key("Z"),
        Wait(10),
        // The hub Ø70, its bore Ø35, the eyes Ø35 with their holes Ø20.
        Key("C"),
        Wait(2),
        ClickWorld(0, 0),
        KeyDown("Shift"),
        ClickWorld(35, 0),
        KeyUp("Shift"),
        Wait(3),
        Type("70"),
        Key("Enter"),
        Wait(3),
        ClickWorld(0, 0),
        KeyDown("Shift"),
        ClickWorld(17.5, 0),
        KeyUp("Shift"),
        Wait(3),
        Type("35"),
        Key("Enter"),
        Wait(3),
        KeyDown("Shift"),
        ClickWorld(-107.5, 0),
        ClickWorld(-90, 0),
        KeyUp("Shift"),
        Wait(3),
        Type("35"),
        Key("Enter"),
        Wait(3),
        ClickWorld(-107.5, 0),
        KeyDown("Shift"),
        ClickWorld(-97.5, 0),
        KeyUp("Shift"),
        Wait(3),
        Type("20"),
        Key("Enter"),
        Wait(3),
        // The right eye and its hole, not dimensioned: Symmetric sizes them.
        KeyDown("Shift"),
        ClickWorld(107.5, 0),
        ClickWorld(123, 0),
        KeyUp("Shift"),
        Wait(3),
        ClickWorld(107.5, 0),
        KeyDown("Shift"),
        ClickWorld(116, 0),
        KeyUp("Shift"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        // The vertical construction centreline from the origin.
        Key("Q"),
        Key("L"),
        Wait(2),
        ClickWorld(0, 0),
        ClickWorld(0, 35),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Key("Q"),
        Wait(2),
        // Symmetric about the centreline: the eyes, then their holes (the right ones take the
        // left ones' sizes, as in ex1-step2).
        Key("Shift+Q"),
        Wait(2),
        Click(world(0, 25)),
        Click(world(-107.5, 17.5)),
        Click(world(107.5, 15.5)),
        Wait(3),
        Click(world(0, 25)),
        Click(world(-107.5, 10)),
        Click(world(107.5, 8.5)),
        Wait(3),
        Key("Escape"),
        Wait(2),
        // The keyway: a centre-point rectangle 45 × 10 on the origin.
        Key("R"),
        Wait(2),
        ClickWorld(0, 0),
        ClickWorld(22.5, 5),
        Wait(3),
        Type("45"),
        Key("Enter"),
        Wait(3),
        Type("10"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        // The webs: four lines from the hub to the eyes.
        Key("L"),
        Wait(2),
        ClickWorld(5.700, 34.533),
        ClickWorld(110.349, 17.267),
        Wait(2),
        Key("Escape"),
        Wait(2),
        ClickWorld(5.700, -34.533),
        ClickWorld(110.349, -17.267),
        Wait(2),
        Key("Escape"),
        Wait(2),
        ClickWorld(-5.700, 34.533),
        ClickWorld(-110.349, 17.267),
        Wait(2),
        Key("Escape"),
        Wait(2),
        ClickWorld(-5.700, -34.533),
        ClickWorld(-110.349, -17.267),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        // Tangent: each web to the hub and to its eye (the tool, then the pairs).
        Key("T"),
        Wait(2),
        Click(world(58, 25.9)),
        Click(world(-24.75, 24.75)),
        Wait(2),
        Click(world(58, 25.9)),
        Click(world(95.13, 12.37)),
        Wait(2),
        Click(world(58, -25.9)),
        Click(world(-24.75, -24.75)),
        Wait(2),
        Click(world(58, -25.9)),
        Click(world(95.13, -12.37)),
        Wait(2),
        Click(world(-58, 25.9)),
        Click(world(24.75, 24.75)),
        Wait(2),
        Click(world(-58, 25.9)),
        Click(world(-95.13, 12.37)),
        Wait(2),
        Click(world(-58, -25.9)),
        Click(world(24.75, -24.75)),
        Wait(2),
        Click(world(-58, -25.9)),
        Click(world(-95.13, -12.37)),
        Wait(2),
        Key("Escape"),
        Wait(2),
        // The left eye horizontal with the origin.
        Click(world(-107.5, 0)),
        Wait(2),
        Click(world(0, 0)),
        Wait(2),
        Key("H"),
        Wait(3),
        // Move the hole's Ø20 label clear of the Ø35 one.
        DragWorld(-89, 20.5, -132, -30),
        Wait(3),
        // The overall length, 250.
        Key("D"),
        Wait(2),
        Click(world(-125, 0)),
        Click(world(125, 0)),
        MoveWorld(0, -70),
        Wait(2),
        Click(world(0, -70)),
        Wait(3),
        Type("250"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-sketch-fully-defined"),
        Click(ui("sketch-dialog-accept")),
        Wait(5),
        // Step 3: Extrude 1, New, Blind 40.
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Key("F"),
        Wait(40),
        Click(xyz(0, 26, 0)),
        Wait(3),
        Click(xyz(60, 0, 0)),
        Wait(3),
        Click(xyz(121.5, 0, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("40"),
        Click(ui("extrude-dialog-title")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-extrude-1-new-blind-40"),
        Key("Enter"),
        Wait(5),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-part-1-sketch-hidden"),
        // Step 4: show Sketch 1 again (its eye), Extrude 2, Add, Blind 25.
        Hover(ui("feature-sketch-1")),
        Wait(3),
        Hover(ui("feature-sketch-1-visibility")),
        Wait(60),
        Screenshot("06-eye-show-sketch-1"),
        Click(ui("feature-sketch-1-visibility")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Key("F"),
        Wait(40),
        Click(xyz(-60, 0, 0)),
        Wait(5),
        Click(xyz(-94.5, 0, 0)),
        Wait(5),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("25"),
        Click(ui("extrude-dialog-title")),
        Wait(8),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-extrude-2-add-picked-by-itself"),
        Key("Enter"),
        Wait(5),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-one-part-sketch-hidden-again"),
        // Step 5: Parts list → right-click → Rename.
        RightClick(ui("part-row-part-1")),
        WaitFor("part-rename"),
        Hover(ui("part-rename")),
        Wait(3),
        Screenshot("09-part-context-menu"),
        Click(ui("part-rename")),
        WaitFor("part-rename"),
        Wait(3),
        Type("Control Arm"),
        Key("Enter"),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-renamed-control-arm"),
        // Step 6: select the part (a click on empty space clears the selection first), then Mass
        // and section properties.
        ClickAt(1420, 900),
        Wait(3),
        Click(ui("part-row-control-arm")),
        Wait(3),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Wait(5),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-mass-properties"),
    ],
)
