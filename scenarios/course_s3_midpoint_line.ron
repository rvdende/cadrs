// T3 / S3.2: "Midpoint line: the first click is the midpoint, and the line grows symmetrically
// in both directions." (`reference/onshape/entity_tools/midpoint-line-01.png`) Line ▾ lists
// Midpoint line. The first click on the origin sets the middle; the preview grows both ways
// with its whole length; the second click places it, with a Midpoint constraint at the origin,
// and its length box: 80 typed keeps the middle on the origin. A second midpoint line, level
// with its middle, is inferred horizontal.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Click(ui("sketch-line-caret")),
        WaitFor("sketch-variant-midpoint-line"),
        Screenshot("01-line-menu"),
        Click(ui("sketch-variant-midpoint-line")),
        ClickWorld(0, 0),
        MoveWorld(20, 10),
        MoveWorld(35, 25),
        Wait(3),
        Screenshot("02-grows-both-ways"),
        ClickWorld(35, 25),
        Screenshot("03-placed-length-box"),
        Type("80"),
        Key("Enter"),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04-length-80-midpoint-at-origin"),
        ClickWorld(-20, -40),
        MoveWorld(0, -40),
        MoveWorld(25, -40),
        Wait(3),
        Screenshot("05-horizontal-inference"),
        ClickWorld(25, -40),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("06-two-midpoint-lines"),
    ],
)
