// P3I.8 / SM18 (lesson `18-sheet-metal-and-top-down-design`, t0044–t0092) through the dialogs, on
// the Heating Mantle master (`fixtures/sheetmetal/sm_topdown_master.cadrs`: the T-notched Space
// Envelope, Side Profile and Front Cutouts, in its own studio, and an empty Part Studio 1; `samples::sheetmetal_topdown` builds the
// same steps, `cadrs_core/tests/sheetmetal_topdown.rs` checks them).
// 01 the Space Envelope master in its studio.
// 02 Part Studio 1, Insert → Derived: Space Envelope at the workspace (t0044.7).
// 03 Sheet metal model → Convert: the derived part, Faces to exclude the top and the angled face,
//    eight bends (the bottom under the sides, the back and the tongue's front; the notch walls
//    and the tongue's sides at their outside corners), Keep input parts (the input translucent,
//    the folded enclosure round it), 1.5 mm, R1.5 (t0055.8).
// 04 accepted; the part renamed "Enclosure".
// 05 Sheet metal model → Thicken of the top and the angled face, the edge between them bent
//    (t0071.0).
// 06 accepted; the part renamed "Cover", the two models renamed "Enclosure" and "Cover": the
//    context dropdown lists them by those names (t0091.2).
// 07 the Enclosure's flat; 08 the Cover's flat.
// 09 Space Envelope tab: Extrude 1 edited through its dialog, depth 150 → 180 (the enclosure
//    wider, as the lesson does).
// 10 Part Studio 1: both parts followed through Derived; 11 the Enclosure's flat 30 wider; 12 the
//    Cover's flat 30 longer.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("fixture sheetmetal/sm_topdown_master"),
        Click(ui("tab-space-envelope")),
        Custom("view 35 30 100 0 60 0.3"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-space-envelope-master"),
        // Derived 1.
        Click(ui("tab-part-studio-1")),
        Click(ui("rail-insert")),
        WaitFor("derived-dialog"),
        Click(ui("derived-studio-space-envelope")),
        Custom("view 35 30 100 0 60 0.3"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-derived-space-envelope"),
        Click(ui("derived-dialog-accept")),
        // The Enclosure: Convert, the top and the angled face excluded, the bottom edges bent.
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-0")),
        Click(ui("sm-parts-field")),
        Click(xyz(125, -75, 40)),
        Click(ui("sm-exclude-field")),
        Click(xyz(100, 0, 120)),
        Click(xyz(180, 0, 100)),
        Click(ui("sm-bends-field")),
        // The bends as the lesson's flat has them (t0091.2): the bottom edges under the sides,
        // the back and the tongue's front, and the notch walls and the tongue's sides off their
        // neighbours at the outside corners; the notches' inside corners stay rips.
        Custom("view -45 -20 100 0 60 0.3"),
        Click(xyz(125, -75, 0)),
        Click(xyz(0, 0, 0)),
        Click(xyz(50, -75, 60)),
        Click(xyz(0, -35, 60)),
        Custom("view -135 -20 100 0 60 0.3"),
        Click(xyz(125, 75, 0)),
        Click(xyz(50, 75, 60)),
        Click(xyz(0, 35, 60)),
        Custom("view 135 -20 100 0 60 0.3"),
        Click(xyz(200, 0, 0)),
        Click(ui("sm-keep-input-checkbox")),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Tab"),
        Click(ui("sm-bend-radius-field")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Tab"),
        Click(ui("sheet-metal-model-dialog-title")),
        Custom("view 35 30 100 0 60 0.3"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-convert-exclude-bends-keep-input"),
        Click(ui("sheet-metal-model-dialog-accept")),
        RightClick(ui("part-row-part-1")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        Key("Ctrl+A"),
        Type("Enclosure"),
        Key("Enter"),
        ClickAt(1420, 900),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-enclosure"),
        // The Cover: Thicken of the top and the angled face, the edge between them bent.
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(ui("sm-faces-field")),
        Click(xyz(100, 0, 120)),
        Click(xyz(180, 0, 100)),
        Click(ui("sm-bends-field")),
        Click(xyz(160, 0, 120)),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Tab"),
        Click(ui("sm-bend-radius-field")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Tab"),
        Click(ui("sheet-metal-model-dialog-title")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-thicken-cover"),
        Click(ui("sheet-metal-model-dialog-accept")),
        RightClick(ui("part-row-part-2")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        Key("Ctrl+A"),
        Type("Cover"),
        Key("Enter"),
        // The models named after their parts (SM18.2).
        RightClick(ui("feature-sheet-metal-model-1")),
        WaitFor("feature-rename"),
        Click(ui("feature-rename")),
        Key("Ctrl+A"),
        Type("Enclosure"),
        Key("Enter"),
        RightClick(ui("feature-sheet-metal-model-2")),
        WaitFor("feature-rename"),
        Click(ui("feature-rename")),
        Key("Ctrl+A"),
        Type("Cover"),
        Key("Enter"),
        Click(ui("panel-sheet-metal")),
        Click(ui("smt-context")),
        MoveTo(1700, 300),
        Wait(3),
        Screenshot("06-contexts-named-after-features"),
        Click(ui("smt-context-option-0")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-enclosure-flat"),
        Click(ui("smt-context")),
        Click(ui("smt-context-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-cover-flat"),
        Click(ui("panel-sheet-metal")),
        // The master edited in its own studio, through Extrude 1's dialog.
        Click(ui("tab-space-envelope")),
        Wait(40),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("180"),
        Key("Tab"),
        Custom("view 35 30 100 0 60 0.3"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-master-extrude-180"),
        Click(ui("extrude-dialog-accept")),
        Click(ui("tab-part-studio-1")),
        Custom("view 35 30 100 0 60 0.3"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-both-follow"),
        Click(ui("panel-sheet-metal")),
        Click(ui("smt-context")),
        Click(ui("smt-context-option-0")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-enclosure-flat-wider"),
        Click(ui("smt-context")),
        Click(ui("smt-context-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-cover-flat-longer"),
    ],
)
