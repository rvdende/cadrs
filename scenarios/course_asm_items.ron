// P3B.8 / A1.7, X16 Items on the flange stand-in (`fixtures/flange_standin.cadrs`).
// 01 (A1.7) "Items (0)" between the instances and Loads, with its +.
// 02 + : the Add item dialog: Name "Thread locker", Quantity 2, Unit Liter, Part number TL-242
//    and Description "Medium strength" being typed.
// 03 ✓: "Items (1)", the row with "× 2".
// 04 A second item, "Label" × 7 (the header's menu: Add item…).
// 05 The row's menu: Edit…, Delete.
// 06 Edit…: the Label's quantity 7 -> 1.
// 07 (A1.7, A20) the Bill of Materials: Flange, Screw, then the two items with their
//    quantities (item numbers 3 and 4, the tag icon), and the Unit of measure column added
//    (Liter for the thread locker, Each for the rest).
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture flange_standin"),
        Click(ui("tab-flange-assembly")),
        Custom("view 25 35 0 0 0 0.16"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("01-a1.7-items-group"),
        Click(ui("assembly-items-add")),
        WaitFor("item-dialog"),
        Click(ui("item-name-field")),
        Key("Ctrl+A"),
        Type("Thread locker"),
        Click(ui("item-quantity-field")),
        Key("Ctrl+A"),
        Type("2"),
        Click(ui("item-unit-field")),
        Key("Ctrl+A"),
        Type("Liter"),
        Click(ui("item-part-number-field")),
        Key("Ctrl+A"),
        Type("TL-242"),
        Click(ui("item-description-field")),
        Key("Ctrl+A"),
        Type("Medium strength"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02-a1.7-add-item-dialog"),
        Click(ui("item-dialog-accept")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("03-a1.7-item-added"),
        RightClick(ui("assembly-items")),
        WaitFor("items-add"),
        Click(ui("items-add")),
        WaitFor("item-dialog"),
        Click(ui("item-name-field")),
        Key("Ctrl+A"),
        Type("Label"),
        Click(ui("item-quantity-field")),
        Key("Ctrl+A"),
        Type("7"),
        Click(ui("item-dialog-accept")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("04-a1.7-second-item"),
        RightClick(ui("item-row-2")),
        WaitFor("item-edit"),
        Hover(ui("item-edit")),
        Wait(3),
        Screenshot("05-a1.7-item-menu"),
        Click(ui("item-edit")),
        WaitFor("item-dialog"),
        Click(ui("item-quantity-field")),
        Key("Ctrl+A"),
        Type("1"),
        Click(ui("item-dialog-accept")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06-a1.7-item-edited"),
        Click(ui("panel-bom")),
        WaitFor("bom-panel"),
        // The Unit of measure column.
        Click(ui("bom-add-column")),
        Click(ui("bom-add-col-8")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-a1.7-items-in-bom"),
    ],
)
