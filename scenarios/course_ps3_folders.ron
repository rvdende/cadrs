// P3.9 / PS3.1–PS3.3: organising the feature list in folders, on the bracket stand-in (`bracket`
// set-up command; see course_ps3_filter).
// 01 (Default geometry closed, so the list fits) Fillet 1 and Fillet 2 selected in the list, right-click: the menu with "Add selection to
//    folder…" (PS3.1).
// 02 the new folder "Folder 1" holds them, open, its name ready to edit in place.
// 03 renamed "Finishing"; the chevron closes it (04: "Finishing (2)").
// 05 "Bosses" opened with its chevron: its features indented under it.
// 06 Extrude 11 dragged out of Bosses (mid-drag: the blue drop line above "Finishing", and a
//    ghost of the dragged row at the pointer, P3.11) (PS3.2); 07 dropped: it has left the folder
//    ("Bosses (10)"), still in history order.
// 08 Extrude 11 dragged onto the "Bosses" name: the whole folder row is outlined in blue (P3.11,
//    P3.9 judge: it was a line under the folder's last feature); 09 dropped: back in the folder,
//    at its end ("Bosses (11)").
// 10 right-click "Finishing": Rename, Open / close, Unpack folder, Delete folder and its
//    features; 11 Unpack folder: the fillets stay, the folder goes (PS3.3).
// 12 "Delete folder and its features" on Bosses: the bosses are gone from the list and the part
//    (PS3.3); 13 undone (Ctrl+Z).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("bracket"),
        Wait(10),
        Key("P"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        // Default geometry closed, so the whole list fits.
        Click(ui_at("feature-default-geometry", 0.05, 0.5)),
        Wait(3),
        Click(ui("feature-fillet-1")),
        Wait(2),
        Click(ui("feature-fillet-2")),
        Wait(2),
        RightClick(ui("feature-fillet-2")),
        WaitFor("feature-context-menu"),
        Wait(3),
        Hover(ui("feature-add-to-folder")),
        Wait(3),
        Screenshot("01-add-selection-to-folder-menu"),
        Click(ui("feature-add-to-folder")),
        Wait(5),
        Screenshot("02-new-folder-rename"),
        Key("Ctrl+A"),
        Type("Finishing"),
        Key("Enter"),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-renamed-finishing"),
        Click(ui_at("feature-folder-finishing", 0.06, 0.5)),
        Wait(5),
        Screenshot("04-finishing-closed"),
        Click(ui_at("feature-folder-bosses", 0.06, 0.5)),
        Wait(5),
        Screenshot("05-bosses-open"),
        Press(ui("feature-extrude-11")),
        Wait(2),
        Hover(ui_at("feature-extrude-11", 0.5, 1.5)),
        Wait(2),
        Hover(ui_at("feature-folder-finishing", 0.5, 0.1)),
        Wait(5),
        Screenshot("06-drag-out-of-folder"),
        Release,
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-left-the-folder"),
        Press(ui("feature-extrude-11")),
        Wait(2),
        Hover(ui_at("feature-extrude-11", 0.5, -0.5)),
        Wait(2),
        Hover(ui("feature-folder-bosses")),
        Wait(5),
        Screenshot("08-drag-onto-folder-name"),
        Release,
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-back-in-the-folder"),
        RightClick(ui("feature-folder-finishing")),
        WaitFor("folder-context-menu"),
        Wait(3),
        Hover(ui("folder-unpack")),
        Wait(3),
        Screenshot("10-folder-menu"),
        Click(ui("folder-unpack")),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-unpacked"),
        RightClick(ui("feature-folder-bosses")),
        WaitFor("folder-context-menu"),
        Wait(3),
        Click(ui("folder-delete")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-folder-deleted-with-features"),
        Key("Ctrl+Z"),
        Wait(10),
        Screenshot("13-undone"),
    ],
)
