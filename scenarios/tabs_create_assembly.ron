// M2: the bottom tab bar. + opens the Insert new tab menu; Create Assembly adds "Assembly 2"
// right of the active tab and opens its empty assembly shell. Double-click renames a tab in
// place; right-click opens the tab menu above the tab bar; Delete removes the tab at once (as
// Onshape does) and the toast's Undo brings it back.
Scenario(
    start: Some("landing"),
    steps: [
        Click(ui("create")),
        WaitFor("new-document"),
        Click(ui("new-document")),
        WaitFor("new-document-create"),
        Click(ui("new-document-create")),
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Hover(ui("create-assembly")),
        Wait(3),
        Screenshot("01-plus-menu"),
        Click(ui("create-assembly")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("02-assembly-2-created"),
        DoubleClick(ui("tab-assembly-2")),
        Wait(3),
        Screenshot("03-tab-rename-inline"),
        Type("Gearbox"),
        Key("Enter"),
        Wait(3),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("04-tab-renamed"),
        RightClick(ui("tab-gearbox")),
        WaitFor("tab-delete"),
        Hover(ui("tab-delete")),
        Wait(3),
        Screenshot("05-tab-context-menu"),
        Click(ui("tab-delete")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("06-tab-deleted-undo-toast"),
        Click(ui("toast-undo")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("07-delete-undone"),
        Click(ui("tab-part-studio-1")),
        Wait(3),
        Click(ui("insert-tab")),
        WaitFor("create-part-studio"),
        Click(ui("create-part-studio")),
        Wait(5),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("08-part-studio-2-created"),
    ],
)
