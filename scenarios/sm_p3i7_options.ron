// P3I.7 / SM16.1, SM16.3, SM16.5 (lesson `16-drawings`: t0024–t0041, t0091–t0114;
// `properties-flatpattern.png`): Create drawing of flat pattern from the Parts list, a projected
// view of the flat, the bend line and tangent edge options and the bend line pens.
// 01 Parts list → right-click the sheet metal part: Create drawing of flat pattern…;
// 02 the Create Drawing dialog (ANSI_A_MM.dwt); 03 OK: the new drawing opens with Insert view
//    armed with the flat (no browser); 04 the flat placed and a projected (edge-on) view of it;
// 04 its bend notes keep clear of each other at the corners; 05 the flat view's menu
//    (`t0112.3`: Show/hide, View orientation, Tangent edges, Adjust linestyle…, View properties…,
//    Order, Align view, Switch to, Move to sheet…, Copy, …), 05b View orientation; 06 its
//    Show/hide submenu; 07 bend lines hidden; 08 shown again, Tangent edges submenu (a new flat
//    view starts Hidden: clean chain lines); 09 tangent edges solid (close up of a bend);
//    10 phantom;
// 11 View properties: the Up/Down bend line pens; 12 down bend lines 0.50 mm red (as the help's
//    picture shows its up bends).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("flat-drawing box"),
        Wait(90),
        Key("F"),
        Wait(30),
        RightClick(ui("part-row-sheet-metal-box")),
        Wait(6),
        Hover(ui("part-flat-drawing")),
        Wait(4),
        Screenshot("01-parts-list-create-drawing-of-flat-pattern"),
        Click(ui("part-flat-drawing")),
        WaitFor("create-drawing-dialog"),
        Wait(8),
        Click(ui("template-row-ANSI_A_MM.dwt")),
        Wait(5),
        MoveTo(1400, 950),
        Wait(3),
        Screenshot("02-create-drawing-dialog"),
        Click(ui("create-drawing-ok")),
        Wait(30),
        Click(ui("insert-view-scale")),
        Wait(5),
        Click(ui("insert-view-scale-option-3")),
        Wait(5),
        MoveWorld(99, 135),
        Wait(40),
        MoveWorld(100, 135),
        Wait(10),
        Screenshot("03-insert-view-armed-with-the-flat"),
        ClickWorld(100, 135),
        Wait(30),
        MoveWorld(205, 135),
        Wait(30),
        MoveWorld(206, 135),
        Wait(10),
        ClickWorld(206, 135),
        Wait(30),
        Key("Escape"),
        Wait(5),
        ClickWorld(250, 200),
        Wait(5),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("04-flat-and-projected-view"),
        RightClick(world(85, 110)),
        Wait(6),
        Screenshot("05-flat-view-menu"),
        Hover(ui("flat-menu-orientation")),
        Wait(6),
        Screenshot("05b-view-orientation-submenu"),
        Hover(ui("flat-menu-show-hide")),
        Wait(6),
        Screenshot("06-show-hide-submenu"),
        Click(ui("flat-menu-bend-lines")),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("07-bend-lines-hidden"),
        RightClick(world(85, 110)),
        Wait(6),
        Hover(ui("flat-menu-show-hide")),
        Wait(6),
        Click(ui("flat-menu-bend-lines")),
        Wait(10),
        RightClick(world(85, 110)),
        Wait(6),
        Hover(ui("flat-menu-tangent-edges")),
        Wait(6),
        Screenshot("08-tangent-edges-submenu"),
        Click(ui("view-menu-tangent-solid")),
        Wait(10),
        Scroll(world(80, 122.5), 8),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("09-tangent-edges-solid"),
        RightClick(world(70, 135)),
        Wait(6),
        Hover(ui("flat-menu-tangent-edges")),
        Wait(6),
        Click(ui("view-menu-tangent-phantom")),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("10-tangent-edges-phantom"),
        Key("F"),
        Wait(10),
        RightClick(world(85, 110)),
        Wait(6),
        Click(ui("view-menu-properties")),
        WaitFor("view-properties-dialog"),
        Wait(5),
        Click(ui("view-props-down-weight")),
        Wait(5),
        Click(ui("view-props-down-weight-option-4")),
        Wait(5),
        Click(ui("view-props-down-color")),
        Wait(5),
        Click(ui("view-props-down-color-option-1")),
        Wait(5),
        Screenshot("11-view-properties-bend-lines"),
        Click(ui("view-props-ok")),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("12-down-bend-lines-red"),
    ],
)
