// P3C.7 / D2.10, X13: Export… from the drawing tab's menu, on the finished Ex1 drawing of the
// Universal Joint Flange stand-in (`Custom("ujoint-drawing")`: `cadrs_core::samples::ujoint_drawing`
// builds the drawing `course_drw_ex1_ujoint` makes through the UI). The files go to
// `target/exports/course_drw_export/` (typed into the Folder field).
// 01 the Ex1 drawing, as exported.
// 02 (ex1-step6, D2.10) the drawing tab's menu: Export… hovered.
// 03 the Export dialog: File name (the drawing's name), Format PDF, All sheets, Color, Folder.
// 04 DWG is disabled (no converter on PATH): its tooltip says what to install.
// 05 DXF chosen: no Colors row (a DXF has layers and linetypes), the Version (R2013 or R2000).
// 06 PNG chosen: Colors and Resolution (300 dpi).
// 07a PDF again; "crates" typed, Browse… opens the folder picker there (its subfolders);
//    07b Select folder fills the Folder field with it; 07c the scenario's folder typed; 08 Export: the toast names the PDF written.
// 09 Export… again: DXF, Current sheet; 10 its toast.
// 11 PNG at 150 dpi, black and white; 12 its toast.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("ujoint-drawing"),
        Wait(120),
        Key("F"),
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("01-ex1-drawing"),
        RightClick(ui("tab-universal-joint-flange-drawing")),
        WaitFor("tab-export"),
        Hover(ui("tab-export")),
        Wait(8),
        Screenshot("02-tab-menu-export"),
        Click(ui("tab-export")),
        WaitFor("drawing-export-dialog"),
        Wait(10),
        Hover(ui("drawing-export-format-pdf")),
        Wait(3),
        Screenshot("03-export-dialog-pdf"),
        Hover(ui("drawing-export-format-dwg")),
        Wait(50),
        Screenshot("04-dwg-disabled-tooltip"),
        Click(ui("drawing-export-format-dxf")),
        Wait(10),
        Screenshot("05-dxf-chosen-version"),
        Click(ui("drawing-export-format-png")),
        Wait(10),
        Screenshot("06-png-resolution"),
        Click(ui("drawing-export-format-pdf")),
        Wait(3),
        // Browse…: the folder picker starts at the typed folder ("crates", with stable
        // subfolders); Select folder takes the folder shown.
        Click(ui("drawing-export-folder")),
        Wait(3),
        Key("Ctrl+A"),
        Type("crates"),
        Wait(3),
        Click(ui("drawing-export-browse")),
        WaitFor("folder-picker"),
        WaitFor("folder-picker-row-cadrs_drawing"),
        Wait(5),
        Hover(ui("folder-picker-open")),
        Wait(5),
        Screenshot("07a-browse-folder-picker"),
        Click(ui("folder-picker-open")),
        Wait(8),
        Screenshot("07b-folder-chosen"),
        Click(ui("drawing-export-folder")),
        Wait(3),
        Key("Ctrl+A"),
        Type("target/exports/course_drw_export"),
        Wait(3),
        Hover(ui("drawing-export-ok")),
        Wait(5),
        Screenshot("07c-pdf-folder-typed"),
        Click(ui("drawing-export-ok")),
        WaitFor("export-toast"),
        MoveTo(1500, 960),
        Wait(10),
        Screenshot("08-pdf-exported"),
        // DXF, the current sheet.
        RightClick(ui("tab-universal-joint-flange-drawing")),
        WaitFor("tab-export"),
        Click(ui("tab-export")),
        WaitFor("drawing-export-dialog"),
        Wait(5),
        Click(ui("drawing-export-format-dxf")),
        Wait(3),
        Click(ui("drawing-export-sheets")),
        WaitFor("drawing-export-sheets-option-1"),
        Click(ui("drawing-export-sheets-option-1")),
        Wait(3),
        Click(ui("drawing-export-folder")),
        Wait(3),
        Key("Ctrl+A"),
        Type("target/exports/course_drw_export"),
        Wait(3),
        Hover(ui("drawing-export-sheets")),
        Wait(5),
        Screenshot("09-dxf-current-sheet"),
        Click(ui("drawing-export-ok")),
        MoveTo(1500, 960),
        Wait(20),
        Screenshot("10-dxf-exported"),
        // PNG, 150 dpi, black and white.
        RightClick(ui("tab-universal-joint-flange-drawing")),
        WaitFor("tab-export"),
        Click(ui("tab-export")),
        WaitFor("drawing-export-dialog"),
        Wait(5),
        Click(ui("drawing-export-format-png")),
        Wait(3),
        Click(ui("drawing-export-color")),
        WaitFor("drawing-export-color-option-1"),
        Click(ui("drawing-export-color-option-1")),
        Wait(3),
        Click(ui("drawing-export-dpi")),
        WaitFor("drawing-export-dpi-option-0"),
        Click(ui("drawing-export-dpi-option-0")),
        Wait(3),
        Click(ui("drawing-export-folder")),
        Wait(3),
        Key("Ctrl+A"),
        Type("target/exports/course_drw_export"),
        Wait(3),
        Hover(ui("drawing-export-ok")),
        Wait(5),
        Screenshot("11-png-black-and-white"),
        Click(ui("drawing-export-ok")),
        MoveTo(1500, 960),
        Wait(20),
        Screenshot("12-png-exported"),
    ],
)
