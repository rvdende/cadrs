// M8: save and reload. Create a document, sketch a dimensioned rectangle and a circle on Top
// (in the default view), move a dimension label, accept, add an Assembly tab and rename things,
// then go back to the documents page (the thumbnail shows the sketch) and reopen it: the
// reopened document (02) matches the one before closing (01) — geometry, constraints,
// dimensions and their label positions, tabs and names all survive. Editing the sketch again
// (04) shows the constraints and dimensions came back too.
Scenario(
    start: Some("landing"),
    steps: [
        Click(ui("create")),
        WaitFor("new-document"),
        Click(ui("new-document")),
        WaitFor("new-document-dialog"),
        Wait(3),
        Type("Round trip"),
        Key("Enter"),
        WaitFor("document-shell"),
        Wait(40),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("G"),
        ClickWorld(-10, -5),
        ClickWorld(38, 22),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("C"),
        ClickWorld(55, 40),
        ClickWorld(63, 40),
        Wait(3),
        Type("20"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Drag(world(15, -13.5), world(24, -21)),
        Wait(3),
        Key("Enter"),
        Wait(5),
        DoubleClick(ui("tab-part-studio-1")),
        Wait(3),
        Key("Ctrl+A"),
        Type("Plate"),
        Key("Enter"),
        Wait(5),
        MoveTo(1500, 900),
        Wait(70),
        Screenshot("01-before-closing"),
        Click(ui("back-to-documents")),
        WaitFor("doc-row-0"),
        Wait(10),
        MoveTo(1500, 900),
        Wait(3),
        Screenshot("02-documents-page-thumbnail-shows-sketch"),
        DoubleClick(ui("doc-name-0")),
        WaitFor("document-shell"),
        Wait(40),
        MoveTo(1500, 900),
        Wait(3),
        Screenshot("03-reopened-matches-01"),
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Wait(5),
        MoveTo(1500, 900),
        Wait(3),
        Screenshot("04-editing-after-reload"),
    ],
)
