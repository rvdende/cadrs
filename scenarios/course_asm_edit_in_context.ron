// P3B.9 / X15 Edit in context on the context stand-in (`fixtures/context_standin.cadrs`: in
// Assembly 1 a Base plate 140 × 90 × 10 mm with two Ø10 holes at x ±40, and a Cover plate
// 120 × 80 × 6 mm on top of it, fixed, with no holes yet).
// 01 Assembly 1: Base <1>, Cover <1> (fixed).
// 02 Cover <1>'s menu: Edit in context.
// 03 The Cover studio in the context of Assembly 1: the Base drawn translucent round the Cover
//    (context geometry), the bar "In context of Assembly 1 · Cover <1>".
// 04 New sketch on the Base's top face (a face of another instance): "Face of Base <1>".
// 05 Use (U) on the Base's two hole edges: two circles, linked to the context.
// 06 Extrude the two circles 6 mm, Remove: the Cover gets the Base's holes.
// 07 Back to assembly: the holes line up.
// 08 The Base moved 15 mm along X (triad arrow, typed): the Cover's holes don't follow yet.
// 09 In the Cover studio: the bar says "Assembly changed".
// 10 Update context: the context moves, and with it the sketch's circles and the holes.
// 11 Back in Assembly 1: the holes line up again.
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture context_standin"),
        Click(ui("tab-assembly-1")),
        Custom("view 25 35 0 0 0 0.16"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("01-x15-assembly"),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-edit-in-context"),
        Hover(ui("asm-edit-in-context")),
        Wait(3),
        Screenshot("02-x15-edit-in-context-menu"),
        Click(ui("asm-edit-in-context")),
        WaitFor("context-bar"),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("03-x15-cover-studio-in-context"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(65, 0, 0)),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("04-x15-sketch-on-context-face"),
        Key("N"),
        MoveTo(913, 520),
        Key("U"),
        ClickWorld(-35, 0),
        ClickWorld(45, 0),
        Key("Escape"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("05-x15-use-context-hole-edges"),
        Click(ui("sketch-dialog-accept")),
        Key("Shift+7"),
        Key("F"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        // The sketch's two circles (its row in the feature list: the whole sketch).
        Click(ui("feature-sketch-2")),
        Click(ui("extrude-operation-2")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Enter"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06-x15-holes-cut-from-context"),
        Key("Enter"),
        Click(ui("context-go")),
        WaitFor("context-go-menu-assembly"),
        Click(ui("context-go-menu-assembly")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-x15-assembly-holes-line-up"),
        Click(xyz(65, 0, 0)),
        Press(ui("triad-arrow-x")),
        Hover(xyz(70, 0, 0)),
        Wait(2),
        Hover(xyz(80, 0, 0)),
        Wait(3),
        Release,
        Wait(3),
        Type("15 mm"),
        Key("Enter"),
        Key("Escape"),
        ClickAt(1300, 250),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08-x15-base-moved-15mm"),
        Click(ui("tab-cover")),
        WaitFor("context-changed"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("09-x15-context-assembly-changed"),
        Click(ui("context-update")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("10-x15-context-updated-holes-follow"),
        Click(ui("context-go")),
        WaitFor("context-go-menu-assembly"),
        Click(ui("context-go-menu-assembly")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("11-x15-assembly-holes-line-up-again"),
    ],
)
