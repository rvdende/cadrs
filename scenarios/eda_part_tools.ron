// The component editors' bulk tools. 01 the pin table: four pins added on the left in one go
// ("1 ANT, 2 GND, 3 3.3V, 4 RESET"), four on the right; 02 the symbol arranged round a box;
// 03 the pad array dialog (eight pads down a column, 2 mm apart); 04 the column of pads; 05 a
// second column from pad 8 upwards, then renumbered counter-clockwise (1–16 like an IC).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-add-component")),
        WaitFor("pcb-name-edit"),
        Key("Ctrl+A"),
        Type("LoRa module"),
        Key("Enter"),
        Click(ui("pcb-part-lora-module")),
        WaitFor("sym-pin-table"),
        Click(ui("sym-pin-table")),
        WaitFor("eda-pin-table"),
        Click(ui("eda-pins-add-field")),
        Type("1 ANT, 2 GND, 3 3.3V, 4 RESET"),
        Click(ui("eda-pins-add-ok")),
        WaitFor("eda-pins-3-name"),
        Click(ui("eda-pins-add-field")),
        Type("5 NSS, 6 MOSI, 7 MISO, 8 SCK"),
        Click(ui("eda-pins-add-side")),
        Click(ui("eda-pins-add-side-option-1")),
        Click(ui("eda-pins-add-ok")),
        WaitFor("eda-pins-7-name"),
        Screenshot("01-pin-table"),
        Click(ui("eda-pins-ok")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Screenshot("02-symbol"),
        // The footprint: a pad, then an array of eight down a column.
        Click(ui("eda-mode-footprint")),
        WaitFor("fp-pad"),
        Custom("eda-zoom -10 -18 14 4"),
        Click(ui("fp-pad")),
        Click(flat(-8.0, 0.0)),
        Key("Escape"),
        Click(ui("fp-pad-array")),
        WaitFor("eda-pad-array"),
        Click(ui("eda-array-dx-field")),
        Key("Ctrl+A"),
        Type("0"),
        Click(ui("eda-array-dy-field")),
        Key("Ctrl+A"),
        Type("-2"),
        Screenshot("03-pad-array"),
        Click(ui("eda-array-ok")),
        MoveTo(1100, 900),
        Screenshot("04-column"),
        // A second column: one pad across from pad 8, arrayed upwards, then renumbered.
        Click(ui("fp-pad")),
        Click(flat(8.0, -14.0)),
        Key("Escape"),
        Click(ui("fp-pad-array")),
        WaitFor("eda-pad-array"),
        Click(ui("eda-array-count-field")),
        Key("Ctrl+A"),
        Type("8"),
        Click(ui("eda-array-dx-field")),
        Key("Ctrl+A"),
        Type("0"),
        Click(ui("eda-array-dy-field")),
        Key("Ctrl+A"),
        Type("2"),
        Click(ui("eda-array-ok")),
        Click(ui("fp-renumber")),
        WaitFor("eda-renumber"),
        Click(ui("eda-renumber-ok")),
        MoveTo(1100, 900),
        Screenshot("05-renumbered"),
    ],
)
