// P3H.5 (PCB6, the Board Exercise; PCB5.2–5.7, PCB9.7–9.8, X8, X9) on the stand-in phone case
// (`fixtures/phone_case_standin.cadrs`, `cadrs_core::samples::phone_case`: the Enclosure studio,
// 70 × 140 with a 2 mm wall and R10 corners, a Battery and an Antenna block; the Cell phone
// assembly with Group 1). Compare `ex1-step2-part-studio-in-context.png`,
// `v5-translate-board-incontext-poster.png`, `ex1-step10-sync-dialog.png`,
// `ex1-step11-synced-board-keepouts.png`, `ex1-step17-export-ecad-dialog.png`,
// `ex1-step18-exported-emn.png`, `ex1-goal-board.png`.
// 01 the Enclosure studio; 02 the Cell phone assembly;
// 03 (step 2) Display states ▾ → Create Part Studio in context; 04 the Origin of new Part Studio
//    dialog, the assembly Origin picked; 05 the new Part Studio with the assembly as context;
// 06 (steps 3–4) Sketch 1 on the battery's top face, Use of the cavity floor (the case's inner
//    outline), the battery's 4 edges and the antenna's 5;
// 07 (step 5) all three regions (picked in the view) extruded 0.062 mm up, New: the board;
// 08 (step 6) the battery and antenna regions extruded 1 mm down, New (Board hidden, Sketch 1
//    shown, as the course's tip says); 09 the parts renamed Board, Keep-out Battery, Keep-out
//    Antenna and the studio "Board & Keep out";
// 10 (step 7) Insert and go to Assembly with the three parts; 11 the assembly with them;
// 12 (step 8) Group 1 edited: the three added;
// 13 (step 9) a PCB Studio; 14 (step 10) the Sync dialog: Cell phone (Assembly), Top Plane;
// 15 (step 11) the board and its two keep-outs, "Not translated: Enclosure, Battery, Antenna";
// 16 (step 12) the Enclosure resized to 85 × 150; 17 (step 13) the board's Update context ▸
//    Board & Keep out; 18 (step 14) the board and keep-outs follow the case;
// 19 (step 15) the Sync dialog pre-filled for a re-sync; 20 (step 16) the board updated in place
//    (81 × 146, still one board);
// 21 (step 17) Export ECAD files, IDF 3.0; 22 the export toast ("Cell phone.zip");
// 23 (step 18) Cell phone.emn: the 9 outline points of the course.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("fixture phone_case_standin"),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("01-enclosure-studio"),
        Click(ui("tab-cell-phone")),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02-cell-phone-assembly"),
        // Step 2.
        Click(ui("display-states")),
        WaitFor("display-states-menu-in-context"),
        Hover(ui("display-states-menu-in-context")),
        Wait(5),
        Screenshot("03-create-part-studio-in-context-menu"),
        Click(ui("display-states-menu-in-context")),
        WaitFor("origin-dialog"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("04-origin-of-new-part-studio"),
        Click(ui("origin-dialog-accept")),
        WaitFor("context-bar"),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("05-part-studio-in-context"),
        // Steps 3–4: Sketch 1 on the battery's top face; Use the floor, the battery, the antenna.
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(0, -25, 7)),
        Key("N"),
        Key("U"),
        Hover(xyz(-22, 30, 2)),
        Wait(3),
        Click(xyz(-22, 30, 2)),
        Hover(xyz(0, -25, 7)),
        Wait(3),
        Click(xyz(0, -25, 7)),
        Hover(xyz(15, 57, 4)),
        Wait(3),
        Click(xyz(15, 57, 4)),
        Key("Escape"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06-sketch-use-cavity-battery-antenna"),
        Click(ui("sketch-dialog-accept")),
        // Step 5: the whole sketch 0.062 mm up, New.
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(-28, 40, 7)),
        Click(xyz(0, -25, 7)),
        Click(xyz(15, 57, 7)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("0.062"),
        Key("Enter"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-board-extruded"),
        // Step 6: hide the board, show Sketch 1, the battery and antenna regions 1 mm down.
        RightClick(ui("part-row-part-1")),
        WaitFor("part-hide"),
        Click(ui("part-hide")),
        RightClick(ui("feature-sketch-1")),
        WaitFor("feature-show"),
        Click(ui("feature-show")),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(0, -25, 7)),
        Click(xyz(15, 57, 7)),
        Click(ui("extrude-operation-0")),
        Click(ui("extrude-flip")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("1"),
        Key("Enter"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("08-keepouts-extruded-down"),
        RightClick(ui("part-row-part-1")),
        WaitFor("part-show"),
        Click(ui("part-show")),
        // Rename the parts and the studio.
        RightClick(ui("part-row-part-1")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        Type("Board"),
        Key("Enter"),
        RightClick(ui("part-row-part-2")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        Type("Keep-out Battery"),
        Key("Enter"),
        RightClick(ui("part-row-part-3")),
        WaitFor("part-rename"),
        Click(ui("part-rename")),
        Type("Keep-out Antenna"),
        Key("Enter"),
        Wait(5),
        DoubleClick(ui("tab-part-studio-1")),
        Key("Ctrl+A"),
        Type("Board & Keep out"),
        Key("Enter"),
        ClickAt(1300, 250),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("09-parts-renamed"),
        // Step 7: Insert and go to Assembly.
        Click(ui("part-row-board")),
        Click(ui("part-row-keep-out-battery")),
        Click(ui("part-row-keep-out-antenna")),
        Click(ui("context-go")),
        WaitFor("context-go-menu-insert"),
        Click(ui("context-go-menu-insert")),
        WaitFor("insert-go-dialog"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("10-insert-and-go-to-assembly"),
        Click(ui("insert-go-dialog-accept")),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("11-assembly-with-board"),
        // Step 8: edit Group 1, add the three new instances.
        RightClick(ui("mate-row-1")),
        WaitFor("mate-edit"),
        Click(ui("mate-edit")),
        WaitFor("group-dialog"),
        Click(ui("instance-row-4")),
        Click(ui("instance-row-5")),
        Click(ui("instance-row-6")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("12-group-1-edited"),
        Click(ui("group-dialog-accept")),
        // Step 9: a PCB Studio.
        Click(ui("insert-tab")),
        WaitFor("create-pcb-studio"),
        Click(ui("create-pcb-studio")),
        WaitFor("pcb-tree"),
        Screenshot("13-pcb-studio"),
        // Step 10: Sync the Cell phone assembly, Top Plane.
        Click(ui("pcb-sync")),
        WaitFor("pcb-sync-dialog"),
        Screenshot("14-sync-dialog"),
        Click(ui("pcb-sync-ok")),
        WaitFor("pcb-sync-toast"),
        MoveTo(1100, 700),
        Wait(3),
        Screenshot("15-synced-board-keepouts"),
        // Step 12: the Enclosure goes to 85 × 150.
        Click(ui("tab-enclosure")),
        Custom("phone-case-size 85 150"),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("16-enclosure-85-by-150"),
        // Step 13: Update context from the Board's menu.
        Click(ui("tab-cell-phone")),
        RightClick(ui("instance-row-4")),
        WaitFor("asm-update-context"),
        Hover(ui("asm-update-context")),
        WaitFor("asm-update-context-0"),
        Hover(ui("asm-update-context-0")),
        Wait(5),
        Screenshot("17-update-context-menu"),
        Click(ui("asm-update-context-0")),
        Key("F"),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("18-board-follows-the-case"),
        // Steps 15–16: sync again with the same settings.
        Click(ui("tab-pcb-studio-1")),
        Click(ui("pcb-sync")),
        WaitFor("pcb-sync-dialog"),
        Screenshot("19-sync-again"),
        Click(ui("pcb-sync-ok")),
        WaitFor("pcb-sync-toast"),
        MoveTo(1100, 700),
        Wait(3),
        Screenshot("20-board-updated"),
        // Steps 17–18: Export this board to IDF 3.0; read Cell phone.emn.
        Click(ui("pcb-export")),
        WaitFor("pcb-export-dialog"),
        Screenshot("21-export-ecad-files"),
        Click(ui("pcb-export-ok")),
        WaitFor("pcb-export-toast"),
        Screenshot("22-exported"),
        Click(ui("pcb-export-open-emn")),
        WaitFor("pcb-emn-viewer"),
        Screenshot("23-cell-phone-emn"),
    ],
)
