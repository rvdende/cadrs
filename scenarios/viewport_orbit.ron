// M2: viewport navigation with Onshape's mouse bindings: right-drag orbits (Z stays up),
// middle-drag pans, Ctrl+right-drag pans, the wheel zooms toward the cursor; the view ball
// (bottom right) turns with the view, its knobs and arrows change it, and Shift+7 gives the
// isometric view.
// 08 the pointer on the ball's Z knob: it grows and lightens, "Top" beside the ball.
// 10a the ring's right roll arrow: the view rolls 15° clockwise.
// 10b the ball dragged to the right: the view turns as a right-drag turns it.
// M8: the View options menu at the tab bar's right end, opening upward (Isometric, Dimetric,
// Trimetric, Zoom to fit, …).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("01-default-view"),
        RightDrag(at(1150, 700), at(1270, 740)),
        Screenshot("02-right-drag-orbit"),
        MiddleDrag(at(1100, 700), at(980, 760)),
        Screenshot("03-middle-drag-pan"),
        KeyDown("Ctrl"),
        RightDrag(at(1100, 700), at(1180, 640)),
        KeyUp("Ctrl"),
        Screenshot("04-ctrl-right-drag-pan"),
        Scroll(at(1200, 350), 4),
        Wait(2),
        Screenshot("05-wheel-zoom-in-at-cursor"),
        Scroll(at(1200, 350), -7),
        Wait(2),
        Screenshot("06-wheel-zoom-out"),
        Key("Shift+7"),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("07-shift-7-isometric"),
        Hover(ui_at("view-cube-image", 0.5, 0.16)),
        Wait(3),
        Screenshot("08-view-cube-hover-top"),
        Click(ui_at("view-cube-image", 0.5, 0.16)),
        Screenshot("09-view-cube-top"),
        Click(ui("view-cube-up")),
        Click(ui("view-cube-right")),
        Screenshot("10-view-cube-arrows"),
        Click(ui("view-cube-roll-right")),
        MoveTo(1420, 780),
        Wait(30),
        Screenshot("10a-view-cube-roll"),
        Drag(ui_at("view-cube-image", 0.3, 0.5), ui_at("view-cube-image", 0.8, 0.5)),
        MoveTo(1420, 780),
        Wait(5),
        Screenshot("10b-view-cube-drag"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Hover(ui("view-zoom-to-fit")),
        Wait(3),
        Screenshot("11-view-menu"),
        Click(ui("view-zoom-to-fit")),
        Screenshot("12-zoom-to-fit"),
    ],
)
