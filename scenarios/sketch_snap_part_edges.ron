// Snapping to part edges in the sketch plane (docs/IDEAS_TRACING.md): an 80 × 50 × 20 plate
// with a Ø12 hole at (40, 25), and a sketch on its top face.
// 01 the Line tool started at the hole's centre (snapped: the circle's centre is a snap point);
//    the cursor over the plate's far corner snaps to it, the two edges there highlighted.
// 02 the line placed: the circle and one edge at the corner are used as construction geometry
//    (linked, so the line's ends follow the part), the line fully placed on them.
// 03 the pointer on the hole's rim: the rim highlighted, a point-on-curve snap.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 80 50 circle 40 25 6"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(10, 10, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(xyz(10, 10, 20)),
        Key("N"),
        MoveTo(913, 520),
        Key("L"),
        ClickWorld(40, 25),
        MoveWorld(79.5, 49.6),
        Wait(5),
        Screenshot("01-snapping-to-the-corner"),
        ClickWorld(79.5, 49.6),
        Key("Escape"),
        MoveTo(1420, 900),
        Wait(10),
        Screenshot("02-line-on-the-used-edges"),
        Key("L"),
        MoveWorld(46.2, 25.3),
        Wait(5),
        Screenshot("03-on-the-hole-rim"),
    ],
)
