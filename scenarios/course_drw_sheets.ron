// P3C.1 / D2.5, D2.7, D2.8, D2.10, D14.2, X4, X5, X12: sheets, sheet and drawing properties.
// 01 The Part Studio tab's menu: "Create Drawing of Part Studio 1…" and "Copy to clipboard"
//    enabled (ex1-step6.png's tab menu).
// 02 The drawing references Part Studio 1: its title block shows the name. Ctrl+S opens the
//    Sheets flyout: Sheets(1), Sheet1 with its referenced Part Studio under it
//    (lesson-drawing-properties-sheets-flyout.png, ex3-step2.png).
// 03 Insert sheet: Sheet2 is added and active (title block "2 OF 2").
// 04 Double-click Sheet1: it is active again.
// 05 Sheet2's context menu: Activate, Properties…, Rename…, Delete.
// 06 Sheet properties: scale, size, orientation, border and zones, referenced object.
// 07 Size → ISO A3 picked.
// 08 OK, then double-click Sheet2: a 420 × 297 mm sheet with ISO zones (1–8, A–F).
// 09 Sheet2 renamed "Handle" in place.
// 10 D14.2: Insert sheet again: Sheets(3); the new third sheet takes the free name Sheet2.
// 11–13 Double-click Sheet1, Handle and the third sheet in turn: each becomes the active sheet.
// 14 The wrench: Drawing properties, Units and precision (Inches, Period, 0.123, 0.123, 0.1;
//    Dual; Leading and trailing zeros) with Update properties from a template… and Lock.
// 15 Show dual dimensions ticked (an undoable edit).
// 16 The Views tab of Drawing properties.
// 17 Right-click on the sheet: Sheet properties…, Drawing properties…
// 18 The keyboard shortcuts dialog's Drawing tab.
// 19 The drawing tab's menu (drawing icon on the tab): Copy to clipboard (D2.10).
// 20 "+" offers "Paste Drawing 1"; 21 the pasted copy "Drawing 1 (1)" with its three sheets.
// 22 Update properties from a template… → ISO_A3_MM.dwt; 23 the properties now read
//    Millimeters, 0.12, leading zeros on, and the title block says millimetres and first angle.
// 24 Lock drawing properties: the settings become read-only.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        RightClick(ui("tab-part-studio-1")),
        Hover(ui("tab-create-drawing")),
        Wait(5),
        Screenshot("01-tab-menu-create-drawing-of"),
        Click(ui("tab-create-drawing")),
        WaitFor("create-drawing-dialog"),
        Click(ui("template-row-ANSI_A_INCH.dwt")),
        Click(ui("create-drawing-ok")),
        // Insert view starts by itself (D1.7, P3C.2): Esc closes it.
        Key("Escape"),
        Key("Ctrl+S"),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("02-sheets-flyout"),
        Click(ui("drawing-insert-sheet")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("03-inserted-sheet2-active"),
        DoubleClick(ui("sheet-row-1")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("04-sheet1-activated"),
        RightClick(ui("sheet-row-2")),
        Screenshot("05-sheet-context-menu"),
        Click(ui("sheet-menu-properties")),
        WaitFor("sheet-properties-dialog"),
        Screenshot("06-sheet-properties"),
        Click(ui("sheet-props-size")),
        Click(ui("sheet-props-size-option-6")),
        Screenshot("07-size-iso-a3"),
        Click(ui("sheet-props-ok")),
        Wait(10),
        DoubleClick(ui("sheet-row-2")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("08-sheet2-iso-a3"),
        RightClick(ui("sheet-row-2")),
        Click(ui("sheet-menu-rename")),
        Key("Ctrl+A"),
        Type("Handle"),
        Key("Enter"),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("09-sheet-renamed"),
        // D14.2: a third sheet, then each of the three activated in turn.
        Click(ui("drawing-insert-sheet")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("10-three-sheets"),
        DoubleClick(ui("sheet-row-1")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("11-activate-sheet1"),
        DoubleClick(ui("sheet-row-2")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("12-activate-handle"),
        DoubleClick(ui("sheet-row-3")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("13-activate-third-sheet"),
        Click(ui("drawing-properties-toggle")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("14-drawing-properties"),
        Click(ui("drawing-prop-show_dual")),
        Screenshot("15-show-dual"),
        Click(ui("drawing-props-tab-views")),
        Screenshot("16-properties-views"),
        RightClick(at(700, 400)),
        Screenshot("17-sheet-space-menu"),
        Key("Escape"),
        Key("Shift+/"),
        Click(ui("shortcuts-tab-5")),
        Screenshot("18-shortcuts-drawing-tab"),
        Key("Escape"),
        RightClick(ui("tab-drawing-1")),
        Hover(ui("tab-copy")),
        Wait(5),
        Screenshot("19-drawing-tab-menu"),
        Click(ui("tab-copy")),
        Click(ui("insert-tab")),
        Hover(ui("paste-tab")),
        Wait(5),
        Screenshot("20-plus-menu-paste"),
        Click(ui("paste-tab")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("21-pasted-drawing"),
        Click(ui("drawing-props-tab-units")),
        Click(ui("drawing-props-update-template")),
        WaitFor("update-template-dialog"),
        Click(ui("update-template-select")),
        Click(ui("update-template-select-option-25")),
        Screenshot("22-update-from-template-iso-a3-mm"),
        Click(ui("update-template-ok")),
        MoveTo(1590, 990),
        Wait(3),
        Screenshot("23-properties-from-iso-template"),
        Click(ui("drawing-props-lock")),
        Screenshot("24-properties-locked"),
    ],
)
