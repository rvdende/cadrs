// T5 / S16: sketch text. "Text tool: draw a corner rectangle for the text box. A dialog takes the
// text, the font, bold/italic, and horizontal/vertical mirroring, with a live preview. The text
// fills the box. Dimension only the width or the height. Deleting its Horizontal constraint lets
// it rotate. Right-click → Edit text. Text regions can be extruded."
// (`reference/onshape/t5/textrectangle-dialog-01.png`, `textrectangle-example.png`,
// `text-flippedvert-text.png`.) The Text tool draws a box from its lower-left corner; the Text
// dialog opens beside the sketch dialog with the field focused. Typing "CAD" previews it in the
// grey box and in the sketch; Bold, Italic and the flips restyle it live. Enter adds it: blue
// outlines on a dash-dot construction box whose lower edge is Horizontal. A height dimension of
// 20 (the sketch's first, which scales it). Deleting the Horizontal glyph and dragging a corner
// turns the text. Right-click → Edit text reopens the dialog; "CADRS" widens the box. The
// letters are extruded 5 mm into raised text.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Click(ui("sketch-text")),
        Wait(2),
        ClickWorld(-40, -10),
        MoveWorld(10, 5),
        Wait(3),
        Screenshot("01-text-box"),
        ClickWorld(10, 5),
        WaitFor("text-dialog"),
        Wait(3),
        Screenshot("02-text-dialog-opens"),
        Type("CAD"),
        Wait(3),
        Screenshot("03-live-preview"),
        Click(ui("text-dialog-bold")),
        Wait(2),
        Click(ui("text-dialog-italic")),
        Wait(3),
        Screenshot("04-bold-italic"),
        Click(ui("text-dialog-flip-h")),
        Wait(3),
        Screenshot("05-flipped-left-to-right"),
        Click(ui("text-dialog-flip-h")),
        Wait(2),
        Click(ui("text-dialog-flip-v")),
        Wait(3),
        Screenshot("06-flipped-upside-down"),
        Click(ui("text-dialog-flip-v")),
        Wait(2),
        Click(ui("text-dialog-italic")),
        Wait(2),
        Key("Enter"),
        Wait(4),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("07-text-added"),
        Key("D"),
        Wait(2),
        ClickWorld(-40, -2),
        Wait(2),
        ClickWorld(-52, -2),
        Wait(3),
        Type("20"),
        Key("Enter"),
        Wait(4),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("08-height-dimensioned"),
        // Delete the lower edge's Horizontal, fix the lower-left corner and drag the lower-right
        // one: the text turns.
        Click(at(875, 598)),
        Wait(3),
        Screenshot("09-horizontal-glyph-selected"),
        Key("Delete"),
        Wait(3),
        Click(at(755, 580)),
        Wait(2),
        Key("Shift+J"),
        Wait(3),
        Drag(at(995, 580), at(985, 500)),
        Wait(4),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("10-text-turned"),
        RightClick(at(875, 540)),
        WaitFor("sketch-text-menu"),
        Wait(3),
        Screenshot("11-right-click-edit-text"),
        Click(ui("sketch-text-edit")),
        WaitFor("text-dialog"),
        Wait(3),
        Type("RS"),
        Wait(3),
        Screenshot("12-edit-text-dialog"),
        Key("Enter"),
        Wait(4),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("13-text-edited"),
        // S16.3: the letters extrude (raised text).
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(at(760, 530)),
        Wait(2),
        Click(at(847, 547)),
        Wait(2),
        Click(at(925, 503)),
        Wait(2),
        Click(at(997, 487)),
        Wait(2),
        Click(at(1088, 476)),
        Wait(3),
        Screenshot("14-letter-regions-picked"),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Type("5"),
        Key("Enter"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("15-raised-text"),
    ],
)
