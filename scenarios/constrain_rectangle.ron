// M6: constraining a rectangle with the constraint tools (compare reference/onshape/screens/12a,
// 17, 17a and constraints.md). A rectangle drawn away from the origin is all blue (its quick
// dimensions skipped with Esc). Select-then-tool: its corner and the origin selected, then
// Coincident from the Constraints ▾ menu: the corner moves onto the origin, and the edges on
// the axes turn black (as in screens/12a). Two edges selected and E makes them equal. Tool
// first: Shift+J with nothing selected keeps the Fix tool active, and clicking the free corner
// fixes it: every degree of freedom is gone and the rectangle is black. Clicking a glyph
// selects it (it and its geometry turn yellow); Delete removes the constraint (the rectangle
// turns partly blue again) and Ctrl+Z brings it back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(20, 15),
        ClickWorld(60, 40),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveWorld(90, -40),
        Wait(2),
        Screenshot("01-rectangle-away-from-origin-blue"),
        Click(world(20, 15)),
        Wait(2),
        Click(world(0, 0)),
        Wait(2),
        MoveWorld(90, -40),
        Wait(2),
        Screenshot("02a-corner-and-origin-selected"),
        Click(ui("sketch-constraints-caret")),
        WaitFor("sketch-constraint-coincident"),
        Wait(3),
        Screenshot("02b-constraints-menu"),
        Click(ui("sketch-constraint-coincident")),
        Wait(3),
        MoveWorld(90, -40),
        Wait(2),
        Screenshot("03-coincident-edges-on-axes-black"),
        Click(world(60, 20)),
        Wait(2),
        Click(world(30, 40)),
        Wait(2),
        Screenshot("04-two-edges-selected"),
        Key("E"),
        Wait(3),
        MoveWorld(90, -40),
        Wait(2),
        Screenshot("05-equal-edges-square"),
        Key("Shift+J"),
        Wait(2),
        MoveWorld(50, 50),
        Wait(2),
        Screenshot("06-fix-tool-active-hover-corner"),
        Click(world(50, 50)),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveWorld(90, -40),
        Wait(2),
        Screenshot("07-fixed-fully-constrained-black"),
        MoveTo(1070, 306),
        Wait(2),
        Screenshot("08-hover-glyph-highlights-geometry"),
        Click(at(1070, 306)),
        Wait(2),
        MoveWorld(90, -40),
        Wait(2),
        Screenshot("09-glyph-selected"),
        Key("Delete"),
        Wait(3),
        Screenshot("10-constraint-deleted-partly-blue"),
        Key("Ctrl+Z"),
        Wait(3),
        Screenshot("11-undo-restores-constraint"),
    ],
)
