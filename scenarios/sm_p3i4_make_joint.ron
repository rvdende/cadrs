// Make joint (P3I.4, SM6.1–SM6.3; `help/feature-tools/sheetmetalmakejoint-dialog.png`): two
// walls apart (a sheet metal Extrude of two lines on Top, 40 mm, 2 mm thick): the empty dialog
// (Rip, Edge joint); their facing edges picked: an edge joint at the corner; Butt joint –
// Direction 1 and 2; then Bend (one part now); accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top chain 0 0 50 0 chain 54 5 54 30"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-1")),
        Wait(10),
        Click(xyz(25, 0, 0)),
        Wait(5),
        Click(xyz(54, 20, 0)),
        Wait(5),
        Click(ui("sm-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("40"),
        Key("Tab"),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(10),
        Click(ui("sheet-metal-menu-make-joint")),
        WaitFor("sheet-metal-make-joint-dialog"),
        Wait(10),
        Custom("view 30 30 40 15 20 0.12"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-make-joint-dialog"),
        Click(xyz(50, 0, 20)),
        Wait(10),
        Click(xyz(54, 5, 20)),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-rip-edge-joint"),
        Click(ui("smf-rip-style")),
        Wait(5),
        Click(ui("smf-rip-style-option-1")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-butt-direction-1"),
        Click(ui("smf-rip-style")),
        Wait(5),
        Click(ui("smf-rip-style-option-2")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-butt-direction-2"),
        Click(ui("smf-joint-type")),
        Wait(5),
        Click(ui("smf-joint-type-option-1")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-bend"),
        Click(ui("sheet-metal-make-joint-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-accepted"),
    ],
)
