// A hypoid pair placed by its shafts (`cadrs_core::gear::hypoid`, issue #179). Two lines for
// shafts: the gear's down the Front plane, the pinion's along the Top plane 25 mm to the side.
// Gear, its type Hypoid pair, 48 teeth to the mate's 24; its Axis the first line and its Mate's
// axis the second (the shaft angle and the offset are theirs, so their fields go); accepted.
// Then Gear again, Cut as its Pinion, 24 teeth to 48, its shafts the other way round; accepted:
// the pair in mesh where the shafts cross.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        SetTimeout(120.0),
        Custom("sketch front chain 0 0 0 -60"),
        Custom("sketch top chain 0 25 -60 25"),
        Key("Shift+7"),
        Key("F"),
        Click(ui("gear")),
        WaitFor("gear-dialog"),
        Click(ui("gear-type")),
        Click(ui("gear-type-option-4")),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("01-hypoid-dialog"),
        Click(ui("gear-shaft-field")),
        Click(xyz(0, 0, -30)),
        Click(xyz(-30, 25, 0)),
        Click(ui("gear-teeth-field")),
        Key("Ctrl+A"),
        Type("48"),
        Key("Tab"),
        Click(ui("gear-mate-teeth-field")),
        Key("Ctrl+A"),
        Type("24"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(8),
        Screenshot("02-gear-on-its-shafts"),
        Click(ui("gear-dialog-accept")),
        Click(ui("gear")),
        WaitFor("gear-dialog"),
        Click(ui("gear-type")),
        Click(ui("gear-type-option-4")),
        Click(ui("gear-member")),
        Click(ui("gear-member-option-1")),
        Click(ui("gear-shaft-field")),
        Click(xyz(-30, 25, 0)),
        Click(xyz(0, 0, -30)),
        Click(ui("gear-teeth-field")),
        Key("Ctrl+A"),
        Type("24"),
        Key("Tab"),
        Click(ui("gear-mate-teeth-field")),
        Key("Ctrl+A"),
        Type("48"),
        Key("Tab"),
        Click(ui("gear-dialog-accept")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(8),
        Screenshot("03-the-pair-in-mesh"),
    ],
)
