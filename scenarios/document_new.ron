// M2: create a document from the documents page; the new Part Studio opens in the default view
// (compare reference/onshape/screens/05). Hover a toolbar tool, rename the document in place,
// then go back to the documents page, which shows the document's real isometric thumbnail.
Scenario(
    start: Some("landing"),
    steps: [
        Click(ui("create")),
        WaitFor("new-document"),
        Click(ui("new-document")),
        WaitFor("new-document-create"),
        Type("Bracket"),
        Click(ui("new-document-create")),
        WaitFor("document-loading"),
        Screenshot("01-loading-studio-data"),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("02-part-studio-default"),
        Hover(ui("sketch")),
        Wait(40),
        Screenshot("03-sketch-hover-tooltip"),
        Hover(ui("draft")),
        Wait(40),
        Screenshot("04-disabled-tool-tooltip"),
        Click(ui("sketch")),
        Screenshot("05-sketch-clicked-dialog"),
        Click(ui("document-name")),
        Screenshot("06-rename-document"),
        Type("Bracket v2"),
        Key("Enter"),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("07-document-renamed"),
        Click(ui("back-to-documents")),
        WaitFor("doc-row-0"),
        MoveTo(1000, 700),
        Wait(2),
        Screenshot("08-back-to-documents-thumbnail"),
    ],
)
