// Final re-audit / S12.14: "Curvature (Shift+U): two splines/conics (G2 continuity)". Spline ▾
// shows Onshape's fit-point Spline (not built, disabled) and the Bézier curve, which the
// toolbar button draws: four clicks, its start, two control points (hollow handles on dashed
// lines) and its end. Two Bézier curves drawn end to end meet with a kink (02). Shift+U, then
// the two curves: the second swings so the join is tangent with the same curvature (G2), with
// a Curvature glyph at the join (03). A line closes them into a region, which extrudes into a
// part whose curved side is one smooth face (04, 05).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Click(ui("sketch-spline-caret")),
        WaitFor("sketch-variant-bezier"),
        MoveTo(1400, 850),
        Hover(ui("sketch-variant-bezier")),
        Wait(3),
        Screenshot("01-spline-menu-bezier"),
        Click(ui("sketch-variant-bezier")),
        ClickWorld(-60, 0),
        ClickWorld(-45, 35),
        ClickWorld(-15, 35),
        ClickWorld(0, 10),
        ClickWorld(0, 10),
        ClickWorld(20, 30),
        ClickWorld(40, -20),
        MoveWorld(55, 5),
        MoveWorld(60, 0),
        Wait(3),
        Screenshot("02-second-curve-kinked-join"),
        ClickWorld(60, 0),
        Key("Escape"),
        Key("Shift+U"),
        ClickWorld(-30, 27.5),
        ClickWorld(30, 5),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-curvature-g2-join"),
        Key("L"),
        ClickWorld(60, 0),
        ClickWorld(-60, 0),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-closed-region"),
        Click(ui("sketch-dialog-accept")),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        ClickWorld(-30, 10),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Enter"),
        Key("Shift+7"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("05-extruded-smooth-side"),
    ],
)
