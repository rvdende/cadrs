// P3I.8 / SM17 (lesson `17-importing-legacy-sheet-metal`, t0043–t0045): a folded part imported
// from STEP (our C-channel exported as a plain solid, `sm-legacy-step`) made active sheet metal:
// 01 the import; 02 Sheet metal model → Thicken of the outer base face with Tangent propagation:
// the whole outer skin picked, the flat appears; 03 the four bend cylinders picked under Edges or
// cylinders to bend, 2 mm, R3, the thickness flipped into the part: real bends; 04 accepted;
// 05 the import removed with Delete part; 06 the table and flat view.
// (`cadrs_core/tests/sheetmetal_legacy.rs`: the same volume and flat as the original.)
Scenario(
    start: Some("landing"),
    steps: [
        Custom("sm-legacy-step target/imports/channel.step"),
        Wait(10),
        Click(ui("create")),
        Wait(10),
        Click(ui("import-files")),
        Wait(10),
        Click(ui("import-picker-folder")),
        Wait(3),
        Key("Ctrl+A"),
        Type("target/imports"),
        Key("Enter"),
        Wait(10),
        Click(ui("import-picker-row-channel.step")),
        Wait(5),
        Click(ui("import-picker-open")),
        Wait(10),
        Click(ui("import-ok")),
        Wait(120),
        Click(ui("tab-channel")),
        Wait(30),
        Custom("view 30 -30 30 -50 20 0.12"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-imported-channel"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(ui("sm-tangent-propagation-checkbox")),
        Wait(5),
        Click(ui("sm-faces-field")),
        Wait(3),
        Click(xyz(30, -50, 0)),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-thicken-tangent-propagation"),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(10),
        Click(ui("sm-bend-radius-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("3"),
        Key("Tab"),
        Wait(10),
        Click(ui("sm-thickness-flip")),
        Wait(20),
        Click(ui("sm-bends-field")),
        Wait(3),
        Custom("view -35 5 30 -50 20 0.12"),
        Wait(20),
        Click(xyz(1.46, -50, 1.46)),
        Wait(5),
        Click(xyz(1.46, -50, 38.54)),
        Wait(5),
        Custom("view 35 5 30 -50 20 0.12"),
        Wait(20),
        Click(xyz(58.54, -50, 1.46)),
        Wait(5),
        Click(xyz(58.54, -50, 38.54)),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-bend-cylinders-picked"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-accepted"),
        RightClick(ui("part-row-channel")),
        Wait(6),
        Click(ui("part-delete")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-import-deleted"),
        Click(ui("panel-sheet-metal")),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-table-and-flat"),
    ],
)
