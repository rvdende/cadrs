// Sheet metal table edits and Modify joint (P3I.3; SM6.4, SM13.3, SM13.4; compare lesson
// `13-bend-and-joint-table` frames t0052 (radius), t0016 (row menu), t0086.7 (Other joints
// with Type and Style), and `help/feature-tools/modify-joint-02.png`): on the converted box,
// Bend A's radius is double-clicked and set to 5 mm (a Modify joint appears after the model);
// Bend C moves up; Bend A is converted to a rip (its row moves to Other joints as Joint A), its
// Style set to Butt joint - Direction 1 and its Type back to Bend; a K Factor of 1.5 leaves the
// cell red with the valid range as its tooltip, and is undone; the Modify joint opens from the
// feature list in its dialog, where Use model K Factor is turned off.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(50, 30, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("40"),
        Key("Enter"),
        Key("F"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("sm-bend-radius-field")),
        Key("Ctrl+A"),
        Type("3"),
        Key("Tab"),
        Click(ui("sm-parts-field")),
        Click(xyz(50, 30, 40)),
        // Bend the four top edges: an open box (upside down) and a separate bottom.
        Click(ui("sm-bends-field")),
        Click(xyz(50, 0, 40)),
        Click(xyz(100, 30, 40)),
        Click(xyz(50, 60, 40)),
        Click(xyz(0, 30, 40)),
        Click(ui("sheet-metal-model-dialog-accept")),
        Key("F"),
        Click(ui("panel-sheet-metal")),
        WaitFor("smt-panel"),
        Wait(30),
        DoubleClick(ui("smt-bend-0-radius")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Enter"),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("01-radius-of-bend-a-is-5"),
        RightClick(ui("smt-bend-row-2")),
        Screenshot("02-row-menu"),
        Click(ui("smt-move-up")),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("03-bend-c-moved-up"),
        RightClick(ui("smt-bend-row-0")),
        Screenshot("04-convert-menu"),
        Click(ui("smt-convert")),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("05-bend-a-is-a-rip"),
        Click(ui("smt-joint-0-style")),
        Screenshot("06-style-menu"),
        Click(ui("smt-joint-0-style-option-1")),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("07-butt-joint-direction-1"),
        Click(ui("smt-joint-0-type")),
        Click(ui("smt-joint-0-type-option-1")),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("08-joint-a-back-to-a-bend"),
        DoubleClick(ui("smt-bend-1-value")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Enter"),
        Hover(ui("smt-bend-1-value")),
        Wait(60),
        Screenshot("09-k-factor-out-of-range-red"),
        MoveTo(700, 900),
        Key("Ctrl+Z"),
        Screenshot("10-undone"),
        DoubleClick(ui("feature-modify-joint-1")),
        WaitFor("modify-joint-dialog"),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("11-modify-joint-dialog"),
        Click(ui("smj-model-k")),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("12-dialog-own-k-factor"),
        Click(ui("modify-joint-dialog-accept")),
        Screenshot("13-accepted"),
        // A Corner break on the lid's corner: the joints' Type, Style and Convert lock (SM11.4).
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-corner-break")),
        WaitFor("sheet-metal-corner-break-dialog"),
        Custom("view 30 -30 100 60 1 0.12"),
        Click(xyz(100, 60, 1)),
        Click(ui("sheet-metal-corner-break-dialog-accept")),
        Key("F"),
        Hover(ui("smt-joint-0-style")),
        Wait(60),
        Screenshot("14-corner-break-locks-the-style"),
        MoveTo(700, 900),
        RightClick(ui("smt-bend-row-0")),
        Hover(ui("smt-convert")),
        Wait(60),
        Screenshot("15-corner-break-locks-convert"),
        Key("Escape"),
    ],
)
