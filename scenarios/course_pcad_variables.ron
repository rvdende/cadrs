// P3F.4 (`intro-to-parametric-cad.md` P5.2, P5.3, X2): variables through the UI, from scratch.
// 01 the toolbar's Variable (ƒx) clicked: the Variable dialog (Type Length | Angle | Number |
//    Any, Name, Value, Description), "#var_1" in the feature list.
// 02 #width = 40 mm with a description, what it evaluates to under the Value.
// 03 a second Variable, #depth = #width / 2 (an expression naming the first): "= 20 mm".
// 04 the Variable table (right strip): #width 40 mm and #depth #width / 2 (= 20 mm).
// 05 a 60 × 30 rectangle on Top, its bottom side dimensioned with "#width" typed in the value box
//    (Show expressions on: the label reads "#width"; the rectangle is 40 wide).
// 06 Extrude with Depth "#depth": 20 mm high.
// 07 #width typed as 70 mm in the Variable table: the sketch, and the depth through #depth, follow
//    (70 wide, 35 high).
// 08 a third Variable #wall = 3 mm, dragged above Extrude 1, the Extrude's depth set to #wall, then
//    #wall dragged back below it: the Extrude is red ("Depth: #wall is used before it is defined;
//    move its Variable above this feature"), shown on hover.
// 09 the filter ":variable width": #width, #depth (it uses #width) and Sketch 1 (its dimension).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("variable")),
        WaitFor("variable-dialog"),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-variable-dialog"),
        Click(ui("variable-name-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("width"),
        Click(ui("variable-value-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("40 mm"),
        Click(ui("variable-description-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("Plate width"),
        Click(ui("variable-dialog-title")),
        Wait(5),
        ExpectText("variable-evaluated", "40 mm"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-width-40"),
        Click(ui("variable-dialog-accept")),
        Wait(5),
        Click(ui("variable")),
        WaitFor("variable-dialog"),
        Wait(5),
        Click(ui("variable-name-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("depth"),
        Click(ui("variable-value-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("#width / 2"),
        Click(ui("variable-dialog-title")),
        Wait(5),
        ExpectText("variable-evaluated", "20 mm"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-depth-expression"),
        Click(ui("variable-dialog-accept")),
        Wait(5),
        Click(ui("panel-variables")),
        WaitFor("variables-panel"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-variable-table"),
        Custom("sketch top rect 0 0 60 30"),
        Wait(10),
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Wait(30),
        Click(ui("sketch-show-expressions")),
        Wait(3),
        Key("D"),
        Wait(2),
        Click(world(30, 0)),
        Wait(2),
        Click(world(30, -12)),
        Wait(3),
        Key("Ctrl+A"),
        Type("#width"),
        Key("Enter"),
        Wait(10),
        Key("Escape"),
        Wait(3),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-dimension-width"),
        Click(ui("sketch-dialog-accept")),
        Wait(10),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(ui("feature-sketch-1")),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("#depth"),
        Click(ui("extrude-dialog-title")),
        Wait(10),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-extrude-depth-variable"),
        Click(ui("extrude-dialog-accept")),
        Wait(10),
        Click(ui("variable-row-width-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("70 mm"),
        Key("Enter"),
        Wait(60),
        Key("F"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-width-70-follows"),
        Click(ui("variable")),
        WaitFor("variable-dialog"),
        Wait(5),
        Click(ui("variable-name-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("wall"),
        Click(ui("variable-value-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("3 mm"),
        Click(ui("variable-dialog-title")),
        Wait(3),
        Click(ui("variable-dialog-accept")),
        Wait(5),
        // #wall dragged above Extrude 1, the depth set to #wall (a good use)...
        Drag(ui("feature-wall"), ui_at("feature-extrude-1", 0.5, 0.15)),
        Wait(10),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        Wait(5),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("#wall"),
        Click(ui("extrude-dialog-title")),
        Wait(10),
        Click(ui("extrude-dialog-accept")),
        Wait(10),
        // ... then dragged back below it: used before it is defined.
        Drag(ui("feature-wall"), ui_at("feature-extrude-1", 0.5, 0.9)),
        Wait(30),
        Hover(ui("feature-extrude-1")),
        Wait(40),
        Screenshot("08-forward-use-error"),
        Click(ui("feature-filter")),
        Wait(2),
        Type(":variable width"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-filter-variable-width"),
    ],
)
