// P3E.3a (TD6.5, PS2.9, X14): the view cube menu's camera and render options, on the drawing
// bracket (`samples::drawing_bracket`: a plate with four holes and rounded corners, an upright
// with a hole and a chamfer), every step through the UI:
// 01 the default, Shaded with edges.
// 02 the view menu with the first render group open: Shaded with edges ✓, Shaded without edges,
//    Shaded with hidden edges, Translucent.
// 03 Shaded without edges; 04 Shaded with hidden edges (the holes' far edges and the plate's
//    hidden corners dashed grey through the faces); 05 Translucent (see-through, every edge).
// 06 the second group: Hidden edges removed ✓ (the group checked and named after its mode).
// 07 Hidden edges removed: white faces, black visible edges, a line drawing; 08 Hidden edges
//    visible: the same with the hidden edges dashed.
// 09 Shaded with edges again, then Perspective view (checked in the menu, 09): 10 the bracket in
//    perspective (the near corner larger, the upright's verticals converging), fitted with F.
// 11 a wheel zoom about the cursor (on the upright's hole) in perspective: the hole stays under
//    it.
// 12 Zoom to window: a box dragged around the upright's hole (drawn while dragging); 13 the
//    hole fills the view.
// 14 Previous view: back to before the zoom to window.
// 15 Perspective off, fitted, zoomed to a window round the hole again; Named views…: the empty
//    panel; 16 "Upright hole" typed, Add view: listed, its row selected (the view is at it),
//    and the name field offers the next name, "View 2".
// 17 the view changed: the Top view, fitted, in Hidden edges removed (the row no longer
//    selected); 18 the row clicked: the saved camera and its Shaded mode are back (as 16).
// 19 Zoom to selection: the upright's front face right-clicked, its menu's Zoom to selection;
//    20 the view fitted to that face.
// 21 a render mode per tab, on the Pneumatic Cylinder (`fixtures/pneumatic_cylinder_ex2.cadrs`):
//    Cylinder parts in Hidden edges visible; 22 the Cylinder assembly tab keeps its own mode
//    (Translucent, set there); 23 back in Cylinder parts, Hidden edges visible still applies.
// 24 named views per tab: in Cylinder parts, Named views… and "Cylinder parts fitted" added
//    (its row hovered: the hover tint); 25 the Cylinder assembly
//    tab with the panel still open: its own list, empty.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("drawing-bracket"),
        Wait(60),
        Key("F"),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-shaded-with-edges"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-shaded")),
        Wait(12),
        Screenshot("02-render-menu"),
        Click(ui("view-render-shaded-no-edges")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-shaded-without-edges"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-shaded")),
        Wait(12),
        Click(ui("view-render-shaded-hidden-edges")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-shaded-with-hidden-edges"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-shaded")),
        Wait(12),
        Click(ui("view-render-translucent")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-translucent"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-hidden-edges")),
        Wait(12),
        Screenshot("06-hidden-line-menu"),
        Click(ui("view-render-hidden-removed")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-hidden-edges-removed"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-hidden-edges")),
        Wait(12),
        Click(ui("view-render-hidden-visible")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-hidden-edges-visible"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-shaded")),
        Wait(12),
        Click(ui("view-render-shaded")),
        Wait(10),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-perspective")),
        Wait(10),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(8),
        Screenshot("09-perspective-checked"),
        Key("Escape"),
        Wait(5),
        Key("F"),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-perspective"),
        Scroll(at(918, 356), 3),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-perspective-wheel-zoom"),
        Key("F"),
        Wait(30),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-zoom-window")),
        Wait(5),
        Press(at(830, 280)),
        MoveTo(900, 330),
        Wait(2),
        MoveTo(1010, 430),
        Wait(5),
        Screenshot("12-zoom-window-box"),
        Release,
        Wait(30),
        MoveTo(120, 560),
        Wait(3),
        Screenshot("13-zoomed-to-window"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-previous")),
        Wait(30),
        MoveTo(120, 560),
        Wait(3),
        Screenshot("14-previous-view"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-perspective")),
        Wait(10),
        Key("F"),
        Wait(30),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-zoom-window")),
        Wait(5),
        Drag(at(820, 280), at(1000, 430)),
        Wait(30),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-named")),
        WaitFor("named-views"),
        Wait(5),
        MoveTo(120, 560),
        Wait(3),
        Screenshot("15-named-views-panel"),
        Click(ui("named-view-name-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("Upright hole"),
        Click(ui("named-view-add")),
        Wait(10),
        ExpectText("named-view-0", "Upright hole"),
        MoveTo(120, 560),
        Wait(3),
        Screenshot("16-named-view-saved"),
        ClickAt(120, 560),
        Wait(3),
        Key("Shift+5"),
        Wait(30),
        Key("F"),
        Wait(30),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-hidden-edges")),
        Wait(12),
        Click(ui("view-render-hidden-removed")),
        Wait(10),
        MoveTo(120, 560),
        Wait(3),
        Screenshot("17-view-changed"),
        Click(ui("named-view-0")),
        Wait(30),
        MoveTo(120, 560),
        Wait(3),
        Screenshot("18-named-view-restored"),
        Click(ui("named-views-close")),
        Wait(5),
        Key("F"),
        Wait(30),
        RightClick(xyz(-22, -8, 22)),
        WaitFor("viewport-zoom-to-selection"),
        Hover(ui("viewport-zoom-to-selection")),
        Wait(5),
        Screenshot("19-zoom-to-selection-item"),
        Click(ui("viewport-zoom-to-selection")),
        Wait(30),
        MoveTo(120, 560),
        Wait(3),
        Screenshot("20-zoomed-to-selection"),
        Custom("fixture pneumatic_cylinder_ex2"),
        Wait(10),
        Click(ui("tab-cylinder-parts")),
        Wait(30),
        Key("F"),
        Wait(30),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-hidden-edges")),
        Wait(12),
        Click(ui("view-render-hidden-visible")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("21-parts-tab-hidden-edges-visible"),
        Click(ui("tab-cylinder-assembly")),
        Wait(30),
        Key("F"),
        Wait(40),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Hover(ui("view-shaded")),
        Wait(12),
        Click(ui("view-render-translucent")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("22-assembly-tab-own-mode"),
        Click(ui("tab-cylinder-parts")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("23-parts-tab-mode-kept"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-named")),
        WaitFor("named-views"),
        Wait(5),
        Click(ui("named-view-name-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("Cylinder parts fitted"),
        Click(ui("named-view-add")),
        Wait(10),
        ExpectText("named-view-0", "Cylinder parts fitted"),
        Hover(ui("named-view-0")),
        Wait(30),
        Screenshot("24-parts-tab-named-view-hovered"),
        Click(ui("tab-cylinder-assembly")),
        Wait(30),
        WaitFor("named-views-empty"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("25-assembly-tab-own-empty-list"),
    ],
)
