// Placing and moving parts with their wires (points are millimetres on the sheet, Y up):
// 01 A, R: the resistor turned while it follows the pointer, the crosshair on its anchor; 02
// placed level, an L of wire from its left pin; 03 the resistor dragged down 5.08 mm: the wire
// stays on the pin and its corner slides, so both legs stay square; 04 R (rotate) over it: the
// wires stay on the pins, square, clear of the body; 05 L, a label: the crosshair on the wire
// (its square filled: it connects) with the dots of the grid; 06 placed on the wire.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-add-board")),
        WaitFor("pcb-name-edit"),
        Key("Ctrl+A"),
        Type("Wiring"),
        Key("Enter"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        Custom("eda-zoom 76.2 83.82 127 119.38"),
        MoveTo(900, 500),
        Key("A"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("resistor"),
        WaitFor("eda-chooser-device-r"),
        Click(ui("eda-chooser-device-r")),
        Click(ui("eda-chooser-ok")),
        Hover(flat(101.6, 101.6)),
        Key("R"),
        Hover(flat(101.6, 101.6)),
        Wait(2),
        Screenshot("01-turned-while-placing"),
        Click(flat(101.6, 101.6)),
        // An L of wire from the left pin.
        Key("W"),
        Click(flat(97.79, 101.6)),
        Click(flat(87.63, 101.6)),
        Click(flat(87.63, 111.76)),
        DoubleClick(flat(87.63, 111.76)),
        Key("Escape"),
        MoveTo(1100, 900),
        Screenshot("02-wired"),
        Drag(flat(101.6, 101.6), flat(101.6, 96.52)),
        Key("Escape"),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("03-dragged"),
        Hover(flat(101.6, 96.52)),
        Key("R"),
        Key("Escape"),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("04-rotated"),
        Key("L"),
        WaitFor("eda-label-dialog"),
        Click(ui("eda-label-text-field")),
        Type("SIG"),
        Click(ui("eda-label-ok")),
        Hover(flat(87.63, 106.68)),
        Wait(2),
        Screenshot("05-label-crosshair"),
        Click(flat(87.63, 106.68)),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("06-label-placed"),
    ],
)
