// T5 / S20: Use keeps its link. "The projection updates when the source changes. A source that
// disappears puts the sketch in an error state." A 50 × 30 box, 25 high (Part 1). Sketch 2 on its
// top face uses the face (U, click): four black lines with link glyphs; ✓. Editing Sketch 1's 50
// to 80 makes the box longer, and Sketch 2 (on the face) follows with its projected lines.
// Deleting Extrude 1 removes their source: Sketch 2's row turns red, and editing it shows the
// orphaned lines and their link glyphs in red.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0.45, 0.3),
        MoveWorld(49.12, 33.17),
        Wait(2),
        ClickWorld(49.12, 33.17),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        ClickWorld(25, 15),
        Wait(3),
        Key("Enter"),
        Wait(3),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(xyz(25, 15, 25)),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("U"),
        Wait(2),
        ClickWorld(25, 12),
        Wait(4),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-face-used-in-sketch-2"),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-sketch-2-on-part-1"),
        // Edit the source: Sketch 1's 50 becomes 80.
        DoubleClick(ui("feature-sketch-1")),
        WaitFor("sketch-dialog"),
        Wait(4),
        DoubleClick(ui("dim-label-50")),
        Wait(4),
        Key("Ctrl+A"),
        Type("80"),
        Key("Enter"),
        Wait(4),
        Click(ui("sketch-dialog-accept")),
        Wait(4),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("03-source-edited-projection-follows"),
        DoubleClick(ui("feature-sketch-2")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Key("N"),
        Wait(40),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-sketch-2-lines-80-long"),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        // Delete the source.
        RightClick(ui("feature-extrude-1")),
        WaitFor("feature-context-menu"),
        Wait(3),
        Click(ui("feature-delete")),
        Wait(4),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("05-source-deleted-sketch-2-in-error"),
        DoubleClick(ui("feature-sketch-2")),
        WaitFor("sketch-dialog"),
        Wait(4),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-orphaned-projections-red"),
    ],
)
