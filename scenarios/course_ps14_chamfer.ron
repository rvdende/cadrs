// P3.6 / PS14.7–14.9: the Chamfer dialog on a 60 × 40 × 30 block and a Ø20 × 30 cylinder
// (values asserted in `cadrs_core/tests/applied.rs` and the kernel's `chamfer_options`).
// 01 Chamfer 1: a vertical edge of the block picked ("Edge of Extrude 1"), Equal distance 5 mm,
//    Offset.
// 02 PS14.8 Two distances 3 and 8 mm: 3 on the edge's first face, 8 on the other.
// 03 the opposite-direction arrow (its icon turned to show the flip): the distances trade faces.
// 04 PS14.8 Distance and angle 5 mm × 30°.
// 05 PS14.9 the top edge of the front face picked: tangent propagation takes only it (its ends
//    meet the neighbours at corners); a second edge in Direction overrides flips that edge alone,
//    previewed with Entities active again (the override edge's bevel runs the other way round).
// 06 PS14.7 the cylinder's top rim, Offset 8 mm; 07 Tangent: along the faces' tangent planes.
//    The side face is straight across the rim (the cylinder curves around it, not across it), so
//    the tangent distance is the offset distance and the bevel is the same (the chord
//    2R·sin(atan(d/R)/2) applies only where a face curves across the edge: kernel
//    `chamfer_options`).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 60 40 circle 110 20 10"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(30, 20, 0)),
        Click(xyz(110, 20, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Enter"),
        Key("F"),
        Click(ui("chamfer")),
        WaitFor("chamfer-dialog"),
        Click(xyz(60, 0, 15)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-chamfer-equal-5"),
        Click(ui("chamfer-type")),
        Click(ui("chamfer-type-option-1")),
        Click(ui("chamfer-distance-field")),
        Key("Ctrl+A"),
        Type("3"),
        Key("Tab"),
        Click(ui("chamfer-distance2-field")),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-two-distances-3-8"),
        Click(ui("chamfer-distance-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-flipped"),
        Click(ui("chamfer-type")),
        Click(ui("chamfer-type-option-2")),
        Click(ui("chamfer-distance-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        Click(ui("chamfer-angle-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-distance-and-angle-5-30"),
        Click(xyz(30, 0, 30)),
        Click(ui("chamfer-overrides-field")),
        Click(xyz(30, 0, 30)),
        MoveTo(1420, 900),
        Wait(3),
        Click(ui("chamfer-entities-field")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-second-edge-direction-override"),
        Click(ui("chamfer-dialog-accept")),
        Click(ui("chamfer")),
        WaitFor("chamfer-dialog"),
        Click(xyz(120, 20, 30)),
        Click(ui("chamfer-distance-field")),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-cylinder-rim-offset-8"),
        Click(ui("chamfer-measurement")),
        Click(ui("chamfer-measurement-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-cylinder-rim-tangent-8"),
    ],
)
