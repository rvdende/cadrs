// The P3I.5 sheet metal dialogs, each from the Sheet metal model ▾ and with nothing picked yet, to
// compare with Onshape's: Tab (`help/feature-tools/sheetmetaltab-dialog.png`), Jog (`sm-jog-01.png`),
// Corner (`sheetmetalcorner-dialog.png`), Bend relief (`sheetmetalbendrelief-dialog.png`), Corner
// break Fillet and Chamfer (`sm-cornerbreak-01.png`), Finish sheet metal model (`smm-finish-01.png`,
// with the warning of exercise E4); then Search tools finding Bend.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-tab")),
        WaitFor("sheet-metal-tab-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-tab-dialog"),
        Key("Escape"),
        Wait(10),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-jog")),
        WaitFor("sheet-metal-jog-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-jog-dialog"),
        Key("Escape"),
        Wait(10),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-corner")),
        WaitFor("sheet-metal-corner-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-corner-dialog"),
        Key("Escape"),
        Wait(10),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-bend-relief")),
        WaitFor("sheet-metal-bend-relief-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-bend-relief-dialog"),
        Key("Escape"),
        Wait(10),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-corner-break")),
        WaitFor("sheet-metal-corner-break-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-corner-break-dialog"),
        Click(ui("sm-corner-break-type-1")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05b-corner-break-chamfer"),
        Key("Escape"),
        Wait(10),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-finish")),
        WaitFor("sheet-metal-finish-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-finish-dialog"),
        Key("Escape"),
        Wait(10),
        Click(ui("search-tools")),
        Wait(10),
        Type("bend"),
        Wait(10),
        Screenshot("07-search-tools"),
        Key("Escape"),
        Wait(5),
    ],
)
