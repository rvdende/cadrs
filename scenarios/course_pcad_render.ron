// P3F.6 (`intro-to-parametric-cad.md` P3.6; `intro-to-parametric-cad-gaps.md`, "P3.6
// rendering"): a photorealistic render of the Control Arm (`Custom("control-arm")`, two parts),
// Part 1 in Aluminum - 6061 (a metal: its own colour, roughness 0.32) and Part 2 blue ABS (a
// dielectric), through Render Studio. The PNG goes to `target/exports/course_pcad_render/`.
// 01 the Control Arm in its Part Studio, turned to the view the render will use.
// 02 the "+" menu: Create Render Studio.
// 03 the Render tab: the panel (Model Part Studio 1, Environment Studio, Background, Ground
//    shadow, Camera Trimetric, Perspective, Output, Materials with the parts' PBR finish) and
//    the path-traced preview with its ground shadow.
// 04 Environment Outdoor, Camera "Current view" (the Part Studio's view from 01).
// 05 Soft light on a white background, the Top view, orthographic.
// 06 back to Studio and Trimetric in perspective; Render…: the dialog (File name "Control Arm",
//    1920 × 1080, Draft (16 samples), the folder).
// 07 the render in progress, paused at 6 of 16 samples (a scripted hold): the progress bar and
//    the partial image.
// 08 the result: 1920 × 1080, 16 samples, denoised; the toast names Control Arm.png.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("clear-dir target/exports/course_pcad_render"),
        Custom("control-arm"),
        Wait(120),
        Custom("part-look 1 - Aluminum - 6061"),
        Custom("part-look 2 #2980B9 ABS"),
        Wait(10),
        Custom("view 25 32"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-control-arm"),
        Click(ui("insert-tab")),
        WaitFor("create-render-studio"),
        Hover(ui("create-render-studio")),
        Wait(8),
        Screenshot("02-create-render-studio"),
        Click(ui("create-render-studio")),
        WaitFor("render-panel"),
        Wait(10),
        MoveTo(1420, 1000),
        Wait(3),
        Screenshot("03-render-tab-preview"),
        Click(ui("render-environment")),
        Wait(5),
        Click(ui("render-environment-option-2")),
        Wait(5),
        Click(ui("render-view")),
        Wait(5),
        Click(ui("render-view-option-0")),
        Wait(5),
        MoveTo(1420, 1000),
        Wait(3),
        Screenshot("04-outdoor-current-view"),
        Click(ui("render-environment")),
        Wait(5),
        Click(ui("render-environment-option-1")),
        Wait(5),
        Click(ui("render-background")),
        Wait(5),
        Click(ui("render-background-option-1")),
        Wait(5),
        Click(ui("render-view")),
        Wait(5),
        Click(ui("render-view-option-7")),
        Wait(5),
        Click(ui("render-perspective")),
        Wait(5),
        MoveTo(1420, 1000),
        Wait(3),
        Screenshot("05-soft-white-top-orthographic"),
        Click(ui("render-environment")),
        Wait(5),
        Click(ui("render-environment-option-0")),
        Wait(5),
        Click(ui("render-background")),
        Wait(5),
        Click(ui("render-background-option-0")),
        Wait(5),
        Click(ui("render-view")),
        Wait(5),
        Click(ui("render-view-option-2")),
        Wait(5),
        Click(ui("render-perspective")),
        Wait(5),
        Click(ui("render-start")),
        WaitFor("render-dialog"),
        Wait(5),
        Click(ui("render-dialog-name")),
        Key("Ctrl+A"),
        Type("Control Arm"),
        Click(ui("render-dialog-resolution")),
        Wait(5),
        Click(ui("render-dialog-resolution-option-1")),
        Wait(3),
        Click(ui("render-dialog-quality")),
        Wait(5),
        Click(ui("render-dialog-quality-option-0")),
        Wait(3),
        Click(ui("render-dialog-folder")),
        Wait(2),
        Key("Ctrl+A"),
        Type("target/exports/course_pcad_render"),
        Wait(3),
        Screenshot("06-render-dialog"),
        Custom("render-hold 6"),
        Wait(2),
        Click(ui("render-dialog-ok")),
        Wait(10),
        MoveTo(1420, 1000),
        Screenshot("07-render-progress"),
        Custom("render-hold off"),
        Wait(5),
        Screenshot("08-render-result"),
    ],
)
