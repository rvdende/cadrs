// Sheet metal loft (P3I.9, SM19.2; `help/feature-tools/sheet-metal-loft-dialog-01.png`,
// `sheet-metal-loft-profile2-01.png`, `sheet-metal-loft-match-01.png`): a 100 × 80 rectangle on
// Top and a Ø60 circle 60 above it. The Loft from the Sheet metal model's ▾: the empty dialog
// (New | Add, Profile 1, Profile 2, Connections, Chordal tolerance 1 mm, General open, Material
// and Relief closed), the rectangle's region as Profile 1 and the circle's as Profile 2 (a
// square-to-round transition of planar facets, ripped at its matched start), Connections on (the
// matched start as a connection, its magenta line and two handles), Add connection (an empty
// connection whose field takes a point on each profile: an edge of the rectangle and a point of
// the circle's edge), ripped there (the loft now rips at that connection instead of its matched
// start: still one part), a coarser chordal tolerance (fewer facets; Tab, then a click off the fields so none is left
// selected),
// accepted with no warning. Then Loft Add (`sm9 loft-add`): a plate and a line above it beside
// one edge; the loft from the plate's edge to the line is joined to the plate by a bend: one
// part, one flat.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sm9 loft-profiles"),
        Wait(10),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Screenshot("01-menu-loft-enabled"),
        Click(ui("sheet-metal-menu-loft")),
        WaitFor("sheet-metal-loft-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-dialog"),
        Click(xyz(40, -35, 0)),
        Wait(10),
        Click(xyz(18, -12, 60)),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-lofted"),
        Click(ui("sm9-connections-checkbox")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-connections"),
        Click(ui("sm-loft-add-connection")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04b-add-connection-picking"),
        Click(xyz(50, -20, 0)),
        Wait(30),
        Click(xyz(27.86, -11.14, 60)),
        Wait(40),
        Click(ui("sm9-rip-1-checkbox")),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-ripped-connection"),
        Click(ui("sm-loft-chordal-tolerance-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("4"),
        Key("Tab"),
        Wait(5),
        // Out of the fields (Tab left Thickness focused, its text selected for typing over).
        Click(at(1420, 900)),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-chordal-tolerance-4"),
        Click(ui("sheet-metal-loft-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-accepted"),
        // Loft Add onto a plate's edge.
        Custom("sm9 loft-add"),
        Wait(60),
        Custom("view 30 35 195 0 20 0.25"),
        Wait(20),
        Click(ui("sheet-metal-model-caret")),
        Wait(5),
        Click(ui("sheet-metal-menu-loft")),
        WaitFor("sheet-metal-loft-dialog"),
        Wait(10),
        Click(ui("sheet-metal-loft-op-1")),
        Wait(10),
        Click(xyz(170, 0, 1)),
        Wait(10),
        Click(ui("sm-loft-profile1-field")),
        Wait(3),
        Click(xyz(220, 0, 0)),
        Wait(10),
        Click(ui("sm-loft-profile2-field")),
        Wait(3),
        Click(xyz(250, 0, 40)),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-loft-add-on-an-edge"),
        Click(ui("sheet-metal-loft-dialog-accept")),
        Wait(30),
        Key("Escape"),
        Click(ui("panel-sheet-metal")),
        Wait(60),
        Click(ui("smt-context")),
        Wait(10),
        Click(ui("smt-context-option-1")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-loft-add-one-flat"),
    ],
)
