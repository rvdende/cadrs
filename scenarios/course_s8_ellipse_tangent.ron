// Final re-audit / S8 (the phase 2 gaps "tangent to an ellipse" and "intersection inference"):
// an ellipse (90 × 40) and a line above it. Tangent (T), then the line, then the ellipse: the
// line drops onto the ellipse, touching it, with a tangent glyph (01, 02). A second line drawn
// across the ellipse; a third line's end, near where the second crosses the ellipse, snaps to
// the crossing (the intersection square, 03), and the click puts its end on both (04).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Click(ui("sketch-circle-caret")),
        WaitFor("sketch-variant-ellipse"),
        Wait(2),
        Click(ui("sketch-variant-ellipse")),
        Wait(2),
        ClickWorld(0, 0),
        ClickWorld(45, 0),
        ClickWorld(20, 20),
        Wait(4),
        Type("90"),
        Key("Enter"),
        Wait(4),
        Type("60"),
        Key("Enter"),
        Wait(4),
        Key("Escape"),
        Wait(2),
        Key("L"),
        Wait(2),
        ClickWorld(-50, 38),
        ClickWorld(40, 30),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("T"),
        Wait(2),
        ClickWorld(0, 34),
        Wait(2),
        MoveWorld(-30, -22.36),
        Wait(3),
        Screenshot("01-tangent-tool-line-picked"),
        ClickWorld(-30, -22.36),
        Wait(5),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("02-line-tangent-to-ellipse"),
        Key("L"),
        Wait(2),
        ClickWorld(-10, -40),
        ClickWorld(50, 10),
        Wait(3),
        Key("Escape"),
        Wait(2),
        ClickWorld(-40, -45),
        MoveWorld(-10, -35),
        MoveWorld(2.5, -29.5),
        Wait(3),
        Screenshot("03-snaps-to-ellipse-crossing"),
        ClickWorld(2.5, -29.5),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04-end-on-the-crossing"),
    ],
)
