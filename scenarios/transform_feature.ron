// Onshape import: the Transform feature (values asserted in `cadrs_core/tests/transform.rs`).
// 01 a 60 × 40 × 20 block, Part 1 picked in the Parts list, the toolbar's Transform: the dialog
//    opens on Translate by line with Part 1 in Parts to transform.
// 02 Translate by XYZ, X 90 mm, Z 30 mm: the block moved, amber outlines where it was.
// 03 Copy part on: the block stays and a moved copy (the preview tint) appears.
// 04 accepted: "Transform 1" in the feature list, two parts.
// 05 a second Transform: Rotate Part 1 45° about its vertical edge at the origin: the dialog with
//    the axis field and the angle.
// 06 accepted: "Transform 2" in the list, the block turned about that edge.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 60 40"),
        Wait(5),
        Key("P"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(30, 20, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Wait(20),
        Key("F"),
        Wait(40),
        Scroll(at(560, 700), -6.0),
        Wait(20),
        Click(ui("part-row-part-1")),
        Wait(3),
        Click(ui("transform")),
        WaitFor("transform-dialog"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-transform-dialog-parts"),
        Click(ui("transform-type")),
        Wait(3),
        Click(ui("transform-type-option-2")),
        Wait(5),
        Click(ui("transform-x-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("90"),
        Key("Tab"),
        Wait(5),
        Click(ui("transform-z-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-translate-xyz"),
        Click(ui("transform-copy-checkbox")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-copy-part"),
        Click(ui("transform-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-accepted-two-parts"),
        Click(ui("part-row-part-1")),
        Wait(3),
        Click(ui("transform")),
        WaitFor("transform-dialog"),
        Wait(5),
        Click(ui("transform-type")),
        Wait(3),
        Click(ui("transform-type-option-4")),
        Wait(5),
        Click(xyz(0, 0, 10)),
        Wait(5),
        Click(ui("transform-angle-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("45"),
        Key("Tab"),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-rotate-about-edge"),
        Click(ui("transform-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-accepted-rotated"),
    ],
)
