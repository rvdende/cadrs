// Gear (`cadrs_core::gear`, issue #179). A Ø44 x 10 disc; the toolbar's Gear with its cylinder
// picked: a spur gear's teeth cut into it, 20 of them to bring the module nearest 2 mm, the field
// showing the module; the tooth line set to Helical; accepted. Then Gear with nothing picked: a
// gear made whole, a Ring gear of 40 teeth, moved 80 mm along X; accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        SetTimeout(60.0),
        Custom("sketch top circle 0 0 22"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(0, 0, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Enter"),
        Key("F"),
        Click(ui("gear")),
        WaitFor("gear-dialog"),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("01-gear-dialog"),
        Click(xyz(15.556, -15.556, 5)),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("02-teeth-on-the-cylinder"),
        Click(ui("gear-style")),
        Click(ui("gear-style-option-1")),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("03-helical"),
        Click(ui("gear-dialog-accept")),
        Click(ui("gear")),
        WaitFor("gear-dialog"),
        Click(ui("gear-type")),
        Click(ui("gear-type-option-1")),
        Click(ui("gear-teeth-field")),
        Key("Ctrl+A"),
        Type("40"),
        Key("Tab"),
        Click(ui("gear-x-field")),
        Key("Ctrl+A"),
        Type("80"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("04-ring-gear-made-whole"),
        Click(ui("gear-dialog-accept")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("05-both"),
    ],
)
