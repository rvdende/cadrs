// P3C.3 / D8, Ex1 Universal Joint Drawing (intro-to-drawings.md D8, ex1-step1..9, target
// ex1-drawing.png) on the stand-in flange (`cadrs_core::samples::ujoint`,
// `fixtures/ujoint_flange_standin.cadrs`: Onshape's public document can't be copied; the yoke is
// built from the drawing's own dimensions, in inches). Sheet points are `world(x, y)` in sheet
// mm on the ANSI A sheet (third angle, 1:2: 1 in of the part is 12.7 mm). Front's origin is at
// (66, 65.85), Top's at (66, 170.8), Right's at (180, 65.85).
// 01 (ex1-step1, D8.1) the copied stand-in: Part Studio "Universal Joint", its features and the
//    part "Universal Joint Flange (stand-in)", isometric.
// 02 (ex1-step2, D8.2) "+" → Create Drawing….
// 03 (ex1-step3, D8.3) ANSI filter, ANSI_A_INCH.dwt, No views.
// 04 (ex1-step4, D8.4) Insert view: the part picked in the browser, Front, 1:2, following the
//    cursor.
// 05 (D8.4, D8.5) Front placed; the tool is Projected view: Top above, Right beside, Isometric
//    up-right, then Esc.
// 06 (ex1-step5, D8.5) the isometric view at 1:4 (View properties) and shaded; hidden lines and
//    phantom tangent edges on the three orthographic views; the title block shows the part:
//    "Universal Joint Flange (stand-in)" / "Made by cadrs", 1:2.
// 07 (ex1-step6, D8.6) the drawing tab's menu, Rename…; 07b the new name typed in the tab; 08
//    renamed "Universal Joint Flange Drawing" (a long name ends in "…" in the tab).
// 09 (ex1-step7, D8.7) Centermark: the top view's centre and its four counterbores, the right
//    view's cross hole. 10 the Centerline ▾ menu; 11 line-to-line centerlines on the
//    counterbored holes' sides (front and right views), the first one's end being dragged up
//    (extended); 12 a 3 point circle centerline through the lug holes' centres in the right
//    view.
// 12b the callout's right-click menu (Edit…); 13 (ex1-step8, D8.8) Hole callout on a top-view
//    counterbore, placed right of it; its Edit… dialog with the Prefix 4x, previewed live on the
//    callout (orange while edited); 14 both callouts with their prefixes (4x, 8x).
// 15 (ex1-step9, D8.9) Diameter (Shift+D) on the flange: Ø4.750 following the cursor (orange);
//    15b (D6.3) with D, the hovered edge's snap points in orange; 15c the Dimension ▾ menu;
//    16 every dimension placed: Ø4.750, 3.282, 2.061 (top), 6.000, 2.600 (front), 2.500, 43.0°,
//    120.0° (angular), Ø1.750, Ø1.250 (right), 3 decimals and 1 for angles, no leading zeros
//    (inch); 17 the finished drawing (ex1-drawing.png).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("ujoint-flange"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1500, 900),
        Wait(3),
        Screenshot("01-flange-part-studio"),
        Click(ui("insert-tab")),
        WaitFor("create-drawing"),
        Hover(ui("create-drawing")),
        Wait(5),
        Screenshot("02-plus-menu-create-drawing"),
        Click(ui("create-drawing")),
        WaitFor("create-drawing-dialog"),
        Click(ui("template-filter-1")),
        Click(ui("template-row-ANSI_A_INCH.dwt")),
        MoveTo(1400, 950),
        Wait(3),
        Screenshot("03-create-drawing-ansi-a-inch"),
        Click(ui("create-drawing-ok")),
        WaitFor("insert-view-dialog"),
        Click(ui("browser-part-1-1")),
        Click(ui("insert-view-scale")),
        Click(ui("insert-view-scale-option-1")),
        MoveWorld(66, 97),
        Wait(25),
        MoveWorld(66, 97.6),
        Wait(10),
        Screenshot("04-insert-view-front-1-2"),
        ClickWorld(66, 97.6),
        MoveWorld(66, 170),
        Wait(25),
        ClickWorld(66, 170.8),
        MoveWorld(180, 97),
        Wait(25),
        ClickWorld(180, 97.6),
        MoveWorld(227, 181),
        Wait(25),
        ClickWorld(228, 182),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("05-four-views"),
        // D8.5: the isometric view at 1:4, shaded.
        RightClick(world(228, 182)),
        Click(ui("view-menu-properties")),
        WaitFor("view-properties-dialog"),
        Click(ui("view-props-scale")),
        Click(ui("view-props-scale-option-2")),
        Click(ui("view-props-ok")),
        RightClick(world(228, 170)),
        Click(ui("view-menu-shaded")),
        // Hidden lines and phantom tangent edges on Front, Top and Right.
        RightClick(world(66, 97.6)),
        Click(ui("view-menu-hidden-lines")),
        RightClick(world(66, 98)),
        Hover(ui("view-menu-tangent-edges")),
        Wait(8),
        Click(ui("view-menu-tangent-phantom")),
        RightClick(world(66, 170.8)),
        Click(ui("view-menu-hidden-lines")),
        RightClick(world(66, 171)),
        Hover(ui("view-menu-tangent-edges")),
        Wait(8),
        Click(ui("view-menu-tangent-phantom")),
        RightClick(world(180, 97.6)),
        Click(ui("view-menu-hidden-lines")),
        RightClick(world(180, 98)),
        Hover(ui("view-menu-tangent-edges")),
        Wait(8),
        Click(ui("view-menu-tangent-phantom")),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("06-iso-shaded-hidden-phantom"),
        // D8.6: rename the drawing tab.
        RightClick(ui("tab-drawing-1")),
        WaitFor("tab-rename"),
        Hover(ui("tab-rename")),
        Wait(5),
        Screenshot("07-tab-menu-rename"),
        Click(ui("tab-rename")),
        Type("Universal Joint Flange Drawing"),
        Screenshot("07b-tab-rename-typing"),
        Key("Enter"),
        MoveTo(1500, 960),
        Wait(3),
        Screenshot("08-tab-renamed"),
        // D8.7: centermarks on the top view's centre and counterbores, and the cross hole.
        Click(ui("drawing-centermark")),
        ClickWorld(66, 140.64),
        ClickWorld(55.69, 149.959),
        ClickWorld(55.69, 191.641),
        ClickWorld(81.867, 149.959),
        ClickWorld(81.867, 191.641),
        ClickWorld(187.94, 113.475),
        MoveWorld(190.9, 123.017),
        Wait(8),
        Screenshot("09-centermarks"),
        Key("Escape"),
        // Line-to-line centerlines on the counterbored holes' sides (hidden lines).
        Click(ui_at("drawing-centerline", 0.85, 0.5)),
        WaitFor("drawing-centerline-line-to-line"),
        Hover(ui("drawing-centerline-line-to-line")),
        Wait(5),
        Screenshot("10-centerline-menu"),
        Click(ui("drawing-centerline-line-to-line")),
        ClickWorld(51.224, 61.0),
        ClickWorld(54.602, 61.0),
        ClickWorld(77.398, 61.0),
        ClickWorld(80.776, 61.0),
        ClickWorld(157.47, 61.0),
        ClickWorld(160.85, 61.0),
        ClickWorld(199.15, 61.0),
        ClickWorld(202.53, 61.0),
        Key("Escape"),
        // Extended after placing: select each front one and drag its top end up.
        ClickWorld(52.913, 58.0),
        Press(world(52.913, 65.85)),
        MoveWorld(52.913, 68.0),
        Wait(2),
        MoveWorld(52.913, 71.0),
        Wait(5),
        Screenshot("11-centerline-extended"),
        Release,
        Wait(5),
        ClickWorld(79.087, 58.0),
        Drag(world(79.087, 65.85), world(79.087, 71.0)),
        Key("Escape"),
        // A 3 point circle centerline through the lug holes' centres.
        Click(ui_at("drawing-centerline", 0.85, 0.5)),
        WaitFor("drawing-centerline-3-point-circle"),
        Click(ui("drawing-centerline-3-point-circle")),
        ClickWorld(170.458, 123.017),
        ClickWorld(189.542, 123.017),
        ClickWorld(189.542, 103.933),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("12-centerlines-circle-centerline"),
        // D8.8: hole callouts, with their prefixes typed in Edit….
        Click(ui("drawing-hole-callout")),
        ClickWorld(81.867, 149.959),
        MoveWorld(99, 146),
        Wait(5),
        ClickWorld(100, 146),
        ClickWorld(191.231, 123.017),
        MoveWorld(213, 128),
        Wait(5),
        ClickWorld(214, 128),
        Key("Escape"),
        RightClick(world(108, 146)),
        Hover(ui("annotation-menu-edit")),
        Wait(5),
        Screenshot("12b-callout-menu-edit"),
        Click(ui("annotation-menu-edit")),
        WaitFor("hole-callout-dialog"),
        Type("4x"),
        Screenshot("13-hole-callout-prefix"),
        Click(ui("hole-callout-ok")),
        RightClick(world(222, 128)),
        Click(ui("annotation-menu-edit")),
        WaitFor("hole-callout-dialog"),
        Type("8x"),
        Key("Enter"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("14-hole-callouts"),
        // D8.9: Ø4.750 with the Diameter tool (Shift+D).
        Key("Shift+D"),
        ClickWorld(66, 200.96),
        MoveWorld(111, 196.5),
        Wait(3),
        MoveWorld(112, 197),
        Wait(5),
        Screenshot("15-diameter-dimension"),
        ClickWorld(112, 197),
        Key("Escape"),
        Key("D"),
        // D6.3: the hovered edge's snap points in orange (the one under the cursor larger).
        MoveWorld(52.913, 104),
        Wait(3),
        MoveWorld(49.49, 101),
        Wait(5),
        Screenshot("15b-dimension-snap-points"),
        // 3.282 and 2.061 between hole centres.
        ClickWorld(52.913, 149.959),
        ClickWorld(52.913, 191.641),
        MoveWorld(25, 170.8),
        Wait(3),
        ClickWorld(25, 170.8),
        ClickWorld(52.913, 149.959),
        ClickWorld(79.087, 149.959),
        MoveWorld(66, 136.8),
        Wait(3),
        ClickWorld(66, 136.8),
        // 6.000 and 2.600 in the front view.
        ClickWorld(58, 59.5),
        ClickWorld(42.7, 135.7),
        MoveWorld(24, 97.6),
        Wait(3),
        ClickWorld(24, 97.6),
        ClickWorld(49.49, 95),
        ClickWorld(82.51, 95),
        MoveWorld(66, 88),
        Wait(3),
        ClickWorld(66, 88),
        // 2.500, Ø1.750 and Ø1.250 in the right view.
        ClickWorld(164.125, 95),
        ClickWorld(195.875, 95),
        MoveWorld(180, 142),
        Wait(3),
        ClickWorld(180, 142),
        ClickWorld(168.89, 113.475),
        MoveWorld(148, 113.475),
        Wait(3),
        ClickWorld(148, 113.475),
        ClickWorld(185.614, 107.861),
        MoveWorld(212, 100),
        Wait(3),
        ClickWorld(212, 100),
        Key("Escape"),
        // 43.0° and 120.0° with the Angular tool.
        Click(ui_at("drawing-dimension", 0.85, 0.5)),
        WaitFor("drawing-dim-angular"),
        Hover(ui("drawing-dim-angular")),
        Wait(5),
        Screenshot("15c-dimension-menu"),
        Click(ui("drawing-dim-angular")),
        ClickWorld(165.71, 131.26),
        ClickWorld(175.24, 135.7),
        MoveWorld(155.5, 129.8),
        Wait(3),
        ClickWorld(155.5, 129.8),
        ClickWorld(157.14, 70.25),
        ClickWorld(152.3, 65.85),
        MoveWorld(140, 75),
        Wait(3),
        ClickWorld(140, 75),
        Key("Escape"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("16-dimensions"),
        ClickWorld(250, 100),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("17-finished-drawing"),
    ],
)
