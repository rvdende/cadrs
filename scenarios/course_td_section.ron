// P3E.3a (PS2.9, X14, IR5.5, A3.3, X15): Section view, every step through the UI.
// The drawing bracket (`samples::drawing_bracket`: a 120 × 80 × 12 plate with four Ø10 holes at
// (±45, ±25) and a 16 mm upright on the Front plane with a Ø24 hole):
// 01 the bottom-right Section view tool: the Section view dialog, its plane field waiting.
// 02 the Front plane picked in the feature list: the front half removed, the cut faces capped
//    in the part's colour with their outlines (the upright's hole cut in half); the Front plane
//    stays selected while the dialog is open (its row and square highlighted) and the blue drag
//    arrow points to the removed side.
// 03 the flip button: the other half removed (seen from inside, the caps face away); the arrow
//    turns round, and the plane's outline hides behind the kept part.
// 04 Offset 25 mm: the plane moved through the plate's front holes (cut, capped around them);
//    the section plane drawn there (orange, round the parts) with its offset arrow.
// 05 ✓: the section stays with the dialog closed; 06 the view menu reads "Exit section view";
// 07 Exit section view: the whole bracket again.
// 08 IR5.5: the feature menu of Sketch 2 (on Front) → Section view…: the dialog with
//    "Sketch 2" as its plane (drawn orange, its row highlighted), the bracket cut through the
//    upright; 09 ✕ ends it.
// 10 A3.3, X15: the Pneumatic Cylinder assembly (`fixtures/pneumatic_cylinder_ex2.cadrs`); the
//    barrel's context menu in the view, its Section view… item; 11 picked: the assembly cut by
//    the Front plane through the barrel's middle, the barrel, piston and rod capped; 12 ✓ (the
//    barrel no longer selected: no orange on its cut).
// 13 Exit section view, the barrel clicked: its triad; the triad origin's menu, Section view…;
//    14 picked: the section through the barrel from the triad (nothing left selected).
// 15 IR5.5 on the drawing bracket again (in a new Part Studio tab): Sketch 2's feature menu open on Section view….
// 16 a planar face as the section plane: the Section view tool, the plate's top face picked:
//    the upright cut off at the plate (capped), the face selected and the plane drawn orange at
//    it; 17 its
//    arrow dragged up from its foot on the plane (z = 12) to z = 50: the plane follows the
//    pointer 1:1 (Offset 1.5 in = 38 mm, P3E.3a judge) and the cut with it.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("drawing-bracket"),
        Wait(60),
        Key("F"),
        Wait(30),
        Click(ui("view-section")),
        WaitFor("section-dialog"),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-section-dialog"),
        Click(ui("feature-front")),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        ExpectText("section-planes", "Front plane"),
        Screenshot("02-front-plane-capped"),
        Click(ui("section-flip")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-flipped"),
        Click(ui("section-flip")),
        Wait(10),
        Click(ui("section-offset-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("25"),
        Key("Enter"),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-offset-25"),
        Click(ui("section-dialog-accept")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-accepted"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(8),
        ExpectText("view-section-item", "Exit section view"),
        Screenshot("06-exit-section-item"),
        Click(ui("view-section-item")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-exited"),
        RightClick(ui("feature-sketch-2")),
        WaitFor("feature-section-view"),
        Wait(3),
        Click(ui("feature-section-view")),
        WaitFor("section-dialog"),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        ExpectText("section-planes", "Sketch 2"),
        Screenshot("08-from-feature-menu"),
        Click(ui("section-dialog-cancel")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-cancelled"),
        Custom("fixture pneumatic_cylinder_ex2"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        Key("F"),
        Wait(40),
        RightClick(at(900, 520)),
        WaitFor("asm-section"),
        Hover(ui("asm-section")),
        Wait(3),
        Screenshot("10-instance-menu"),
        Click(ui("asm-section")),
        WaitFor("section-dialog"),
        Wait(90),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-assembly-section"),
        Click(ui("section-dialog-accept")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-assembly-section-accepted"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(5),
        Click(ui("view-section-item")),
        Wait(10),
        Click(at(900, 520)),
        Wait(10),
        RightClick(ui("triad-origin")),
        WaitFor("asm-section"),
        Hover(ui("asm-section")),
        Wait(3),
        Screenshot("13-triad-menu"),
        Click(ui("asm-section")),
        WaitFor("section-dialog"),
        Wait(90),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("14-triad-section"),
        Click(ui("section-dialog-accept")),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-part-studio"),
        Click(ui("create-part-studio")),
        Wait(10),
        Custom("drawing-bracket"),
        Wait(60),
        Key("F"),
        Wait(30),
        RightClick(ui("feature-sketch-2")),
        WaitFor("feature-section-view"),
        Hover(ui("feature-section-view")),
        Wait(5),
        Screenshot("15-feature-menu-section-item"),
        Key("Escape"),
        Wait(5),
        // Nothing selected (the right-click selected Sketch 2): the face is the only plane.
        Key("Space"),
        Wait(5),
        Click(ui("view-section")),
        WaitFor("section-dialog"),
        Wait(5),
        Click(xyz(-50, 0, 12)),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("16-face-reference"),
        Drag(xyz(0, 0, 12), xyz(0, 0, 50)),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("17-arrow-dragged"),
    ],
)
