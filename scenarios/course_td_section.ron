// P3E.3a (PS2.9, X14, IR5.5, A3.3, X15): Section view, every step through the UI.
// The drawing bracket (`samples::drawing_bracket`: a 120 × 80 × 12 plate with four Ø10 holes at
// (±45, ±25) and a 16 mm upright on the Front plane with a Ø24 hole):
// 01 the bottom-right Section view tool: the Section view dialog, its plane field waiting.
// 02 the Front plane picked in the feature list: the front half removed, the cut faces capped
//    in the part's colour with their outlines (the upright's hole cut in half).
// 03 the flip button: the other half removed (seen from inside, the caps face away).
// 04 Offset 25 mm: the plane moved through the plate's front holes (cut, capped around them).
// 05 ✓: the section stays with the dialog closed; 06 the view menu reads "Exit section view";
// 07 Exit section view: the whole bracket again.
// 08 IR5.5: the feature menu of Sketch 2 (on Front) → Section view…: the dialog with
//    "Sketch 2" as its plane, the bracket cut through the upright; 09 ✕ ends it.
// 10 A3.3, X15: the Pneumatic Cylinder assembly (`fixtures/pneumatic_cylinder_ex2.cadrs`); the
//    barrel's context menu in the view, its Section view… item; 11 picked: the assembly cut by
//    the Front plane through the barrel's middle, the barrel, piston and rod capped; 12 ✓.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("drawing-bracket"),
        Wait(60),
        Key("F"),
        Wait(30),
        Click(ui("view-section")),
        WaitFor("section-dialog"),
        Wait(5),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-section-dialog"),
        Click(ui("feature-front")),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        ExpectText("section-plane", "Front plane"),
        Screenshot("02-front-plane-capped"),
        Click(ui("section-flip")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-flipped"),
        Click(ui("section-flip")),
        Wait(10),
        Click(ui("section-offset-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("25"),
        Key("Enter"),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-offset-25"),
        Click(ui("section-dialog-accept")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-accepted"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Wait(8),
        ExpectText("view-section-item", "Exit section view"),
        Screenshot("06-exit-section-item"),
        Click(ui("view-section-item")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-exited"),
        RightClick(ui("feature-sketch-2")),
        WaitFor("feature-section-view"),
        Wait(3),
        Click(ui("feature-section-view")),
        WaitFor("section-dialog"),
        Wait(60),
        MoveTo(1420, 900),
        Wait(3),
        ExpectText("section-plane", "Sketch 2"),
        Screenshot("08-from-feature-menu"),
        Click(ui("section-dialog-cancel")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-cancelled"),
        Custom("fixture pneumatic_cylinder_ex2"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        Key("F"),
        Wait(40),
        RightClick(at(900, 520)),
        WaitFor("asm-section"),
        Hover(ui("asm-section")),
        Wait(3),
        Screenshot("10-instance-menu"),
        Click(ui("asm-section")),
        WaitFor("section-dialog"),
        Wait(90),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-assembly-section"),
        Click(ui("section-dialog-accept")),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-assembly-section-accepted"),
    ],
)
