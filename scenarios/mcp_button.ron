// The top bar's AI assistants (MCP) button and its menu: off (the robot struck through), the
// port changed from the menu's popup, then put back with Reset; the Preferences' port field and
// its Reset follow. The scheme button beside it steps light, dark, system.
Scenario(
    start: Some("landing"),
    seed_documents: 2,
    steps: [
        WaitFor("mcp"),
        Screenshot("01-top-bar"),
        Click(ui("mcp")),
        WaitFor("mcp-menu"),
        Screenshot("02-mcp-menu-off"),
        Click(ui("mcp-port")),
        WaitFor("mcp-port-popup"),
        Key("Ctrl+A"),
        Type("7691"),
        Key("Enter"),
        Click(ui("mcp")),
        WaitFor("mcp-menu"),
        ExpectText("mcp-menu", "7691"),
        Screenshot("03-mcp-menu-port-7691"),
        Click(ui("mcp-port-reset")),
        Click(ui("mcp")),
        WaitFor("mcp-menu"),
        ExpectText("mcp-menu", "7680"),
        Key("Escape"),
        Click(ui("mcp")),
        Click(ui("mcp-preferences")),
        WaitFor("preferences-dialog"),
        ExpectText("pref-mcp-port-field", "7680"),
        Click(ui("pref-mcp-port-field")),
        Key("Ctrl+A"),
        Type("7692"),
        ExpectText("pref-mcp-endpoint", "7692"),
        Screenshot("04-preferences-port"),
        Click(ui("pref-mcp-port-reset")),
        ExpectText("pref-mcp-endpoint", "7680"),
        Click(ui("pref-cancel")),
        Click(ui("color-scheme")),
        Click(ui("color-scheme")),
        Screenshot("05-dark"),
    ],
)
