// T3 / S10.1: "The Point tool places points on the plane or on entities. Points can be
// dimensioned and constrained." Point (Shift+S). A line; a point placed on the plane, one on
// the line (coincident with it) and one at its midpoint (midpoint inference). The Dimension
// tool dimensions the free point from the origin (vertical 22, then horizontal 30); dragging the
// point on the line slides it along the line.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("L"),
        Wait(2),
        ClickWorld(-50, -20),
        ClickWorld(40, -20),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Shift+S"),
        Wait(2),
        ClickWorld(-25, 22),
        Wait(2),
        MoveWorld(22, -20),
        Wait(3),
        Screenshot("01-point-tool-on-line"),
        ClickWorld(22, -20),
        Wait(2),
        MoveWorld(-5, -20),
        Wait(3),
        Screenshot("02-midpoint-inference"),
        ClickWorld(-5, -20),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("03-three-points"),
        Key("D"),
        Wait(2),
        ClickWorld(-25, 22),
        Click(world(0, 0)),
        ClickWorld(-40, 10),
        Wait(4),
        Type("22"),
        Key("Enter"),
        Wait(4),
        ClickWorld(-25, 22),
        Click(world(0, 0)),
        ClickWorld(-12, 32),
        Wait(4),
        Type("30"),
        Key("Enter"),
        Wait(4),
        Key("Escape"),
        Wait(2),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04-point-dimensioned"),
        DragWorld(22, -20, 34, -20),
        Wait(4),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("05-point-dragged-along-line"),
    ],
)
