// CAM Studio on a plasma table: the with-hole plate (60 × 40 × 10 with a Ø16 hole through,
// `Custom("with-hole")`) cut from sheet on a LinuxCNC (QtPlasmaC) plasma table. The program goes
// to `target/exports/cam_studio_plasma/`.
// 01 Create machine: the catalogue by type, the plasma table chosen (no tool changer, no
//    canned cycles; the torch's post settings).
// 02 Create tool: the plasma torch (kerf, pierce delay and height, cut height, torch height
//    control).
// 03 Create toolpath: Cut, kerf compensated: the hole first, then the outline, each pierced in
//    the scrap and led in on an arc, the part on the right (the torch's good side).
// 04 the Beam tab: power, passes, microjoints, small holes slower.
// 05 Verify: the kerf cut out of the sheet; the part comes free.
// 06 Post: the QtPlasmaC program (torch on M3 $0 S1, pierce dwell, torch off M5 $0).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        // The frame-stats panel off (F12: profile, fps, hidden).
        Key("F12"),
        Key("F12"),
        Custom("clear-dir target/exports/cam_studio_plasma"),
        Custom("with-hole"),
        Wait(3),
        Click(ui("insert-tab")),
        WaitFor("create-cam-studio"),
        Click(ui("create-cam-studio")),
        WaitFor("cam-tree"),
        Click(ui("cam-tb-insert")),
        WaitFor("cam-insert-part"),
        Click(ui("cam-insert-part")),
        WaitFor("cam-dialog"),
        Click(ui("cam-dialog-accept")),
        Wait(5),
        Click(ui("cam-tb-job")),
        WaitFor("cam-dialog"),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Custom("cam fit"),
        Click(ui("cam-tb-machine")),
        WaitFor("cam-dialog"),
        Click(ui("cam-f-machine")),
        Click(ui("cam-f-machine-option-8")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-plasma-machine"),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-setup")),
        WaitFor("cam-dialog"),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-tool")),
        WaitFor("cam-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-plasma-torch"),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-toolpath")),
        WaitFor("cam-dialog"),
        MoveTo(1420, 900),
        Wait(10),
        Screenshot("03-cut-preview"),
        Click(ui("cam-f-tab-3")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-beam-tab"),
        Click(ui("cam-dialog-accept")),
        Wait(5),
        Click(ui("cam-tb-preview")),
        WaitFor("cam-preview-bar"),
        Click(ui("cam-pv-verify")),
        Custom("cam preview-end"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("05-verify-sheet"),
        ExpectText("cam-pv-readout", "1 part free"),
        Click(ui("cam-pv-close")),
        Custom("cam select setup 0"),
        Click(ui("cam-tb-post")),
        WaitFor("cam-export-dialog"),
        Click(ui("cam-export-folder")),
        Key("Ctrl+A"),
        Type("target/exports/cam_studio_plasma"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-post"),
        // QtPlasmaC: its preamble, the torch codes, no Z.
        ExpectText("cam-export-preview", "G21 G40 G49 G64 P0.1 G80 G90 G92.1 G94 G97"),
        ExpectText("cam-export-preview", "M3 $0 S1"),
        Click(ui("cam-export-ok")),
        Wait(3),
    ],
)
