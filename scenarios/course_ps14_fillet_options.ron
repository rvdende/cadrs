// P3.10 / PS14.6, PS18.3 and the P3.8 judge's fillet preview: the Fillet dialog's further
// options on two 60 × 40 × 30 blocks (values asserted in
// `cadrs_core/tests/part_studio_options.rs`: `variable_and_asymmetric_fillets`,
// `one_fillet_on_two_parts`; the kernel's `fillet_asymmetric`, `fillet_variable_radius`).
// 01 PS14.6 Asymmetric: the front right vertical edge, Radius 4 and Second radius 10 (with its
//    flip): the round is the quarter ellipse with those semi-axes; the picked edge stays drawn in
//    the selection colour over the preview, whole (no specks where the round hides it).
// 02 the asymmetric flip: the radii swap faces.
// 03 Variable fillet: Vertices (the edge's bottom and top, picked in the view, which shows the
//    parts before the fillet while that field takes picks) with R2 and R8, Smooth transition
//    off: the radius runs linearly from 2 up to 8; each vertex's radius is labelled in the view
//    ("2 mm", "8 mm", P3.11, P3.10 judge). As the course lays it out
//    (`lesson-fillet-and-chamfer.png`): an entry per vertex, "[2 mm] Vertex of Extrude 1",
//    with its Radius and Magnitude nested under it (Magnitude disabled: it belongs to the
//    Curvature cross section, out of scope as niche).
// 04 Add point on edge, then the edge: a point halfway along it, R12, between the vertices'
//    radii; its entry "[12 mm] Edge of Extrude 1" with Edge, Location, Radius and Magnitude,
//    CLEAR at the group's top right; the vertex entries collapsed; the point's "12 mm" label halfway up.
// 05 why Magnitude is disabled, on hover.
// 06 P3.11 Partial fillet (fix round 1): R10 on the same edge between Parameter 0.25 and 0.75
//    (the defaults): the round runs along the middle half of the edge only and stops at a flat
//    end face square to the edge at each bound (`partial_fillet`, conformance
//    `fillet_partial`); the rows nested under the checkbox: Boundary type, First bound with its
//    flip, Second bound.
// 06b Boundary type Length, First bound 0 and Second bound 12 mm, flipped: the round runs 12 mm
//    down from the edge's top end, and ends there as the whole fillet does.
// 06c Smooth fillet corners (Final): what it does, on hover.
// 07 PS18.3 one fillet on both blocks: an edge of each, R6; accepted, both parts are rounded
//    and stay separate parts.
// 08 (Final, PS14.6) a new Fillet, R6, on the three edges meeting at the second block's back
//    top corner (160, 40, 30), close up: OCCT's default corner, the three fillets closed by a
//    sphere where they meet.
// 09 Smooth fillet corners on: the fillets end 9 mm (1.5 × R) from the vertex and one patch,
//    tangent to all six faces round it (G1, conformance `fillet_smooth_corner`), blends the
//    corner; the other options' rows are unchanged (it turns Asymmetric, Partial and Variable
//    off).
// 10 accepted: the smooth corner in the part.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 60 40"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(30, 20, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Enter"),
        Custom("sketch top rect 100 0 160 40"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(130, 20, 0)),
        Click(ui("extrude-operation-0")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Enter"),
        Key("F"),
        Key("Shift+F"),
        WaitFor("fillet-dialog"),
        Click(xyz(60, 0, 15)),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("4"),
        Key("Tab"),
        Click(ui("fillet-asymmetric-checkbox")),
        Click(ui("fillet-second-radius-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-asymmetric-4-and-10"),
        Click(ui("fillet-second-radius-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-asymmetric-flipped"),
        Click(ui("fillet-variable-checkbox")),
        Click(xyz(60, 0, 0)),
        Click(xyz(60, 0, 30)),
        Click(ui("fillet-vertex-radius-0-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("fillet-vertex-radius-1-field")),
        Key("Ctrl+A"),
        Type("8"),
        Key("Tab"),
        Click(ui("fillet-smooth-transition-checkbox")),
        Click(ui("fillet-entities-field")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-variable-vertices-2-to-8"),
        Click(ui("fillet-add-point")),
        Click(xyz(60, 0, 15)),
        Click(ui("fillet-point-radius-0-field")),
        Key("Ctrl+A"),
        Type("12"),
        Key("Tab"),
        Click(ui("fillet-vertex-0-toggle")),
        Click(ui("fillet-vertex-1-toggle")),
        Click(ui("fillet-entities-field")),
        ExpectText("fillet-point-0-title", "[12 mm] Edge of"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-point-on-edge-r12"),
        Hover(ui("fillet-point-magnitude-0")),
        Wait(40),
        Screenshot("05-magnitude-why"),
        Click(ui("fillet-variable-checkbox")),
        Click(ui("fillet-partial-checkbox")),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Tab"),
        Click(ui("fillet-entities-field")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-partial-fillet"),
        Click(ui("fillet-partial-bound")),
        Click(ui("fillet-partial-bound-option-1")),
        Click(ui("fillet-partial-first-field")),
        Key("Ctrl+A"),
        Type("0"),
        Key("Tab"),
        Click(ui("fillet-partial-second-field")),
        Key("Ctrl+A"),
        Type("12"),
        Key("Tab"),
        Click(ui("fillet-partial-first-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06b-partial-length-flipped"),
        Hover(ui("fillet-smooth-corners")),
        Wait(40),
        Screenshot("06c-smooth-corners-tooltip"),
        Click(ui("fillet-partial-checkbox")),
        Click(ui("fillet-entities-field")),
        Click(xyz(160, 0, 15)),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Tab"),
        Click(ui("fillet-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-one-fillet-two-parts"),
        Custom("view 130 30 152 32 24 0.045"),
        Key("Shift+F"),
        WaitFor("fillet-dialog"),
        Click(xyz(160, 40, 15)),
        Click(xyz(160, 25, 30)),
        Click(xyz(140, 40, 30)),
        Click(ui("fillet-size-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-three-fillets-default-corner"),
        Click(ui("fillet-smooth-corners-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-smooth-fillet-corners"),
        Click(ui("fillet-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-smooth-corner-accepted"),
    ],
)
