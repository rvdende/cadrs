// P3B.3 / A11.1–A11.3, A10.1, A12.1–A12.3, A7.9, A7.10: Tangent (with propagation over a tangent
// chain), Planar + Tangent in a curved slot, and Width, on the mates stand-in
// (`fixtures/mates_standin.cadrs`): the Ramp, the Clevis, the Cam Plate and the Table fixed; the
// Roller, the Cam Pin, the Ball, the Tab and the two Jaws.
// 01 the parts inserted.
// 02 (A11.1, A11.2) Tangent: two entity picks (the Roller's cylindrical face, the Ramp's flat top),
//    no connectors; Tangent propagation on by default: the roller rests on the picked face.
// 03–04 (A11.2) the roller dragged back: over the R15 fillet (03) and up the slope (04): the
//    contact follows the tangent chain.
// 05 (A11.1, A10.1) Tangent: the Cam Pin's side and the slot's outer wall: inside it (the side
//    the pin is on is taken).
// 06 (A10.1) Planar: the slot's floor and the pin's top edge, Offset Z −16 mm (the pin's height):
//    its bottom on the floor. 07 accepted: Planar + Tangent keep the pin in the curved slot.
// 08–09 (A10.1, A11.2) the pin dragged along the slot: it follows the arc (08) and stops at the
//    slot's round end (09).
// 09a (A11.1) Tangent, the Ball on the Table's top; 09b (A11.3) Flip: the other side of the
//    plane: under the table (seen from the front).
// 10 (A12.1) Width: two Tab connectors on the Tab (its front face, its back top edge); the Width
//    field takes the picks next.
// 11 (A12.2) picking the Tab again for the Width field is refused: the field turns red.
// 12 (A12.3) the Clevis's inner top edges as the Width pair: the Tab centred between them.
// 13 accepted: "Width 1".
// 14 (A12.3) a second Width: one tab on each Jaw, their outer faces (the Right Jaw's picked in
//    the Back view): they move mirror-symmetric about the centre plane.
// 15 accepted: the two Jaws (same X, apart in Y) mirror-symmetric about the clevis's centre plane;
//    15b the same from the top: the jaws equally far either side of the clevis's centre plane.
// 16 the left jaw dragged further out: the right jaw follows the other way (mirror-symmetric).
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture mates_standin"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Ramp"),
        Wait(5),
        Click(ui("insert-part-ramp")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Roller"),
        Wait(5),
        Click(ui("insert-part-roller")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Clevis"),
        Wait(5),
        Click(ui("insert-part-clevis")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Tab"),
        Wait(5),
        Click(ui("insert-part-tab")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Jaw"),
        Wait(5),
        Click(ui("insert-part-left-jaw")),
        Wait(3),
        Click(ui("insert-part-right-jaw")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Cam"),
        Wait(5),
        Click(ui("insert-part-cam-plate")),
        Wait(3),
        Click(ui("insert-part-cam-pin")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Table"),
        Wait(5),
        Click(ui("insert-part-table")),
        Wait(3),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Ball"),
        Wait(5),
        Click(ui("insert-part-ball")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        RightClick(ui("instance-row-3")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        RightClick(ui("instance-row-7")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        RightClick(ui("instance-row-9")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        Click(at(1500, 880)),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        MoveTo(1500, 880),
        Wait(2),
        Screenshot("01-inserted"),
        // A11: Tangent, the roller on the ramp's flat top.
        Click(ui("mate-tangent")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(77.07, 0, 67.07)),
        Wait(3),
        Click(xyz(77.07, 0, 67.07)),
        Wait(5),
        Hover(xyz(94, -20, 10)),
        Wait(3),
        Click(xyz(94, -20, 10)),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("02-a11.1-tangent-on-the-picked-face"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        // A11.2: rolled back over the fillet and up the slope.
        Press(xyz(97, 0, 27)),
        Hover(xyz(92, 0, 27)),
        Wait(2),
        Hover(xyz(86, 0, 27)),
        Wait(2),
        Hover(xyz(80, 0, 28)),
        Wait(2),
        Hover(xyz(76, 0, 30)),
        Wait(2),
        Hover(xyz(72, 0, 32)),
        Wait(5),
        Screenshot("03-a11.2-over-the-fillet"),
        Hover(xyz(68, 0, 35)),
        Wait(2),
        Hover(xyz(64, 0, 38)),
        Wait(2),
        Hover(xyz(60, 0, 41)),
        Wait(2),
        Hover(xyz(56, 0, 44)),
        Wait(5),
        Screenshot("04-a11.2-up-the-slope"),
        Release,
        Wait(5),
        // A10.1: the Cam Pin in the curved slot: Tangent, then Planar (zoomed in on the plate).
        Click(ui("mate-tangent")),
        WaitFor("mate-dialog"),
        Wait(3),
        Scroll(xyz(-20, -90, 5), 4),
        Wait(30),
        Hover(xyz(-16.46, -83.54, 12)),
        Wait(3),
        Click(xyz(-16.46, -83.54, 12)),
        Wait(5),
        Hover(xyz(-8.03, -77.11, 7)),
        Wait(3),
        Wait(3),
        Click(xyz(-8.03, -77.11, 7)),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("05-a10.1-tangent-inside-the-slot-wall"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        Click(ui("mate-planar")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(-3.5, -81.4, 4)),
        Wait(3),
        Click(xyz(-3.5, -81.4, 4)),
        Wait(5),
        Hover(xyz(-16.46, -83.54, 20)),
        Wait(3),
        Click(xyz(-16.46, -83.54, 20)),
        Wait(5),
        // The pin's top 16 mm above the floor: its bottom on the floor.
        Click(ui("mate-offset-checkbox")),
        Wait(5),
        Click(ui("mate-offset-z")),
        Key("Ctrl+A"),
        Type("-16 mm"),
        Key("Enter"),
        Wait(5),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("06-a10.1-planar-offset-bottom-on-the-floor"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("07-a10.1-planar-and-tangent"),
        // The pin along the slot, from its end round to the other.
        Press(xyz(5.98, -95, 19)),
        Hover(xyz(2, -88, 20)),
        Wait(2),
        Hover(xyz(-5, -82, 20)),
        Wait(2),
        Hover(xyz(-12, -79, 20)),
        Wait(2),
        Hover(xyz(-20, -78, 20)),
        Wait(5),
        Screenshot("08-a10.1-pin-follows-the-arc"),
        Hover(xyz(-28, -79, 20)),
        Wait(2),
        Hover(xyz(-36, -83, 20)),
        Wait(2),
        Hover(xyz(-44, -90, 20)),
        Wait(2),
        Hover(xyz(-50, -97, 20)),
        Wait(2),
        Hover(xyz(-56, -104, 20)),
        Wait(5),
        Screenshot("09-a11.2-pin-stops-at-the-round-end"),
        Release,
        Wait(5),
        Key("F"),
        Wait(30),
        // A11.3: Flip, on the Ball and the Table's top.
        Click(ui("mate-tangent")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(245.77, -5.77, 15.77)),
        Wait(3),
        Click(xyz(245.77, -5.77, 15.77)),
        Wait(5),
        Hover(xyz(350, -20, 8)),
        Wait(3),
        Click(xyz(350, -20, 8)),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("09a-a11.1-ball-on-the-table"),
        Click(ui("mate-flip")),
        Wait(8),
        // Seen from the front: the ball against the table's underside.
        Key("Shift+1"),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("09b-a11.3-flip-the-other-side-seen-from-the-front"),
        Key("Shift+7"),
        Wait(40),
        Click(ui("mate-flip")),
        Wait(5),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        // A12: Width, one instance's two tabs.
        Click(ui("mate-width")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(148, 40, 32)),
        Wait(3),
        Click(xyz(148, 40, 32)),
        Wait(5),
        Hover(xyz(140, 52, 40)),
        Wait(3),
        Click(xyz(140, 52, 40)),
        Wait(5),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("10-a12.1-two-tabs"),
        Hover(xyz(150, 40, 22)),
        Wait(3),
        Click(xyz(150, 40, 22)),
        Wait(5),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("11-a12.2-no-instance-in-both"),
        Hover(xyz(140, -15, 40)),
        Wait(3),
        Click(xyz(140, -15, 40)),
        Wait(5),
        Hover(xyz(140, 15, 40)),
        Wait(3),
        Click(xyz(140, 15, 40)),
        Wait(8),
        // Everything in view (P3B.3 judge: this frame's framing).
        Key("F"),
        Wait(40),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("12-a12.3-tab-centred"),
        AssertEnabled("mate-dialog-accept"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("13-width-accepted"),
        Key("F"),
        Wait(30),
        // A12.3: one tab on each of two instances.
        Click(ui("mate-width")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(180, 40, 20)),
        Wait(3),
        Click(xyz(180, 40, 20)),
        Wait(5),
        // The Right Jaw's outer face (+Y) faces away: picked from the Back view (the two
        // outer faces, so the jaws end mirror-symmetric).
        Key("Shift+2"),
        Wait(40),
        Hover(xyz(180, 72, 20)),
        Wait(3),
        Click(xyz(180, 72, 20)),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        Hover(xyz(150, -15, 40)),
        Wait(3),
        Click(xyz(150, -15, 40)),
        Wait(5),
        Hover(xyz(150, 15, 40)),
        Wait(3),
        Click(xyz(150, 15, 40)),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("14-a12.3-two-instances-mirror"),
        AssertEnabled("mate-dialog-accept"),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("15-a12.3-accepted-mirrored"),
        // Seen from the top: the jaws the same distance either side of the clevis's centre.
        Key("Shift+5"),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1500, 880),
        Wait(3),
        Screenshot("15b-a12.3-mirrored-seen-from-the-top"),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        // The left jaw dragged further out (−Y): the right jaw follows the other way.
        // On the left jaw's top face (y −16 … −8 once centred; the press was on the Tab before
        // the Width's centre plane was fixed, Final part 3).
        Press(xyz(180, -12, 30)),
        Hover(xyz(180, -16, 30)),
        Wait(2),
        Hover(xyz(180, -22, 30)),
        Wait(2),
        Hover(xyz(180, -28, 30)),
        Wait(5),
        Screenshot("16-a12.3-drag-keeps-mirror"),
        Release,
        Wait(5),
    ],
)
