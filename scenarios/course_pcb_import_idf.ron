// P3H.3 (PCB3.1, PCB3.4, PCB3.7, PCB4.3, PCB4.4): Import ECAD files into a PCB Studio. Compare
// `ex2-step4-import-ecad-dialog.png` (the dialog: Choose Files, "No file chosen", Import /
// Cancel), `v4-import-idf-poster.png` (an imported board in iso: green board, coloured
// components, the board bold and blue under Boards) and `v3-interface-poster.png` (two boards).
// 01 the empty studio's Import ECAD files dialog; 02 Choose Files: the multi-select picker in
//    fixtures/idf/vision controller with Vision PCB.emn and (Ctrl+click) Vision PCB.emp picked;
// 03 back in the dialog: "2 files chosen"; 04 imported: Vision PCB shown in iso, zoomed to fit,
//    bold and blue under Boards and listed under Components, the export and create-assembly
//    buttons enabled; 05 a second import (the secondary board pair, chosen by the scenario);
// 06 two boards, the secondary board shown and active; 07 Vision PCB clicked under Boards: shown
//    again at once (cached), bold and blue; 08 its Components node expanded (packages with part
//    numbers and counts); 09 the view orbited and zoomed (camera controls work as in a Part
//    Studio); 10 the secondary board clicked under Components.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-import")),
        WaitFor("pcb-import-dialog"),
        Screenshot("01-import-dialog"),
        Click(ui("pcb-import-choose")),
        WaitFor("pcb-import-picker"),
        Click(ui("pcb-import-picker-row-fixtures")),
        WaitFor("pcb-import-picker-row-idf"),
        Click(ui("pcb-import-picker-row-idf")),
        WaitFor("pcb-import-picker-row-vision controller"),
        Click(ui("pcb-import-picker-row-vision controller")),
        WaitFor("pcb-import-picker-row-Vision PCB.emn"),
        Click(ui("pcb-import-picker-row-Vision PCB.emn")),
        KeyDown("Ctrl"),
        Click(ui("pcb-import-picker-row-Vision PCB.emp")),
        KeyUp("Ctrl"),
        Hover(ui("pcb-import-picker-open")),
        Wait(10),
        Screenshot("02-choose-files"),
        Click(ui("pcb-import-picker-open")),
        ExpectText("pcb-import-chosen", "2 files chosen"),
        Screenshot("03-two-files-chosen"),
        Click(ui("pcb-import-ok")),
        WaitFor("pcb-board-vision-pcb"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("04-vision-imported"),
        Click(ui("pcb-import")),
        WaitFor("pcb-import-dialog"),
        Custom("pcb-choose secondary board/secondary board.emn;secondary board/secondary board.emp"),
        ExpectText("pcb-import-chosen", "2 files chosen"),
        Screenshot("05-second-import"),
        Click(ui("pcb-import-ok")),
        WaitFor("pcb-board-secondary-board"),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("06-two-boards"),
        Click(ui("pcb-board-vision-pcb")),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("07-switched-to-vision"),
        Click(ui_at("pcb-components-vision-pcb", 0.06, 0.5)),
        Screenshot("08-components-expanded"),
        RightDrag(at(900, 600), at(960, 560)),
        Scroll(at(900, 520), 2),
        Wait(10),
        Screenshot("09-orbit-zoom"),
        Click(ui("pcb-components-secondary-board")),
        MoveTo(1100, 900),
        Wait(5),
        Screenshot("10-secondary-from-components"),
    ],
)
