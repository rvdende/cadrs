// T2 / S13.1: "While sketching: after placing geometry, type a number and press Enter. This
// works for nearly all tools." A line: its length box opens beside it (without taking the
// keyboard, so the tool's keys still work; `dimension/sketchdims-linebox.png`); typing 50 and
// Enter makes it 50 long with an aligned dimension (`sketchdims-linedim.png`), and the chain
// goes on from the moved end. Back over the end and out again for a tangent arc: its radius box;
// 20 and Enter. The line tool continues from the arc's end.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(-60, -20),
        ClickWorld(-18, -20.3),
        MoveWorld(-5, -35),
        Wait(3),
        Screenshot("01-line-placed-length-box"),
        Type("50"),
        Screenshot("02-typing-50"),
        Key("Enter"),
        MoveWorld(0, -35),
        Wait(3),
        Screenshot("03-line-is-50-chain-goes-on"),
        MoveWorld(-10, -20),
        MoveWorld(10, -8),
        MoveWorld(20, 0),
        Wait(3),
        ClickWorld(20, 0),
        MoveWorld(40, 30),
        Wait(3),
        Screenshot("04-tangent-arc-radius-box"),
        Type("20"),
        Key("Enter"),
        MoveWorld(40, 30),
        Wait(3),
        Screenshot("05-arc-radius-20"),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-line-and-arc-dimensioned"),
    ],
)
