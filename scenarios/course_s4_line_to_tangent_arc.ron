// T2 / S4.6: "Line → tangent arc transition: in the Line tool, hover an endpoint and move away
// to draw a tangent arc without switching tools." (`circle_arc/line-to-arc-01.png`) A line;
// moving away from its end shows the next line; moving back over the end point and out again
// turns the rubber band into a tangent arc (with its center dot and live radius). The click
// places the arc (coincident and tangent), and the tool goes on with a line from the arc's end.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(-50, -30),
        ClickWorld(-10, 10),
        MoveWorld(0, -10),
        MoveWorld(10, -20),
        Wait(3),
        Screenshot("01-next-segment-is-a-line"),
        MoveWorld(0, 0),
        MoveWorld(-10, 10),
        Wait(3),
        Screenshot("02-back-over-the-end-point"),
        MoveWorld(0, 22),
        MoveWorld(15, 20),
        MoveWorld(28, 5),
        Wait(3),
        Screenshot("03-out-again-tangent-arc"),
        ClickWorld(28, 5),
        MoveWorld(40, -25),
        Wait(3),
        Screenshot("04-arc-placed-line-resumes"),
        ClickWorld(40, -25),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("05-line-arc-line-tangent"),
    ],
)
