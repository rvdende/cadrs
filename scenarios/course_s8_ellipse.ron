// T3 / S8: "Ellipse: three clicks: the center, the major axis end, then the minor axis extent."
// (`reference/onshape/entity_tools/ellipse-02.png`, `ellipse-04.png`) Circle ▾ → Ellipse. After
// the center, the preview is already an ellipse with its major radius; after the major axis it
// follows the cursor with both radii. Placing it opens the major axis box (90), then the
// minor one (40): axis dimensions drawn across the whole axes, as in ellipse-04 (the help calls
// them the axis diameters). Only its center is a point. Accepted and selected, its region reads
// π·45·20 = 2827.433 mm².
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Click(ui("sketch-circle-caret")),
        WaitFor("sketch-variant-ellipse"),
        Click(ui("sketch-variant-ellipse")),
        ClickWorld(0, 0),
        MoveWorld(20, 10),
        MoveWorld(38, 12),
        Wait(3),
        Screenshot("01-major-axis"),
        ClickWorld(38, 12),
        MoveWorld(15, 20),
        MoveWorld(8, 22),
        Wait(3),
        Screenshot("02-minor-axis"),
        ClickWorld(8, 22),
        Screenshot("03-major-radius-box"),
        Type("90"),
        Key("Enter"),
        Type("40"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1350, 850),
        Wait(3),
        Screenshot("04-axes-90-40"),
        Click(ui("sketch-dialog-accept")),
        ClickWorld(-10, 5),
        Screenshot("05-region-area"),
    ],
)
