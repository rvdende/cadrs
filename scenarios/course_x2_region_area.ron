// T1 / X2: region selection and the Area readout (intro-to-sketching.md X2; compare
// training/intro-to-sketching/ex1-step8.png and ex2-step16.png). A 100 x 60 rectangle with a
// Ø30 hole: in the sketch, clicking inside the rectangle (away from its edges) selects the region:
// it turns light orange and the bottom right of the viewport reads "Area: 5293.142 mm²"
// (6000 - π·15², the hole excluded). Clicking the hole instead selects the disc
// (706.858 mm²). Accepted, in the Part Studio, clicking the region selects it the same way
// (orange with an orange outline, as in ex1-step8), and Shift-free clicks add regions: both
// selected read 6000 mm². Clicking empty space clears it.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(-50, -30),
        ClickWorld(50, 30),
        Wait(3),
        Type("100"),
        Key("Enter"),
        Wait(2),
        Type("60"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("C"),
        Wait(2),
        ClickWorld(20, 0),
        ClickWorld(35, 0),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveWorld(-80, -55),
        Wait(2),
        Screenshot("01-rectangle-with-hole"),
        Click(world(-30, 10)),
        Wait(3),
        MoveWorld(-80, -55),
        Wait(2),
        Screenshot("02-sketch-region-selected-area"),
        Click(world(-30, 10)),
        Wait(2),
        Click(world(28, 6)),
        Wait(3),
        MoveWorld(-80, -55),
        Wait(2),
        Screenshot("03-hole-region-selected-area"),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-dialog-accept")),
        Wait(10),
        MoveTo(1400, 800),
        Wait(2),
        Screenshot("04-accepted"),
        Click(world(-30, 10)),
        Wait(3),
        MoveTo(1400, 800),
        Wait(2),
        Screenshot("05-part-studio-region-selected-area"),
        Click(world(28, 6)),
        Wait(3),
        MoveTo(1400, 800),
        Wait(2),
        Screenshot("06-both-regions-area-sums"),
        Click(world(-80, -55)),
        Wait(3),
        Screenshot("07-empty-click-clears"),
    ],
)
