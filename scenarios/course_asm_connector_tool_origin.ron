// P3B.7 / A1.2, A22.2, A16.3, X10: the assembly's own Mate connector tool and mates to the Origin,
// on the mates stand-in (`fixtures/mates_standin.cadrs`): the Table and the Puck.
// 01 (A16.3) Fastened: the Table's top face centre, then the Origin: the Table fastened to the
//    origin; the root row shows it (tooltip).
// 02 (A1.2, A22.3) Ctrl+M in the assembly: the Mate connector dialog; the Puck's top face centre
//    picked, moved −12 mm along Z (to its underside).
// 03 (A22.2, A22.7) accepted: the assembly's connector on the Puck (it stays in the assembly).
// 04 (A22.7) Fastened: the Puck's connector (picked by its glyph) on the Table's top face centre.
// 05 (X10) K hides the connectors in the assembly.
// 06 (A22.2) the Part Studio: no new feature (the connector stays in the assembly).
// 07 (P3B.7 judge) back in the assembly: "Mate connector 1" is a row of the Mate Features list;
//    its menu: Rename, Edit…, Delete. 08 Edit…: the Mate connector dialog on it. 09 Renamed
//    "Puck base" (one undo step).
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture mates_standin"),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Table"),
        Click(ui("insert-part-table")),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Puck"),
        Click(ui("insert-part-puck")),
        Click(ui("insert-dialog-accept")),
        Custom("view 30 30 170 30 0 0.45"),
        // A16.3: the Table fastened to the Origin.
        Click(ui("mate-fastened")),
        WaitFor("mate-dialog"),
        Hover(xyz(330, 0, 8)),
        Wait(3),
        Click(xyz(330, 0, 8)),
        Click(xyz(0, 0, 0)),
        Click(ui("mate-dialog-accept")),
        Custom("view 30 30 0 30 0 0.3"),
        Hover(ui("instance-root-fastened")),
        Wait(60),
        Screenshot("01-a16.3-table-fastened-to-origin"),
        // A1.2, A22.3: Ctrl+M in the assembly; the Puck's top face centre, moved to its underside.
        MoveTo(1400, 880),
        Custom("view 30 30 150 30 0 0.4"),
        Key("Ctrl+M"),
        WaitFor("mate-connector-dialog"),
        Hover(xyz(300, 60, 12)),
        Wait(3),
        Click(xyz(300, 60, 12)),
        Click(ui("mate-connector-move-checkbox")),
        Click(ui("mate-connector-z-field")),
        Key("Ctrl+A"),
        Type("-12 mm"),
        Key("Enter"),
        MoveTo(1400, 880),
        Wait(2),
        Screenshot("02-a1.2-assembly-mate-connector-tool"),
        Click(ui("mate-connector-dialog-accept")),
        MoveTo(1400, 880),
        Wait(2),
        Screenshot("03-a22.2-connector-on-the-puck"),
        // A22.7: the Puck's connector in a Fastened mate, on the Table's top face centre.
        Click(ui("mate-fastened")),
        WaitFor("mate-dialog"),
        Hover(xyz(300, 60, 0)),
        Wait(3),
        Click(xyz(300, 60, 0)),
        Hover(xyz(0, 0, 0)),
        Wait(3),
        Click(xyz(0, 0, 0)),
        Click(ui("mate-dialog-accept")),
        Custom("view 30 30 0 0 0 0.25"),
        MoveTo(1400, 880),
        Wait(2),
        Screenshot("04-a22.7-puck-fastened-on-its-connector"),
        Key("K"),
        Screenshot("05-x10-k-hides-connectors"),
        Key("K"),
        Click(ui("tab-mate-parts")),
        MoveTo(1400, 880),
        Wait(2),
        Screenshot("06-a22.2-part-studio-unchanged"),
        // P3B.7 judge: the assembly's connector is a row of the Mate Features list.
        Click(ui("tab-assembly-1")),
        RightClick(ui("mate-connector-row-mate-connector-1")),
        WaitFor("local-connector-edit"),
        Hover(ui("local-connector-edit")),
        Wait(3),
        Screenshot("07-a22.2-assembly-connector-row-menu"),
        Click(ui("local-connector-edit")),
        WaitFor("mate-connector-dialog"),
        MoveTo(1400, 880),
        Wait(2),
        Screenshot("08-a22.2-assembly-connector-edit"),
        Click(ui("mate-connector-dialog-cancel")),
        RightClick(ui("mate-connector-row-mate-connector-1")),
        WaitFor("local-connector-rename"),
        Click(ui("local-connector-rename")),
        Key("Ctrl+A"),
        Type("Puck base"),
        Key("Enter"),
        MoveTo(1400, 880),
        Wait(2),
        Screenshot("09-a22.2-assembly-connector-renamed"),
    ],
)
