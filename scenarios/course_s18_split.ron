// T4 / S18.1: "Split divides an entity at the clicked point into separate entities. The split
// points can be dimensioned and constrained." (Trim ▾ → Split; `sketch_split.htm`,
// `reference/onshape/edit_tools/bezier-split-01.png`: the curve highlighted, the split point at
// the cursor). A horizontal line and a 3-point arc. With Split, hovering the line highlights it
// with the split point under the cursor; clicking splits it there into two lines sharing that
// point (they stay collinear). Hovering the arc snaps the split point to its midpoint; clicking
// splits the arc in two. The line got its 90 length first (the sketch's first dimension, which
// scales it, S13.3); then the Dimension tool dimensions the line's split point from its left
// end: 30 mm, and the split point slides along the line to it (the rest stays put). A circle
// splits at two points: the first click marks a point, the second splits it into two arcs.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("L"),
        ClickWorld(-50, -20),
        ClickWorld(40, -20),
        Key("Escape"),
        Key("Escape"),
        Key("A"),
        ClickWorld(-40, 10),
        ClickWorld(40, 10),
        ClickWorld(0, 32),
        Key("Escape"),
        Key("D"),
        ClickWorld(-30, -20),
        ClickWorld(-10, -45),
        Type("90"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-line-and-arc"),
        Click(ui("sketch-trim-caret")),
        WaitFor("sketch-variant-split"),
        Screenshot("02-trim-menu-trim-extend-split"),
        Click(ui("sketch-variant-split")),
        MoveWorld(5, -20),
        Wait(3),
        Screenshot("03-hover-line-split-point"),
        ClickWorld(5, -20),
        MoveWorld(1, 32),
        Wait(3),
        Screenshot("04-hover-arc-snaps-to-midpoint"),
        ClickWorld(1, 32),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("05-line-and-arc-split"),
        Key("Escape"),
        Key("D"),
        ClickWorld(5, -20),
        ClickWorld(-50, -20),
        ClickWorld(-20, -30),
        Type("30"),
        Key("Enter"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-split-point-dimensioned"),
        Key("C"),
        ClickWorld(40, -50),
        ClickWorld(52, -50),
        Key("Escape"),
        Key("Escape"),
        Click(ui("sketch-trim-caret")),
        WaitFor("sketch-variant-split"),
        Click(ui("sketch-variant-split")),
        MoveWorld(52, -50),
        Wait(3),
        Screenshot("07-hover-circle-split-point"),
        ClickWorld(52, -50),
        MoveWorld(28, -50),
        Wait(3),
        Screenshot("08-first-point-marked-second-hovered"),
        ClickWorld(28, -50),
        Key("Escape"),
        MoveWorld(40, -38),
        Wait(3),
        Screenshot("09-circle-split-into-two-arcs"),
    ],
)
