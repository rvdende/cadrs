// The Layout's properties and artwork (on the course's finished board, GS18; points are mm, Y
// up): 01 E on R1: its exact position, angle, side and 3D model; 02 moved to x 30, turned 90°;
// 03 text 0.75 mm high, left-aligned; 04 Import graphic: an SVG logo following the pointer;
// 05 placed on the silkscreen; 06 a rectangle drawn, E: its width, filled, net; 07 filled.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("eda-example gs18"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        Custom("eda-zoom -5 -5 60 55"),
        Hover(flat(30.65, 11.46)),
        Key("E"),
        WaitFor("eda-fprops-dialog"),
        Screenshot("01-footprint-properties"),
        Click(ui("eda-fprops-x-field")),
        Key("Ctrl+A"),
        Type("30"),
        Click(ui("eda-fprops-angle-field")),
        Key("Ctrl+A"),
        Type("90"),
        Click(ui("eda-fprops-ok")),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("02-moved-and-turned"),
        Click(ui("pcb-text")),
        WaitFor("eda-btext-dialog"),
        Click(ui("eda-btext-text-field")),
        Type("v1.0.0"),
        Click(ui("eda-btext-height-field")),
        Key("Ctrl+A"),
        Type("0.75"),
        Click(ui("eda-btext-align")),
        WaitFor("eda-btext-align-option-0"),
        Click(ui("eda-btext-align-option-0")),
        Screenshot("03-text-style"),
        Click(ui("eda-btext-ok")),
        Click(flat(4.0, 46.0)),
        Click(ui("pcb-graphic")),
        WaitFor("eda-graphic-picker"),
        Click(ui("eda-graphic-picker-name-field")),
        Type("fixtures/eda/d4_logo.svg"),
        Click(ui("eda-graphic-picker-open")),
        Hover(flat(4.0, 42.0)),
        Wait(2),
        Screenshot("04-graphic-follows"),
        Click(flat(4.0, 42.0)),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("05-graphic-placed"),
        Click(ui("pcb-draw-rect")),
        Click(flat(2.0, 2.0)),
        Click(flat(8.0, 6.0)),
        Key("Escape"),
        Hover(flat(2.0, 4.0)),
        Key("E"),
        WaitFor("eda-sprops-dialog"),
        Click(ui("eda-sprops-filled")),
        Screenshot("06-shape-properties"),
        Click(ui("eda-sprops-ok")),
        MoveTo(1100, 900),
        Wait(2),
        Screenshot("07-filled"),
    ],
)
