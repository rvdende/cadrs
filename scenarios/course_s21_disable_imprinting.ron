// T5 / S21.2: "The Disable imprinting checkbox in the sketch dialog turns it off (for speed, and
// easier region picking)." The box and circle of `course_s21_imprinting`: with imprinting (the
// default) the circle is split by the face's edge. Checking Disable imprinting (an undoable step,
// saved with the sketch) leaves only the circle's own region: clicking on the face inside it
// selects the whole circle ("Area: 314.159 mm²"). Unchecking brings the split back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0.45, 0.3),
        MoveWorld(49.12, 33.17),
        Wait(2),
        ClickWorld(49.12, 33.17),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        ClickWorld(25, 15),
        Wait(3),
        Key("Enter"),
        Wait(3),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(xyz(25, 15, 25)),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("C"),
        Wait(2),
        // Shift: no inference. Unshifted, the centre snaps to the midpoint of the face's right
        // edge (snapping to part edges), which fixes it, and the 50 below would be driven.
        KeyDown("Shift"),
        ClickWorld(50, 15),
        KeyUp("Shift"),
        ClickWorld(60, 15),
        Wait(3),
        Type("20"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        // Its center 50 from the origin: on the face's right edge.
        Key("D"),
        Wait(2),
        ClickWorld(50, 15),
        Wait(2),
        ClickWorld(0, 0),
        Wait(2),
        ClickWorld(25, -8),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Click(world(45, 15)),
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-imprinted-half-selected"),
        Click(world(45, 15)),
        Wait(2),
        Click(ui("sketch-disable-imprinting")),
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("02-imprinting-disabled"),
        Click(world(45, 15)),
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-whole-circle-selected-area"),
        Click(world(45, 15)),
        Wait(2),
        Click(ui("sketch-disable-imprinting")),
        Wait(3),
        Click(world(45, 15)),
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-imprinting-back-half-selected"),
    ],
)
