// T1 / S19.2: the Mirror tool: "pick the mirror line, then the entities. Adds Symmetric
// constraints automatically." (Compare training/intro-to-sketching/ex2-step4.png and
// ex2-step11.png.) A vertical construction line, and on its left a line chain starting on the
// axis, an arc and a circle. Mirror (toolbar; Onshape has no key for it): the first pick is the
// mirror line (yellow), then each entity picked is mirrored at once, the copies linked to their
// sources with Σ Symmetric glyphs; the chain's end on the axis is shared with its copy.
// Dragging a source corner afterwards moves its copy too.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("Q"),
        Key("L"),
        ClickWorld(0, -55),
        ClickWorld(0, 55),
        Key("Escape"),
        Key("Q"),
        ClickWorld(0, -30),
        ClickWorld(-40, -30),
        ClickWorld(-40, 10),
        Key("Escape"),
        Key("Escape"),
        Key("A"),
        ClickWorld(-40, 10),
        ClickWorld(-12, 38),
        ClickWorld(-33, 31),
        Key("Escape"),
        Key("Escape"),
        Key("C"),
        ClickWorld(-22, -12),
        ClickWorld(-15, -12),
        Key("Escape"),
        Key("Escape"),
        Hover(ui("sketch-mirror")),
        Wait(40),
        Screenshot("01-mirror-tool-tooltip"),
        Click(ui("sketch-mirror")),
        MoveWorld(0, 20),
        Wait(2),
        Screenshot("02-mirror-active-hover-line"),
        Click(world(0, 20)),
        Screenshot("03-mirror-line-picked"),
        Click(world(-20, -30)),
        Click(world(-40, -10)),
        Click(world(-33, 31)),
        Click(world(-15, -12)),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("04-mirrored-copies-symmetric-glyphs"),
        Key("Escape"),
        MoveWorld(-40, -30),
        Wait(2),
        Press(world(-40, -30)),
        MoveWorld(-45, -34),
        Wait(2),
        MoveWorld(-50, -38),
        Wait(3),
        Release,
        Wait(3),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("05-editing-the-source-moves-the-copy"),
    ],
)
