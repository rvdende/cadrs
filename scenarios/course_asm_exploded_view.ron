// P3B.8 / A1.8, X16 Exploded views on the Ex2 end state (`fixtures/pneumatic_cylinder_ex2.cadrs`:
// "Cylinder assembly", 17 instances, 14 mates).
// 01 (A1.8) the right strip's Exploded views button: the empty panel.
// 02 Add exploded view: "Exploded view 1" opens for editing (no steps yet).
// 03 Step 1: Retaining Plate, Top Cap, O-Ring 0.125 <3>, <4> selected, along Z, 120 mm typed:
//    added (Enter); the trail lines from where they were.
// 04 Step 2: Piston & Rod and its three O-rings selected; the explode triad at them, its Z arrow
//    dragged up (60 mm).
// 05 Released: step 2 added.
// 06 Step 3: Rear Cap, Rear Cap mount, O-Ring 0.125 <1>, <2> along Z, -100 mm typed.
// 07 Step 4: the Rear Cap rotated 90 deg about X (Rotate, X, "90 deg"): its spigot turns sideways.
// 08 Reorder: step 3 moved up (↑); 09 step 1 clicked: its settings in the editor ("Change step 1"),
//    150 mm typed and Update step.
// 10 Done: the view at 100 %, with trail lines; 11 the slider at 50 %: the first two steps done
//    (the steps play one after another); 12 at 0 %: assembled.
// 13 The mates and placements are untouched: Slider 1 -> Reset changes nothing, the Instances
//    list and the Mate Features list as before; the view row clicked again puts it away.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture pneumatic_cylinder_ex2"),
        Wait(10),
        Click(ui("tab-cylinder-assembly")),
        Wait(10),
        Custom("view 30 20 0 0 90 0.4"),
        Wait(20),
        Click(ui("panel-exploded-views")),
        WaitFor("exploded-views-panel"),
        Wait(5),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("01-a1.8-exploded-views-panel"),
        Click(ui("exploded-view-add")),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("02-x16-new-exploded-view"),
        // Step 1: the top of the cylinder, 120 mm along Z (typed).
        Click(ui("instance-row-3")),
        Wait(2),
        Click(ui("instance-row-4")),
        Wait(2),
        Click(ui("instance-row-8")),
        Wait(2),
        Click(ui("instance-row-9")),
        Wait(5),
        Click(ui("explode-axis-z")),
        Wait(3),
        Click(ui("explode-amount-field")),
        Key("Ctrl+A"),
        Type("120 mm"),
        Key("Enter"),
        Wait(10),
        Custom("view 30 20 0 0 110 0.55"),
        Wait(20),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("03-x16-step-1-typed"),
        // Step 2: the piston, dragged up by the triad's Z arrow.
        Click(ui("instance-row-14")),
        Wait(2),
        Click(ui("instance-row-15")),
        Wait(2),
        Click(ui("instance-row-16")),
        Wait(2),
        Click(ui("instance-row-17")),
        Wait(8),
        // The Z arrow runs 70 px up from the piston's middle (z 117.5 mm; 0.55 mm/px).
        Press(xyz(0, 0, 145)),
        Hover(xyz(0, 0, 160)),
        Wait(3),
        Hover(xyz(0, 0, 185)),
        Wait(3),
        Hover(xyz(0, 0, 205)),
        Wait(5),
        Screenshot("04-x16-step-2-triad-drag"),
        Release,
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("05-x16-step-2-added"),
        // Step 3: the bottom, -100 mm along Z.
        Click(ui("instance-row-2")),
        Wait(2),
        Click(ui("instance-row-5")),
        Wait(2),
        Click(ui("instance-row-6")),
        Wait(2),
        Click(ui("instance-row-7")),
        Wait(5),
        Click(ui("explode-axis-z")),
        Click(ui("explode-amount-field")),
        Key("Ctrl+A"),
        Type("-100 mm"),
        Key("Enter"),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("06-x16-step-3"),
        // Step 4: the Rear Cap turned 90 deg about X (its spigot turns to face the viewer).
        Click(ui("instance-row-2")),
        Wait(5),
        Click(ui("explode-kind-rotate")),
        Wait(3),
        Click(ui("explode-axis-x")),
        Click(ui("explode-amount-field")),
        Key("Ctrl+A"),
        Type("90 deg"),
        Key("Enter"),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("07-x16-step-4-rotate"),
        Click(ui("explode-kind-move")),
        Wait(3),
        // Reorder: step 3 up.
        Click(ui("exploded-step-3-up")),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("08-x16-step-reordered"),
        // Change step 1: 150 mm.
        Click(ui("exploded-step-1")),
        Wait(8),
        Click(ui("explode-amount-field")),
        Key("Ctrl+A"),
        Type("150 mm"),
        Key("Tab"),
        Wait(5),
        Click(ui("explode-step-add")),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("09-x16-step-1-changed"),
        Click(ui("exploded-view-done")),
        Wait(10),
        Custom("view 30 20 0 0 110 0.6"),
        Wait(20),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("10-x16-exploded-100-trails"),
        Click(ui_at("exploded-view-slider", 0.5, 0.5)),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("11-x16-slider-50"),
        Click(ui_at("exploded-view-slider", 0.05, 0.5)),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("12-x16-slider-0-assembled"),
        Click(ui_at("exploded-view-slider", 0.95, 0.5)),
        Wait(10),
        Click(ui("exploded-view-row-1")),
        Wait(10),
        MoveTo(1100, 250),
        Wait(3),
        Screenshot("13-x16-put-away-positions-untouched"),
    ],
)
