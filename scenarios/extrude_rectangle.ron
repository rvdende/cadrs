// M9: the reference walkthrough from sketch to part (compare reference/onshape/screens/09–24,
// 24a and NOTES.md "Extrude"). A 50 × 30 rectangle on Top from the origin, dimensioned with the
// quick-dimension boxes (fully defined, black); ✓ accepts it (grey region, screens/20); Shift+7
// turns to the isometric view (21). Extrude opens "Extrude 1" (22): Solid and New, the region
// field waiting (blue), Blind, Depth 25 mm. Hovering the rectangle's region highlights it;
// clicking selects it (orange, "Face of Sketch 1"), a translucent preview with the depth arrow
// appears and "Part 1" is listed under Parts (23). ✓ makes Extrude 1: the part is shaded blue-
// grey with black edges, Sketch 1 is greyed out and hidden, Parts (1) (24). Hovering the top face
// outlines it orange (24a), and a side face likewise.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0.45, 0.3),
        MoveWorld(49.12, 33.17),
        Wait(2),
        ClickWorld(49.12, 33.17),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("01-rectangle-50x30-fully-defined"),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-sketch-accepted"),
        Key("Shift+7"),
        Wait(40),
        Screenshot("03-isometric-view"),
        Click(ui("extrude")),
        WaitFor("extrude-dialog"),
        Wait(3),
        MoveTo(560, 120),
        Wait(3),
        Screenshot("04-extrude-dialog-waiting"),
        MoveWorld(25, 15),
        Wait(3),
        Screenshot("05-hover-sketch-region"),
        ClickWorld(25, 15),
        Wait(4),
        Screenshot("06-region-selected-preview-part-1"),
        Click(ui("extrude-dialog-accept")),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("07-extruded-part-shaded"),
        Hover(xyz(25, 15, 25)),
        Wait(3),
        Screenshot("08-hover-top-face-orange-outline"),
        Hover(xyz(50, 15, 12)),
        Wait(3),
        Screenshot("09-hover-side-face"),
    ],
)
