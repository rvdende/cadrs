// The desk power monitor's LoRa board, redrawn in cadrs (cadrs_eda::power_monitor; no KiCad
// import): 01 the schematic; 02 ERC (only the headers' unused pins, as in KiCad); 02b the
// schematic plotted (PDF, SVG) and its netlist exported; 03 the
// layout (the layers panel bottom-left); 04 the antenna and its matching network, close; 05 the
// back copper active, the other layers dimmed; 06 DRC; 06b the board as STEP and JLCPCB's BOM and
// placement files; 07 the board in 3D; 08 the RA-01SH component's symbol; 09 its footprint;
// 10 its generated 3D model; 11 the PCB antenna's footprint (front and back copper strips,
// plated holes, keep-out).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("eda-example power-monitor"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        Custom("eda-zoom 40 85 195 175"),
        MoveTo(1100, 900),
        Screenshot("01-schematic"),
        Click(ui("sch-erc")),
        WaitFor("eda-erc-dialog"),
        Click(ui("eda-erc-run")),
        Screenshot("02-erc"),
        Click(ui("eda-erc-close")),
        // The schematic plotted as PDF and SVG, the netlist exported.
        Click(ui("sch-plot")),
        WaitFor("eda-splot-dialog"),
        Click(ui("eda-splot-dir-field")),
        Key("Ctrl+A"),
        Type("target/scenarios/eda_power_monitor/plots/"),
        Click(ui("eda-splot-pdf")),
        Click(ui("eda-splot-svg")),
        Click(ui("eda-splot-netlist")),
        Screenshot("02b-plotted"),
        Click(ui("eda-splot-close")),
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        Custom("eda-zoom 85 -106 121 -62"),
        MoveTo(1100, 900),
        Screenshot("03-layout"),
        Custom("eda-zoom 90 -105 114 -84"),
        MoveTo(1100, 900),
        Screenshot("04-antenna"),
        // The layers panel: the back copper active, the other layers dimmed.
        Click(ui("eda-layers-toggle")),
        WaitFor("eda-layer-bottom-copper"),
        Custom("eda-zoom 85 -106 121 -62"),
        Click(ui("eda-layer-bottom-copper")),
        Click(ui("eda-layers-dim")),
        MoveTo(1100, 900),
        Screenshot("05-back-copper"),
        Click(ui("eda-layers-dim")),
        Click(ui("eda-layer-top-copper")),
        Click(ui("eda-layers-toggle")),
        Click(ui("pcb-drc")),
        WaitFor("eda-drc-dialog"),
        Click(ui("eda-drc-run")),
        Screenshot("06-drc"),
        Click(ui("eda-drc-close")),
        // Outputs: the board as STEP, JLCPCB's BOM and placement files.
        Click(ui("pcb-plot")),
        WaitFor("eda-plot-dialog"),
        Click(ui("eda-plot-dir-field")),
        Key("Ctrl+A"),
        Type("target/scenarios/eda_power_monitor/fab/"),
        Click(ui("eda-plot-step")),
        Click(ui("eda-plot-assembly")),
        Screenshot("06b-outputs"),
        Click(ui("eda-plot-close")),
        Click(ui("eda-mode-3d")),
        Wait(3),
        Key("F"),
        MoveTo(1100, 900),
        Screenshot("07-3d"),
        Click(ui("pcb-part-ra-01sh")),
        WaitFor("eda-mode-symbol"),
        Click(ui("eda-mode-symbol")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Screenshot("08-ra01sh-symbol"),
        Click(ui("eda-mode-footprint")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Screenshot("09-ra01sh-footprint"),
        Click(ui("eda-mode-3d")),
        Wait(3),
        Key("F"),
        MoveTo(1100, 900),
        Screenshot("10-ra01sh-3d"),
        Click(ui("pcb-part-pcb-antenna")),
        WaitFor("eda-mode-footprint"),
        Click(ui("eda-mode-footprint")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Screenshot("11-antenna-footprint"),
    ],
)
