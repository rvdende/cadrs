// The desk power monitor's LoRa board, redrawn in cadrs (cadrs_eda::power_monitor; no KiCad
// import): 01 the schematic; 02 ERC (only the headers' unused pins, as in KiCad); 03 the
// layout (the layers panel bottom-left); 04 the antenna and its matching network, close; 05 the
// back copper active, the other layers dimmed; 06 DRC; 07 the board in 3D; 08 the RA-01SH
// component's symbol; 09 its footprint; 10 its generated 3D model; 11 the PCB antenna's
// footprint (front and back copper strips, plated holes, keep-out).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("eda-example power-monitor"),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        Custom("eda-zoom 40 85 195 175"),
        MoveTo(1100, 900),
        Screenshot("01-schematic"),
        Click(ui("sch-erc")),
        WaitFor("eda-erc-dialog"),
        Click(ui("eda-erc-run")),
        Screenshot("02-erc"),
        Click(ui("eda-erc-close")),
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        Custom("eda-zoom 85 -106 121 -62"),
        MoveTo(1100, 900),
        Screenshot("03-layout"),
        Custom("eda-zoom 90 -105 114 -84"),
        MoveTo(1100, 900),
        Screenshot("04-antenna"),
        // The layers panel: the back copper active, the other layers dimmed.
        Click(ui("eda-layers-toggle")),
        WaitFor("eda-layer-bottom-copper"),
        Custom("eda-zoom 85 -106 121 -62"),
        Click(ui("eda-layer-bottom-copper")),
        Click(ui("eda-layers-dim")),
        MoveTo(1100, 900),
        Screenshot("05-back-copper"),
        Click(ui("eda-layers-dim")),
        Click(ui("eda-layer-top-copper")),
        Click(ui("eda-layers-toggle")),
        Click(ui("pcb-drc")),
        WaitFor("eda-drc-dialog"),
        Click(ui("eda-drc-run")),
        Screenshot("06-drc"),
        Click(ui("eda-drc-close")),
        Click(ui("eda-mode-3d")),
        Wait(3),
        Key("F"),
        MoveTo(1100, 900),
        Screenshot("07-3d"),
        Click(ui("pcb-part-ra-01sh")),
        WaitFor("eda-mode-symbol"),
        Click(ui("eda-mode-symbol")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Screenshot("08-ra01sh-symbol"),
        Click(ui("eda-mode-footprint")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Screenshot("09-ra01sh-footprint"),
        Click(ui("eda-mode-3d")),
        Wait(3),
        Key("F"),
        MoveTo(1100, 900),
        Screenshot("10-ra01sh-3d"),
        Click(ui("pcb-part-pcb-antenna")),
        WaitFor("eda-mode-footprint"),
        Click(ui("eda-mode-footprint")),
        Custom("eda-fit"),
        MoveTo(1100, 900),
        Screenshot("11-antenna-footprint"),
    ],
)
