// MCX2 "Slide" (`managed-in-context-design.md` MC3, MCX2) on the stand-in
// (`fixtures/mic_slide_standin.cadrs`: a Rail 200 × 30 × 10 mm with Ø6 end-stop holes at x ±80,
// Carriage <1> at x −40 and Carriage <2> at x 40 on it).
// 01 The Slide assembly.
// 02 (MC3.3) Carriage <1>'s menu: Edit in context; a sketch on the Rail's top face, Use on the
//    right end-stop hole: the Carriage studio in Context 1, Sketch 2 with its arrow.
// 03 (MC3.1) back in the assembly: Carriage <1> has the solid arrow (primary), Carriage <2> the
//    faint one (secondary).
// 04 (MC3.4) Carriage <1> deleted: Carriage <2> keeps its arrow; Update context ▸ Context 1 is
//    disabled ("no primary instance").
// 05 (MC3.4) the Carriage studio says "No primary instance"; Update context is disabled.
// 06 (MC3.3) Carriage <2>'s menu: Set as primary instance; its arrow is solid now.
// 07 (MC3.2) Update context ▸ Context 1: the Rail comes into the studio relative to Carriage <2>
//    (80 mm further left), and the used hole edge with it.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture mic_slide_standin"),
        Wait(20),
        Click(ui("tab-slide")),
        Wait(10),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("01-mcx2-slide"),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-edit-in-context"),
        Click(ui("asm-edit-in-context")),
        WaitFor("context-bar"),
        Wait(20),
        Key("F"),
        Wait(40),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(xyz(90, 0, 0)),
        Wait(10),
        Key("N"),
        Wait(40),
        MoveTo(913, 520),
        Key("U"),
        Wait(2),
        ClickWorld(117, 0),
        Wait(3),
        Key("Escape"),
        Wait(3),
        Click(ui("sketch-dialog-accept")),
        Wait(10),
        Key("Shift+7"),
        Wait(40),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02-mc3-3-carriage-1-in-context"),
        Click(ui("context-go")),
        WaitFor("context-go-menu-assembly"),
        Click(ui("context-go-menu-assembly")),
        Wait(20),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("03-mc3-1-primary-and-secondary"),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-delete"),
        Click(ui("asm-delete")),
        Wait(20),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-update-context"),
        Hover(ui("asm-update-context")),
        WaitFor("asm-update-context-0"),
        Hover(ui("asm-update-context-0")),
        Wait(5),
        Screenshot("04-mc3-4-primary-deleted"),
        Key("Escape"),
        Wait(3),
        Click(ui("tab-carriage")),
        WaitFor("context-no-primary"),
        Wait(20),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("05-mc3-4-no-primary-instance"),
        Click(ui("tab-slide")),
        Wait(20),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-set-primary"),
        Hover(ui("asm-set-primary")),
        Wait(3),
        Click(ui("asm-set-primary")),
        Wait(20),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("06-mc3-3-set-as-primary-instance"),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-update-context"),
        Hover(ui("asm-update-context")),
        WaitFor("asm-update-context-0"),
        Click(ui("asm-update-context-0")),
        Wait(20),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-edit-in-context"),
        Hover(ui("asm-edit-in-context")),
        WaitFor("asm-edit-in-context-0"),
        Click(ui("asm-edit-in-context-0")),
        WaitFor("context-bar"),
        Wait(20),
        Key("F"),
        Wait(40),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("07-mc3-2-anchored-on-carriage-2"),
    ],
)
