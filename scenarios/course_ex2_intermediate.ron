// T1: Onshape course "Introduction to Sketching", exercise 2 (Intermediate Sketching), every
// step of training/intro-to-sketching/ex2-step1..16.png, driven through the UI:
// 1. A new document (mm); a sketch on Front.
// 2. A vertical construction center line from the origin (Q, L); a horizontal base half-line
//    and a vertical side line (inference: H, V).
// 3. A 3-point arc up from the side line, its top end not above its bottom.
// 4. Mirror (toolbar) about the center line: the base, side and arc.
// 5. A tangent arc (Arc ▾) between the two arcs' top ends: the head.
// 6. The head's center made coincident with the center line's top (I).
// 7. R75 (the first dimension: it scales the sketch), R125, 200, 50, 125.
// 8. Offset (O) the head arc inward, 40 typed after placing it.
// 9. A vertical line; 10. a tangent arc from its top to the offset arc's end (it ends tangent
//    to it); 11. Mirror both: the copy joins the offset arc's other end, coincident and
//    tangent; 12. a tangent arc joining the two lines' bottom ends.
// 13. A center-point rectangle (R) centered on the center line.
// 14. R40, R15, 100, 20, 25, 80: fully defined.
// 15. Accept (✓). 16. Select the region: "Area: 24906.823 mm²" (see the derivation in
//    crates/cadrs_core/tests/course_exercises.rs).
Scenario(
    start: Some("landing"),
    steps: [
        // Step 1.
        Click(ui("create")),
        WaitFor("new-document"),
        Click(ui("new-document")),
        WaitFor("new-document-dialog"),
        Wait(3),
        Key("Ctrl+A"),
        Type("Exercise: Intermediate Sketching"),
        Click(ui("new-document-create")),
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-front")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("P"),
        Wait(3),
        Scroll(at(913, 520), -5),
        Wait(3),
        MiddleDrag(at(913, 520), at(913, 790)),
        Wait(5),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("01-step1-sketch-on-front"),
        // Step 2.
        Key("Q"),
        Key("L"),
        Wait(2),
        ClickWorld(0, 0),
        ClickWorld(0, 180),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Q"),
        ClickWorld(0, 0),
        ClickWorld(-60, 0),
        ClickWorld(-60, 45),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("02-step2-center-line-base-and-side"),
        // Step 3.
        Key("A"),
        Wait(2),
        ClickWorld(-60, 45),
        ClickWorld(-63, 160),
        ClickWorld(-48, 100),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("03-step3-three-point-arc"),
        // Step 4: mirror about the center line.
        Click(ui("sketch-mirror")),
        Wait(2),
        Click(world(0, 120)),
        Wait(2),
        Click(world(-30, 0)),
        Wait(2),
        Click(world(-60, 25)),
        Wait(2),
        Click(world(-48.5, 100)),
        Wait(3),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("04-step4-mirror"),
        Key("Escape"),
        Wait(2),
        // Step 5: a tangent arc (Arc ▾) between the arcs' top ends.
        Click(ui("sketch-arc-caret")),
        WaitFor("sketch-variant-tangent-arc"),
        Wait(2),
        Click(ui("sketch-variant-tangent-arc")),
        Wait(2),
        ClickWorld(-63, 160),
        ClickWorld(63, 160),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("05-step5-tangent-arc-head"),
        // Step 6: the head's center coincident with the center line's top.
        Click(world(0, 193.27)),
        Click(world(0, 180)),
        Key("I"),
        Wait(3),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("06-step6-head-center-coincident"),
        // Step 7: dimensions. R75 first: it scales the sketch.
        Key("D"),
        Wait(2),
        Click(world(34.4, 248.4)),
        MoveWorld(62, 272),
        Wait(2),
        Click(world(62, 272)),
        Wait(3),
        Type("75"),
        Key("Enter"),
        Wait(3),
        Click(world(0, 0)),
        Click(world(0, 205.5)),
        MoveWorld(110, 100),
        Wait(2),
        Click(world(110, 100)),
        Wait(3),
        Type("200"),
        Key("Enter"),
        Wait(3),
        Click(world(-66.8, 0)),
        Click(world(66.8, 0)),
        MoveWorld(0, -25),
        Wait(2),
        Click(world(0, -25)),
        Wait(3),
        Type("125"),
        Key("Enter"),
        Wait(3),
        Click(world(62.5, 25)),
        MoveWorld(92, 25),
        Wait(2),
        Click(world(92, 25)),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Click(world(-52, 109.2)),
        MoveWorld(-112, 100),
        Wait(2),
        Click(world(-112, 100)),
        Wait(3),
        Type("125"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("07-step7-dimensions-r75-r125-200-50-125"),
