        Wait(3),
        Type("40"),
        Key("Enter"),
        Wait(3),
        Click(world(0, 200)),
        Click(world(-15, 100)),
        MoveWorld(-95, 150),
        Wait(2),
        Click(world(-95, 150)),
        Wait(3),
        Type("100"),
        Key("Enter"),
        Wait(3),
        Click(world(-40, 35)),
        MoveWorld(-82, 35),
        Wait(2),
        Click(world(-82, 35)),
        Wait(3),
        Type("20"),
        Key("Enter"),
        Wait(3),
        Click(world(-40, 25)),
        Click(world(-30, 0)),
        MoveWorld(-82, 12),
        Wait(2),
