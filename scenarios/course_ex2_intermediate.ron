        // Step 9: a vertical line.
        Key("L"),
        Wait(2),
        ClickWorld(-15, 100),
        ClickWorld(-15, 145),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1300, 900),
        Wait(2),
        Screenshot("09-step9-vertical-line"),
        // Step 10: a tangent arc from its top to the offset arc's end.
        Click(ui("sketch-arc-caret")),
        WaitFor("sketch-variant-tangent-arc"),
        Wait(2),
        Click(ui("sketch-variant-tangent-arc")),
        Wait(2),
        ClickWorld(-15, 145),
        MoveWorld(-28, 178),
        Wait(2),
        MoveWorld(-30.68, 183.16),
        Wait(2),
