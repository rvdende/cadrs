        Key("D"),
        Wait(2),
        Click(world(-7.9, 86.3)),
        MoveWorld(40, 72),
        Wait(2),
        Click(world(40, 72)),
        Wait(3),
        Type("15"),
        Key("Enter"),
        Wait(3),
        Click(world(-20.4, 162.2)),
        MoveWorld(-45, 178),
        Wait(2),
