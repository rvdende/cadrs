// P3F.2 judge (`essential-tips.md` T8.1, T8.2; `intro-to-parametric-cad.md` P3.4): exporting
// from the Parts list, from an assembly instance and from an assembly tab with Keep assembly
// structure, and importing those files back (STEP as an assembly; IGES, Y axis up). The start is
// the bracket pair (`Custom("step-fixture …")`: 2 parts, 3 instances) imported with its
// structure; the exports go to `target/exports/course_tips_export_assembly/` (emptied first).
// 01 the Part Studio: each part where its first occurrence is (the shaft through the first
//    bracket's upright, not at the origin inside the bracket).
// 02 the Parts list's Export… on the Bracket: the dialog for one part, named "Bracket" after it
//    ("Exporting: Bracket (1 part)"), IGES chosen, Y axis up.
// 03 its toast: "Bracket.igs".
// 04 an instance's Export… (Shaft <1>) in the assembly: the dialog for that instance, named
//    "Shaft" ("Exporting: Shaft <1> (1 part)").
// 05 the assembly tab's Export…: "Keep assembly structure" checked (each part once, with its
//    instances), STEP.
// 06 its toast: "Bracket pair.step".
// 07 + ▸ Import… of that file: "an assembly of 2 parts with 3 instances"; Keep assembly structure.
// 08 imported: a second assembly with the three instances where they were.
// 09 + ▸ Import… of Bracket.igs, "File is Y axis up" ticked.
// 10 imported: the file's +Y is our +Z again, so the round trip lands the bracket upright, as
//    it was modelled.
Scenario(
    start: Some("landing"),
    steps: [
        Custom("clear-dir target/exports/course_tips_export_assembly"),
        Custom("step-fixture target/imports/bracket_pair.step"),
        Click(ui("create")),
        WaitFor("import-files"),
        Click(ui("import-files")),
        WaitFor("import-picker"),
        Click(ui("import-picker-folder")),
        Key("Ctrl+A"),
        Type("target/imports"),
        Key("Enter"),
        WaitFor("import-picker-row-bracket_pair.step"),
        Click(ui("import-picker-row-bracket_pair.step")),
        Click(ui("import-picker-open")),
        WaitFor("import-dialog"),
        Click(ui("import-ok")),
        WaitFor("document-shell"),
        // The Part Studio "bracket_pair" keeps the plain node name; the Assembly "Bracket pair"
        // (the same slug) is `tab-bracket-pair-assembly` (P3F.5 judge).
        Click(ui("tab-bracket-pair")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-parts-at-first-occurrence"),
        RightClick(ui("part-row-bracket")),
        WaitFor("part-export"),
        Click(ui("part-export")),
        WaitFor("export-dialog"),
        Click(ui("export-folder")),
        Key("Ctrl+A"),
        Type("target/exports/course_tips_export_assembly"),
        Click(ui("export-format-iges")),
        // Y axis up, so importing it back as Y-up stands it upright again (P3F.3–P3F.4 judge).
        Click(ui("export-y-up")),
        Screenshot("02-parts-list-export-iges"),
        Click(ui("export-ok")),
        WaitFor("export-toast"),
        Screenshot("03-iges-exported"),
        Click(ui("tab-bracket-pair-assembly")),
        RightClick(ui("instance-row-3")),
        WaitFor("asm-export"),
        Click(ui("asm-export")),
        WaitFor("export-dialog"),
        Screenshot("04-instance-export"),
        Click(ui("export-cancel")),
        RightClick(ui("tab-bracket-pair-assembly")),
        WaitFor("tab-export"),
        Click(ui("tab-export")),
        WaitFor("export-dialog"),
        Click(ui("export-folder")),
        Key("Ctrl+A"),
        Type("target/exports/course_tips_export_assembly"),
        Screenshot("05-assembly-tab-keep-structure"),
        Click(ui("export-ok")),
        WaitFor("export-toast"),
        Screenshot("06-assembly-exported"),
        Click(ui("insert-tab")),
        WaitFor("import-files"),
        Click(ui("import-files")),
        WaitFor("import-picker"),
        Click(ui("import-picker-folder")),
        Key("Ctrl+A"),
        Type("target/exports/course_tips_export_assembly"),
        Key("Enter"),
        WaitFor("import-picker-row-Bracket pair.step"),
        Click(ui("import-picker-row-Bracket pair.step")),
        Click(ui("import-picker-open")),
        WaitFor("import-dialog"),
        Click(ui("import-as-assembly")),
        Screenshot("07-import-back-keep-structure"),
        Click(ui("import-ok")),
        WaitFor("import-toast"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-assembly-imported-back"),
        Click(ui("insert-tab")),
        WaitFor("import-files"),
        Click(ui("import-files")),
        WaitFor("import-picker"),
        Click(ui("import-picker-folder")),
        Key("Ctrl+A"),
        Type("target/exports/course_tips_export_assembly"),
        Key("Enter"),
        WaitFor("import-picker-row-Bracket.igs"),
        Click(ui("import-picker-row-Bracket.igs")),
        Click(ui("import-picker-open")),
        WaitFor("import-dialog"),
        Click(ui("import-y-up")),
        Screenshot("09-iges-import-y-up"),
        Click(ui("import-ok")),
        WaitFor("import-toast"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-iges-imported-y-up"),
    ],
)
