// P3.2 Persistent naming (intro-to-part-studios-gaps.md): selection fields name a face after the
// feature that made it, as Onshape does ("Face of Extrude 1", `training/intro-to-part-studios/
// ex3-step3.png`), not after the part. On the Control Arm (`control-arm` set-up command):
// 01 the hub's top face selected; 02 the Sketch dialog opened on it reads "Face of Extrude 1";
// 03 after cancelling, the left web's top face (made by Extrude 2) gives "Face of Extrude 2";
// 04 after Extrude 2 is renamed "Left arm", the same field reads "Face of Left arm" (the name is
// the feature's, by id, so it follows a rename).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("control-arm"),
        // The readout is off by default since P3.3 (Onshape has none); it shows the names here.
        Custom("selection-readout"),
        Key("Shift+7"),
        Key("F"),
        Click(xyz(-2, -26, 40)),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("01-hub-top-selected"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("02-sketch-plane-face-of-extrude-1"),
        Key("Escape"),
        Key("Shift+7"),
        ClickAt(1300, 300),
        // The left web's top face (Extrude 2, 25 mm).
        Click(xyz(-60, 0, 25)),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("03-sketch-plane-face-of-extrude-2"),
        Key("Escape"),
        Key("Shift+7"),
        ClickAt(1300, 300),
        // Rename Extrude 2.
        RightClick(ui("feature-extrude-2")),
        WaitFor("feature-context-menu"),
        Click(ui("feature-rename")),
        Key("Ctrl+A"),
        Type("Left arm"),
        Key("Enter"),
        Click(xyz(-60, 0, 25)),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("04-renamed-feature-face-of-left-arm"),
    ],
)
