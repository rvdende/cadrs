// The Getting Started course's schematic (docs/PLAN.md GS3–GS12) drawn in cadrs: a new board,
// its Schematic view. Points are sheet millimetres (`flat(x, y)`, Y up).
// 01 Page settings (title, revision); 02 the symbol chooser filtered to "LED"; 03 LED, R_US
// and Battery_Cell placed (annotated D1, R1, BT1); 04 R1 and D1 moved (M) and D1 turned (R);
// 05 the loop wired (W); 06 VCC and GND ports (P) and the `led` label (L); 07 values set (E);
// 08 ERC: the two "power input not driven" errors; 09 PWR_FLAGs added, ERC clean;
// 10 footprints assigned; 11 the BOM.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-add-board")),
        WaitFor("pcb-name-edit"),
        Key("Enter"),
        WaitFor("eda-mode-bar"),
        // GS3: page settings.
        Click(ui("sch-page")),
        WaitFor("eda-page-dialog"),
        Click(ui("eda-page-title-field")),
        Key("Ctrl+A"),
        Type("Getting Started"),
        Click(ui("eda-page-rev-field")),
        Type("0"),
        Screenshot("01-page-settings"),
        Click(ui("eda-page-ok")),
        // GS4: symbols.
        MoveTo(800, 500),
        Key("A"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("LED"),
        Wait(2),
        Screenshot("02-chooser"),
        Key("Enter"),
        Click(flat(152.4, 101.6)),
        Key("A"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("R_US"),
        Key("Enter"),
        Click(flat(203.2, 101.6)),
        Key("A"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("Battery_Cell"),
        Key("Enter"),
        Click(flat(101.6, 101.6)),
        Custom("eda-zoom 70 60 230 140"),
        MoveTo(1100, 860),
        Screenshot("03-symbols-placed"),
        // GS5: R1 up, D1 under it, turned.
        Click(flat(203.2, 101.6)),
        Key("M"),
        Click(flat(203.2, 114.3)),
        Click(flat(152.4, 101.6)),
        Key("M"),
        Click(flat(203.2, 93.98)),
        Key("R"),
        Key("Escape"),
        MoveTo(1100, 860),
        Screenshot("04-moved-and-rotated"),
        // GS6: the loop.
        Key("W"),
        Click(flat(101.6, 105.41)),
        Click(flat(101.6, 127.0)),
        Click(flat(203.2, 127.0)),
        Click(flat(203.2, 118.11)),
        Click(flat(203.2, 110.49)),
        Click(flat(203.2, 97.79)),
        Click(flat(203.2, 90.17)),
        Click(flat(203.2, 76.2)),
        Click(flat(101.6, 76.2)),
        Click(flat(101.6, 97.79)),
        Key("Escape"),
        MoveTo(1100, 860),
        Screenshot("05-wired"),
        // GS7: power ports and the label.
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("VCC"),
        Key("Enter"),
        Click(flat(152.4, 132.08)),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("GND"),
        Key("Enter"),
        Click(flat(152.4, 71.12)),
        Key("W"),
        Click(flat(152.4, 132.08)),
        Click(flat(152.4, 127.0)),
        Click(flat(152.4, 71.12)),
        Click(flat(152.4, 76.2)),
        Key("Escape"),
        Key("L"),
        WaitFor("eda-label-dialog"),
        Click(ui("eda-label-text-field")),
        Type("led"),
        Click(ui("eda-label-ok")),
        Click(flat(203.2, 104.14)),
        MoveTo(1100, 860),
        Screenshot("06-power-and-label"),
        // GS9: values.
        Hover(flat(203.2, 93.98)),
        Key("E"),
        WaitFor("eda-props-dialog"),
        Click(ui("eda-props-value-field")),
        Key("Ctrl+A"),
        Type("red"),
        Screenshot("07-properties"),
        Click(ui("eda-props-ok")),
        Hover(flat(203.2, 114.3)),
        Key("E"),
        WaitFor("eda-props-dialog"),
        Click(ui("eda-props-value-field")),
        Key("Ctrl+A"),
        Type("1k"),
        Click(ui("eda-props-ok")),
        Hover(flat(101.6, 101.6)),
        Key("E"),
        WaitFor("eda-props-dialog"),
        Click(ui("eda-props-value-field")),
        Key("Ctrl+A"),
        Type("3V"),
        Click(ui("eda-props-ok")),
        // GS11: ERC, then the flags.
        Click(ui("sch-erc")),
        WaitFor("eda-erc-dialog"),
        ExpectText("eda-erc-summary", "Violations (2): 2 errors, 0 warnings"),
        Screenshot("08-erc-power-errors"),
        Click(ui("eda-erc-close")),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("PWR_FLAG"),
        Key("Enter"),
        Click(flat(101.6, 116.84)),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("PWR_FLAG"),
        Key("Enter"),
        Click(flat(101.6, 86.36)),
        Click(ui("sch-erc")),
        WaitFor("eda-erc-dialog"),
        ExpectText("eda-erc-summary", "No violations"),
        Screenshot("09-erc-clean"),
        Click(ui("eda-erc-close")),
        // GS10: footprints.
        Click(ui("sch-assign")),
        WaitFor("eda-assign-dialog"),
        Click(ui("eda-assign-filter-field")),
        Type("1058"),
        Wait(2),
        DoubleClick(ui("eda-assign-fp-battery-batteryholder-keystone-1058-1x2032")),
        Click(ui("eda-assign-filter-field")),
        Key("Ctrl+A"),
        Type("D5.0"),
        Wait(2),
        DoubleClick(ui("eda-assign-fp-led-tht-led-d5-0mm")),
        Click(ui("eda-assign-filter-field")),
        Key("Ctrl+A"),
        Type("DIN0309"),
        Wait(2),
        DoubleClick(ui("eda-assign-fp-resistor-tht-r-axial-din0309-l9-0mm-d3-2mm-p12-70mm-horizontal")),
        Wait(2),
        Screenshot("10-footprints-assigned"),
        Click(ui("eda-assign-ok")),
        // GS12: the BOM.
        Click(ui("sch-bom")),
        WaitFor("eda-bom-dialog"),
        Screenshot("11-bom"),
        Click(ui("eda-bom-close")),
    ],
)
