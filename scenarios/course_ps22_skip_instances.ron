// P3.8 / PS22.5, PS23, PS9.6: a Linear part pattern with Skip instances. A 10 mm cube (the
// closed forms of the part pattern are asserted in `cadrs_core/tests/pattern.rs`).
// 01 Linear pattern 1: Part pattern of the cube, Direction the Right plane's normal (+X), 20 mm,
//    5 instances: the copies keep the cube's colour (PS9.6), Skip instances on: a grey dot on
//    every copy (PS22.5).
// 02 the dot of (2, 0) clicked: it turns light blue, the copy goes, and "Instances to skip"
//    lists "(2, 0)" with CLEAR.
// 03 Second direction: the Front plane's normal flipped (+Y), 25 mm, 2: a grid, (2, 0) still
//    skipped; (3, 1) clicked too.
// 04 accepted: 8 parts, all the cube's colour, in the Parts list.
// 05 edited again, CLEAR: the list empties and every copy is back.
// 06 P3.11 (P3.8 judge): a box dragged in the view over three of the dots (a thin blue box, as
//    Onshape's selection box); 07 released: the three dots inside it are skipped at once,
//    (2, 1), (3, 0) and (3, 1) in the list, one undo step ("Skip instances").
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 10 10"),
        Wait(5),
        Key("P"),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        Click(xyz(5, 5, 0)),
        Wait(3),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("10"),
        Key("Enter"),
        Wait(10),
        Custom("view 20 30 45 25 5 0.12"),
        Wait(40),
        Click(ui("pattern")),
        WaitFor("pattern-menu"),
        Wait(3),
        Click(ui("pattern-menu-linear")),
        WaitFor("linear-pattern-dialog"),
        Wait(5),
        Click(xyz(5, 5, 10)),
        Wait(3),
        Click(ui("linear-pattern-direction-field")),
        Wait(3),
        Click(ui("feature-right")),
        Wait(3),
        Click(ui("linear-pattern-distance-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("20"),
        Key("Tab"),
        Wait(5),
        Click(ui("linear-pattern-count-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        Wait(20),
        Click(ui("linear-pattern-skip-checkbox")),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-part-pattern-skip-dots"),
        Click(xyz(45, 5, 5)),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-skipped-2-0"),
        Click(ui("linear-pattern-second-checkbox")),
        Wait(10),
        Click(ui("linear-pattern-direction2-field")),
        Wait(3),
        Click(ui("feature-front")),
        Wait(5),
        Click(ui("linear-pattern-count2-flip")),
        Wait(5),
        Click(ui("linear-pattern-distance2-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("25"),
        Key("Tab"),
        Wait(30),
        Click(xyz(65, 30, 5)),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-grid-skipped-2-0-and-3-1"),
        Click(ui("linear-pattern-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-accepted-8-parts"),
        DoubleClick(ui("feature-linear-pattern-1")),
        WaitFor("linear-pattern-dialog"),
        Wait(10),
        Click(ui("linear-pattern-skip-clear")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-clear-all-back"),
        // P3.11: a box dragged over three of the dots skips them all at once.
        Press(at(890, 470)),
        Hover(at(1000, 560)),
        Hover(at(1120, 650)),
        Wait(3),
        Screenshot("06-box-over-three-dots"),
        Release,
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-three-skipped"),
    ],
)
