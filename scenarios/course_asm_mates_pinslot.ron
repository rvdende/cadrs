// P3B.3 / A9.2, A9.3, A6.3 (Reorder), A6.8 (Flip), A6.9 (▶), A16.4 (drag), A6.12 (tooltip): a
// Pin slot mate on the mates stand-in (`fixtures/mates_standin.cadrs`): the Slot Plate (fixed)
// and the Pin.
// 01 the two parts inserted, the Slot Plate fixed.
// 02 (A9.2) Pin slot dialog: the pin picked first, then the slot: the wrong order.
// 03 (A6.3) Reorder items: drag handles and Done.
// 04 the slot's connector dragged to the top.
// 05 Done: slot first, pin second.
// 06 (A6.8) Flip primary axis: the pin stands in the slot.
// 07 (A9.3) Limits: X −½ … +½ slot length (±20 mm), Z angle 0 / 0.
// 08 (A6.9) Animate ▶: the pin half way along the slot.
// 09 accepted: "Pin slot 1" with its limit icon.
// 10 (A16.4) dragging the pin past the end of the slot: it stops at the end.
// 11 (A9.3) a triad ring drag can't turn it (rotation locked by the angle limits).
// 12 (A6.12, A8.2) hovering the mate: its tooltip (type, limits), its instances highlighted.
Scenario(
    start: Some("document"),
    steps: [
        Wait(10),
        Custom("fixture mates_standin"),
        Wait(10),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Wait(5),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Wait(5),
        Click(ui("insert-part-slot-plate")),
        Wait(2),
        Click(ui("insert-part-pin")),
        Wait(3),
        Click(ui("insert-dialog-accept")),
        Wait(5),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Wait(5),
        Key("Shift+7"),
        Wait(30),
        Key("F"),
        Wait(30),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("01-inserted-plate-fixed"),
        // A9.2: the pin first (wrong), then the slot's centre.
        Click(ui("mate-pin-slot")),
        WaitFor("mate-dialog"),
        Wait(3),
        Hover(xyz(-16.46, 41.46, 16)),
        Wait(3),
        Click(xyz(-16.46, 41.46, 16)),
        Wait(5),
        Hover(xyz(-20, 2, 4)),
        Wait(3),
        Click(xyz(-20, 2, 4)),
        Wait(8),
        MoveTo(1300, 700),
        Wait(3),
        Screenshot("02-a9.2-picked-wrong-order"),
        Click(ui("mate-connectors-reorder")),
        Wait(5),
        Screenshot("03-a6.3-reorder-handles"),
        Drag(ui("mate-connectors-item-1-handle"), ui("mate-connectors-item-0-handle")),
        Wait(5),
        Screenshot("04-a6.3-reordered"),
        Click(ui("mate-connectors-done")),
        Wait(5),
        MoveTo(1300, 700),
        Wait(3),
        Screenshot("05-a9.2-slot-first"),
        Click(ui("mate-flip")),
        Wait(8),
        MoveTo(1300, 700),
        Wait(3),
        Screenshot("06-a6.8-flipped"),
        // A9.3: limits ±½ slot length, rotation locked.
        Click(ui("mate-limits-checkbox")),
        Wait(5),
        Click(ui("mate-limit-x-min")),
        Key("Ctrl+A"),
        Type("-20 mm"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-x-max")),
        Key("Ctrl+A"),
        Type("20 mm"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-angle-min")),
        Key("Ctrl+A"),
        Type("0 deg"),
        Key("Enter"),
        Wait(3),
        Click(ui("mate-limit-angle-max")),
        Key("Ctrl+A"),
        Type("0 deg"),
        Key("Enter"),
        Wait(5),
        MoveTo(1300, 700),
        Wait(3),
        Screenshot("07-a9.3-limits"),
        Click(ui("mate-animate")),
        Wait(12),
        Screenshot("08-a6.9-animate-preview"),
        Wait(80),
        Click(ui("mate-dialog-accept")),
        Wait(8),
        MoveTo(1300, 700),
        Wait(3),
        Screenshot("09-accepted"),
        // A16.4: drag the pin along the slot and past its end.
        Press(xyz(-16.46, -3.54, 12)),
        Hover(xyz(-10, -3.54, 12)),
        Wait(2),
        Hover(xyz(10, -3.54, 12)),
        Wait(2),
        Hover(xyz(45, -3.54, 12)),
        Wait(5),
        Screenshot("10-a16.4-drag-stops-at-slot-end"),
        Release,
        Wait(5),
        // A9.3: the triad's ring can't turn it.
        Click(xyz(-2, 0, 20)),
        Wait(5),
        Press(ui("triad-ring-z")),
        Hover(ui_at("triad-ring-z", -4.0, 4.0)),
        Wait(2),
        Hover(ui_at("triad-ring-z", -10.0, 10.0)),
        Wait(5),
        Screenshot("11-a9.3-rotation-locked"),
        Release,
        Wait(5),
        Click(at(1350, 800)),
        Wait(3),
        Hover(ui("mate-row-1")),
        Wait(70),
        Screenshot("12-a6.12-tooltip-and-highlight"),
    ],
)
