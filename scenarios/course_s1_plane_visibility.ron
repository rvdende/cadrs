// T2 / S1.4: "P hides or shows all planes. Each plane row in the feature list has its own
// show/hide toggle." Hovering a plane's row shows an eye at its right end; clicking it hides that
// plane only (its row greys out, `intro-to-sketching/ex1-step1.png`, and the eye shows crossed
// out on hover). P hides the rest; P again shows them all. The eye brings one back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Hover(ui("feature-top")),
        Wait(3),
        Screenshot("01-hover-top-row-shows-eye"),
        Click(ui("feature-top-visibility")),
        Screenshot("02-top-hidden-row-greyed-eye-crossed"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-top-plane-hidden"),
        Hover(ui("feature-front")),
        Wait(3),
        Click(ui("feature-front-visibility")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-front-hidden-too-right-shown"),
        Key("P"),
        Screenshot("05-p-hides-all"),
        Key("P"),
        Screenshot("06-p-shows-all"),
        Key("P"),
        Hover(ui("feature-right")),
        Wait(3),
        Click(ui("feature-right-visibility")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("07-eye-shows-right-only"),
    ],
)
