// P3.11 / PS25 (P3.8 judge: the Curve pattern had test evidence only, `curve_pattern_along_an_arc`
// in `cadrs_core/tests/pattern.rs`): a 10 mm cube centred on (50, 0), patterned along a half
// circle R50 on Top (a 3 point arc drawn from (50, 0) to (−50, 0) through (0, 50)) that starts
// at its centre.
// 01 the pattern menu open on the toolbar: Linear, Circular and Curve pattern.
// 02 Curve pattern 1: Part pattern of the cube, Path to pattern along = the arc (Curve of
//    Sketch 2), 5 instances, Equal spacing, Tangent to curve: the copies go round the arc 45°
//    apart, each turned with the arc's tangent.
// 03 Equal spacing off, Distance 30 mm along the path: the copies bunch up on the first
//    stretch of the arc (30 mm of arc apart, ≈34.4° each).
// 04 accepted: 5 parts.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 45 -5 55 5"),
        Key("P"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(50, 0, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Enter"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        MoveTo(913, 520),
        Key("A"),
        ClickWorld(50, 0),
        ClickWorld(-50, 0),
        ClickWorld(0, 50),
        Key("Escape"),
        Key("Escape"),
        Click(ui("sketch-dialog-accept")),
        Custom("view 0 55 0 20 0 0.15"),
        Click(ui("pattern")),
        WaitFor("pattern-menu"),
        MoveTo(1420, 900),
        Hover(ui("pattern-menu-curve")),
        Wait(3),
        Screenshot("01-pattern-menu"),
        Click(ui("pattern-menu-curve")),
        WaitFor("curve-pattern-dialog"),
        Click(xyz(50, 0, 10)),
        Click(ui("curve-pattern-path-field")),
        Click(xyz(0, 50, 0)),
        Click(ui("curve-pattern-count-field")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-five-along-the-arc"),
        Click(ui("curve-pattern-equal-spacing-checkbox")),
        Click(ui("curve-pattern-distance-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-distance-30"),
        Click(ui("curve-pattern-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-accepted-five-parts"),
    ],
)
