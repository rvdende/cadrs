// T1 / S13.4: dimensions to circles and arcs, "clicking near the outside dimensions to the
// outside; clicking near the inside dimensions to the inside". Two concentric circles (R40,
// R20) and a vertical line at x = 70. With the Dimension tool:
// - the big circle clicked just inside and the small one just outside: the ring's width (20),
//   drawn radially along the label's direction (exercise 1's "35"); typing 25 shrinks the
//   small circle to R15;
// - the line and the big circle clicked on its outside (the line's side): to its near side,
//   30; placed, then 20 typed: the line moves 10 closer (the circle's center is on the origin);
// - the line and the big circle clicked on its half away from the line (just inside): to its
//   far side, 100 (shown, then dropped with Esc);
// - a point and the small circle clicked on the half facing the point: to its near side.
// The side is the half of the circle that was clicked (facing the other entity: near; away
// from it: far), not whether the click was just inside or outside the curve.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("C"),
        ClickWorld(0, 0),
        ClickWorld(40, 0),
        Type("80"),
        Key("Enter"),
        ClickWorld(0, 0),
        ClickWorld(20, 0),
        Key("Escape"),
        Key("Escape"),
        Key("L"),
        ClickWorld(70, -30),
        ClickWorld(70, 30),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("01-two-circles-and-a-line"),
        Key("D"),
        Click(world(-27.93, 27.93)),
        Click(world(-14.43, 14.43)),
        MoveWorld(-21, 21),
        Wait(2),
        Screenshot("02-ring-inside-outside-width-20"),
        Click(world(-21, 21)),
        Type("25"),
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("03-ring-width-25-small-circle-r15"),
        Click(world(70, 12)),
        Click(world(40.7, 0)),
        MoveWorld(55, -18),
        Wait(2),
        Screenshot("04-line-to-circle-clicked-outside-near-30"),
        Click(world(55, -18)),
        Type("20"),
        Screenshot("04b-line-to-circle-typing-20"),
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("04c-typed-20-the-line-moved"),
        Click(world(60, 12)),
        Click(world(-39.3, 0)),
        MoveWorld(20, -50),
        Wait(2),
        Screenshot("05-line-to-circle-clicked-far-half-far-100"),
        Key("Escape"),
        Click(world(60, 30)),
        Click(world(10.7, 10.7)),
        MoveWorld(58, 2),
        Wait(2),
        Screenshot("06-point-to-circle-outside-near"),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("07-dimensions-drive-the-geometry"),
    ],
)
