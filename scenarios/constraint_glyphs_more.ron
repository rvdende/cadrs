// M7 (M6 leftover): more constraint glyphs (compare reference/onshape/constraints.md and
// constraints/*.png). A line continued by a tangent arc (Shift+A) shows the tangent glyph where
// they meet; two circles made concentric (select both, Shift+O) show the concentric glyph on
// each; a line started at another line's midpoint shows the midpoint glyph (and the
// perpendicular inferred on the way). Dragging a glyph moves its group (the leader follows).
// Then the Constraints ▾ menu with its keycap shortcuts.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        // A line, then a tangent arc.
        Key("L"),
        Wait(2),
        ClickWorld(-65, 45),
        ClickWorld(-30, 45),
        Wait(2),
        Key("Shift+A"),
        MoveWorld(-12, 25),
        Wait(2),
        ClickWorld(-12, 25),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        // Two circles, then Concentric.
        Key("C"),
        Wait(2),
        ClickWorld(35, 40),
        ClickWorld(52, 40),
        Wait(3),
        Key("Escape"),
        Wait(2),
        ClickWorld(42, 47),
        ClickWorld(48, 47),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Click(world(52, 40)),
        Click(world(48, 47)),
        Wait(2),
        Key("Shift+O"),
        Wait(4),
        // A line from another line's midpoint.
        Key("L"),
        Wait(2),
        ClickWorld(-60, -30),
        ClickWorld(-10, -30),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveWorld(-35, -30),
        Wait(2),
        ClickWorld(-35, -30),
        MoveWorld(-35, -62),
        Wait(2),
        ClickWorld(-35, -62),
        Wait(2),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("01-tangent-concentric-midpoint-glyphs"),
        Hover(at(756, 327)),
        Wait(2),
        Screenshot("02-hover-tangent-glyph"),
        Drag(at(756, 327), at(716, 292)),
        Wait(2),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("03-glyph-group-dragged"),
        Click(ui("sketch-constraints-caret")),
        WaitFor("sketch-constraint-coincident"),
        Wait(3),
        Screenshot("04-constraints-menu-keycaps"),
        Key("Escape"),
        Wait(2),
    ],
)
