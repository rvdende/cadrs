// Not a golden: run on a copy of the user's "pcbs" document (`--data-dir target/pcbs_store`,
// CADRS_USER_LIBRARIES for their LCSC parts). Opens it, makes PCB Studio 1's board the LoRa board
// (`eda-redraw power-monitor`), photographs it as the KiCad screenshots show it (the schematic;
// the layout with the fab layers hidden; the 3D view from the front left, 50° up), and goes back to the
// documents page, which saves it.
Scenario(
    start: Some("landing"),
    timeout: 120.0,
    steps: [
        WaitFor("doc-row-0"),
        DoubleClick(ui("doc-name-0")),
        WaitFor("document-shell"),
        Click(ui("tab-pcb-studio-1")),
        WaitFor("pcb-tree"),
        Custom("eda-redraw power-monitor"),
        Wait(10),
        WaitFor("eda-mode-bar"),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        Custom("eda-zoom 36.9 73.5 198.9 188.5"),
        MoveTo(1100, 940),
        Wait(3),
        Screenshot("01-schematic"),
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        Custom("eda-zoom 86 -105 120 -63"),
        Click(ui("eda-layers-toggle")),
        WaitFor("eda-layer-top-fabrication-eye"),
        Click(ui("eda-layer-top-fabrication-eye")),
        Click(ui("eda-layer-bottom-fabrication-eye")),
        Click(ui("eda-layer-comments-eye")),
        Click(ui("eda-layers-toggle")),
        MoveTo(1100, 940),
        Wait(3),
        Screenshot("02-layout"),
        Custom("eda-zoom 92 -104 112 -95"),
        Wait(2),
        Screenshot("02b-antenna"),
        Click(ui("eda-mode-3d")),
        Wait(30),
        Key("F"),
        Wait(5),
        Key("F"),
        Wait(5),
        MoveTo(1100, 940),
        Custom("view -38 56"),
        Wait(20),
        Key("F"),
        Wait(5),
        Scroll(at(940, 540), 1.7),
        Wait(10),
        Screenshot("03-3d"),
        Click(ui("back-to-documents")),
        WaitFor("doc-row-0"),
        Wait(5),
    ],
)
