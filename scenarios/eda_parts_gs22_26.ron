// The Getting Started course's custom switch (docs/PLAN.md GS22–GS26), from the finished board
// (`eda-example gs18`). Points are millimetres (`flat(x, y)`).
// 01 + under Components: "Switch", its Symbol editor; 02 symbol properties; 03 pins A/2 and
// B/3 with the lever drawn; 04 the Footprint editor: pads 2 and 3 (Ø2.22, hole 1.62), fab,
// silkscreen and courtyard; 05 the courtyard's corners typed in; 06 the 3D model; 07 SW1 in the
// schematic, ERC clean; 08 Update PCB brings SW1; 09 the old VCC route gone, a wider outline;
// 10 SW1 placed and routed, refilled; 11 DRC clean; 12 the board in 3D.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Custom("eda-example gs18"),
        WaitFor("eda-mode-bar"),
        // GS22–GS23: a component; its symbol.
        Click(ui("pcb-add-component")),
        WaitFor("pcb-name-edit"),
        Key("Ctrl+A"),
        Type("Switch"),
        Key("Enter"),
        Click(ui("pcb-part-switch")),
        WaitFor("eda-mode-symbol"),
        MoveTo(1100, 860),
        Screenshot("01-symbol-editor"),
        Click(ui("sym-props")),
        WaitFor("eda-sym-dialog"),
        Click(ui("eda-sym-name-field")),
        Key("Ctrl+A"),
        Type("M2011S3A1W03"),
        Click(ui("eda-sym-ref-field")),
        Key("Ctrl+A"),
        Type("SW"),
        Click(ui("eda-sym-value-field")),
        Key("Ctrl+A"),
        Type("M2011S3A1W03"),
        Click(ui("eda-sym-keywords-field")),
        Type("spst switch toggle"),
        Click(ui("eda-sym-pin-names")),
        Screenshot("02-symbol-properties"),
        Click(ui("eda-sym-ok")),
        Click(ui("sym-pin")),
        WaitFor("eda-pin-dialog"),
        Click(ui("eda-pin-name-field")),
        Key("Ctrl+A"),
        Type("A"),
        Click(ui("eda-pin-number-field")),
        Key("Ctrl+A"),
        Type("2"),
        Click(ui("eda-pin-x-field")),
        Key("Ctrl+A"),
        Type("-200"),
        Click(ui("eda-pin-ok")),
        MoveTo(1100, 860),
        Key("Insert"),
        DoubleClick(flat(-4.0, -2.54)),
        WaitFor("eda-pin-dialog"),
        Click(ui("eda-pin-name-field")),
        Key("Ctrl+A"),
        Type("B"),
        Click(ui("eda-pin-orientation")),
        Click(ui("eda-pin-orientation-option-1")),
        Click(ui("eda-pin-x-field")),
        Key("Ctrl+A"),
        Type("200"),
        Click(ui("eda-pin-y-field")),
        Key("Ctrl+A"),
        Type("0"),
        Click(ui("eda-pin-ok")),
        Click(ui("sym-circle")),
        Click(flat(-2.54, 0.0)),
        Click(flat(-1.905, 0.0)),
        Click(flat(2.54, 0.0)),
        Click(flat(3.175, 0.0)),
        Click(ui("sym-line")),
        Click(flat(-1.905, 0.0)),
        DoubleClick(flat(1.905, 1.905)),
        Key("Escape"),
        MoveTo(1100, 860),
        Screenshot("03-symbol"),
        // GS24: the footprint.
        Click(ui("eda-mode-footprint")),
        WaitFor("fp-props"),
        Custom("eda-zoom -9 -14 9 5"),
        Click(ui("fp-props")),
        WaitFor("eda-fp-dialog"),
        Click(ui("eda-fp-name-field")),
        Key("Ctrl+A"),
        Type("Switch_Toggle_SPST_NKK_M2011S3A1x03"),
        Click(ui("eda-fp-value-field")),
        Key("Ctrl+A"),
        Type("Switch_Toggle_SPST_NKK_M2011S3A1x03"),
        Click(ui("eda-fp-ok")),
        // Pad 2: KiCad's (0, 4.7) is our (0, -4.7) (Y up); the hole and ring as expressions.
        Click(ui("fp-pad")),
        Click(flat(0.0, -4.7)),
        Key("Escape"),
        DoubleClick(flat(0.0, -4.7)),
        WaitFor("eda-pad-dialog"),
        Click(ui("eda-pad-number-field")),
        Key("Ctrl+A"),
        Type("2"),
        Click(ui("eda-pad-w-field")),
        Key("Ctrl+A"),
        Type("1.62 + 2*0.15"),
        Click(ui("eda-pad-h-field")),
        Key("Ctrl+A"),
        Type("1.62 + 2*0.15"),
        Click(ui("eda-pad-drill-field")),
        Key("Ctrl+A"),
        Type("1.42 + 0.2"),
        Click(ui("eda-pad-ok")),
        // Pad 3 copies pad 2.
        Click(ui("fp-pad")),
        Click(flat(0.0, -9.4)),
        Key("Escape"),
        // Bigger rings: pad 2 to 1.62+2*0.3, pushed to pad 3.
        DoubleClick(flat(0.0, -4.7)),
        WaitFor("eda-pad-dialog"),
        Click(ui("eda-pad-w-field")),
        Key("Ctrl+A"),
        Type("1.62+2*0.3"),
        Click(ui("eda-pad-h-field")),
        Key("Ctrl+A"),
        Type("1.62+2*0.3"),
        Click(ui("eda-pad-ok")),
        Click(flat(0.0, -4.7)),
        Click(ui("fp-push")),
        // Fab, silkscreen and courtyard outlines (the layer button cycles them).
        Click(ui("fp-rect")),
        Click(flat(-3.95, 1.8)),
        Click(flat(3.95, -11.2)),
        Click(ui("fp-layer")),
        Click(flat(-4.05, 1.9)),
        Click(flat(4.05, -11.3)),
        Click(ui("fp-layer")),
        Click(flat(-6.0, 3.0)),
        Click(flat(6.0, -12.5)),
        Key("Escape"),
        MoveTo(1100, 860),
        Screenshot("04-footprint"),
        // GS24: the courtyard's corners typed in.
        Click(flat(6.0, -6.0)),
        Key("E"),
        WaitFor("eda-rect-dialog"),
        Click(ui("eda-rect-x0-field")),
        Key("Ctrl+A"),
        Type("-4.2"),
        Click(ui("eda-rect-y0-field")),
        Key("Ctrl+A"),
        Type("2.05"),
        Click(ui("eda-rect-x1-field")),
        Key("Ctrl+A"),
        Type("4.2"),
        Click(ui("eda-rect-y1-field")),
        Key("Ctrl+A"),
        Type("-11.45"),
        Click(ui("eda-rect-ok")),
        Key("Escape"),
        MoveTo(1100, 860),
        Screenshot("05-courtyard"),
        // GS26: the 3D model, turned 90° about Z.
        Click(ui("fp-model")),
        WaitFor("eda-model-dialog"),
        Click(ui("eda-model-path-field")),
        Key("Ctrl+A"),
        Type("getting-started.3dshapes/Switch_Toggle_SPST_NKK_M2011S3A1x03.step"),
        Click(ui("eda-model-rot-z-field")),
        Key("Ctrl+A"),
        Type("90"),
        Screenshot("06-model"),
        Click(ui("eda-model-ok")),
        // GS25: SW1 between the battery and VCC.
        Click(ui("pcb-board-getting-started")),
        Click(ui("eda-mode-schematic")),
        WaitFor("sch-erc"),
        Custom("eda-zoom 70 60 230 140"),
        Click(flat(101.6, 110.0)),
        Key("Delete"),
        Click(flat(101.6, 116.84)),
        Key("Delete"),
        MoveTo(800, 500),
        Key("A"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("M2011"),
        Key("Enter"),
        Click(flat(101.6, 115.57)),
        // R turns the symbol under the pointer.
        Key("R"),
        Key("W"),
        Click(flat(101.6, 105.41)),
        Click(flat(101.6, 110.49)),
        Key("Escape"),
        Key("W"),
        Click(flat(101.6, 120.65)),
        Click(flat(101.6, 127.0)),
        Key("Escape"),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("PWR_FLAG"),
        Key("Enter"),
        Click(flat(101.6, 123.19)),
        Key("Escape"),
        MoveTo(1100, 860),
        Click(ui("sch-erc")),
        WaitFor("eda-erc-dialog"),
        ExpectText("eda-erc-summary", "No violations"),
        Click(ui("eda-erc-close")),
        MoveTo(1100, 860),
        Screenshot("07-schematic"),
        // GS25: the board. The old battery-to-resistor connection goes (U, U: through the via).
        Click(ui("eda-mode-layout")),
        WaitFor("eda-layout-tools"),
        Custom("eda-zoom -5 -5 60 55"),
        MoveTo(1100, 860),
        Key("F8"),
        WaitFor("eda-update-dialog"),
        Click(ui("eda-update-run")),
        Wait(2),
        Click(ui("eda-update-close")),
        MoveTo(1100, 860),
        Screenshot("08-sw1-added"),
        Click(flat(37.12, 26.0)),
        Key("U"),
        Key("U"),
        Key("Delete"),
        // A wider board and zone.
        Click(flat(45.0, 40.0)),
        Key("Delete"),
        Click(flat(2.0, 45.0)),
        Key("Delete"),
        Click(ui("pcb-outline")),
        Click(flat(0.0, 0.0)),
        Click(flat(55.0, 50.0)),
        Key("Escape"),
        MoveTo(1100, 860),
        Screenshot("09-wider"),
        Key("PageDown"),
        Click(ui("pcb-zone")),
        WaitFor("eda-zone-dialog"),
        Click(ui("eda-zone-ok")),
        Click(flat(0.0, 0.0)),
        Click(flat(55.0, 0.0)),
        Click(flat(55.0, 50.0)),
        DoubleClick(flat(0.0, 50.0)),
        Key("Escape"),
        // SW1 by the battery (M takes it by its origin), then its two connections: the
        // battery's on the back, the resistor's on the front.
        Hover(flat(31.7, 15.6)),
        Key("M"),
        Click(flat(49.0, 26.0)),
        Key("Escape"),
        Hover(flat(37.23, 32.0)),
        Key("X"),
        Click(flat(49.0, 21.3)),
        Key("PageUp"),
        Hover(flat(49.0, 16.6)),
        Key("X"),
        Click(flat(37.0, 11.5)),
        Key("Escape"),
        Key("B"),
        MoveTo(1100, 860),
        Screenshot("10-routed"),
        Click(ui("pcb-drc")),
        WaitFor("eda-drc-dialog"),
        Click(ui("eda-drc-run")),
        Screenshot("11-drc"),
        ExpectText("eda-drc-summary", "Violations (0): 0 errors, 0 warnings. Unconnected items: 0"),
        Click(ui("eda-drc-close")),
        // GS26: the switch's model in 3D.
        Click(ui("eda-mode-3d")),
        Key("F"),
        MoveTo(1100, 860),
        Screenshot("12-3d"),
    ],
)
