// Face mirror of a flange (P3I.5, SM12.2): a 100 × 60 plate centred on the Right plane, bent down
// at x = 35 (Hold line); Mirror with type Face, the flange's face picked and the Right plane: the
// flange comes over to x = −35 with its bend, in the definition (the flat has both).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect -50 0 50 60"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(0, 30, 0)),
        Wait(5),
        Click(ui("sm-thickness-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Custom("sketch top chain 35 -15 35 75"),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(15),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Wait(10),
        Click(xyz(35, 70, 0)),
        Wait(30),
        Click(ui("sm-bend-alignment")),
        Wait(5),
        Click(ui("sm-bend-alignment-option-1")),
        Wait(20),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Wait(30),
        Custom("view 30 30 0 30 -10 0.11"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-flange"),
        Click(ui("mirror")),
        WaitFor("mirror-dialog"),
        Wait(5),
        Click(ui("mirror-type")),
        Wait(5),
        Click(ui("mirror-type-option-2")),
        Wait(10),
        Click(xyz(38, 30, -8)),
        Wait(10),
        Click(ui("mirror-plane-field")),
        Wait(3),
        Click(ui("feature-right")),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-face-mirror"),
        Click(ui("mirror-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
    ],
)
