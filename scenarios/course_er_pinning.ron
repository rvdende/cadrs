        MoveTo(1420, 780),
        Wait(3),
        Screenshot("06-pinned-stays-v1"),
        Click(ui("instance-row-2-linked")),
        WaitFor("reference-manager"),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("07-pinned-icon-selective"),
        Click(ui("refman-update")),
        MoveTo(1420, 780),
        Wait(3),
