// The public chat (the documents page's app menu): say something; the line is signed, carries
// its proof of work and shows at once (the network is off in scenarios, so nobody else hears).
Scenario(
    start: Some("landing"),
    steps: [
        WaitFor("landing-page"),
        Click(ui("app-menu")),
        WaitFor("app-public-chat"),
        Click(ui("app-public-chat")),
        WaitFor("public-chat-dialog"),
        Type("Hello, makers"),
        Click(ui("public-chat-send")),
        WaitFor("public-chat-0"),
        ExpectText("public-chat-0", "Hello, makers"),
        Screenshot("01-public-chat"),
    ],
)
