// P3E.4 (TD12.4–TD12.7, TD3.7, X9; the test drive exercise's step 9): version → branch →
// 1 mm gasket → merge → Restore, on the stand-in "Carburetor (stand-in)" (`Custom("gasket")`,
// `cadrs_core::samples::gasket`: the Part Studios Gasket (CARBURETOR_GASKET, 2 mm) and Manifold,
// and Assembly 1 with both).
// 01 History panel: Create version "V1" ("Gasket 2 mm"): Main, V1 (a square), Start.
// 02 right-click V1: Open read-only, Restore, Branch to create workspace….
// 03 Branch to create workspace from V1: the name "Alternate Gasket Thickness" typed.
// 04 Create: the branch is open: the header and the panel's top row say "Alternate Gasket
//    Thickness"; its rail ends at V1 (Main's version it came from); "Other workspaces": Main.
// 05 in the branch, Extrude 1's depth 2 → 1 mm (the dialog's preview).
// 06 accepted, and the Manifold's Extrude 1 20 → 25 mm too; back on Gasket, Mass properties of
//    CARBURETOR_GASKET: 1985.31 mm³ (the 1 mm gasket); the branch's "2 changes".
// 07 the documents page: the row shows the last-opened workspace, "Alternate Gasket Thickness"
//    (TD3.7), not "Main".
// 08 reopened (in the branch, as it was left); the header's workspace name opens the workspace
//    menu: Main, Alternate Gasket Thickness (checked).
// 09 Main: unchanged: the gasket is still 3970.62 mm³ (2 mm); the header says "Main".
// 10 the History panel on Main: Main, V1, Start; under "Other workspaces" the branch, "From V1".
// 11 right-click the branch: Switch to workspace, Merge into current workspace….
// 12 the merge dialog lists the changed tabs (Gasket, Manifold: Modified), each "Replace with
//    Alternate Gasket Thickness" by default; the Manifold's action opened.
// 13 the Manifold set to "Keep Main".
// 14 Merge: one entry, "Merge from Alternate Gasket Thickness"; the gasket is 1 mm in Main
//    (1985.31 mm³).
// 14b Assembly 1 (kept) after the merge: its CARBURETOR_GASKET <1> instance still resolves, now
//    to the 1 mm gasket of the replaced Gasket tab (the same part id), on the Manifold
//    (kept at 20 mm).
// 15 right-click Start (the entry before the merge) → Restore: Main is back at 2 mm
//    (3970.62 mm³); "Restore : Start" on the rail above the merge.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("gasket"),
        Key("Shift+7"),
        Key("F"),
        Click(ui("rail-history")),
        WaitFor("history-panel"),
        Click(ui("history-create-version")),
        WaitFor("version-popup"),
        Click(ui("version-popup-description")),
        Type("Gasket 2 mm"),
        Click(ui("version-popup-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-version-v1"),
        RightClick(ui("history-version-1")),
        WaitFor("history-version-menu"),
        Screenshot("02-version-menu"),
        Click(ui("history-branch")),
        WaitFor("branch-dialog"),
        Type("Alternate Gasket Thickness"),
        Screenshot("03-branch-dialog"),
        Click(ui("branch-create")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-branch-open"),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("1"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-depth-1mm"),
        Click(ui("extrude-dialog-accept")),
        Click(ui("tab-manifold")),
        Wait(40),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("25"),
        Key("Enter"),
        Click(ui("tab-gasket")),
        Click(ui("history-group-1")),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "1985.31"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-branch-gasket-1mm"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        Click(ui("back-to-documents")),
        WaitFor("doc-row-0"),
        ExpectText("doc-row-0", "Alternate Gasket Thickness"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-documents-workspace"),
        DoubleClick(ui("doc-name-0")),
        WaitFor("document-shell"),
        Key("Shift+7"),
        Key("F"),
        Click(ui("branch-label")),
        WaitFor("workspace-menu"),
        Screenshot("08-workspace-menu"),
        Click(ui("workspace-item-0")),
        ExpectText("branch-label", "Main"),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "3970.62"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-main-unchanged"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        Click(ui("rail-history")),
        WaitFor("history-panel"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-main-history"),
        RightClick(ui("history-workspace-1")),
        WaitFor("history-workspace-menu"),
        Screenshot("11-workspace-menu"),
        Click(ui("history-merge")),
        WaitFor("merge-dialog"),
        Click(ui("merge-tab-1")),
        WaitFor("merge-tab-1-menu"),
        Screenshot("12-merge-dialog"),
        Click(ui("merge-tab-1-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("13-merge-keep-manifold"),
        Click(ui("merge-accept")),
        Click(ui("history-group-1")),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "1985.31"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("14-merged"),
        Click(ui("mass-dialog-cancel")),
        Key("Space"),
        Click(ui("tab-assembly-1")),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("14b-merged-assembly"),
        Click(ui("tab-gasket")),
        RightClick(ui("history-start")),
        WaitFor("history-row-menu"),
        Click(ui("history-restore")),
        Click(ui("part-row-carburetor-gasket")),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        ExpectText("mass-dialog", "3970.62"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("15-restored"),
    ],
)
