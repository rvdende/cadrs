        Press(world(210.585, 203.2)),
        MoveWorld(212, 203.2),
        Wait(3),
        MoveWorld(214.5, 203.2),
        Wait(8),
        Screenshot("12b-bom-column-width-dragged"),
        Release,
        Wait(10),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("13-bom-resized"),
        Key("Escape"),
        Wait(3),
        // D12.10: Callout: Underline, Part: Name, x Table: Qty.
        Click(ui("drawing-callout")),
        WaitFor("callout-dialog"),
        Wait(8),
        Click(ui("callout-border")),
        Wait(5),
        Click(ui("callout-border-option-1")),
        Wait(5),
        Click(ui("callout-center-field")),
        Wait(3),
        Key("Ctrl+A"),
        Key("Backspace"),
        Wait(3),
        Click(ui("callout-part-property")),
        Wait(5),
        Click(ui("callout-part-name")),
        Wait(5),
        Click(ui("callout-right-field")),
        Wait(3),
        Type("x "),
        Wait(3),
        Click(ui("callout-table-property")),
        Wait(5),
        Hover(ui("callout-table-qty")),
        Wait(3),
        Screenshot("14-callout-table-property-menu"),
        Click(ui("callout-table-qty")),
        Wait(5),
        // The flange, top left.
        ClickWorld(68.288, 165.795),
        Wait(8),
        MoveWorld(70, 190),
        Wait(5),
        MoveWorld(62, 196),
        Wait(10),
        Screenshot("14b-callout-following-cursor"),
        ClickWorld(62, 196),
        Wait(8),
        // The centre block, right.
        ClickWorld(64.0, 134.886),
        Wait(8),
        MoveWorld(124, 128),
        Wait(5),
        ClickWorld(124, 128),
        Wait(8),
        // The axle (its end face's rim): it snaps under the block's callout (D11.6). The
