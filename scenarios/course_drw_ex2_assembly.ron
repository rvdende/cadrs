        // D11.5: the axle's callout → Edit…: Part number in its lower field; ✓; undone.
        RightClick(world(135, 118.5)),
        WaitFor("annotation-menu-edit"),
        Hover(ui("annotation-menu-edit")),
        Wait(5),
