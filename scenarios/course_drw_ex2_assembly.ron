        ClickWorld(88.6, 124.6),
        Wait(8),
        MoveWorld(125.6, 116),
        Wait(10),
        Screenshot("14c-callout-inference-line"),
        ClickWorld(125.6, 116),
        Wait(8),
        // A screw (the lower right one, below the axle).
        ClickWorld(92.97, 119.35),
        Wait(8),
        MoveWorld(124.8, 104),
        Wait(5),
        ClickWorld(124.8, 104),
        Wait(8),
        // A bush (its flange's lower rim), placed out of line.
        ClickWorld(82.4, 107.5),
        Wait(8),
        MoveWorld(116, 86),
        Wait(5),
        ClickWorld(116, 86),
        Wait(8),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("15-five-callouts"),
        Click(ui("callout-dialog-ok")),
        Wait(8),
        // D12.11: the bush's callout dragged into line: the dashed inference line.
        Press(world(135, 88)),
        MoveWorld(138, 88),
        Wait(3),
        MoveWorld(141, 88),
        Wait(3),
        MoveWorld(143.6, 88),
        Wait(10),
