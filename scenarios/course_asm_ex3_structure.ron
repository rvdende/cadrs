        Screenshot("20b-a21.14-eight-hole-edges-rods-shown"),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-source-2")),
        Click(ui("std-category")),
        Click(ui("std-category-option-1")),
        Click(ui("std-size")),
        Click(ui("std-size-option-4")),
        Click(ui("std-material")),
        Click(ui("std-material-option-1")),
