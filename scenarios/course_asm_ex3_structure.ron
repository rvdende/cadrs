// P3B.4 + P3B.5 / A21: "Exercise: Assembly structure" (intro-to-assemblies.md A21, ex3-step1..16,
// ex3-drawing), the whole exercise on the Ex2 end state (`fixtures/pneumatic_cylinder_ex2.cadrs`,
// built by `samples::pneumatic_ex2` as `course_asm_ex2_pneumatic` builds it).
// 00 (A21.1, ex3-step1) the workspace units checked: ☰ → Workspace units: Inch, Pound.
// 01 (A21.1) the copied document, "Cylinder assembly": 17 instances.
// A21.2 (ex3-step2): Piston & Rod hidden, the Retaining Plate zoomed to, its six Ø0.266 hole
//    edges clicked; 02 Insert → Standard content: ANSI inch / Bolts & screws / Hex bolts / Hex cap
//    screw, 1/4-28 x 0.75, thread length 0.75, Stainless Steel (Part number, Description and the
//    preview filled in); 03 Insert: six screws with Fastened 12–17.
// A21.3 (ex3-step3): 04 right-click a screw → Select instances with same part and same
//    configuration: the six; 05 Add selection to folder… "Hardware"; 06 the folder, closed.
// 07 (A21.4, ex3-step4) Retaining Plate, Top Cap, O-Ring 0.125 <3>, <4> → Move to new
//    subassembly.
// 08 (A21.5, ex3-step5) the new tab renamed "Top Cap subassembly", the Top Cap fixed: 4
//    instances, numbered afresh in it (O-Ring 0.125 <1>, <2>, as `ex3-step16.png`), 3 mates (Fastened 3, 4 and Fastened 18, which stands for the old Group; the six
//    screws' mates stay in Cylinder assembly, holding them to the plate inside the subassembly).
// 09 (A21.6, ex3-step6) Cylinder assembly: right-click Rear Cap → Create empty subassembly.
// 10 (A21.7, ex3-step7) Rear Cap, Rear Cap mount, O-Ring 0.125 <1>, <2> dragged onto it
//    ("4 items"); 11 dropped.
// 12 (A21.8, ex3-step8) "Rear Cap subassembly", the Rear Cap fixed: Fastened 1, 2, Revolute 1.
// 13 (A21.9, ex3-step9) Piston & Rod and the 3 O-Ring 0.185 → Move to new subassembly.
// 14 (A21.10, ex3-step10) "Piston subassembly", Piston & Rod fixed: Fastened 9, 10, 11.
// 15 (A21.11, ex3-step11) Rear Cap subassembly opened (with its Items and Mate Features), the
//    Rear Cap mount dragged out to the top, its name in a pill by the pointer; 16 out (Revolute 1, which holds it to the Rear Cap
//    inside the subassembly, is now a Cylinder assembly mate; the subassembly keeps Fastened 1
//    and 2).
// 17 (A21.12, ex3-step12) right-click Piston subassembly → Dissolve subassembly; 18 its
//    instances back at the top level, its tab kept.
// 19 (A21.13, ex3-step13) the empty Piston subassembly tab (Instances (0)), its tab menu;
//    20 deleted.
// 20b (A21.14) the eight hole edges selected.
// A21.14 (ex3-step14): with the rods shown, in one view from above, the four rod-hole edges on
//    top of the Top Cap and the four on the Rear Cap's flange selected (a hole edge its rod fills
//    is still picked; the back one through the clear barrel); 21 Insert → Standard
//    content: ANSI inch / Nuts / Hex nuts / Hex nut, 3/8-16, Chamfered, Stainless Steel, Plain;
//    22 Insert: eight nuts (on the Top Cap and on the Rear Cap's flange, as `ex3-drawing.png`
//    shows them), each Fastened.
// 23 (A21.15, ex3-step15) the eight nuts dragged onto Hardware ("8 items"); 24 Hardware (14).
// 25 (A21.16, ex3-step16) Top Cap subassembly: its root row → Mass properties: 0.484 lb,
//    5.058 in³, CoM (0, 0, 6.033) in (its four instances: the screws stay in Cylinder assembly).
// 26 the end state (ex3-drawing): Instances (26): Rear Cap mount <1>, Barrel <1> (fixed), Rear
//    Cap subassembly <1>, Top Cap subassembly <1>, Structural Rod <1–4>, Piston & Rod <1>, O-Ring
//    0.185 <1–3>, Hardware (14).
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture pneumatic_cylinder_ex2"),
        Click(ui("tab-cylinder-assembly")),
        Key("F"),
        // A21.1: the workspace units are Inch / Pound.
        Click(ui("document-menu")),
        WaitFor("document-menu-units"),
        Click(ui("document-menu-units")),
        WaitFor("workspace-units-dialog"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("00-a21.1-workspace-units-inch-pound"),
        Click(ui("units-cancel")),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("01-a21.1-cylinder-assembly"),
        // A21.2: six hex cap screws on the Retaining Plate's hole edges.
        Hover(ui("instance-row-14")),
        Wait(3),
        Click(ui("instance-row-14-eye")),
        RightClick(ui("instance-row-3")),
        WaitFor("asm-zoom-selection"),
        Click(ui("asm-zoom-selection")),
        Key("Escape"),
        Click(at(262, 100)),
        Click(xyz(17.348, 0.0, 168.275)),
        Click(xyz(8.674, 15.024, 168.275)),
        Click(xyz(-8.674, 15.024, 168.275)),
        Click(xyz(-17.348, 0.0, 168.275)),
        Click(xyz(-8.674, -15.024, 168.275)),
        Click(xyz(8.674, -15.024, 168.275)),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-source-2")),
        Click(ui("std-size")),
        Click(ui("std-size-option-1")),
        Click(ui("std-material")),
        Click(ui("std-material-option-1")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("02-a21.2-hex-cap-screw-options"),
        Click(ui("std-insert")),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("03-a21.2-six-screws"),
        Click(ui("insert-dialog-accept")),
        Hover(ui("instance-row-14")),
        Wait(3),
        Click(ui("instance-row-14-eye")),
        Key("F"),
        // A21.3: select the six (same part and configuration), into a folder "Hardware".
        RightClick(ui("instance-row-18")),
        WaitFor("asm-select-same-part"),
        Hover(ui("asm-select-same-part")),
        Wait(3),
        Screenshot("04-a21.3-select-same-part-and-configuration"),
        Click(ui("asm-select-same-part")),
        RightClick(ui("instance-row-20")),
        WaitFor("asm-folder"),
        Click(ui("asm-folder")),
        WaitFor("folder-name-popup"),
        Type("Hardware"),
        Screenshot("05-a21.3-folder-name-hardware"),
        Click(ui("folder-name-popup-accept")),
        Click(ui_at("instance-folder-hardware", 0.04, 0.5)),
        Click(at(1350, 650)),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("06-a21.3-hardware-folder"),
        // A21.4: Move to new subassembly.
        Click(ui("instance-row-3")),
        Click(ui("instance-row-4")),
        Click(ui("instance-row-8")),
        Click(ui("instance-row-9")),
        RightClick(ui("instance-row-4")),
        WaitFor("asm-move-to-new"),
        Hover(ui("asm-move-to-new")),
        Wait(3),
        Screenshot("07-a21.4-move-to-new-subassembly"),
        Click(ui("asm-move-to-new")),
        // A21.5: its tab renamed, the Top Cap fixed.
        Click(ui("tab-assembly-1")),
        RightClick(ui("tab-assembly-1")),
        WaitFor("tab-rename"),
        Click(ui("tab-rename")),
        Key("Ctrl+A"),
        Type("Top Cap subassembly"),
        Key("Enter"),
        Key("F"),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-fix"),
        Hover(ui("asm-fix")),
        Wait(3),
        Screenshot("08-a21.5-top-cap-subassembly-fix"),
        Click(ui("asm-fix")),
        // A21.6: Create empty subassembly.
        Click(ui("tab-cylinder-assembly")),
        RightClick(ui("instance-row-2")),
        WaitFor("asm-empty-sub"),
        Hover(ui("asm-empty-sub")),
        Wait(3),
        Screenshot("09-a21.6-create-empty-subassembly"),
        Click(ui("asm-empty-sub")),
        // A21.7: drag Rear Cap, Rear Cap mount, O-Ring <1>, <2> onto it.
        Click(at(1350, 650)),
        Click(ui("instance-row-2")),
        Click(ui("instance-row-5")),
        Click(ui("instance-row-6")),
        Click(ui("instance-row-7")),
        Press(ui("instance-row-6")),
        Wait(2),
        Hover(ui_at("instance-row-5", 0.5, 0.3)),
        Wait(2),
        Hover(ui_at("instance-row-3", 0.5, 0.5)),
        Wait(5),
        Screenshot("10-a21.7-four-items"),
        Release,
        Wait(10),
        MoveTo(1300, 250),
        Wait(3),
        Screenshot("11-a21.7-dropped"),
        // A21.8: "Rear Cap subassembly", the Rear Cap fixed.
        Click(ui("tab-assembly-1")),
        RightClick(ui("tab-assembly-1")),
        WaitFor("tab-rename"),
        Click(ui("tab-rename")),
        Key("Ctrl+A"),
        Type("Rear Cap subassembly"),
        Key("Enter"),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Key("F"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("12-a21.8-rear-cap-subassembly"),
        // A21.9: Piston & Rod and the three O-Ring 0.185 → Move to new subassembly.
        Click(ui("tab-cylinder-assembly")),
        Click(ui("instance-row-8")),
        Click(ui("instance-row-9")),
        Click(ui("instance-row-10")),
        Click(ui("instance-row-11")),
        RightClick(ui("instance-row-8")),
        WaitFor("asm-move-to-new"),
        Hover(ui("asm-move-to-new")),
        Wait(3),
        Screenshot("13-a21.9-piston-move-to-new"),
        Click(ui("asm-move-to-new")),
        // A21.10: "Piston subassembly", Piston & Rod fixed.
        Click(ui("tab-assembly-1")),
        RightClick(ui("tab-assembly-1")),
        WaitFor("tab-rename"),
        Click(ui("tab-rename")),
        Key("Ctrl+A"),
        Type("Piston subassembly"),
        Key("Enter"),
        RightClick(ui("instance-row-1")),
        WaitFor("asm-fix"),
        Click(ui("asm-fix")),
        Key("F"),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("14-a21.10-piston-subassembly"),
        // A21.11: the Rear Cap mount dragged out of the Rear Cap subassembly.
        Click(ui("tab-cylinder-assembly")),
        Click(ui_at("instance-row-2", 0.05, 0.5)),
        Press(ui("instance-child-rear-cap-mount-1")),
        Wait(2),
        Hover(ui_at("instance-row-1", 0.5, 0.6)),
        Wait(2),
        Hover(ui_at("instance-row-1", 0.5, 0.1)),
        Wait(5),
