        Click(ui("tab-cylinder-assembly")),
        Click(at(1350, 650)),
        Custom("view 25 60"),
        Key("F"),
        Click(xyz(26.143, 19.814, 165.1)),
        Click(xyz(-22.117, 19.814, 165.1)),
        Click(xyz(-22.117, -28.446, 165.1)),
        Click(xyz(26.143, -28.446, 165.1)),
        Click(xyz(26.143, 19.814, 19.05)),
        Click(xyz(-27.498, 27.498, 19.05)),
        Click(xyz(-22.117, -28.446, 19.05)),
        Click(xyz(26.143, -28.446, 19.05)),
        MoveTo(1300, 250),
