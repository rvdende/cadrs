        MoveTo(1300, 250),
        Wait(3),
        Screenshot("16-a21.11-mount-out"),
        // A21.12: Dissolve the Piston subassembly.
        Click(ui_at("instance-row-3", 0.05, 0.5)),
        RightClick(ui("instance-row-9")),
        WaitFor("asm-dissolve"),
        Hover(ui("asm-dissolve")),
        Wait(3),
        Screenshot("17-a21.12-dissolve-piston"),
        Click(ui("asm-dissolve")),
        MoveTo(1300, 250),
