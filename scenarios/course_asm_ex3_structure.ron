        Hover(ui("tab-delete")),
        Wait(3),
        Screenshot("19-a21.13-empty-tab-menu"),
        Click(ui("tab-delete")),
        MoveTo(1300, 250),
        Wait(2),
        Screenshot("20-a21.13-tab-deleted"),
        // A21.14: eight hex nuts on the rod holes, the rods shown, all picked in one view from
