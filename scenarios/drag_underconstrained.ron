// M6: dragging under-constrained geometry with no tool active; the solver keeps the constraints
// every frame with the minimum-norm step. A rectangle's corner follows the pointer while the
// opposite corner stays and the sides stay horizontal/vertical (mid-drag and dropped); dragging
// its left edge moves the edge; pulling a circle's rim changes its radius (the center stays);
// a horizontal line dragged by its middle moves with the pointer and stays horizontal, and
// dragged by its end it stays horizontal too. Each drag is one undo step: Ctrl+Z puts the last
// one back.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("G"),
        ClickWorld(-60, 10),
        ClickWorld(-20, 40),
        Key("Escape"),
        Key("Escape"),
        Key("C"),
        ClickWorld(30, 25),
        ClickWorld(45, 25),
        Key("Escape"),
        Key("L"),
        ClickWorld(-50, -30),
        ClickWorld(10, -30),
        Key("Escape"),
        Key("Escape"),
        MoveWorld(80, -60),
        Wait(2),
        Screenshot("01-under-constrained-geometry"),
        Press(world(-20, 40)),
        Hover(world(-17, 43)),
        Hover(world(-13, 47)),
        Hover(world(-9, 51)),
        Wait(2),
        Screenshot("02-dragging-corner-mid-drag"),
        Hover(world(-5, 55)),
        Wait(2),
        Release,
        Wait(3),
        Screenshot("03-corner-dropped-still-rectangle"),
        Press(world(-60, 30)),
        Hover(world(-64, 28)),
        Hover(world(-70, 25)),
        Wait(2),
        Screenshot("04-dragging-left-edge"),
        Release,
        Wait(2),
        Press(world(45, 25)),
        Hover(world(48, 26)),
        Hover(world(52, 28)),
        Wait(2),
        Screenshot("05-dragging-circle-rim-radius"),
        Release,
        Wait(2),
        Press(world(-20, -30)),
        Hover(world(-18, -26)),
        Hover(world(-15, -20)),
        Wait(2),
        Screenshot("06-dragging-horizontal-line"),
        Release,
        Wait(2),
        Press(world(15, -20)),
        Hover(world(20, -12)),
        Hover(world(25, -5)),
        Wait(2),
        Screenshot("07-dragging-line-end-stays-horizontal"),
        Release,
        Wait(2),
        MoveWorld(80, -60),
        Wait(2),
        Screenshot("08-after-drags"),
        Key("Ctrl+Z"),
        Screenshot("09-undo-last-drag"),
    ],
)
