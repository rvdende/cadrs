// Bend (P3I.5, SM9; exercise E1 steps 6–10): a 100 × 60 plate made by Thicken, two sketch lines
// across it, the Sheet metal model ▾ now offering the built tools, the Bend dialog as
// `help/feature-tools/bend-dialog.png` lays it out, the line picked (the face under it filled
// in), Bend alignment Inner, accepted; a second bend with the opposite angle. The flat keeps its
// 100 × 60 size (tests: `cadrs_core/tests/sheetmetal_tools.rs`).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(xyz(50, 30, 0)),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Custom("sketch top chain 80 -15 80 75 chain 20 -15 20 75"),
        Click(ui("sheet-metal-model-caret")),
        Screenshot("01-menu-tools-enabled"),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-bend-dialog"),
        Click(xyz(80, 70, 0)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-line-picked-face-filled"),
        Click(ui("sm-bend-alignment")),
        Screenshot("04-alignment-menu"),
        Click(ui("sm-bend-alignment-option-3")),
        Custom("view 30 30 50 30 10 0.11"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-bent-inner"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        // The Bend hid Sketch 2 (its line's sketch), as Onshape does: shown again for the next.
        Hover(ui("feature-sketch-2")),
        Wait(5),
        Click(ui("feature-sketch-2-visibility")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Click(xyz(20, 70, 0)),
        Click(ui("sm-bend-alignment")),
        Click(ui("sm-bend-alignment-option-3")),
        Click(ui("sm-bend-angle-control-flip")),
        Custom("view 30 30 50 30 0 0.11"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-second-bend-opposite"),
        Click(ui("sheet-metal-bend-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-accepted"),
    ],
)
