// M5: intersection inference (reference/onshape/inference.md). Two crossing lines and a circle;
// hovering the lines' crossing shows the snap square with both lines orange and two coincident
// glyphs; then the crossing of a line and the circle, and of a line and the sketch's Y axis (the
// axis turns orange). A line committed from the lines' crossing to the circle records a point
// on each line and a point on the circle, shown as coincident glyphs. A second circle
// overlapping the first: hovering where the two circles cross snaps to the intersection.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("L"),
        ClickWorld(-80, 10),
        ClickWorld(-10, 60),
        Key("Escape"),
        ClickWorld(-80, 55),
        ClickWorld(40, 15),
        Key("Escape"),
        Key("C"),
        ClickWorld(45, 35),
        ClickWorld(67, 35),
        Key("Escape"),
        Key("L"),
        MoveWorld(-36.5, 40.2),
        Wait(2),
        Screenshot("01-hover-line-line-intersection"),
        MoveWorld(31.6, 18.5),
        Wait(2),
        Screenshot("02-hover-line-circle-intersection"),
        MoveWorld(0.6, 27.7),
        Wait(2),
        Screenshot("03-hover-line-axis-intersection"),
        ClickWorld(-36.5, 40.2),
        MoveWorld(23.4, 35.5),
        Wait(2),
        Screenshot("04-line-to-circle"),
        ClickWorld(23.4, 35.5),
        Key("Escape"),
        MoveWorld(90, 70),
        Wait(3),
        Screenshot("05-committed-constraint-glyphs"),
        Key("C"),
        ClickWorld(75, 35),
        ClickWorld(95, 35),
        Key("Escape"),
        Key("L"),
        MoveWorld(61.6, 49.4),
        Wait(2),
        Screenshot("06-hover-circle-circle-intersection"),
    ],
)
