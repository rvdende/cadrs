// The Variable Studio (Onshape's `VariableStudio/variable_studio.htm` and the
// `variables-and-expressions` course), through the UI.
// 01 + ▸ Create Variable Studio: an empty table (Name, Type, Value, Evaluates to, Description),
//    the "Add variable" row, the availability checkbox at the bottom.
// 02 the help page's table top: #length = 1200 mm, #width = #length / 2 (= 600 mm), #legs = 4
//    (Number), a description; #overhang = #thickness * 2 is red: #thickness is below it.
// 03 #thickness moved up (right-click ▸ Move up): #overhang = 50 mm, no errors.
// 04 Part Studio 1: a 60 × 30 rectangle extruded by "#thickness" (25 mm).
// 05 #thickness = 40 mm in the studio: the Part Studio's extrude follows (one undo step).
// 06 Variable Studio 1 unchecked (a draft): Part Studio 1's extrude fails, #thickness isn't
//    defined (checked again afterwards).
// 07 a second studio, Insert Variable Studio: Variable Studio 1 picked, its variables checked.
// 08 inserted: Variable Studio 1's table above the own one, #depth = #width / 10 (= 60 mm).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("insert-tab")),
        WaitFor("create-variable-studio"),
        Click(ui("create-variable-studio")),
        WaitFor("variable-studio-new-name"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-empty-variable-studio"),
        Click(ui("variable-studio-new-name")),
        Type("length"),
        Key("Enter"),
        Type("1200 mm"),
        Key("Enter"),
        Type("width"),
        Key("Enter"),
        Type("#length / 2"),
        Key("Enter"),
        Type("legs"),
        Key("Enter"),
        Type("4"),
        Key("Enter"),
        Type("overhang"),
        Key("Enter"),
        Type("#thickness * 2"),
        Key("Enter"),
        Type("thickness"),
        Key("Enter"),
        Type("25"),
        Key("Enter"),
        Key("Escape"),
        Click(ui("variable-studio-row-3-type")),
        WaitFor("type-number"),
        Click(ui("type-number")),
        Click(ui("variable-studio-row-1-description")),
        Type("Table top length"),
        Key("Enter"),
        ExpectText("variable-studio-row-2-result", "600 mm"),
        ExpectText("variable-studio-row-4-result", "used before it is defined"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-table-top-with-error"),
        RightClick(ui("variable-studio-row-5")),
        WaitFor("row-move-up"),
        Click(ui("row-move-up")),
        ExpectText("variable-studio-row-5-result", "50 mm"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-moved-up-no-errors"),
        Click(ui("tab-part-studio-1")),
        WaitFor("feature-rows"),
        Custom("sketch top rect 0 0 60 30"),
        Wait(10),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(ui("feature-sketch-1")),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("#thickness"),
        Click(ui("extrude-dialog-title")),
        Click(ui("extrude-dialog-accept")),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(10),
        Screenshot("04-part-studio-uses-thickness"),
        Click(ui("tab-variable-studio-1")),
        WaitFor("variable-studio-row-4-value"),
        Click(ui("variable-studio-row-4-value")),
        Key("Ctrl+A"),
        Type("40 mm"),
        Key("Enter"),
        Key("Escape"),
        Click(ui("tab-part-studio-1")),
        WaitFor("feature-rows"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(10),
        Screenshot("05-thickness-40-follows"),
        Click(ui("tab-variable-studio-1")),
        WaitFor("variable-studio-available"),
        Click(ui("variable-studio-available")),
        Click(ui("tab-part-studio-1")),
        WaitFor("feature-rows"),
        Hover(ui("feature-extrude-1")),
        Wait(40),
        Screenshot("06-unavailable-extrude-fails"),
        Click(ui("tab-variable-studio-1")),
        WaitFor("variable-studio-available"),
        Click(ui("variable-studio-available")),
        Click(ui("insert-tab")),
        WaitFor("create-variable-studio"),
        Click(ui("create-variable-studio")),
        WaitFor("variable-studio-insert"),
        Click(ui("variable-studio-insert")),
        WaitFor("vs-insert-dialog"),
        Click(ui("vs-insert-studio-0")),
        WaitFor("vs-insert-whole"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-insert-variable-studio-dialog"),
        Click(ui("vs-insert-ok")),
        Click(ui("variable-studio-new-name")),
        Type("depth"),
        Key("Enter"),
        Type("#width / 10"),
        Key("Enter"),
        Key("Escape"),
        ExpectText("variable-studio-row-1-result", "60 mm"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-inserted-table"),
    ],
)
