// A worm drive (`cadrs_core::gear::worm`, issue #179). Gear, its type Worm drive: the wheel of
// a single-start worm, 30 teeth, accepted. Then Gear again, Cut as its Worm (its starts and the
// wheel's teeth change places), accepted: the worm on its wheel, in mesh.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        SetTimeout(120.0),
        Click(ui("gear")),
        WaitFor("gear-dialog"),
        Click(ui("gear-type")),
        Click(ui("gear-type-option-5")),
        Click(ui("gear-teeth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(6),
        Screenshot("01-worm-wheel"),
        Click(ui("gear-dialog-accept")),
        Click(ui("gear")),
        WaitFor("gear-dialog"),
        Click(ui("gear-type")),
        Click(ui("gear-type-option-5")),
        Click(ui("gear-teeth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        Click(ui("gear-member")),
        Click(ui("gear-member-option-1")),
        MoveTo(1420, 900),
        Wait(6),
        Screenshot("02-its-worm"),
        Click(ui("gear-dialog-accept")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(6),
        Screenshot("03-the-worm-drive"),
    ],
)
