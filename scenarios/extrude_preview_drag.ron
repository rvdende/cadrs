// M9: changing an extrude's depth and direction (compare reference/onshape/screens/23 and
// NOTES.md "Extrude"). A 50 × 30 rectangle on Top, Extrude, its region picked: the preview at
// 25 mm with the arrow. Dragging the arrow up deepens the preview live (the Depth field follows,
// in whole millimetres); released at 40 mm. Dragging it down through the sketch plane flips the
// extrusion below it. The flip button turns it back up. Typing an expression in Depth
// ("20 + 5*2") and Enter gives 30 mm and accepts, as in Onshape; Ctrl+Z takes Extrude 1 away (and gives Sketch 1
// back), Ctrl+Y brings it back. Double-clicking Extrude 1 reopens its dialog with its values;
// Esc closes it unchanged.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("G"),
        Wait(2),
        ClickWorld(0.45, 0.3),
        MoveWorld(49.12, 33.17),
        Wait(2),
        ClickWorld(49.12, 33.17),
        Wait(3),
        Type("50"),
        Key("Enter"),
        Wait(3),
        Type("30"),
        Key("Enter"),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Click(ui("sketch-dialog-accept")),
        Wait(3),
        Key("Shift+7"),
        Wait(40),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Wait(3),
        ClickWorld(25, 15),
        Wait(4),
        Hover(ui("extrude-arrow")),
        Wait(3),
        Screenshot("01-preview-25-mm-arrow-hovered"),
        Press(xyz(25, 15, 26)),
        Wait(2),
        Hover(xyz(25, 15, 34)),
        Wait(3),
        Screenshot("02-dragging-arrow-33-mm"),
        Hover(xyz(25, 15, 41)),
        Wait(3),
        Screenshot("03-dragging-arrow-40-mm"),
        Release,
        Wait(3),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("04-released-at-40-mm"),
        Press(xyz(25, 15, 41)),
        Wait(2),
        Hover(xyz(25, 15, 20)),
        Wait(2),
        Hover(xyz(25, 15, -5)),
        Wait(2),
        Hover(xyz(25, 15, -19)),
        Wait(3),
        Screenshot("05-dragged-through-the-plane-flipped"),
        Release,
        Wait(3),
        Click(ui("extrude-flip")),
        Wait(3),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("06-flip-button-back-up"),
        Click(ui("extrude-depth-field")),
        Wait(2),
        Type("20 + 5*2"),
        Wait(2),
        Screenshot("07-typing-an-expression"),
        Key("Enter"),
        Wait(3),
        MoveTo(1420, 780),
        Wait(3),
        Screenshot("08-enter-sets-30-mm-and-accepts"),
        Key("Ctrl+Z"),
        Wait(3),
        Screenshot("09-undo-extrude-gone"),
        Key("Ctrl+Y"),
        Wait(3),
        Screenshot("10-redo-extrude-back"),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        Wait(3),
        MoveTo(1420, 780),
        Wait(2),
        Screenshot("11-double-click-edits-extrude-1"),
        Key("Escape"),
        Wait(3),
        Screenshot("12-esc-closes-unchanged"),
    ],
)
