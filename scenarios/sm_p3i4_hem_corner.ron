// Hem corners (P3I.4, SM4.4; `help/feature-tools/hem-straight-simple.png`, `-closed.png`): a
// 60 × 40 × 2 plate (Thicken); one Hem on its east and north top edges, which meet at the corner
// (60, 40) (Straight, inner radius 1, 6 mm, Outer), seen from outside the corner: Simple (both
// legs cut on the corner's bisector, half the minimal gap off it), then Closed (the legs carried on and cut along the corner's bisector, the
// minimal gap apart: a mitred corner); accepted.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 60 40"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(xyz(30, 20, 0)),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-hem")),
        WaitFor("sheet-metal-hem-dialog"),
        Custom("view 30 30 30 20 0 0.1"),
        Click(xyz(60, 20, 2)),
        Click(xyz(30, 40, 2)),
        Click(ui("smf-flattened-checkbox")),
        Click(ui("smf-hem-total-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Tab"),
        Custom("view 135 45 56 36 2 0.045"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-simple"),
        Click(ui("smf-corner-type")),
        Click(ui("smf-corner-type-option-1")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-closed"),
        Click(ui("sheet-metal-hem-dialog-accept")),
        Custom("view 30 30 30 20 5 0.1"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
    ],
)
