// T2 / S11.4: "Dragging existing geometry also infers. For example, dragging a circle center
// until it's vertically aligned with the origin adds a Vertical constraint." A circle off to
// the right; its center is dragged left. Once it is straight above the origin it snaps there,
// with the dotted alignment guide from the origin and the vertical glyph at the cursor;
// releasing adds a Vertical constraint (its glyph by the center), as the same undo step as the
// drag: one Ctrl+Z puts the circle back without it.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        Click(ui("feature-top")),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("C"),
        Wait(2),
        ClickWorld(40, 30),
        ClickWorld(52, 30),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("01-circle"),
        Press(world(40, 30)),
        Hover(world(30, 32)),
        Hover(world(15, 33)),
        Wait(3),
        Screenshot("02-dragging-not-aligned"),
        Hover(world(0.4, 33)),
        Wait(3),
        Screenshot("03-aligned-with-origin-guide-and-glyph"),
        Release,
        Wait(3),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-released-vertical-constraint"),
        Key("Ctrl+Z"),
        Wait(5),
        Screenshot("05-one-undo-step-back"),
        Key("Ctrl+Y"),
        Wait(5),
        Screenshot("06-redo"),
    ],
)
