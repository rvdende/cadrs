// Issue #97: framing the selection and orbiting about it, keeping the camera up, and walking.
// The DC motor mount stand-in's hole is clicked and Alt+F frames it (01 → 02: its top and
// bottom circles about the view's centre, the bottom one hidden in the plate); a right-drag then
// turns the view about the hole's centre (03: the opening swings about the middle). The view menu's "Keep camera
// up" (04) makes the right-drag turn about the vertical without roll (05: the part's vertical
// edges stay upright). "Walk mode" goes to perspective, a crosshair at the centre where the
// mouse is held to look round, through a normal lens of about 45 mm (06). The wheel away from the user goes to a
// longer lens (07: about 140 mm, the part larger from the same spot) and back towards the user
// to the widest, 8 mm (08: the grid stretched towards the edges). W held a frame walks
// forward at 1.5 m/s (09), E up (10), and Esc leaves walk mode, back to the orthographic view
// and the normal lens (11).
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture motor_mount_standin"),
        Wait(20),
        Key("F"),
        Wait(20),
        Click(at(1006, 467)),
        Wait(2),
        Screenshot("01-hole-selected"),
        Key("Alt+F"),
        Wait(60),
        Screenshot("02-alt-f-frames-the-hole"),
        RightDrag(at(937, 560), at(997, 545)),
        Wait(5),
        Screenshot("03-orbits-about-the-hole"),
        Key("Space"),
        Key("F"),
        Wait(20),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Screenshot("04-view-menu-keep-up-walk"),
        Click(ui("view-keep-up")),
        Wait(2),
        RightDrag(at(700, 400), at(1150, 460)),
        Wait(5),
        Screenshot("05-turned-without-roll"),
        Click(ui("render-mode")),
        WaitFor("view-menu"),
        Click(ui("view-walk")),
        Wait(20),
        Screenshot("06-walk-mode-perspective"),
        Scroll(at(913, 527), 8),
        Wait(2),
        Screenshot("07-wheel-longer-lens"),
        Scroll(at(913, 527), -40),
        Wait(2),
        Screenshot("08-wheel-widest-lens"),
        KeyDown("W"),
        Wait(1),
        KeyUp("W"),
        Wait(2),
        Screenshot("09-walked-forward"),
        KeyDown("E"),
        Wait(1),
        KeyUp("E"),
        Wait(2),
        Screenshot("10-walked-up"),
        Key("Escape"),
        Wait(20),
        Screenshot("11-escape-leaves-walk-mode"),
    ],
)
