// P3.7 / PS20: Loft. A 40 × 40 square on Top; Plane 1 and Plane 2 offset 60 and 100 from Top,
// with a Ø30 and a Ø10 circle sketched on them. (Equal squares give the prism's volume and two
// circles the frustum's: the kernel's `loft_sections_and_conditions` conformance case.)
// 01 PS20.1 the Loft dialog as in `ex4-step9.png`: the square and the Ø30 circle picked in
//    order ("Face of Sketch 1", "Face of Sketch 2"), End conditions None: a ruled-looking
//    blend from the square to the circle.
// 02 the Ø10 circle added as the third profile: one smooth loft through the three.
// 03 PS20.2 the ↑↓ Reorder items button: drag handles at the rows' left, Done under them.
// 04 the square dragged to the end: the order is circle Ø30, circle Ø10, square.
// 05 Done; back in the first order (undo of the move), then PS20.4 Start profile condition
//    Normal to profile, Start magnitude 2: the loft leaves the square straight up. PS20.3: the
//    square has 4 edges and the circles 1; each circle is cut where its direction from the
//    centre meets the square's corners' (the square's sides meet the circle's quarters).
// 06 the square removed: the Ø30 circle leaves its plane straight up (normal, magnitude 2) and
//    bulges before narrowing to the Ø10.
// 07 accepted: Loft 1 in the list.
// 08 PS20.5 a new loft with a two-contour profile (Sketch 4 on Front: two separate squares):
//    its item is red, its regions are drawn red, and the dialog says why. Cancelled.
// 09 PS20.6 Loft 1 edited: Thin, 1 mm: the loft's side as a wall, open at both ends.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect -20 -20 20 20"),
        Key("Shift+7"),
        // Plane 1 and Plane 2.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("feature-top")),
        Click(ui("plane-offset-field")),
        Key("Ctrl+A"),
        Type("60"),
        Key("Enter"),
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("feature-top")),
        Click(ui("plane-offset-field")),
        Key("Ctrl+A"),
        Type("100"),
        Key("Enter"),
        // The circles.
        Click(ui("feature-plane-1")),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Key("C"),
        ClickWorld(0, 0),
        ClickWorld(15, 0),
        Key("Escape"),
        Key("Escape"),
        Click(ui("sketch-dialog-accept")),
        Click(ui("feature-plane-2")),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Key("C"),
        ClickWorld(0, 0),
        ClickWorld(5, 0),
        Key("Escape"),
        Key("Escape"),
        Click(ui("sketch-dialog-accept")),
        Key("Shift+7"),
        Key("F"),
        // The loft.
        Click(ui("loft")),
        WaitFor("loft-dialog"),
        Click(xyz(10, 10, 0)),
        Click(xyz(7, 7, 60)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-loft-square-to-circle"),
        Click(xyz(2, 2, 100)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-loft-three-profiles"),
        Click(ui("loft-profiles-field-reorder")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-loft-reorder-handles"),
        Drag(ui("loft-profiles-field-item-0-handle"), ui("loft-profiles-field-item-2")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-loft-square-dragged-last"),
        Click(ui("loft-profiles-field-done")),
        Key("Ctrl+Z"),
        Click(ui("loft-start-condition")),
        Click(ui("loft-start-condition-option-1")),
        Click(ui("loft-start-magnitude-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-loft-square-to-circles-normal-to-profile"),
        Click(ui("loft-profiles-field-item-0-remove")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-loft-circles-start-normal-magnitude-2"),
        Click(ui("loft-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-loft-accepted"),
        // PS20.5: a profile of two contours.
        Custom("sketch front rect 30 -10 40 0 rect 50 -10 60 0"),
        Click(ui("loft")),
        WaitFor("loft-dialog"),
        Click(ui("feature-sketch-4")),
        Click(ui("feature-sketch-3")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-loft-two-contour-profile-red"),
        Click(ui("loft-dialog-cancel")),
        Wait(10),
        // PS20.6: Thin.
        DoubleClick(ui("feature-loft-1")),
        WaitFor("loft-dialog"),
        Click(ui("loft-body-type-2")),
        Click(ui("loft-thickness1-field")),
        Key("Ctrl+A"),
        Type("1"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-loft-thin-1mm"),
        Click(ui("loft-dialog-accept")),
    ],
)
