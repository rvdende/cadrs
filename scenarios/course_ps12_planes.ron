// P3.7 / PS12.2–PS12.3: the Plane feature on a 100 × 60 × 40 block (the plane types' frames are
// asserted against hand-built ones in `cadrs_core::plane`'s `eight_plane_types` test).
// 01 Plane 1: Top picked in the feature list, Offset 25 mm by default: a translucent square
//    with its outline and name, the dialog as in `ex4-step5.png` (Entities "Top plane",
//    Offset, Offset distance with its flip, Flip normal, Final in the footer), and the offset's
//    arrow on the new plane.
// 02 The arrow dragged up: the distance follows it (55 mm, snapped), live.
// 03 Offset distance typed: 70: the plane above the block.
// 04 Its flip: 70 below Top. Flipped back and accepted.
// 05 Plane 2, Mid plane: the block's top face and Top: halfway up the block (z = 20).
// 06 Plane 3, Line angle: the block's top front edge and Top, 30°: tilted about the edge.
// 07 Plane 4, Three point: three corners of the block: a diagonal plane.
// 08 Mid plane of Front and Right (at 90°): the bisector through the Z axis; Flip alignment
//    (09): the other bisector. (Cancelled, as are 10–12 and 15.)
// 10 Plane point: Top and the block's far top corner: parallel to Top at z = 40.
// 11 Point normal: the block's front right vertical edge and its front left top corner: square
//    to the edge at z = 40.
// 12 Curve point: the block's top front edge and its left end: square to the edge at x = 0.
// 13 PS12.3: Plane 1 as a sketch plane: a Ø30 circle sketched on it.
// 14 PS12.3: Plane 3 as a direction: the circle extruded 50 along Plane 3's normal.
// 15 Tangent: a Ø30 cylinder's side face, at 300° round its axis (from X, counter-clockwise seen from above): a plane touching it along a
//    ruling. (The types' frames are asserted against hand-built ones in `cadrs_core::plane`'s
//    `eight_plane_types` and `tangent_planes` tests.)
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(50, 30, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("40"),
        Key("Enter"),
        Key("F"),
        // Plane 1: Offset from Top.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("feature-top")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-plane-offset-top-default"),
        Drag(xyz(0, 0, 25.5), xyz(0, 0, 57)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-plane-offset-arrow-dragged"),
        Click(ui("plane-offset-field")),
        Key("Ctrl+A"),
        Type("70"),
        Key("Tab"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-plane-offset-70"),
        Click(ui("plane-offset-flip")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-plane-offset-flipped"),
        Click(ui("plane-offset-flip")),
        Click(ui("plane-dialog-accept")),
        Key("F"),
        // Plane 2: Mid plane of the top face and Top.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-5")),
        Click(xyz(50, 30, 40)),
        Click(ui("feature-top")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-plane-mid-plane"),
        Click(ui("plane-dialog-accept")),
        // Plane 3: Line angle about the top front edge, from Top, 30°.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-2")),
        Click(xyz(50, 0, 40)),
        Click(ui("feature-top")),
        Click(ui("plane-angle-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-plane-line-angle-30"),
        Click(ui("plane-dialog-accept")),
        // Plane 4: Three point.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-4")),
        Click(xyz(0, 0, 40)),
        Click(xyz(100, 60, 40)),
        Click(xyz(100, 0, 0)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-plane-three-point"),
        Click(ui("plane-dialog-accept")),
        // Mid plane of two planes at an angle, and Flip alignment (the view turned a little, so
        // neither bisector is seen edge-on).
        RightDrag(at(1300, 800), at(1360, 780)),
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-5")),
        Click(ui("feature-front")),
        Click(ui("feature-right")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-plane-mid-plane-at-an-angle"),
        Click(ui("plane-flip-alignment-checkbox")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("09-plane-mid-plane-flip-alignment"),
        Click(ui("plane-dialog-cancel")),
        Key("Shift+7"),
        Key("F"),
        // Plane point.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-1")),
        Click(ui("feature-top")),
        Click(xyz(100, 60, 40)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("10-plane-plane-point"),
        Click(ui("plane-dialog-cancel")),
        // Point normal.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-3")),
        Click(xyz(100, 0, 20)),
        Click(xyz(0, 0, 40)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("11-plane-point-normal"),
        Click(ui("plane-dialog-cancel")),
        // Curve point.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-6")),
        Click(xyz(50, 0, 40)),
        Click(xyz(0, 0, 40)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("12-plane-curve-point"),
        Click(ui("plane-dialog-cancel")),
        // PS12.3: sketch on Plane 1.
        Click(ui("feature-plane-1")),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Key("C"),
        ClickWorld(50, 30),
        ClickWorld(65, 30),
        Key("Escape"),
        Key("Escape"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("13-sketch-on-plane-1"),
        Click(ui("sketch-dialog-accept")),
        // PS12.3: extruded along Plane 3's normal.
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(50, 30, 70)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("50"),
        Key("Tab"),
        Click(ui("extrude-direction-checkbox")),
        Click(ui("feature-plane-3")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("14-extrude-along-plane-3-normal"),
        Key("Enter"),
        // Tangent to a cylinder's side: a Ø30 cylinder 20 high beside the block.
        Custom("sketch top circle 150 30 15"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(150, 30, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Key("F"),
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("plane-type")),
        Click(ui("plane-type-option-8")),
        Click(xyz(150, 15, 10)),
        Click(ui("plane-angle-field")),
        Key("Ctrl+A"),
        Type("300"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(3),
        Scroll(at(1340, 680), -3),
        Wait(20),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("15-plane-tangent-to-the-cylinder"),
        Click(ui("plane-dialog-cancel")),
    ],
)
