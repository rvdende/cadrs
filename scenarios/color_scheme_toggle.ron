// The top bar's light / dark / system button, a click stepping to the next: dark at once on the
// documents page, still dark in a document (menus and dialogs too), and back to the system's,
// which scripted runs read as light, then light.
Scenario(
    start: Some("landing"),
    seed_documents: 6,
    steps: [
        WaitFor("color-scheme"),
        Screenshot("01-light-system"),
        // System, then light, then dark.
        Click(ui("color-scheme")),
        Click(ui("color-scheme")),
        Screenshot("02-dark-documents"),
        Click(ui("create")),
        WaitFor("new-document"),
        Screenshot("03-dark-create-menu"),
        Click(ui("new-document")),
        WaitFor("new-document-dialog"),
        Type("Dark bracket"),
        Screenshot("04-dark-new-document-dialog"),
        Click(ui("new-document-create")),
        WaitFor("document-shell"),
        Screenshot("05-dark-document"),
        Click(ui("app-menu")),
        Click(ui("app-preferences")),
        WaitFor("preferences-dialog"),
        Screenshot("06-dark-preferences"),
        Click(ui("pref-cancel")),
        Click(ui("color-scheme")),
        Screenshot("07-system-is-light-in-scripts"),
        Click(ui("color-scheme")),
        Screenshot("08-light-document"),
    ],
)
