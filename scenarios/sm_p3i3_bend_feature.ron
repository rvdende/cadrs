// SM13.3 with a Bend feature (P3I.3 fixes; lesson 13 "updates the bend radius value if using the
// Bend feature"): a 100 × 60 plate made by Thicken and bent by a Bend feature along x = 80. In
// the table, the Bend's bend takes a new radius into the Bend feature itself (no Modify joint
// appears); its row menu greys Convert, saying why; a K Factor no Bend can take (1.5) leaves the
// cell red with the reason, and nothing changes.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+7"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sheet-metal-model-operation-2")),
        Click(xyz(50, 30, 0)),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("sheet-metal-model-dialog-accept")),
        Custom("sketch top chain 80 -15 80 75"),
        Click(ui("sheet-metal-model-caret")),
        Click(ui("sheet-metal-menu-bend")),
        WaitFor("sheet-metal-bend-dialog"),
        Click(xyz(80, 70, 0)),
        Click(ui("sheet-metal-bend-dialog-accept")),
        Key("F"),
        Click(ui("panel-sheet-metal")),
        WaitFor("smt-panel"),
        Wait(40),
        DoubleClick(ui("smt-bend-0-radius")),
        Key("Ctrl+A"),
        Type("5"),
        Key("Enter"),
        MoveTo(700, 900),
        Wait(3),
        Screenshot("01-bend-feature-radius-5-no-modify-joint"),
        RightClick(ui("smt-bend-row-0")),
        Hover(ui("smt-convert")),
        Wait(60),
        Screenshot("02-convert-greyed-for-a-bend-feature"),
        Key("Escape"),
        // SM1.4 for edges and vertices: the plate's free side in the flat is the model's edge
        // (hovered, then selected); its corner is the model's vertex.
        Hover(ui_at("smt-flat", 0.276, 0.794)),
        Wait(10),
        Screenshot("03a-flat-side-hover-lights-the-model-edge"),
        Click(ui_at("smt-flat", 0.276, 0.794)),
        Hover(ui_at("smt-flat", 0.0358, 0.2056)),
        Wait(10),
        Screenshot("03b-edge-selected-corner-hover-lights-the-vertex"),
        Click(ui_at("smt-flat", 0.276, 0.794)),
        Wait(5),
        DoubleClick(ui("smt-bend-0-value")),
        Key("Ctrl+A"),
        Type("1.5"),
        Key("Enter"),
        Hover(ui("smt-bend-0-value")),
        Wait(60),
        Screenshot("04-k-factor-no-bend-takes-red"),
    ],
)
