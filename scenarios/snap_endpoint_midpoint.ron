// M5: point inference with the Line tool (compare reference/onshape/screens/18, 18a, 18b and
// NOTES.md "Line tool and inference"). An existing line; hovering its endpoint shows the orange
// snap square; its midpoint the square, the whole line orange and the midpoint glyph (-•-) at
// the cursor; elsewhere on it the whole line orange and the coincident glyph; empty space shows
// no inference. A line committed from the midpoint (snapping vertical) and one from the endpoint
// then show their constraint glyphs: midpoint, vertical, coincident at the shared endpoint.
// A 3-point arc: hovering its middle snaps to the arc's midpoint (square and -•-).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Wait(3),
        ClickAt(560, 575),
        Wait(3),
        Key("N"),
        Wait(40),
        Key("L"),
        Wait(2),
        ClickWorld(-50, 30),
        ClickWorld(30, 30.4),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveWorld(30.8, 30.9),
        Wait(2),
        Screenshot("01-hover-endpoint-square"),
        MoveWorld(-9.4, 30.5),
        Wait(2),
        Screenshot("02-hover-midpoint-glyph"),
        MoveWorld(12, 30.7),
        Wait(2),
        Screenshot("03-hover-on-line-orange"),
        MoveWorld(5, 60),
        Wait(2),
        Screenshot("04-empty-space-no-inference"),
        ClickWorld(-9.6, 30.3),
        MoveWorld(-9.2, -15),
        Wait(2),
        Screenshot("05-from-midpoint-vertical"),
        ClickWorld(-9.2, -15),
        Wait(2),
        Key("Escape"),
        Wait(2),
        ClickWorld(30.4, 30.2),
        MoveWorld(55, 5),
        Wait(2),
        Screenshot("06-from-endpoint"),
        ClickWorld(55, 5),
        Wait(2),
        Key("Escape"),
        Wait(2),
        MoveWorld(80, 60),
        Wait(3),
        Screenshot("07-committed-constraint-glyphs"),
        Key("A"),
        Wait(2),
        ClickWorld(-60, -40),
        ClickWorld(-20, -40),
        ClickWorld(-40, -25),
        Wait(3),
        Key("Escape"),
        Wait(2),
        Key("L"),
        Wait(2),
        MoveWorld(-39.8, -25.3),
        Wait(2),
        Screenshot("08-hover-arc-midpoint"),
    ],
)
