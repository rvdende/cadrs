// Sheet metal model, Convert (P3I.2, SM2.2, SM2.5, X4; lesson `02-sheet-metal-model` frames
// t0039–t0072): a 100 × 60 × 40 block picked in *Parts and surfaces to convert* becomes six
// walls (six parts, ripped at every edge); the white thickness arrow on the model flips the
// material inside and back; in *Edges or cylinders to bend* the view shows the block to pick on
// with the folded model translucent over it, updating with each pick, and three edges picked
// in two orders give two different models: the pick that would close a loop of bends stays a
// rip, so first the right wall hangs off the front one (a bend at the front-right corner, a gap along the top-right edge), then off the top (the
// other way round). Thickness 2 mm and bend radius 3 mm; accepted, undone and redone.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(50, 30, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("40"),
        Key("Enter"),
        Key("F"),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Click(ui("sm-thickness-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Tab"),
        Click(ui("sm-bend-radius-field")),
        Key("Ctrl+A"),
        Type("3"),
        Key("Tab"),
        Click(ui("sm-parts-field")),
        Click(xyz(50, 30, 40)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-block-six-walls"),
        // The thickness arrow on the model (`t0039.4.png`): a click flips the material inside
        // the block, a second click puts it back.
        Click(ui("sm-thickness-arrow")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01b-arrow-flips-thickness-inside"),
        Click(ui("sm-thickness-arrow")),
        Click(ui("sm-bends-field")),
        Click(xyz(50, 0, 40)),
        Click(xyz(100, 0, 20)),
        Click(xyz(100, 30, 40)),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-edges-picked-on-the-block"),
        Click(ui("sm-parts-field")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-order-a-front-right-bent"),
        Custom("view 30 30 100 0 40 0.05"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03b-order-a-corner"),
        Key("F"),
        // Pick again in another order: top-right, top-front, front-right.
        Click(ui("sm-bends-field")),
        Click(xyz(50, 0, 40)),
        Click(xyz(50, 0, 40)),
        Click(xyz(100, 0, 20)),
        Click(xyz(100, 0, 20)),
        Click(ui("sm-parts-field")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-order-b-top-right-bent"),
        Custom("view 30 30 100 0 40 0.05"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04b-order-b-corner"),
        Key("F"),
        Click(ui("sheet-metal-model-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-accepted"),
        Key("Ctrl+Z"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-undone"),
        Key("Ctrl+Y"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("07-redone"),
    ],
)
