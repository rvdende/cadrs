// Flange on several edges with an automatic miter (P3I.4, SM3.1, SM3.5): two flanges of one
// feature on the east and north edges of a 60 × 40 × 1 plate meet at its corner: a rip (an edge
// joint, "Joint C") between them, the minimal gap apart; then Automatic miter off ends the
// flanges where the miter plane (through the corner's outside) cuts their insides, seen from
// outside the corner: 45 deg (both at the plate's corner), then 30 deg (the east flange stops
// T·(cot 30° − 1) short, the north one runs T·(1 − tan 30°) on: the seam moves off the corner);
// then a 60 deg bend angle and Outer alignment.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Wait(30),
        Custom("sketch top rect 0 0 60 40"),
        Wait(5),
        Key("Shift+7"),
        Wait(40),
        Click(ui("sheet-metal-model")),
        WaitFor("sheet-metal-model-dialog"),
        Wait(5),
        Click(ui("sheet-metal-model-operation-2")),
        Wait(10),
        Click(xyz(30, 20, 0)),
        Wait(30),
        Click(ui("sheet-metal-model-dialog-accept")),
        Wait(30),
        Click(ui("sheet-metal-model-caret")),
        Wait(10),
        Click(ui("sheet-metal-menu-flange")),
        WaitFor("sheet-metal-flange-dialog"),
        Wait(10),
        Custom("view 30 30 40 20 0 0.11"),
        Wait(10),
        Click(xyz(60, 20, 1)),
        Wait(10),
        Click(xyz(30, 40, 1)),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-two-flanges-mitred"),
        Custom("view 30 30 60 40 10 0.04"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-mitred-corner"),
        // Automatic miter off: the ends cut at the miter angle, looked at from outside the corner
        // (the seam between the two flanges' faces).
        Click(ui("smf-auto-miter-checkbox")),
        Wait(40),
        Custom("view 135 15 60 40 12 0.035"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-miter-angle-45"),
        Click(ui("smf-miter-angle-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("30"),
        Key("Tab"),
        Wait(40),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03b-miter-angle-30"),
        Click(ui("smf-auto-miter-checkbox")),
        Wait(10),
        Click(ui("smf-bend-angle-field")),
        Wait(2),
        Key("Ctrl+A"),
        Type("60"),
        Key("Tab"),
        Wait(10),
        Click(ui("smf-alignment")),
        Wait(5),
        Click(ui("smf-alignment-option-1")),
        Wait(40),
        Custom("view 30 30 40 20 0 0.11"),
        Wait(10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-60-outer"),
        Click(ui("sheet-metal-flange-dialog-accept")),
        Wait(30),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-accepted"),
    ],
)
